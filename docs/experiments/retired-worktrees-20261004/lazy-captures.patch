+test "module template callables materialize captured state only on first call" {
+    const Probe = struct {
+        fn call(_: *Context, captures: Captures, _: []const Value) ![]const Value {
+            const cell = try captures.cell(0);
+            const next = if (cell.value == .number) cell.value.number + 1 else 1;
+            cell.value = .{ .number = next };
+            const out = try std.heap.smp_allocator.alloc(Value, 1);
+            out[0] = .{ .number = next };
+            return out;
+        }
+    };
+
+    var source_arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer source_arena.deinit();
+    var source = try Context.init(source_arena.allocator(), 0);
+    defer source.deinit();
+    const source_cell = try source.allocator.create(Cell);
+    source_cell.* = .{ .value = .{ .number = 0 } };
+    const original = try source.makeFunctionKnown(17, Probe.call, &.{source_cell});
+
+    var child_arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer child_arena.deinit();
+    var child = try Context.init(child_arena.allocator(), 0);
+    defer child.deinit();
+    child.module_template_clone_source = &source;
+    var clone = Context.ModuleTemplateClone{ .source = &source, .target = &child };
+    defer clone.deinit();
+    const lazy = try clone.cloneValue(original);
+    try std.testing.expect(lazy == .callable and lazy.callable != original.callable);
+    try std.testing.expect(lazy.callable.captures() == .template);
+    try std.testing.expectEqual(@as(usize, 0), child.module_template_clone_cells.count());
+
+    const first = try child.callValue(lazy, &.{});
+    defer freeResults(first);
+    try std.testing.expectEqual(@as(f64, 1), first[0].number);
+    try std.testing.expectEqual(@as(f64, 0), source_cell.value.number);
+    try std.testing.expectEqual(@as(usize, 1), child.module_template_clone_cells.count());
+
+    const second = try child.callValue(lazy, &.{});
+    defer freeResults(second);
+    try std.testing.expectEqual(@as(f64, 2), second[0].number);
+    try std.testing.expectEqual(@as(f64, 0), source_cell.value.number);
+}
