{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "jsx": "preserve", "jsxImportSource": "solid-js", "noEmit": true,
    "strict": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "allowImportingTsExtensions": true, "isolatedModules": true
  },
  "include": ["src"]
}
