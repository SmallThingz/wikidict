# Generated by the ordinary app configure; executed only by cmake --install.
set(_roots [==[@WIKIDICT_RUNTIME_ROOTS@]==])
set(_version [==[@WIKIDICT_RUNTIME_VERSION@]==])
set(_readelf [==[@WIKIDICT_RUNTIME_READELF@]==])
set(_strip [==[@WIKIDICT_RUNTIME_STRIP@]==])
set(_strip_debug [==[@WIKIDICT_QT_RUNTIME_STRIP_DEBUG@]==])
set(_gui [==[@WIKIDICT_RUNTIME_GUI@]==])
set(_linked_qt_files [==[@WIKIDICT_RUNTIME_LINKED_QT_FILES@]==])
set(_plugin_files [==[@WIKIDICT_RUNTIME_PLUGIN_FILES@]==])
set(_plugin_types [==[@WIKIDICT_RUNTIME_PLUGIN_TYPES@]==])
set(_plugin_targets [==[@WIKIDICT_RUNTIME_PLUGIN_TARGETS@]==])
if(NOT _version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Invalid selected Qt version")
endif()
set(_stage "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(REAL_PATH "${_stage}" _stage)

function(_owned_source source output)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Required Qt runtime artifact is not built: ${source}")
    endif()
    file(REAL_PATH "${source}" real)
    set(owned FALSE)
    foreach(root IN LISTS _roots)
        string(FIND "${real}" "${root}/" offset)
        if(offset EQUAL 0)
            set(owned TRUE)
        endif()
    endforeach()
    if(NOT owned)
        message(FATAL_ERROR "Qt artifact escapes selected coherent roots: ${real}")
    endif()
    set(${output} "${real}" PARENT_SCOPE)
endfunction()

function(_elf file needed_out soname_out rpath_out)
    execute_process(COMMAND "${_readelf}" -d "${file}"
        RESULT_VARIABLE status OUTPUT_VARIABLE dynamic ERROR_VARIABLE diagnostic)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect runtime ELF ${file}: ${diagnostic}")
    endif()
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]\n]*\\]" rows "${dynamic}")
    set(needed "")
    foreach(row IN LISTS rows)
        string(REGEX REPLACE ".*\\[([^]]*)\\].*" "\\1" name "${row}")
        if(NOT name MATCHES "^[A-Za-z0-9_+.-]+$")
            message(FATAL_ERROR "Nonportable ELF dependency in ${file}: ${name}")
        endif()
        list(APPEND needed "${name}")
    endforeach()
    string(REGEX MATCH "\\(SONAME\\)[^\n]*\\[([^]\n]*)\\]" row "${dynamic}")
    set(soname "${CMAKE_MATCH_1}")
    string(REGEX MATCHALL "\\((RUNPATH|RPATH)\\)[^\n]*\\[[^]\n]*\\]" paths "${dynamic}")
    list(LENGTH paths path_count)
    if(NOT path_count EQUAL 1)
        message(FATAL_ERROR "Qt artifact needs one reserved relocatable runtime path: ${file}")
    endif()
    list(GET paths 0 row)
    string(REGEX REPLACE ".*\\[([^]]*)\\].*" "\\1" rpath "${row}")
    set(${needed_out} "${needed}" PARENT_SCOPE)
    set(${soname_out} "${soname}" PARENT_SCOPE)
    set(${rpath_out} "${rpath}" PARENT_SCOPE)
endfunction()

function(_resolve_qt name output)
    set(candidates "")
    foreach(root IN LISTS _roots)
        if(EXISTS "${root}/lib/${name}")
            _owned_source("${root}/lib/${name}" real)
            list(APPEND candidates "${real}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES candidates)
    list(LENGTH candidates count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Qt dependency ${name} has ${count} selected candidates; no system fallback")
    endif()
    list(GET candidates 0 real)
    get_filename_component(filename "${real}" NAME)
    string(REGEX REPLACE "^libQt6[A-Za-z0-9_]+\\.so\\." "" actual_version "${filename}")
    if(NOT actual_version STREQUAL _version)
        message(FATAL_ERROR "Qt dependency does not match selected version ${_version}: ${filename}")
    endif()
    set(${output} "${real}" PARENT_SCOPE)
endfunction()

function(_dynamic_symbols file output)
    # Compare source and installed symbols with the same tool and locale. This
    # presentation digest is deliberately not a portable manifest field.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${_readelf}" --dyn-syms --wide "${file}"
        RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE diagnostic)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect runtime dynamic symbols ${file}: ${diagnostic}")
    endif()
    string(SHA256 digest "${symbols}")
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()

# A same-SONAME system target is not interchangeable with the selected private
# target. Verify actual configure-time imported module locations as well.
foreach(file IN LISTS _linked_qt_files)
    _owned_source("${file}" real)
    _elf("${real}" needed soname rpath)
    _resolve_qt("${soname}" selected)
    if(NOT selected STREQUAL real)
        message(FATAL_ERROR "Configured Qt target differs from selected runtime: ${file}")
    endif()
endforeach()

# Resolve only Qt dependencies of the real GUI and explicitly selected plugins.
# Non-Qt platform libraries remain normal distribution dependencies.
set(_queue "${_gui}")
set(_plugins "")
set(_plugin_relatives "")
list(LENGTH _plugin_files _plugin_count)
list(LENGTH _plugin_types _type_count)
list(LENGTH _plugin_targets _target_count)
if(NOT _plugin_count EQUAL _type_count OR NOT _plugin_count EQUAL _target_count OR _plugin_count EQUAL 0)
    message(FATAL_ERROR "Invalid configured Qt plugin inventory")
endif()
math(EXPR _last_plugin "${_plugin_count} - 1")
foreach(index RANGE ${_last_plugin})
    list(GET _plugin_files ${index} file)
    list(GET _plugin_types ${index} type)
    _owned_source("${file}" real)
    get_filename_component(name "${real}" NAME)
    if(NOT name MATCHES "^lib[A-Za-z0-9_-]+\\.so$" OR NOT type MATCHES "^[a-z][a-z-]*$")
        message(FATAL_ERROR "Invalid configured plugin artifact: ${type}/${name}")
    endif()
    get_filename_component(source_directory "${real}" DIRECTORY)
    get_filename_component(source_type "${source_directory}" NAME)
    if(NOT source_type STREQUAL type)
        message(FATAL_ERROR "Selected plugin directory differs from its runtime type: ${real}")
    endif()
    set(relative "lib/qt6/plugins/${type}/${name}")
    if(relative IN_LIST _plugin_relatives)
        message(FATAL_ERROR "Duplicate runtime plugin destination: ${relative}")
    endif()
    list(APPEND _plugins "${real}")
    list(APPEND _plugin_relatives "lib/qt6/plugins/${type}/${name}")
    list(APPEND _queue "${real}")
endforeach()
set(_libraries "")
set(_seen "")
while(_queue)
    list(POP_FRONT _queue file)
    if(file IN_LIST _seen)
        continue()
    endif()
    list(APPEND _seen "${file}")
    _elf("${file}" needed soname rpath)
    foreach(name IN LISTS needed)
        if(name MATCHES "^libQt6[A-Za-z0-9_]+\\.so\\.6$")
            _resolve_qt("${name}" real)
            if(NOT real IN_LIST _libraries)
                list(APPEND _libraries "${real}")
                list(APPEND _queue "${real}")
            endif()
        elseif(name MATCHES "^libQt")
            message(FATAL_ERROR "Unexpected Qt dependency name: ${name}")
        endif()
    endforeach()
endwhile()
if(NOT _libraries)
    message(FATAL_ERROR "GUI has no selected Qt runtime dependencies")
endif()

# No symlinked destination directory may redirect a package write outside its
# prefix. CLI/user-data paths are not changed by this runtime staging.
function(_directory relative)
    set(current "${_stage}")
    string(REPLACE "/" ";" pieces "${relative}")
    foreach(piece IN LISTS pieces)
        string(APPEND current "/${piece}")
        if(IS_SYMLINK "${current}")
            message(FATAL_ERROR "Symlinked runtime destination directory: ${current}")
        endif()
        file(MAKE_DIRECTORY "${current}")
    endforeach()
endfunction()

function(_copy_runtime source relative new_rpath output)
    get_filename_component(directory "${relative}" DIRECTORY)
    _directory("${directory}")
    set(destination "${_stage}/${relative}")
    if(IS_SYMLINK "${destination}")
        message(FATAL_ERROR "Runtime file destination is a symlink: ${relative}")
    endif()
    _elf("${source}" needed soname old_rpath)
    _dynamic_symbols("${source}" source_symbols)
    file(SHA256 "${source}" source_sha)
    # Compare bytes rather than source timestamps: an earlier install already
    # rewrote its RPATH, and an incremental artifact can retain timestamps.
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT RESULT copy_error)
    if(NOT copy_error STREQUAL "0")
        message(FATAL_ERROR "Cannot stage Qt runtime ${relative}: ${copy_error}")
    endif()
    if(NOT old_rpath STREQUAL new_rpath)
        file(RPATH_CHANGE FILE "${destination}" OLD_RPATH "${old_rpath}" NEW_RPATH "${new_rpath}")
    endif()
    if(_strip_debug)
        if(NOT EXISTS "${_strip}")
            message(FATAL_ERROR "Selected debug stripping tool is unavailable")
        endif()
        # Only the installed copy is changed. Keep dynamic symbols, resources,
        # plugin metadata and the original build's debugging information.
        execute_process(COMMAND "${_strip}" --strip-debug "${destination}"
            RESULT_VARIABLE strip_status ERROR_VARIABLE strip_diagnostic)
        if(NOT strip_status EQUAL 0)
            message(FATAL_ERROR "Cannot remove runtime debug information ${relative}: ${strip_diagnostic}")
        endif()
        execute_process(COMMAND "${_readelf}" --sections --wide "${destination}"
            RESULT_VARIABLE sections_status OUTPUT_VARIABLE sections ERROR_VARIABLE sections_diagnostic)
        if(NOT sections_status EQUAL 0 OR sections MATCHES "[ \t]\\.(debug|zdebug|stab)[_. \t]")
            message(FATAL_ERROR "Runtime debug information remains in ${relative}: ${sections_diagnostic}")
        endif()
    endif()
    _dynamic_symbols("${destination}" installed_symbols)
    if(NOT installed_symbols STREQUAL source_symbols)
        message(FATAL_ERROR "Installed runtime dynamic symbols differ: ${relative}")
    endif()
    _elf("${destination}" installed_needed installed_soname installed_rpath)
    if(NOT installed_rpath STREQUAL new_rpath OR NOT installed_needed STREQUAL needed
        OR NOT installed_soname STREQUAL soname)
        message(FATAL_ERROR "Installed runtime identity/RPATH differs: ${relative}")
    endif()
    file(SHA256 "${destination}" installed_sha)
    set(needed_json "[]")
    set(index 0)
    foreach(name IN LISTS needed)
        string(JSON needed_json SET "${needed_json}" ${index} "\"${name}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    set(row "{\"path\":\"${relative}\",\"source_sha256\":\"${source_sha}\",\"sha256\":\"${installed_sha}\",\"soname\":\"${soname}\",\"rpath\":\"${new_rpath}\",\"needed\":${needed_json}}")
    set(${output} "${row}" PARENT_SCOPE)
endfunction()

set(_manifest "{\"schema\":\"wikidict.qt-runtime.v1\",\"qt_version\":\"${_version}\",\"libraries\":[],\"plugins\":[],\"dynamic_symbols_preserved\":true}")
if(_strip_debug)
    string(JSON _manifest SET "${_manifest}" debug_information "\"removed\"")
else()
    string(JSON _manifest SET "${_manifest}" debug_information "\"preserved\"")
endif()
set(_expected_libs "")
set(_expected_plugins "")
set(index 0)
foreach(file IN LISTS _libraries)
    get_filename_component(name "${file}" NAME)
    _elf("${file}" needed soname rpath)
    if(NOT soname MATCHES "^libQt6[A-Za-z0-9_]+\\.so\\.6$")
        message(FATAL_ERROR "Invalid Qt library SONAME: ${file}")
    endif()
    _copy_runtime("${file}" "lib/${name}" "$ORIGIN" row)
    set(link "${_stage}/lib/${soname}")
    if(IS_SYMLINK "${link}")
        file(READ_SYMLINK "${link}" target)
        if(NOT target STREQUAL name)
            message(FATAL_ERROR "Existing Qt SONAME link has a different target: ${link}")
        endif()
    elseif(EXISTS "${link}")
        message(FATAL_ERROR "Existing Qt SONAME path is not the expected link: ${link}")
    else()
        file(CREATE_LINK "${name}" "${link}" SYMBOLIC RESULT link_error)
        if(NOT link_error STREQUAL "0")
            message(FATAL_ERROR "Cannot create Qt SONAME link: ${link_error}")
        endif()
    endif()
    list(APPEND _expected_libs "${_stage}/lib/${name}" "${link}")
    string(JSON _manifest SET "${_manifest}" libraries ${index} "${row}")
    math(EXPR index "${index} + 1")
endforeach()
foreach(index RANGE ${_last_plugin})
    list(GET _plugins ${index} file)
    list(GET _plugin_relatives ${index} relative)
    list(GET _plugin_targets ${index} target)
    _copy_runtime("${file}" "${relative}" "$ORIGIN/../../.." row)
    list(APPEND _expected_plugins "${_stage}/${relative}")
    string(JSON row SET "${row}" target "\"${target}\"")
    string(JSON _manifest SET "${_manifest}" plugins ${index} "${row}")
endforeach()
# A fresh or repeat install contains exactly this runtime, never stale SDK or
# differently-versioned Qt libraries accidentally left in the selected prefix.
file(GLOB _actual_libs "${_stage}/lib/libQt*.so*")
list(SORT _actual_libs)
list(SORT _expected_libs)
if(NOT _actual_libs STREQUAL _expected_libs)
    message(FATAL_ERROR "Installed prefix contains Qt libraries outside the selected runtime closure")
endif()
file(GLOB_RECURSE _actual_plugins LIST_DIRECTORIES FALSE "${_stage}/lib/qt6/plugins/*")
list(SORT _actual_plugins)
list(SORT _expected_plugins)
if(NOT _actual_plugins STREQUAL _expected_plugins)
    message(FATAL_ERROR "Installed prefix contains plugins outside the selected inventory")
endif()
_directory("bin")
_directory("share/wikidict")
foreach(relative IN ITEMS "bin/qt.conf" "share/wikidict/qt-runtime.json")
    if(IS_SYMLINK "${_stage}/${relative}")
        message(FATAL_ERROR "Symlinked runtime metadata destination: ${relative}")
    endif()
endforeach()
# The caller supplies the retained, source-identical notice payload, separately
# from binary roots. No source code, headers, build tools or SDK are installed.
set(_notice_manifest [==[@WIKIDICT_RUNTIME_NOTICE_MANIFEST@]==])
set(_notice_expected_sha [==[@WIKIDICT_RUNTIME_NOTICE_MANIFEST_SHA256@]==])
file(SHA256 "${_notice_manifest}" _notice_sha)
if(NOT _notice_sha STREQUAL _notice_expected_sha)
    message(FATAL_ERROR "Selected Qt notice manifest changed after configure")
endif()
file(READ "${_notice_manifest}" _notices)
string(JSON _notice_schema GET "${_notices}" schema)
string(JSON _notice_count LENGTH "${_notices}" files)
string(JSON _missing_count LENGTH "${_notices}" missing_referenced_files)
if(NOT _notice_schema STREQUAL "wikidict.qt-notices.v1" OR _notice_count EQUAL 0 OR NOT _missing_count EQUAL 0)
    message(FATAL_ERROR "Invalid selected Qt notice inventory")
endif()
get_filename_component(_notice_root "${_notice_manifest}" DIRECTORY)
set(_notice_rows "[]")
math(EXPR _last_notice "${_notice_count} - 1")
set(_seen_notices "")
foreach(index RANGE ${_last_notice})
    string(JSON relative GET "${_notices}" files ${index} path)
    string(JSON expected_sha GET "${_notices}" files ${index} sha256)
    if(NOT relative MATCHES "^(qtbase|qtsvg|qtmultimedia)/(LICENSES|src)/[A-Za-z0-9_./+-]+$"
        OR relative MATCHES "(^|/)\\.\\.(/|$)" OR relative IN_LIST _seen_notices)
        message(FATAL_ERROR "Invalid Qt notice path: ${relative}")
    endif()
    list(APPEND _seen_notices "${relative}")
    set(source "${_notice_root}/notices/${relative}")
    file(REAL_PATH "${source}" real)
    string(FIND "${real}" "${_notice_root}/notices/" offset)
    if(NOT offset EQUAL 0 OR IS_SYMLINK "${source}")
        message(FATAL_ERROR "Qt notice source escaped its retained payload")
    endif()
    file(SHA256 "${source}" sha)
    if(NOT sha STREQUAL expected_sha)
        message(FATAL_ERROR "Qt notice bytes changed: ${relative}")
    endif()
    set(destination_relative "share/licenses/wikidict/qt/${relative}")
    get_filename_component(directory "${destination_relative}" DIRECTORY)
    _directory("${directory}")
    if(IS_SYMLINK "${_stage}/${destination_relative}")
        message(FATAL_ERROR "Symlinked Qt notice destination")
    endif()
    file(COPY_FILE "${source}" "${_stage}/${destination_relative}" ONLY_IF_DIFFERENT)
    file(SHA256 "${_stage}/${destination_relative}" installed_sha)
    if(NOT installed_sha STREQUAL sha)
        message(FATAL_ERROR "Installed Qt notice bytes differ")
    endif()
    string(JSON _notice_rows SET "${_notice_rows}" ${index}
        "{\"path\":\"${destination_relative}\",\"sha256\":\"${sha}\"}")
    list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${CMAKE_INSTALL_PREFIX}/${destination_relative}")
endforeach()
string(JSON _manifest SET "${_manifest}" notices "${_notice_rows}")

file(WRITE "${_stage}/bin/qt.conf" "[Paths]\nPrefix=..\nLibraries=lib\nPlugins=lib/qt6/plugins\n")
file(WRITE "${_stage}/share/wikidict/qt-runtime.json" "${_manifest}\n")

foreach(file IN LISTS _expected_libs _expected_plugins)
    string(LENGTH "$ENV{DESTDIR}" destdir_length)
    string(SUBSTRING "${file}" ${destdir_length} -1 installed)
    list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${installed}")
endforeach()
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${CMAKE_INSTALL_PREFIX}/bin/qt.conf" "${CMAKE_INSTALL_PREFIX}/share/wikidict/qt-runtime.json")
