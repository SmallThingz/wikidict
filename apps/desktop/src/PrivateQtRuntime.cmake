# Optional coherent Qt runtime deployment for the paired private Qt build.
# System-Qt packages keep their existing installation contract.
option(WIKIDICT_BUNDLE_QT_RUNTIME "Install the selected matching Qt runtime beside the GUI" OFF)
option(WIKIDICT_QT_RUNTIME_STRIP_DEBUG "Remove debug information from installed Qt copies; retain build artifacts" ON)
set(WIKIDICT_QT_RUNTIME_ROOTS "" CACHE STRING "Exact coherent Qt build/install prefixes supplying runtime artifacts")
set(_required_runtime_plugins
    "QWaylandIntegrationPlugin;QWaylandXdgShellIntegrationPlugin;QXcbIntegrationPlugin;QSvgPlugin;QSvgIconPlugin;QFFmpegMediaPlugin;QTlsBackendOpenSSLPlugin;QJpegPlugin;QGifPlugin;QComposePlatformInputContextPlugin;QIbusPlatformInputContextPlugin"
)
if(NOT WIKIDICT_BUNDLE_QT_RUNTIME)
    return()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Bundled Qt runtime staging currently requires a native Linux ELF build")
endif()
if(NOT WIKIDICT_QT_RUNTIME_ROOTS)
    message(FATAL_ERROR "Set WIKIDICT_QT_RUNTIME_ROOTS to the coherent Qt prefixes")
endif()
set(WIKIDICT_QT_RUNTIME_NOTICES_MANIFEST "" CACHE FILEPATH "Authenticated Qt runtime notice inventory with adjacent notices payload")
if(NOT EXISTS "${WIKIDICT_QT_RUNTIME_NOTICES_MANIFEST}")
    message(FATAL_ERROR "Bundled Qt requires its retained license/attribution notice payload")
endif()
file(REAL_PATH "${WIKIDICT_QT_RUNTIME_NOTICES_MANIFEST}" WIKIDICT_RUNTIME_NOTICE_MANIFEST)
file(SHA256 "${WIKIDICT_RUNTIME_NOTICE_MANIFEST}" WIKIDICT_RUNTIME_NOTICE_MANIFEST_SHA256)
find_program(WIKIDICT_RUNTIME_READELF NAMES readelf REQUIRED)
set(WIKIDICT_RUNTIME_STRIP "")
if(WIKIDICT_QT_RUNTIME_STRIP_DEBUG)
    if(CMAKE_STRIP AND EXISTS "${CMAKE_STRIP}")
        set(WIKIDICT_RUNTIME_STRIP "${CMAKE_STRIP}")
    else()
        find_program(WIKIDICT_RUNTIME_STRIP_TOOL NAMES llvm-strip strip REQUIRED)
        set(WIKIDICT_RUNTIME_STRIP "${WIKIDICT_RUNTIME_STRIP_TOOL}")
    endif()
endif()
set(_runtime_roots "")
foreach(_root IN LISTS WIKIDICT_QT_RUNTIME_ROOTS)
    if(NOT IS_ABSOLUTE "${_root}" OR NOT IS_DIRECTORY "${_root}/lib")
        message(FATAL_ERROR "Invalid private Qt runtime root: ${_root}")
    endif()
    file(REAL_PATH "${_root}" _real_root)
    list(APPEND _runtime_roots "${_real_root}")
endforeach()
list(REMOVE_DUPLICATES _runtime_roots)
set(WIKIDICT_RUNTIME_ROOTS "${_runtime_roots}")
set(WIKIDICT_RUNTIME_VERSION "${Qt6Core_VERSION}")
set(WIKIDICT_RUNTIME_GUI "$<TARGET_FILE:wikidict-gui>")
set(WIKIDICT_RUNTIME_PLUGIN_FILES "")
set(WIKIDICT_RUNTIME_PLUGIN_TYPES "")
set(WIKIDICT_RUNTIME_PLUGIN_TARGETS "${_required_runtime_plugins}")
if(BUILD_TESTING)
    list(APPEND WIKIDICT_RUNTIME_PLUGIN_TARGETS QOffscreenIntegrationPlugin)
endif()
list(REMOVE_DUPLICATES WIKIDICT_RUNTIME_PLUGIN_TARGETS)
# These packages expose the platform plugin's matching private module targets;
# they do not cause any unrelated Qt target to be compiled.
find_package(Qt6 ${Qt6Core_VERSION} EXACT REQUIRED COMPONENTS OpenGL WaylandClient)
set(WIKIDICT_RUNTIME_LINKED_QT_FILES "")
foreach(_module IN ITEMS Core Gui Widgets Concurrent Network Multimedia Svg OpenGL WaylandClient DBus)
    if(NOT TARGET "Qt6::${_module}")
        message(FATAL_ERROR "Missing coherent imported Qt module: ${_module}")
    endif()
    list(APPEND WIKIDICT_RUNTIME_LINKED_QT_FILES "$<TARGET_FILE:Qt6::${_module}>")
endforeach()
# Svg's image/icon plugin packages belong to Gui, but a separate Svg build
# prefix does not participate in Gui's local automatic plugin-config scan.
# Import those existing packages explicitly from the selected Svg prefix.
get_filename_component(_svg_plugin_package_dir "${Qt6Svg_DIR}/../Qt6Gui" REALPATH)
set(_owned_svg_package FALSE)
foreach(_root IN LISTS _runtime_roots)
    if(_svg_plugin_package_dir STREQUAL "${_root}/lib/cmake/Qt6Gui")
        set(_owned_svg_package TRUE)
    endif()
endforeach()
if(NOT _owned_svg_package)
    message(FATAL_ERROR "Svg plugin package directory is outside the selected Qt roots")
endif()
foreach(_svg_plugin IN ITEMS QSvgPlugin QSvgIconPlugin)
    if(NOT TARGET "Qt6::${_svg_plugin}")
        set(Qt6${_svg_plugin}_DIR "${_svg_plugin_package_dir}")
        find_package(Qt6${_svg_plugin} ${Qt6Core_VERSION} EXACT REQUIRED CONFIG
            PATHS "${_svg_plugin_package_dir}" NO_DEFAULT_PATH)
    endif()
endforeach()

foreach(_plugin IN LISTS WIKIDICT_RUNTIME_PLUGIN_TARGETS)
    if(NOT _plugin MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT TARGET "Qt6::${_plugin}")
        message(FATAL_ERROR "Required coherent Qt plugin target is unavailable: ${_plugin}")
    endif()
    get_target_property(_type "Qt6::${_plugin}" QT_PLUGIN_TYPE)
    # Qt exports a sanitized C++ identifier, while its loader and install
    # directory retain the original hyphens. Do not decode arbitrary types.
    if(_plugin STREQUAL "QWaylandXdgShellIntegrationPlugin" AND _type STREQUAL "wayland_shell_integration")
        set(_type "wayland-shell-integration")
    endif()
    if(NOT _type MATCHES "^(platforms|imageformats|iconengines|multimedia|tls|platforminputcontexts|wayland-shell-integration)$")
        message(FATAL_ERROR "Unexpected runtime plugin type for ${_plugin}: ${_type}")
    endif()
    list(APPEND WIKIDICT_RUNTIME_PLUGIN_FILES "$<TARGET_FILE:Qt6::${_plugin}>")
    list(APPEND WIKIDICT_RUNTIME_PLUGIN_TYPES "${_type}")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/InstallPrivateQtRuntime.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/InstallPrivateQtRuntime.in.cmake" @ONLY)
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/InstallPrivateQtRuntime-$<CONFIG>.cmake"
    INPUT "${CMAKE_CURRENT_BINARY_DIR}/InstallPrivateQtRuntime.in.cmake")
install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/InstallPrivateQtRuntime-$<CONFIG>.cmake")
set(WIKIDICT_UNIFIED_RUNTIME_ARGUMENT --private-qt-runtime)
