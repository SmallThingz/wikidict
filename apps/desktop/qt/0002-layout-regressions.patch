+void tst_QTextDocumentLayout::rubyJointBreaksRequireEveryVisibleInterior()
+{
+    QTextDocument document;
+    QFont font; font.setPixelSize(20); document.setDefaultFont(font);
+    QFont small = font; small.setPixelSize(12);
+    QTextCursor cursor(&document); QTextCharFormat base; base.setFont(font);
+    QTextCharFormat reading; reading.setFont(small);
+    const QString baseText = QString::fromUtf16(u"\u4e00\u4e8c\u4e09\u56db\u4e94\u516d\u4e03\u516b");
+    const QString readingText = QString::fromUtf16(u"\u3042\u3044\u3046\u3048\u304a\u304b\u304d\u304f");
+    cursor.insertText(baseText, base); cursor.insertText(readingText, reading);
+    QTextRubyLayout::Description source;
+    QTextRubyLayout::Child b; b.source = {0, 8}; b.ownerFont = font; b.usedAbove = 16; b.usedBelow = 4;
+    QTextRubyLayout::Child a; a.source = {8, 16}; a.ownerFont = small;
+    source.bases = {b}; source.readings = {{a, 0, 1, 0}}; source.gaps = {0};
+    auto fragments = QTextRubyLayout::fragments(&document, source, 55);
+    QVERIFY(fragments); QVERIFY(fragments->size() > 1);
+    int nextBase = 0, nextReading = 8;
+    for (const auto &fragment : *fragments) {
+        QCOMPARE(fragment.bases[0].source.first, nextBase);
+        QCOMPARE(fragment.readings[0].child.source.first, nextReading);
+        QVERIFY(fragment.bases[0].source.last > nextBase);
+        QVERIFY(fragment.readings[0].child.source.last > nextReading);
+        nextBase = fragment.bases[0].source.last;
+        nextReading = fragment.readings[0].child.source.last;
+        QVERIFY(QTextRubyLayout::create(&document, fragment));
+    }
+    QCOMPARE(nextBase, 8); QCOMPARE(nextReading, 16);
+    source.readings[0].child.source.last = 8; // Visible empty reading is real.
+    fragments = QTextRubyLayout::fragments(&document, source, 55);
+    QVERIFY(fragments); QCOMPARE(fragments->size(), 1);
+    source.readings[0].child.source.last = 16;
+    source.bases[0].option.setWrapMode(QTextOption::NoWrap);
+    fragments = QTextRubyLayout::fragments(&document, source, 55);
+    QVERIFY(fragments); QCOMPARE(fragments->size(), 1);
+    source.bases[0].option.setWrapMode(QTextOption::WordWrap);
+    auto hidden = a; hidden.source.last = hidden.source.first;
+    hidden.background = QBrush(Qt::magenta); hidden.baselineDelta = -1000;
+    source.readings = {{hidden, 0, 1, 0, true}};
+    auto allHidden = QTextRubyLayout::create(&document, source); QVERIFY(allHidden);
+    auto plainSource = source; plainSource.readings.clear();
+    auto ordinary = QTextRubyLayout::create(&document, plainSource); QVERIFY(ordinary);
+    QVERIFY(!allHidden->metrics().visibleAnnotation);
+    QCOMPARE(allHidden->metrics().advance, ordinary->metrics().advance);
+    QCOMPARE(allHidden->metrics().occupiedTop, ordinary->metrics().occupiedTop);
+    QCOMPARE(allHidden->metrics().occupiedBottom, ordinary->metrics().occupiedBottom);
+    auto invalidHidden = source; invalidHidden.readings[0].child.source.last += 1;
+    QVERIFY(!QTextRubyLayout::create(&document, invalidHidden));
+    // Put the hidden paint inside the raster; the metric stress offset above
+    // must not make this paint-negative assertion vacuous.
+    source.readings[0].child.baselineDelta = 0;
+    auto paintHidden = QTextRubyLayout::create(&document, source); QVERIFY(paintHidden);
+    QImage hiddenPaint(300, 100, QImage::Format_ARGB32_Premultiplied), plainPaint = hiddenPaint;
+    hiddenPaint.fill(Qt::white); plainPaint.fill(Qt::white);
+    { QPainter painter(&hiddenPaint); paintHidden->draw(&painter, QPointF(10, 40), {}); }
+    { QPainter painter(&plainPaint); ordinary->draw(&painter, QPointF(10, 40), {}); }
+    QCOMPARE(hiddenPaint, plainPaint);
+    source.readings.append({a, 0, 1, 1, false});
+    auto lower = QTextRubyLayout::create(&document, source); QVERIFY(lower);
+    QVERIFY(lower->characterRect(8).top() >= lower->characterRect(0).bottom() - 1.0 / 64);
+    fragments = QTextRubyLayout::fragments(&document, source, 55);
+    QVERIFY(fragments); QVERIFY(fragments->size() > 1); // Hidden empty row cannot block a real joint split.
+}
