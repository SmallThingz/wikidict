+class TableCaptionImageHandler : public QObject, public QTextObjectInterface
+{
+    Q_OBJECT
+    Q_INTERFACES(QTextObjectInterface)
+public:
+    int depth = 0, maximumDepth = 0, calls = 0;
+    bool valid = true;
+    QRectF painted;
+    QList<QVariantMap> decorations;
+    QSizeF intrinsicSize(QTextDocument *document, int position, const QTextFormat &format) override
+    {
+        ++calls; maximumDepth = qMax(maximumDepth, ++depth);
+        const auto leave = qScopeGuard([&] { --depth; });
+        if (depth != 1) { valid = false; return {}; }
+        auto *native = qobject_cast<QTextDocumentLayout *>(document->documentLayout());
+        const auto image = format.toImageFormat();
+        const int revision = document->revision();
+        const qreal width = native->wikidictFigureContentWidth(position);
+        valid &= qIsFinite(width) && width >= 0 && width == native->wikidictFigureContentWidth(position)
+            && revision == document->revision();
+        const qreal ratio = qMin(image.width(), qMax(qreal(0), width)) / image.width();
+        return QSizeF(image.width() * ratio, image.height() * ratio);
+    }
+    void drawObject(QPainter *painter, const QRectF &rect, QTextDocument *, int, const QTextFormat &format) override
+    {
+        if (format.hasProperty(QTextFormat::UserProperty + 0x57af)) {
+            decorations.append(format.property(QTextFormat::UserProperty + 0x57af).toMap()); return;
+        }
+        painted = rect; painter->fillRect(rect, QColor(200, 0, 200));
+    }
+};
