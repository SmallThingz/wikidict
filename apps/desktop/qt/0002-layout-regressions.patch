+            // End/outside-visible requests retain the stock edge policy even for owned captions.
+            const auto &nativeLine = block.layout()->engine()->lines.at(line.lineNumber());
+            const QList<int> outside = {nativeLine.from + nativeLine.length,
+                qMax(0, nativeLine.from - 1)};
