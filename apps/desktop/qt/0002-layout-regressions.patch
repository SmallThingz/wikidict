+    void cachedFloatLineDisplacementAdvancesFollowingBlock()
+    {
+        for (int heightType : {int(QTextBlockFormat::SingleHeight), int(QTextBlockFormat::ProportionalHeight), int(QTextBlockFormat::FixedHeight)}) {
+            QTextDocument doc;
+            doc.setLayoutEnabled(false);
+            doc.setDefaultFont(QFont(QStringLiteral("DejaVu Sans"), 12));
+            QTextOption option = doc.defaultTextOption();
+            option.setWrapMode(QTextOption::WordWrap);
+            doc.setDefaultTextOption(option);
+            doc.setTextWidth(360);
+            QTextCursor cursor(&doc);
+            QTextFrameFormat floating;
+            floating.setPosition(QTextFrameFormat::FloatLeft);
+            floating.setWidth(300); floating.setHeight(260);
+            floating.setMargin(0); floating.setPadding(0); floating.setBorder(0);
+            auto *frame = cursor.insertFrame(floating);
+            frame->firstCursorPosition().insertText(QStringLiteral("Float"));
+            cursor.setPosition(frame->lastPosition() + 1);
+            QTextBlockFormat headingFormat;
+            headingFormat.setLineHeight(heightType == QTextBlockFormat::ProportionalHeight ? 150 : 40, heightType);
+            cursor.setBlockFormat(headingFormat);
+            QTextCharFormat headingInk; headingInk.setFontPointSize(20);
+            QFont headingFont = doc.defaultFont(); headingFont.setPointSize(20);
+            const QFontMetricsF headingMetrics(headingFont, doc.documentLayout()->paintDevice());
+            const qreal headingWidth = headingMetrics.horizontalAdvance(QStringLiteral("Heading"));
+            const qreal contentWidth = doc.textWidth() - 2 * doc.documentMargin();
+            const qreal sideGap = contentWidth - floating.width().rawValue();
+            QVERIFY(sideGap > 0);
+            QVERIFY(headingWidth > sideGap);
+            QVERIFY(headingWidth < contentWidth);
+            QCOMPARE(doc.defaultTextOption().wrapMode(), QTextOption::WordWrap);
+            cursor.insertText(QStringLiteral("Heading"), headingInk);
+            const QTextBlock heading = cursor.block();
+            cursor.insertBlock();
+            QTextBlockFormat followingFormat;
+            followingFormat.setProperty(QTextFormat::UserProperty + 0x5760, QStringLiteral("wikidict.paragraph-box/2"));
+            followingFormat.setProperty(QTextFormat::UserProperty + 0x5761, 0.0);
+            followingFormat.setProperty(QTextFormat::UserProperty + 0x5762, 0.0);
+            followingFormat.setProperty(QTextFormat::UserProperty + 0x5763, false);
+            cursor.setBlockFormat(followingFormat);
+            QTextCharFormat link; link.setAnchor(true); link.setAnchorHref(QStringLiteral("dict:following"));
+            link.setFontPointSize(12);
+            cursor.insertText(QStringLiteral("Following paragraph link"), link);
+            const QTextBlock following = cursor.block();
+            const QString raw = doc.toRawText();
+            auto *native = qobject_cast<QTextDocumentLayout *>(doc.documentLayout()); QVERIFY(native);
+            doc.setLayoutEnabled(true); native->documentSize();
+            const auto lineRect = [](const QTextBlock &block) {
+                const auto *layout = block.layout();
+                return layout->lineAt(0).rect().translated(layout->position());
+            };
+            QCOMPARE(heading.layout()->lineCount(), 1);
+            QCOMPARE(following.layout()->lineCount(), 1);
+            const QRectF initialHeading = lineRect(heading);
+            const QRectF initialFollowing = lineRect(following);
+            QVERIFY(initialHeading.top() >= native->frameBoundingRect(frame).bottom());
+            QVERIFY(initialFollowing.top() >= initialHeading.bottom());
+            for (int repetition = 0; repetition < 3; ++repetition) {
+                doc.markContentsDirty(following.position(), following.length());
+                native->documentSize();
+                QCOMPARE(native->wikidictParagraphBoxLayoutError(), 0);
+                QCOMPARE(lineRect(heading), initialHeading);
+                QCOMPARE(lineRect(following), initialFollowing);
+                QVERIFY(lineRect(following).top() >= lineRect(heading).bottom());
+                const auto first = following.layout()->lineAt(0);
+                const QPointF point = following.layout()->position()
+                    + QPointF((first.cursorToX(0) + first.cursorToX(1)) / 2, first.y() + first.height() / 2);
+                const int hit = native->hitTest(point, Qt::FuzzyHit);
+                QVERIFY(hit >= following.position() && hit <= following.position() + 1);
+                QTextCursor actual(&doc); actual.setPosition(following.position());
+                actual.movePosition(QTextCursor::NextCharacter, QTextCursor::KeepAnchor);
+                QCOMPARE(actual.charFormat().anchorHref(), QStringLiteral("dict:following"));
+                QCOMPARE(doc.toRawText(), raw);
+            }
+        }
+    }
