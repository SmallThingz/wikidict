+            QTextDocument doc; doc.setDefaultFont(QFont(QStringLiteral("DejaVu Sans"), 12));
+            doc.setDocumentMargin(0); doc.setTextWidth(pageWidth);
+            QCOMPARE(doc.documentLayout()->property("_wikidictCellStyleLayoutCapability").toString(), QStringLiteral("wikidict.cell-style/1"));
+            QTextCursor cursor(&doc); auto f = baseFormat(); f.setWidth(QTextLength(QTextLength::FixedLength, 300));
+            QTextTable *table = cursor.insertTable(1, 3, f);
+            for (int c : {0, 2}) {
+                auto cell = table->cellAt(0, c); requested(cell, QStringLiteral("percent"), 48);
+                auto childCursor = cell.firstCursorPosition();
+                QTextTableFormat nested; nested.setBorder(0); nested.setCellPadding(0); nested.setCellSpacing(0);
+                auto *child = childCursor.insertTable(1, 1, nested);
+                auto text = child->cellAt(0, 0).firstCursorPosition();
+                text.insertText(c == 0 ? QStringLiteral("Left") : QStringLiteral("Right"));
+            }
+            requested(table->cellAt(0, 1), QStringLiteral("percent"), 1);
+            const auto source = doc.toRawText();
+            QCOMPARE(force(doc), 0);
+            auto *layout = qobject_cast<QTextDocumentLayout *>(doc.documentLayout()); QVERIFY(layout);
+            const auto box = layout->tableBoundingRect(table);
+            QVERIFY(QDir().mkpath(QStringLiteral(".tmp/tallrik")));
+            QImage captured(pageWidth, qMax(120, qCeil(doc.size().height())), QImage::Format_ARGB32_Premultiplied);
+            captured.fill(Qt::white); QPainter capturePainter(&captured); doc.drawContents(&capturePainter); capturePainter.end();
+            const QString capture = QStringLiteral(".tmp/tallrik/cell-percent-%1-parent%2").arg(QCoreApplication::applicationPid()).arg(pageWidth);
+            QVERIFY(captured.save(capture + QStringLiteral(".png")));
+            QJsonArray cellWidths;
+            for (int c = 0; c < 3; ++c) cellWidths.append(layout->tableCellBoundingRect(table, table->cellAt(0, c)).width());
+            QFile dimensions(capture + QStringLiteral(".json")); QVERIFY(dimensions.open(QIODevice::WriteOnly | QIODevice::NewOnly));
+            const QByteArray geometry = QJsonDocument(QJsonObject{{"parent_width", pageWidth}, {"table_width", box.width()}, {"cell_widths", cellWidths}}).toJson();
+            QCOMPARE(dimensions.write(geometry), qint64(geometry.size())); dimensions.close();
+            QVERIFY(qAbs(box.width() - 300) <= 1);
+            // Changing only the surrounding page must not change the 48% basis.
+            for (int c : {0, 2}) {
+                const auto rect = layout->tableCellBoundingRect(table, table->cellAt(0, c));
+                QVERIFY2(rect.width() >= 143 && rect.width() < 155, qPrintable(QString::number(rect.width())));
+            }
+            QCOMPARE(doc.toRawText(), source);
+        }
+        {
+            QTextDocument doc; doc.setDefaultFont(QFont(QStringLiteral("DejaVu Sans"), 12));
+            doc.setDocumentMargin(0); doc.setTextWidth(900);
+            auto textOption = doc.defaultTextOption(); textOption.setWrapMode(QTextOption::WordWrap); doc.setDefaultTextOption(textOption);
+            QTextCursor cursor(&doc); auto *table = cursor.insertTable(3, 2, baseFormat());
+            requested(table->cellAt(0, 0), QStringLiteral("fixed"), 20);
+            requested(table->cellAt(1, 0), QStringLiteral("fixed"), 65);
+            table->mergeCells(2, 0, 1, 2); requested(table->cellAt(2, 0), QStringLiteral("fixed"), 220);
+            for (int r = 0; r < 2; ++r) for (int c = 0; c < 2; ++c) {
+                auto text = table->cellAt(r, c).firstCursorPosition(); text.insertText(QStringLiteral("x"));
+            }
+            auto text = table->cellAt(2, 0).firstCursorPosition(); text.insertText(QStringLiteral("Spanning"));
+            QCOMPARE(force(doc), 0);
+            auto *layout = qobject_cast<QTextDocumentLayout *>(doc.documentLayout()); QVERIFY(layout);
+            QVERIFY(layout->tableBoundingRect(table).width() >= 220);
+            QVERIFY(layout->tableCellBoundingRect(table, table->cellAt(1, 0)).width() >= 65);
+            const QString word(24, QLatin1Char('W'));
+            text = table->cellAt(0, 1).firstCursorPosition(); text.select(QTextCursor::BlockUnderCursor); text.insertText(word);
+            requested(table->cellAt(0, 1), QStringLiteral("fixed"), 5);
