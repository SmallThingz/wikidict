+            const auto line = block.layout()->lineForTextPosition(link.selectionStart() - block.position());
+            const int local = link.selectionStart() - block.position();
+            const qreal first = line.cursorToX(local, QTextLine::Leading);
+            const qreal next = line.cursorToX(local + 1, QTextLine::Leading);
+            const qreal trailing = line.cursorToX(local, QTextLine::Trailing);
+            QVERIFY(qAbs(trailing - next) <= 1.0 / 32);
