+void tst_QTextDocumentLayout::rubyColumnsKeepDisjointSourceRanges()
+{
+    using Map = QTextRubyRangeMap;
+    QTextDocument document;
+    document.setPlainText(QStringLiteral("ABxy"));
+    Map::Segment segment;
+    segment.gap = {0, 0};
+    segment.bases = {{{0, 0}, {{0, 1}, {}}}, {{1, 1}, {{1, 2}, {}}}};
+    segment.annotations = {
+        {0, 1, 0, false, {2, 2}, {{2, 3}, {}}},
+        {1, 1, 0, false, {3, 3}, {{3, 4}, {}}}
+    };
+    Map::Owner owner{{0, 4}, {segment}};
+    QString error;
+    auto map = Map::create(&document, owner, 100, &error);
+    QVERIFY2(map, qPrintable(error));
+    const auto first = map->columnSources(0, 0);
+    const auto second = map->columnSources(0, 1);
+    QCOMPARE(first.size(), 2);
+    QCOMPARE(second.size(), 2);
+    QCOMPARE(first[0].range.first, 0);
+    QCOMPARE(first[0].range.last, 1);
+    QCOMPARE(first[1].range.first, 2);
+    QCOMPARE(first[1].range.last, 3);
+    QCOMPARE(second[0].range.first, 1);
+    QCOMPARE(second[1].range.first, 3);
+    // Selecting B is inside the bounding envelope of column A/x, but is not
+    // part of either child: it must not highlight A or x.
+    QVERIFY(Map::selected(first[0].range, 1, 2).empty());
+    QVERIFY(Map::selected(first[1].range, 1, 2).empty());
+    QCOMPARE(Map::selected(second[0].range, 1, 2).first, 1);
+    QCOMPARE(Map::selected(second[0].range, 1, 2).last, 2);
+    QCOMPARE(document.toPlainText(), QStringLiteral("ABxy"));
+    QCOMPARE(document.characterCount(), 5);
+    auto invalid = owner;
+    invalid.segments[0].annotations[0].body.range = {1, 3};
+    QVERIFY(!Map::create(&document, invalid, 100, &error));
+    invalid = owner;
+    invalid.segments[0].annotations[1].baseStart = 0;
+    QVERIFY(!Map::create(&document, invalid, 100, &error));
+    invalid = owner;
+    invalid.segments[0].annotations[0].level = -1;
+    QVERIFY(!Map::create(&document, invalid, 100, &error));
+    QVERIFY(!Map::create(&document, owner, 1, &error));
+    QTextCursor cursor(&document);
+    cursor.insertText(QStringLiteral("!"));
+    QVERIFY(!map->current());
+    QVERIFY(map->columnSources(0, 0).isEmpty());
+    QVERIFY(!map->owner());
+}
