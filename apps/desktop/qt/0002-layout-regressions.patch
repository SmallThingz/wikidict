+void tst_QTextDocumentLayout::rubyMultipleOwnersPaintAndKeepChildOffsets()
+{
+    QTextDocument document;
+    QFont baseFont; baseFont.setPixelSize(20);
+    QFont readingFont = baseFont; readingFont.setPixelSize(12);
+    document.setDefaultFont(baseFont);
+    document.setTextWidth(480);
+    QVERIFY(document.documentLayout()->setProperty("cursorWidth", 4));
+    QTextCursor cursor(&document);
+    QTextCharFormat ordinary; ordinary.setFont(baseFont);
+    QTextCharFormat link = ordinary; link.setAnchor(true); link.setAnchorHref(QStringLiteral("dict:dog"));
+    QTextCharFormat reading = link; reading.setFont(readingFont);
+    cursor.insertText(QStringLiteral("prefix "), ordinary);
+    const int a = cursor.position(); cursor.insertText(QStringLiteral("AB"), link);
+    const int ar = cursor.position(); cursor.insertText(QStringLiteral("reading"), reading);
+    const int middle = cursor.position(); cursor.insertText(QStringLiteral(" middle "), ordinary);
+    const int b = cursor.position(); cursor.insertText(QStringLiteral("C"), link);
+    const int br = cursor.position(); cursor.insertText(QStringLiteral("see"), reading);
+    const int suffix = cursor.position(); cursor.insertText(QStringLiteral(" suffix"), ordinary);
+    const int end = cursor.position();
+    const QString original = document.toRawText();
+    const int revision = document.revision();
+    const auto description = [&](int baseFirst, int baseLast, int readingFirst, int readingLast) {
+        QTextRubyLayout::Description value;
+        QTextRubyLayout::Child base;
+        base.source = {baseFirst, baseLast}; base.ownerFont = baseFont;
+        base.usedAbove = 16; base.usedBelow = 4;
+        QTextRubyLayout::Child annotation;
+        annotation.source = {readingFirst, readingLast}; annotation.ownerFont = readingFont;
+        value.bases.append(base); value.readings.append({annotation, 0, 1, 0});
+        value.gaps = {0}; value.breakBefore = value.breakAfter = true;
+        return value;
+    };
+    const auto text = [](int first, int last) {
+        return QVariantMap{{"kind", QStringLiteral("text")}, {"first", first}, {"last", last}};
+    };
+    const auto ruby = [&](int anchor, const QTextRubyLayout::Description &value) {
+        return QVariantMap{{"kind", QStringLiteral("ruby")}, {"anchor", anchor}, {"value", QVariant::fromValue(value)}};
+    };
+    const QVariantList parts{text(0, a), ruby(a, description(a, ar, ar, middle)),
+        text(middle, b), ruby(b, description(b, br, br, suffix)), text(suffix, end)};
+    const QVariantList owners{QVariantMap{{"first", 0}, {"last", end},
+        {"direction", int(Qt::LeftToRight)}, {"joins", QVariantList{}}, {"parts", parts}}};
+    bool accepted = false;
+    QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictSetLogicalFlows",
+        Qt::DirectConnection, Q_RETURN_ARG(bool, accepted), Q_ARG(QVariantList, owners)));
+    QVERIFY(accepted);
+    QVERIFY(document.documentLayout()->documentSize().height() > 0);
+    const auto geometry = [&](int offset) {
+        QVariantMap result;
+        const bool invoked = QMetaObject::invokeMethod(document.documentLayout(), "wikidictLogicalPosition",
+            Qt::DirectConnection, Q_RETURN_ARG(QVariantMap, result), Q_ARG(int, offset));
+        if (!invoked) return QVariantMap();
+        return result;
+    };
+    // Bounded native observation in the existing owned test cwd. Save before
+    // the geometry assertions so a failing layout remains independently visible.
+    const QString capturePath = QStringLiteral(".tmp/ui-screenshots/native-inline-list-ruby-multiple.png");
+    QDir().mkpath(QStringLiteral(".tmp/ui-screenshots"));
+    QImage raster(520, 220, QImage::Format_ARGB32_Premultiplied); raster.fill(Qt::white);
+    {
+        QPainter rasterPainter(&raster);
+        QAbstractTextDocumentLayout::PaintContext rasterContext;
+        document.documentLayout()->draw(&rasterPainter, rasterContext);
+    }
+    const bool captureSaved = raster.save(capturePath);
+    qInfo() << "Ruby native capture" << capturePath << "saved" << captureSaved;
+    const auto base = geometry(a), annotation = geometry(ar), second = geometry(b), secondReading = geometry(br);
+    for (const auto &value : {base, annotation, second, secondReading}) {
+        QCOMPARE(value.value("error", -1).toInt(), 0);
+        QVERIFY(!value.value("characterRect").toRectF().isEmpty());
+    }
+    QVERIFY(annotation.value("characterRect").toRectF().bottom() <= base.value("characterRect").toRectF().top() + 1.0 / 64);
+    QVERIFY(secondReading.value("characterRect").toRectF().bottom() <= second.value("characterRect").toRectF().top() + 1.0 / 64);
+    QCOMPARE(annotation.value("cursorRect").toRectF().width(), qreal(4));
+    QVERIFY(second.value("characterRect").toRectF().left() > base.value("characterRect").toRectF().right());
+    const QPointF hit = annotation.value("characterRect").toRectF().center();
+    const int target = document.documentLayout()->hitTest(hit, Qt::ExactHit);
+    qInfo() << "Ruby hit geometry" << annotation << "hit" << hit << "target" << target << "expected" << ar << middle;
+    QVERIFY(target >= ar && target < middle);
+    QTextCursor targetCursor(&document); targetCursor.setPosition(target);
+    targetCursor.setPosition(target + 1, QTextCursor::KeepAnchor);
+    QCOMPARE(targetCursor.charFormat().anchorHref(), QStringLiteral("dict:dog"));
+    QImage image(500, 180, QImage::Format_ARGB32_Premultiplied); image.fill(Qt::white);
+    QPainter painter(&image);
+    QAbstractTextDocumentLayout::PaintContext context;
+    QAbstractTextDocumentLayout::Selection selection;
+    selection.cursor = QTextCursor(&document); selection.cursor.setPosition(ar);
+    selection.cursor.setPosition(middle, QTextCursor::KeepAnchor);
+    selection.format.setBackground(QColor(0, 255, 0)); context.selections.append(selection);
+    document.documentLayout()->draw(&painter, context); painter.end();
+    int selectedPixels = 0;
+    for (int y = 0; y < image.height(); ++y) for (int x = 0; x < image.width(); ++x)
+        selectedPixels += image.pixelColor(x, y) == QColor(0, 255, 0);
+    QVERIFY(selectedPixels > 0);
+    QCOMPARE(document.toRawText(), original); QCOMPARE(document.revision(), revision);
+    QCOMPARE(geometry(ar), annotation); // Existing cached-layout path.
+    cursor.movePosition(QTextCursor::End); cursor.insertText(QStringLiteral("!"));
+    QVERIFY(geometry(ar).value("error", -1).toInt() != 0);
+    QVERIFY(captureSaved);
+    // Allocated edge padding is not a neighboring action. Exact hit testing
+    // uses shaped characters; fuzzy caret placement may still reach the end.
+    QTextDocument padded; padded.setDefaultFont(baseFont);
+    QTextCursor pc(&padded);
+    auto baseLink = link; baseLink.setAnchorHref(QStringLiteral("dict:base"));
+    auto readingLink = reading; readingLink.setAnchorHref(QStringLiteral("dict:reading"));
+    pc.insertText(QStringLiteral("WWWW"), baseLink); pc.insertText(QStringLiteral("x"), readingLink);
+    for (auto direction : {Qt::LeftToRight, Qt::RightToLeft}) {
+        auto value = description(0, 4, 4, 5); value.direction = direction;
+        value.bases[0].option.setTextDirection(direction);
+        value.readings[0].child.option.setTextDirection(direction);
+        auto measured = QTextRubyLayout::create(&padded, value); QVERIFY(measured);
+        const auto box = measured->characterRect(4); QVERIFY(!box.isEmpty());
+        QCOMPARE(measured->hitTest(box.center(), Qt::ExactHit), 4);
+        const auto width = measured->metrics().advance.toReal();
+        QVERIFY(width > box.width() + 1);
+        for (qreal x : {qreal(.25), width - .25}) {
+            QCOMPARE(measured->hitTest(QPointF(x, box.center().y()), Qt::ExactHit), -1);
+            const int caret = measured->hitTest(QPointF(x, box.center().y()), Qt::FuzzyHit);
+            QVERIFY(caret >= 4 && caret <= 5);
+        }
+        QTextCursor action(&padded); action.setPosition(4); action.setPosition(5, QTextCursor::KeepAnchor);
+        QCOMPARE(action.charFormat().anchorHref(), QStringLiteral("dict:reading"));
+    }
+}
