+// Additional slots for the same existing tst_QTextDocumentLayout target.
+// Source-only, uncompiled/unrun.
+void tst_QTextDocumentLayout::rubyGapGeometryAndDeviceLifetime()
+{
+    QImage device(400, 200, QImage::Format_ARGB32_Premultiplied);
+    QTextDocument document;
+    document.documentLayout()->setPaintDevice(&device);
+    QFont baseFont; baseFont.setPixelSize(20);
+    QFont readingFont = baseFont; readingFont.setPixelSize(12);
+    document.setDefaultFont(baseFont);
+    QTextCursor cursor(&document);
+    QTextCharFormat base; base.setFont(baseFont);
+    QTextCharFormat reading; reading.setFont(readingFont);
+    cursor.insertText(QStringLiteral("A B "), base);
+    cursor.insertText(QStringLiteral("r s"), reading);
+    QTextRubyLayout::Description ruby;
+    const auto child = [](int first, int last, QFont font, qreal above, qreal below) {
+        QTextRubyLayout::Child c; c.source = {first, last}; c.ownerFont = font;
+        c.usedAbove = above; c.usedBelow = below; return c;
+    };
+    ruby.bases = {child(0, 1, baseFont, 16, 4), child(2, 3, baseFont, 16, 4)};
+    ruby.readings = {{child(4, 5, readingFont, 0, 0), 0, 1, 0},
+        {child(6, 7, readingFont, 0, 0), 1, 1, 0}};
+    ruby.gaps = {0, QFontMetricsF(baseFont, &device).horizontalAdvance(QChar(' '))};
+    ruby.gapSources = {{child(1, 2, baseFont, 16, 4), 1, -1},
+        {child(5, 6, readingFont, 0, 0), -1, 1}};
+    auto measured = QTextRubyLayout::create(&document, ruby);
+    QVERIFY(measured); QVERIFY(measured->current());
+    for (const int position : {1, 5}) {
+        QVERIFY(measured->contains(position));
+        const auto box = measured->characterRect(position);
+        QVERIFY(!box.isEmpty());
+        QCOMPARE(measured->hitTest(box.center(), Qt::ExactHit), position);
+        QVERIFY(!measured->cursorRect(position).isEmpty());
+    }
+    QVERIFY(measured->characterRect(5).bottom() <= measured->characterRect(1).top() + 1.0 / 64);
+    const int revision = document.revision();
+    document.documentLayout()->setPaintDevice(nullptr);
+    QCOMPARE(document.revision(), revision);
+    QVERIFY(!measured->current());
+    QVERIFY(measured->characterRect(1).isEmpty());
+    QCOMPARE(measured->hitTest(QPointF(0, 0), Qt::FuzzyHit), -1);
+
+    // A large anonymous row gap must reserve real shared column spacing and
+    // retain its own Ruby-origin shift, independently of either reading owner.
+    for (const auto direction : {Qt::LeftToRight, Qt::RightToLeft}) {
+        for (const int level : {0, 1}) {
+            QTextDocument gapsDocument;
+            gapsDocument.setDefaultFont(baseFont);
+            QTextCursor insert(&gapsDocument);
+            QFont baseGapFont = baseFont; baseGapFont.setPixelSize(28);
+            QFont rowGapFont = baseFont; rowGapFont.setPixelSize(48);
+            QTextCharFormat baseGapFormat; baseGapFormat.setFont(baseGapFont);
+            QTextCharFormat rowGapFormat; rowGapFormat.setFont(rowGapFont);
+            QTextCharFormat readingLink = reading;
+            readingLink.setAnchor(true); readingLink.setAnchorHref(QStringLiteral("dict:r"));
+            insert.insertText(QStringLiteral("A"), base);
+            insert.insertText(QStringLiteral(" "), baseGapFormat);
+            insert.insertText(QStringLiteral("B"), base);
+            insert.insertText(QStringLiteral("r"), readingLink);
+            insert.insertText(QStringLiteral(" "), rowGapFormat);
+            readingLink.setAnchorHref(QStringLiteral("dict:s"));
+            insert.insertText(QStringLiteral("s"), readingLink);
+            const QString original = gapsDocument.toRawText();
+            const int originalRevision = gapsDocument.revision();
+            QTextRubyLayout::Description spaced;
+            spaced.direction = direction; spaced.baselineOrigin = 11;
+            spaced.bases = {child(0, 1, baseFont, 16, 4), child(2, 3, baseFont, 16, 4)};
+            auto firstReading = child(3, 4, readingFont, 0, 0);
+            auto secondReading = child(5, 6, readingFont, 0, 0);
+            firstReading.baselineDelta = secondReading.baselineDelta = spaced.baselineOrigin;
+            if (level == 1) {
+                auto hidden = firstReading; hidden.source.last = hidden.source.first;
+                spaced.readings.append({hidden, 0, 2, 0, true});
+            }
+            const int firstReadingIndex = spaced.readings.size();
+            spaced.readings.append({firstReading, 0, 1, level});
+            spaced.readings.append({secondReading, 1, 1, level});
+            const int secondReadingIndex = firstReadingIndex + 1;
+            spaced.gaps = {0, 0}; // Measured source gaps, not guessed base spacing.
+            auto baseGap = child(1, 2, baseGapFont, 22, 6);
+            auto rowGap = child(4, 5, rowGapFont, 0, 0);
+            rowGap.baselineDelta = spaced.baselineOrigin + 3;
+            spaced.gapSources = {{baseGap, 1, -1}, {rowGap, -1, secondReadingIndex}};
+            auto actual = QTextRubyLayout::create(&gapsDocument, spaced); QVERIFY(actual);
+            const qreal baseGapWidth = QFontMetricsF(baseGapFont).horizontalAdvance(QChar(' '));
+            const qreal rowGapWidth = QFontMetricsF(rowGapFont).horizontalAdvance(QChar(' '));
+            QVERIFY(rowGapWidth > baseGapWidth);
+            const QRectF baseA = actual->characterRect(0), baseB = actual->characterRect(2);
+            const QRectF baseSpace = actual->characterRect(1), rowSpace = actual->characterRect(4);
+            QVERIFY(!baseSpace.isEmpty()); QVERIFY(!rowSpace.isEmpty());
+            QVERIFY(qAbs(baseSpace.width() - baseGapWidth) <= 1.0 / 64);
+            QVERIFY(qAbs(rowSpace.width() - rowGapWidth) <= 1.0 / 64);
+            const qreal separation = direction == Qt::LeftToRight
+                ? baseB.left() - baseA.right() : baseA.left() - baseB.right();
+            QVERIFY(qAbs(separation - rowGapWidth) <= 1.0 / 64);
+            QVERIFY(qAbs(actual->metrics().advance.toReal()
+                - (baseA.width() + rowGapWidth + baseB.width())) <= 1.0 / 64);
+            QCOMPARE(actual->hitTest(rowSpace.center(), Qt::ExactHit), 4);
+            for (const auto &linkBox : actual->linkBoxes()) {
+                QVERIFY(!linkBox.rect.intersects(rowSpace));
+            }
+            // Move only the neighboring annotation. Its own local shift must
+            // move that child, not the anonymous gap or the shared row baseline.
+            auto shiftedReading = spaced;
+            shiftedReading.readings[secondReadingIndex].child.baselineDelta += 9;
+            auto movedReading = QTextRubyLayout::create(&gapsDocument, shiftedReading); QVERIFY(movedReading);
+            QCOMPARE(movedReading->characterRect(4), rowSpace);
+            QVERIFY(qAbs(movedReading->characterRect(5).top()
+                - actual->characterRect(5).top() - 9) <= 1.0 / 64);
+            // Conversely, a gap's local shift moves only that anonymous box.
+            auto shiftedGap = spaced; shiftedGap.gapSources[1].child.baselineDelta += 5;
+            auto movedGap = QTextRubyLayout::create(&gapsDocument, shiftedGap); QVERIFY(movedGap);
+            QVERIFY(qAbs(movedGap->characterRect(4).top() - rowSpace.top() - 5) <= 1.0 / 64);
+            QCOMPARE(movedGap->characterRect(3), actual->characterRect(3));
+            QCOMPARE(movedGap->characterRect(5), actual->characterRect(5));
+            // Recover the actual row baseline from its reading, then apply the
+            // anonymous box's own font ascent and Ruby-origin shift.
+            const qreal rowBaseline = actual->characterRect(3).top() + QFontMetricsF(readingFont).ascent();
+            QVERIFY(qAbs(rowSpace.top() - (rowBaseline + 3 - QFontMetricsF(rowGapFont).ascent())) <= 1.0 / 64);
+            QVERIFY(actual->metrics().occupiedTop.toReal() <= rowSpace.top() + 1.0 / 64);
+            QVERIFY(actual->metrics().occupiedBottom.toReal() >= rowSpace.bottom() - 1.0 / 64);
+            auto malformed = spaced; malformed.gaps[1] = -1;
+            QVERIFY(!QTextRubyLayout::create(&gapsDocument, malformed));
+            malformed = spaced; malformed.gapSources[1].beforeReading = firstReadingIndex;
+            QVERIFY(!QTextRubyLayout::create(&gapsDocument, malformed)); // No prior same-level span.
+            QCOMPARE(gapsDocument.toRawText(), original);
+            QCOMPARE(gapsDocument.revision(), originalRevision);
+        }
+    }
+
+    // A reading may span several columns: a gap at the adjacent span boundary
+    // still constrains one shared separator. Nonadjacent spans explicitly refuse.
+    QTextDocument spanningDocument; spanningDocument.setDefaultFont(baseFont);
+    QTextCursor spanningInsert(&spanningDocument);
+    spanningInsert.insertText(QStringLiteral("ABC"), base);
+    spanningInsert.insertText(QStringLiteral("r s"), reading);
+    QTextRubyLayout::Description spanning;
+    spanning.bases = {child(0, 1, baseFont, 16, 4), child(1, 2, baseFont, 16, 4),
+        child(2, 3, baseFont, 16, 4)};
+    spanning.readings = {{child(3, 4, readingFont, 0, 0), 0, 2, 0},
+        {child(5, 6, readingFont, 0, 0), 2, 1, 0}};
+    spanning.gaps = {0, 0, 0};
+    spanning.gapSources = {{child(4, 5, readingFont, 0, 0), -1, 1}};
+    auto spanningLayout = QTextRubyLayout::create(&spanningDocument, spanning); QVERIFY(spanningLayout);
+    const QRectF spanningGap = spanningLayout->characterRect(4);
+    QVERIFY(!spanningGap.isEmpty());
+    QCOMPARE(spanningLayout->hitTest(spanningGap.center(), Qt::ExactHit), 4);
+    spanning.readings[0].baseCount = 1; // Unannotated intervening column.
+    QVERIFY(!QTextRubyLayout::create(&spanningDocument, spanning));
+}
