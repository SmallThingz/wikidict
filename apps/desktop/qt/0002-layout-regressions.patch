+        const QString suffix = QStringLiteral("RightEdge");
+        QFont widthFont; widthFont.setPointSizeF(12);
+        const auto widths = [&](const QString &text, bool formatted, QTextOption::WrapMode mode) {
+            QTextLayout measured(text, widthFont);
+            QTextOption option; option.setWrapMode(mode); measured.setTextOption(option);
+            if (formatted) {
+                QTextCharFormat link; link.setForeground(QColor(QStringLiteral("#c02040")));
+                link.setAnchor(true); link.setAnchorHref(QStringLiteral("dict:RightTarget"));
+                measured.setFormats({QTextLayout::FormatRange{int(prefix.size()), int(text.size() - prefix.size()), link}});
+            }
+            measured.beginLayout();
+            qreal natural = 0;
+            while (true) {
+                auto line = measured.createLine(); if (!line.isValid()) break;
+                line.setLineWidth(100000); natural = qMax(natural, line.naturalTextWidth());
+            }
+            measured.endLayout();
+            return QPair<qreal, qreal>(measured.minimumWidth(), natural);
+        };
