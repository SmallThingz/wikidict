+// Source-only test slots for the existing native QTextDocumentLayout test class.
+// Requires existing private qtextengine_p.h include. Not inserted or compiled.
+// These are engine metric/boundary controls, not Ruby paint/copy/AX acceptance.
+void tst_QTextDocumentLayout::projectedRubyUsesResolvedBaseMetricsOnly()
+{
+    QTextDocument source;
+    source.setPlainText(QStringLiteral("base reading"));
+    const QString original = source.toRawText();
+    qreal firstHeight = -1;
+    for (int occupied = 0; occupied != 2; ++occupied) {
+        QTextLayout layout(QString(QChar::ObjectReplacementCharacter), source.defaultFont());
+        // Raw engine inspection below requires shaped data to survive endLayout().
+        layout.setCacheEnabled(true);
+        auto *engine = layout.engine();
+        engine->projectedDocument = &source;
+        engine->projectedSourcePositions = QList<int>{-1};
+        QTextEngine::ProjectedRubyMetrics ruby;
+        ruby.advance = QFixed(40);
+        ruby.minimumWidth = QFixed(40);
+        ruby.baseAscent = QFixed(9);
+        ruby.baseDescent = QFixed(3);
+        ruby.baseLeading = QFixed();
+        ruby.occupiedTop = QFixed(occupied ? -70 : -9);
+        ruby.occupiedBottom = QFixed(occupied ? 50 : 3);
+        ruby.visibleAnnotation = occupied;
+        QVERIFY(ruby.valid());
+        engine->mutableProjectedRubyMetrics().insert(0, ruby);
+        layout.beginLayout();
+        auto line = layout.createLine();
+        QVERIFY(line.isValid());
+        line.setLineWidth(200);
+        layout.endLayout();
+        QVERIFY(layout.cacheEnabled());
+        QVERIFY(engine->layoutData);
+        QVERIFY(!engine->projectedRubyMetricsInvalid());
+        const int index = engine->findItem(0);
+        QVERIFY(index >= 0);
+        const auto &item = engine->layoutData->items.at(index);
+        QCOMPARE(item.width, ruby.advance);
+        QCOMPARE(item.ascent, ruby.baseAscent);
+        QCOMPARE(item.descent, ruby.baseDescent);
+        QCOMPARE(item.leading, QFixed());
+        QVERIFY(!engine->format(&item).isImageFormat());
+        QVERIFY(!engine->hasDocumentObject(0));
+        if (!occupied) firstHeight = line.height();
+        else QCOMPARE(line.height(), firstHeight); // Annotation reserve belongs to qdoc only.
+        QCOMPARE(source.toRawText(), original);
+    }
+}
