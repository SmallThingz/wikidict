+                    ? QStringLiteral("<hr style='margin:0px;-qt-user-state:%1;'>").arg(state)
+                    : QStringLiteral("<hr style='margin:0px;'>");
+                if (context == 0) return rule;
+                if (context == 1) return QStringLiteral("<p>Before</p>") + rule + QStringLiteral("<p>After</p>");
+                return QStringLiteral("<table><tr><td><p>Before</p>") + rule
+                    + QStringLiteral("<p>After</p></td></tr></table>");
+            };
+            QTextDocument document;
+            QString sourceText; int sourceCount = -1;
+            for (bool marked : {false, true, false}) {
+                document.setHtml(html(marked));
+                document.setTextWidth(300);
