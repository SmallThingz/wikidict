+            QCOMPARE(force(doc), 0);
+            QVERIFY(layout->tableCellBoundingRect(table, table->cellAt(0, 1)).width() >= intrinsic - 1);
+            requested(table->cellAt(0, 0), QStringLiteral("fixed"), 0);
+            QCOMPARE(force(doc), 0);
