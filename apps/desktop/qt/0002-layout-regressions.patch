+void tst_QTextDocumentLayout::rubyGapDoesNotConsumeNonbreakingBaseContent()
+{
+    using Map = QTextRubyRangeMap;
+    QTextDocument document;
+    document.setPlainText(QStringLiteral("A B"));
+    Map::Segment segment;
+    segment.gap = {0, 0};
+    segment.bases = {{{0, 0}, {{0, 1}, {}}}, {{1, 2}, {{2, 3}, {}}}};
+    QString error;
+    QVERIFY(Map::create(&document, Map::Owner{{0, 3}, {segment}}, 100, &error));
+    // NBSP is ordinary base text, not a CSS inter-base gap. Refuse a map
+    // that discards it from base measurement, while admitting it in the body.
+    document.setPlainText(QStringLiteral("A") + QChar(0x00a0) + QStringLiteral("B"));
+    QVERIFY(!Map::create(&document, Map::Owner{{0, 3}, {segment}}, 100, &error));
+    segment.bases[1].gap = {1, 1};
+    segment.bases[1].body.range = {1, 3};
+    auto map = Map::create(&document, Map::Owner{{0, 3}, {segment}}, 100, &error);
+    QVERIFY2(map, qPrintable(error));
+    const QString raw = QStringLiteral("A") + QChar(0x00a0) + QStringLiteral("B");
+    QCOMPARE(document.toRawText(), raw);
+    QCOMPARE(map->text(0, 3), raw);
+    // Qt's public plain-text convenience deliberately normalizes NBSP. Neither
+    // the Ruby source map nor its native shaping/break/selection path uses it.
+    QCOMPARE(document.toPlainText(), QStringLiteral("A B"));
+    const auto selected = map->selectionToDocument(1, 2);
+    QCOMPARE(selected.first, 1); QCOMPARE(selected.last, 2);
+    QTextCursor cursor(&document); cursor.setPosition(selected.first);
+    cursor.setPosition(selected.last, QTextCursor::KeepAnchor);
+    QCOMPARE(cursor.selectedText(), QString(QChar(0x00a0)));
+    QTextRubyLayout::Description ruby;
+    QTextRubyLayout::Child child; child.source = {0, 3}; child.ownerFont = document.defaultFont();
+    child.usedAbove = 12; child.usedBelow = 4; ruby.bases = {child}; ruby.gaps = {0};
+    auto shaped = QTextRubyLayout::create(&document, ruby); QVERIFY(shaped);
+    QVERIFY(!shaped->characterRect(1).isEmpty());
+    QVERIFY(shaped->cursorRect(2).left() > shaped->cursorRect(1).left());
+    auto fragments = QTextRubyLayout::fragments(&document, ruby, 1);
+    QVERIFY(fragments); QCOMPARE(fragments->size(), 1);
+    QCOMPARE(fragments->first().bases.first().source.first, 0);
+    QCOMPARE(fragments->first().bases.first().source.last, 3);
+}
