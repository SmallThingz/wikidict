+        const auto requested = [&](QTextTableCell cell, const QString &unit, double value) {
+            auto f = cell.format(); f.setProperty(width, QVariantMap{{QStringLiteral("unit"), unit}, {QStringLiteral("value"), value}});
+            cell.setFormat(f);
+        };
+        const auto force = [](QTextDocument &doc) {
+            auto *layout = qobject_cast<QTextDocumentLayout *>(doc.documentLayout());
+            if (!layout) return -100;
+            layout->documentSize();
