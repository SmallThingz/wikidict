+            stock.setLayoutEnabled(true); owned.setLayoutEnabled(true);
+            const QString raw = owned.toRawText();
+            int sample = 0;
+            for (const int width : {0, 120, 0}) {
+                stock.setPageSize(QSizeF(width, -1)); owned.setPageSize(QSizeF(width, -1));
+                stock.documentLayout()->documentSize(); native->documentSize();
+                QCOMPARE(native->wikidictParagraphBoxLayoutError(), 0);
+                const auto position = native->wikidictLogicalPosition(0);
+                QVERIFY(position.value(QStringLiteral("handled")).toBool());
+                QCOMPARE(position.value(QStringLiteral("error")).toInt(), 0);
+                QCOMPARE(position.value(QStringLiteral("lineCount")).toInt(), 1);
+                const auto stockLine = stock.begin().layout()->lineAt(0);
+                QCOMPARE(stock.begin().layout()->lineCount(), 1);
+                QVERIFY(stockLine.naturalTextWidth() > 120);
+                QCOMPARE(position.value(QStringLiteral("lineNaturalWidth")).toReal(), stockLine.naturalTextWidth());
+                QCOMPARE(position.value(QStringLiteral("lineHeight")).toReal(), stockLine.height());
+                QCOMPARE(native->documentSize(), stock.documentLayout()->documentSize());
+                for (const int offset : {0, int(text.size() / 2), int(text.size())}) {
+                    const auto mapped = native->wikidictLogicalPosition(offset);
+                    QCOMPARE(mapped.value(QStringLiteral("position")).toInt(), offset);
+                    QCOMPARE(mapped.value(QStringLiteral("error")).toInt(), 0);
+                    const auto rect = mapped.value(QStringLiteral("cursorRect")).toRectF();
+                    QVERIFY(qIsFinite(rect.x()) && qIsFinite(rect.y()) && rect.height() > 0);
+                }
