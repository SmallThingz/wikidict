+    void nativeInlineTableKeepsCompensatedListIndent()
+    {
+        // A colour/anchor run cannot split the intrinsic width of an unbroken
+        // word. Its real line must fit the width offered to a table cell.
+        const QString prefix(40, QLatin1Char('W'));
+        const QString suffix = QStringLiteral("RightEdge");
+        QFont widthFont; widthFont.setPointSizeF(12);
+        const auto widths = [&](const QString &text, bool formatted, QTextOption::WrapMode mode) {
+            QTextLayout measured(text, widthFont);
+            QTextOption option; option.setWrapMode(mode); measured.setTextOption(option);
+            if (formatted) {
+                QTextCharFormat link; link.setForeground(QColor(QStringLiteral("#c02040")));
+                link.setAnchor(true); link.setAnchorHref(QStringLiteral("dict:RightTarget"));
+                measured.setFormats({QTextLayout::FormatRange{int(prefix.size()), int(text.size() - prefix.size()), link}});
+            }
+            measured.beginLayout();
+            qreal natural = 0;
+            while (true) {
+                auto line = measured.createLine(); if (!line.isValid()) break;
+                line.setLineWidth(100000); natural = qMax(natural, line.naturalTextWidth());
+            }
+            measured.endLayout();
+            return QPair<qreal, qreal>(measured.minimumWidth(), natural);
+        };
+        for (const QString &separator : {QString(), QString(QChar(0x00a0)), QStringLiteral(" "), QString(QChar(0x2028))}) {
+            const QString text = prefix + separator + suffix;
+            for (auto mode : {QTextOption::WordWrap, QTextOption::WrapAnywhere,
+                              QTextOption::WrapAtWordBoundaryOrAnywhere, QTextOption::NoWrap}) {
+                const auto ordinary = widths(text, false, mode);
+                const auto formatted = widths(text, true, mode);
+                QVERIFY(ordinary.first > 0); QVERIFY(formatted.first > 0);
+                QVERIFY2(qAbs(ordinary.first - formatted.first) < .08,
+                         qPrintable(QStringLiteral("format boundary minimum %1 vs %2, separator %3 mode %4")
+                             .arg(ordinary.first).arg(formatted.first).arg(separator.isEmpty() ? 0 : separator.at(0).unicode()).arg(int(mode))));
+                if (mode == QTextOption::WordWrap) {
+                    if (separator.isEmpty() || separator == QString(QChar(0x00a0)))
+                        QVERIFY(qAbs(formatted.first - formatted.second) < .08);
+                    else if (separator == QStringLiteral(" "))
+                        QVERIFY(formatted.first + 1 < formatted.second);
+                }
+            }
+        }
+        QJsonArray observations;
