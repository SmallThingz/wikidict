+        struct Shape { bool valid = false; QList<quint32> glyphs; QList<QPointF> positions; qreal width = 0; QFont font; };
+        const auto shape = [&](const QString &text, bool kerning, qreal tracking,
+                               const QMap<QFont::Tag, quint32> &features, bool noShaping) {
