+                QCOMPARE(imageFragment(f).charFormat(), identity); QCOMPARE(helper->frameFormat(), neutral);
+                QCOMPARE(f.image->childFrames(), QList<QTextFrame *>{helper});
+            }
+            for (int mode : {0, 1, 2}) {
+                f.document.setLayoutEnabled(false); auto changed = neutral;
+                if (mode == 0) changed.setPosition(QTextFrameFormat::FloatLeft);
+                else if (mode == 1) changed.setProperty(TableCaptionFixture::base + 4, QStringLiteral("image"));
+                else changed.setWidth(1);
+                helper->setFrameFormat(changed);
+                QVERIFY(!f.layout(300)); QCOMPARE(f.native->wikidictParagraphBoxLayoutError(), 1);
+                QCOMPARE(f.native->wikidictParagraphBoxLayoutErrorPosition(), f.image->firstPosition());
+                QCOMPARE(f.document.toRawText(), source); QCOMPARE(imageFragment(f).charFormat(), identity);
+                f.document.setLayoutEnabled(false); helper->setFrameFormat(neutral);
+                QVERIFY(f.layout(300)); QCOMPARE(f.native->wikidictParagraphBoxLayoutError(), 0);
+            }
+        }
