+// Exercise the same query an image intrinsic-size handler uses while its
+// containing logical figure is being laid out. The depth bound is test-only:
+// a recursive callback is recorded as a failure instead of exhausting the stack.
+class FigureWidthQueryHandler : public QObject, public QTextObjectInterface
+{
+    Q_OBJECT
+    Q_INTERFACES(QTextObjectInterface)
+public:
+    int calls = 0;
+    int depth = 0;
+    int maximumDepth = 0;
+    bool valid = true;
+    int expectedPosition = -1;
+    QList<qreal> widths;
+
+    QSizeF intrinsicSize(QTextDocument *document, int position, const QTextFormat &) override
+    {
+        ++calls;
+        ++depth;
+        maximumDepth = qMax(maximumDepth, depth);
+        const auto leave = qScopeGuard([&] { --depth; });
+        if (depth > 1) return QSizeF(16, 12);
+        auto *layout = qobject_cast<QTextDocumentLayout *>(document->documentLayout());
+        if (!layout) { valid = false; return QSizeF(16, 12); }
+        const int revision = document->revision();
+        const qreal width = layout->wikidictFigureContentWidth(position);
+        const qreal repeated = layout->wikidictFigureContentWidth(position);
+        valid = valid && position == expectedPosition && qIsFinite(width) && width > 0
+            && width == repeated && revision == document->revision();
+        widths.append(width);
+        return QSizeF(qMin(qreal(16), qMax(qreal(1), width)), 12);
+    }
+    void drawObject(QPainter *, const QRectF &, QTextDocument *, int, const QTextFormat &) override {}
+};
