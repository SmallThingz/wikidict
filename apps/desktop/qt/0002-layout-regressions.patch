+void tst_QTextDocumentLayout::projectedRubyKeepsOnlyAdmittedOrdinaryBoundaries()
+{
+    QTextDocument source;
+    source.setPlainText(QStringLiteral("abBASEreadingcd"));
+    const QString original = source.toRawText();
+    const QString projected = QStringLiteral("ab\u2066\ufffc\u2069cd");
+    for (bool allow : {false, true}) {
+        for (auto wrap : {QTextOption::WordWrap, QTextOption::NoWrap}) {
+            QTextLayout layout(projected, source.defaultFont());
+            // Raw engine inspection below requires shaped data to survive endLayout().
+            layout.setCacheEnabled(true);
+            auto option = layout.textOption(); option.setWrapMode(wrap); layout.setTextOption(option);
+            auto *engine = layout.engine();
+            engine->projectedDocument = &source;
+            engine->projectedSourcePositions = QList<int>{0,1,-1,-1,-1,13,14};
+            QTextEngine::ProjectedRubyMetrics ruby;
+            ruby.advance = ruby.minimumWidth = QFixed(90);
+            ruby.baseAscent = QFixed(9); ruby.baseDescent = QFixed(3);
+            ruby.occupiedTop = QFixed(-20); ruby.occupiedBottom = QFixed(3);
+            ruby.visibleAnnotation = true;
+            ruby.breakBefore = ruby.breakAfter = allow;
+            engine->mutableProjectedRubyMetrics().insert(3, ruby);
+            layout.beginLayout();
+            int consumed = 0;
+            for (int count = 0; count < projected.size() + 1; ++count) {
+                auto line = layout.createLine();
+                if (!line.isValid()) break;
+                line.setLineWidth(QFontMetricsF(source.defaultFont()).horizontalAdvance(QStringLiteral("ab")) + 45);
+                QVERIFY(line.textLength() > 0);
+                consumed += line.textLength();
+            }
+            layout.endLayout();
+            QVERIFY(layout.cacheEnabled());
+            QVERIFY(engine->layoutData);
+            QVERIFY(!engine->projectedRubyMetricsInvalid());
+            QCOMPARE(consumed, projected.size());
+            for (int at : {2,3,4,5})
+                QCOMPARE(engine->projectedRubyBoundaryAllowed(at), allow);
+            if (!allow || wrap == QTextOption::NoWrap)
+                QCOMPARE(layout.lineCount(), 1);
+            else QVERIFY(layout.lineCount() > 1);
+            QCOMPARE(source.toRawText(), original);
+        }
+    }
+}
