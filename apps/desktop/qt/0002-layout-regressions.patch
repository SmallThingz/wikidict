+                QImage actual(expected.size(), expected.format()); actual.fill(Qt::white);
+                { QPainter painter(&expected); stock.drawContents(&painter); }
+                { QPainter painter(&actual); owned.drawContents(&painter); }
+                const auto ink = [](const QImage &image) {
+                    int count = 0; QRect bounds;
+                    for (int y = 0; y < image.height(); ++y) for (int x = 0; x < image.width(); ++x) {
+                        if (image.pixelColor(x, y) == QColor(Qt::white)) continue;
+                        ++count; bounds = bounds.united(QRect(x, y, 1, 1));
+                    }
+                    return qMakePair(count, bounds);
