+            QCOMPARE(f.native->anchorAt(point), QStringLiteral("wikidict:caption"));
+            const int character = block.position() + line.xToCursor(point.x() - origin.x(), QTextLine::CursorOnCharacter);
+            QVERIFY(character >= link.selectionStart() && character < link.selectionEnd());
+            QRectF painted;
+            for (const auto &run : line.glyphRuns(local, 1)) painted |= run.boundingRect();
+            QVERIFY(!painted.isEmpty());
+            QVERIFY((first + next) / 2 >= painted.left() - 1.0 / 32);
+            QVERIFY((first + next) / 2 <= painted.right() + 1.0 / 32);
