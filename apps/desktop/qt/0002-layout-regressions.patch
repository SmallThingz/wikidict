+            QCOMPARE(force(doc), 1);
+            doc.setLayoutEnabled(false);
+            requested(table->cellAt(0, 0), QStringLiteral("fixed"), 0);
+            doc.setLayoutEnabled(true);
+            QCOMPARE(force(doc), 0);
+            QCOMPARE(doc.toRawText(), source);
+        }
+    }
