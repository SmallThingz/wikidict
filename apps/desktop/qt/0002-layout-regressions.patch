+class FixedImageMemoStaticGetter : public FixedImageMemoProxy
+{
+    Q_OBJECT
+    Q_PROPERTY(QObject* _wikidictFixedImageIntrinsicDelegateV1 READ declaredDelegate)
+public:
+    explicit FixedImageMemoStaticGetter(QAbstractTextDocumentLayout *layout) : FixedImageMemoProxy(layout, false) {}
+    mutable int getterCalls = 0;
+    QObject *declaredDelegate() const { ++getterCalls; return delegate; }
+};
