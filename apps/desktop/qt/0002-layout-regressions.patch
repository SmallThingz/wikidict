+void tst_QTextDocumentLayout::rubyJustificationRejectsUnrepresentableGlyphAdvance()
+{
+    QTextDocument document;
+    QFont baseFont; baseFont.setPixelSize(20);
+    QFont readingFont = baseFont; readingFont.setPixelSize(100);
+    document.setDefaultFont(baseFont);
+    QTextCursor cursor(&document);
+    QTextCharFormat base; base.setFont(baseFont);
+    QTextCharFormat reading; reading.setFont(readingFont);
+    cursor.insertText(QString::fromUtf16(u"\u4e00\u4e8c"), base);
+    cursor.insertText(QString(30000, QChar('W')), reading);
+    QTextRubyLayout::Description ruby;
+    QTextRubyLayout::Child b; b.source = {0, 2}; b.ownerFont = baseFont; b.usedAbove = 16; b.usedBelow = 4;
+    QTextRubyLayout::Child a; a.source = {2, 30002}; a.ownerFont = readingFont;
+    ruby.bases = {b}; ruby.readings = {{a, 0, 1, 0}}; ruby.gaps = {0};
+    const auto measuredBase = QTextRubyGeometry::measureFlatChild(QString::fromUtf16(u"\u4e00\u4e8c"),
+        baseFont, {{0, 2, base}}, QTextOption(), nullptr);
+    const auto measuredReading = QTextRubyGeometry::measureFlatChild(QString(30000, QChar('W')),
+        readingFont, {{0, 30000, reading}}, QTextOption(), nullptr);
+    QVERIFY(measuredBase); QVERIFY(measuredReading);
+    QVERIFY(measuredReading->advance < qreal(QFIXED_MAX));
+    QVERIFY((measuredReading->advance - measuredBase->advance) * 32 > ((1 << 24) - 1));
+    QSet<int> baseClusters;
+    for (const auto &run : measuredBase->layout->glyphRuns(0, 2, QTextLayout::RetrieveStringIndexes))
+        for (auto index : run.stringIndexes()) baseClusters.insert(int(index));
+    QVERIFY(baseClusters.contains(0)); QVERIFY(baseClusters.contains(1));
+    QVERIFY(measuredBase->layout->isValidCursorPosition(1));
+    // QFixed can represent this width, but one glyph's justification field is
+    // only 24 bits. Refuse rather than paint and hit-test different advances.
+    QVERIFY(!QTextRubyLayout::create(&document, ruby));
+    ruby.readings[0].child.source.last = 5;
+    QVERIFY(QTextRubyLayout::create(&document, ruby));
+}
