+    void namedAnchorPreservesFollowingLinkRangeAndNameOnlySemantics()
+    {
+#ifdef QT_NO_WIDGETS
+        QSKIP("This control requires the existing QtWidgets target for actual anchor traversal.");
+#else
+        struct Browser : QTextBrowser { using QTextBrowser::focusNextPrevChild; };
+        const QString target = QStringLiteral("dict:MaiFirst");
+        const QString name = QStringLiteral("section-0");
+        const QStringList labels{QStringLiteral("First"), QString::fromUcs4(U"\U0001f642First")};
+        for (const QString &label : labels) for (int mode = 0; mode < 4; ++mode) {
+            Browser browser; auto *document = browser.document();
+            QFont font; font.setPointSizeF(12); document->setDefaultFont(font);
+            const QString link = QStringLiteral("<a href=\"%1\">%2</a>").arg(target, label.toHtmlEscaped());
+            QString html;
+            if (mode == 0) html = QStringLiteral("<a name=\"%1\"></a><table><tr><td>%2</td></tr></table>").arg(name, link);
+            else if (mode == 1) html = QStringLiteral("<p><a name=\"%1\" href=\"%2\">%3</a></p>").arg(name, target, label.toHtmlEscaped());
+            else if (mode == 2) html = QStringLiteral("<p><a name=\"%1\">%2</a></p>").arg(name, label.toHtmlEscaped());
+            else html = QStringLiteral("<p>%1</p>").arg(link);
+            document->setHtml(html); document->setTextWidth(320);
+            auto *native = qobject_cast<QTextDocumentLayout *>(document->documentLayout()); QVERIFY(native);
+            native->documentSize(); QCOMPARE(native->wikidictParagraphBoxLayoutError(), 0);
+            const auto selected = document->find(label, 0, QTextDocument::FindCaseSensitively); QVERIFY(!selected.isNull());
+            QCOMPARE(selected.selectedText(), label); QCOMPARE(selected.selectionEnd() - selected.selectionStart(), label.size());
+            const auto raw = document->toRawText(); const int count = document->characterCount(), revision = document->revision();
+            QString joined; int next = selected.selectionStart(), named = 0, eligible = 0;
+            for (auto it = selected.block().begin(); !it.atEnd(); ++it) {
+                const auto fragment = it.fragment(); QVERIFY(fragment.isValid());
+                const auto format = fragment.charFormat();
+                QCOMPARE(fragment.position(), next); next += fragment.length(); joined += fragment.text();
+                const bool namedFirst = mode != 3 && fragment.position() == selected.selectionStart();
+                QCOMPARE(format.anchorNames(), namedFirst ? QStringList{name} : QStringList());
+                if (namedFirst) {
+                    ++named;
+                    QCOMPARE(fragment.length(), label.front().isHighSurrogate() ? 2 : 1);
+                }
+                QCOMPARE(format.anchorHref(), mode == 2 ? QString() : target);
+                QCOMPARE(format.isAnchor(), mode != 2 || namedFirst);
+                eligible += format.isAnchor() && format.hasProperty(QTextFormat::AnchorHref);
+            }
+            QCOMPARE(joined, label); QCOMPARE(next, selected.selectionEnd()); QCOMPARE(named, mode == 3 ? 0 : 1);
+            browser.setTextCursor(QTextCursor(document));
+            if (mode == 2) {
+                QCOMPARE(eligible, 0); QVERIFY(!browser.focusNextPrevChild(true));
+                QCOMPARE(browser.textCursor().position(), 0); QCOMPARE(browser.textCursor().anchor(), 0);
+            } else {
+                QVERIFY(eligible > 0); QVERIFY(browser.focusNextPrevChild(true));
+                QCOMPARE(browser.textCursor().selectionStart(), selected.selectionStart());
+                QCOMPARE(browser.textCursor().selectionEnd(), selected.selectionEnd());
+                QCOMPARE(browser.textCursor().selectedText(), label);
+            }
+            QCOMPARE(document->toRawText(), raw); QCOMPARE(document->characterCount(), count); QCOMPARE(document->revision(), revision);
+        }
+#endif
+    }
