+void tst_QTextDocumentLayout::rubyFlatShapingPreservesOwnerAndScalarBoundaries()
+{
+    using namespace QTextRubyGeometry;
+    QFont original;
+    original.setPointSizeF(20);
+    QFont child = original;
+    child.setPointSizeF(8);
+    child.setBold(false);
+    child.setItalic(false);
+    QFont owner = original;
+    owner.setBold(true);
+    owner.setItalic(true);
+    QTextCharFormat childFormat;
+    childFormat.setFont(child);
+    const QString text = QStringLiteral("A e\u0301 \U0001f9d1");
+    QCOMPARE(text.size(), 7);
+    const QList<QTextLayout::FormatRange> formats{{0, int(text.size()), childFormat}};
+    QTextOption option;
+    option.setTextDirection(Qt::LeftToRight);
+    const auto shaped = measureFlatChild(text, owner, formats, option, nullptr);
+    QVERIFY(shaped);
+    QCOMPARE(shaped->layout->text(), text);
+    QCOMPARE(shaped->layout->lineCount(), 1);
+    QVERIFY(shaped->advance > 0);
+    QVERIFY(!shaped->layout->isValidCursorPosition(3)); // combining mark
+    QVERIFY(!shaped->layout->isValidCursorPosition(6)); // low surrogate
+    QVERIFY(shaped->layout->isValidCursorPosition(5));
+    const QFontMetricsF declaring(owner);
+    QVERIFY(shaped->fontTop <= -declaring.ascent());
+    QVERIFY(shaped->fontBottom >= declaring.descent());
+    QVERIFY(!shaped->layout->formats()[0].format.font().bold());
+    QVERIFY(!shaped->layout->formats()[0].format.font().italic());
+    // The helper never resolves a small child from a small owner again. It
+    // retains the complete native format supplied by the original-basis adapter.
+    QCOMPARE(shaped->layout->formats()[0].format.font().pointSizeF(), qreal(8));
+    auto split = formats;
+    split[0].length = 6;
+    split.append({6, 1, childFormat});
+    QVERIFY(!measureFlatChild(text, owner, split, option, nullptr));
+    auto object = childFormat;
+    object.setObjectType(QTextFormat::ImageObject);
+    QVERIFY(!measureFlatChild(text, owner, {{0, int(text.size()), object}}, option, nullptr));
+    QVERIFY(!measureFlatChild(QStringLiteral("A\r\nB"), owner,
+        {{0, 4, childFormat}}, option, nullptr));
+    const auto empty = measureFlatChild({}, owner, {}, option, nullptr);
+    QVERIFY(empty);
+    QCOMPARE(empty->advance, qreal(0));
+    QCOMPARE(empty->fontTop, -declaring.ascent());
+    QCOMPARE(empty->fontBottom, declaring.descent());
+    QVERIFY(!empty->hasInk);
+    QVERIFY(empty->layout->text().isEmpty());
+    QCOMPARE(empty->layout->lineCount(), 0);
+}
