+    void figureTableCaptionAcceptsOnlyItsImportedInlineImageHelper()
+    {
+        // Cursor formats intentionally omit ObjectIndex. Fragment formats expose
+        // the stored image identity used by the native importer and validator.
+        const auto imageFragment = [](const TableCaptionFixture &f) {
+            const auto block = f.document.findBlock(f.imagePosition);
+            for (auto it = block.begin(); !it.atEnd(); ++it) {
+                const auto fragment = it.fragment();
+                if (fragment.position() == f.imagePosition && fragment.length() == 1
+                    && fragment.charFormat().isImageFormat())
+                    return fragment;
+            }
+            return QTextFragment();
+        };
+        const auto importImage = [&imageFragment](TableCaptionFixture &f) {
+            f.document.setLayoutEnabled(false);
+            QTextCursor cursor(&f.document);
+            cursor.setPosition(f.imagePosition); cursor.setPosition(f.imagePosition + 1, QTextCursor::KeepAnchor);
+            cursor.insertHtml(QStringLiteral("<a href='wikidict:File:Controlled'><img src='controlled-caption-image' width='%1' height='%2'></a>")
+                .arg(120 * f.scale).arg(60 * f.scale));
+            cursor.setPosition(f.imagePosition); cursor.setPosition(f.imagePosition + 1, QTextCursor::KeepAnchor);
+            QTextCharFormat alignment;
+            alignment.setVerticalAlignment(QTextCharFormat::AlignNormal); cursor.mergeCharFormat(alignment);
+            f.suffixFirst = f.figure->lastPosition() + 1; f.end = f.document.characterCount() - 1;
+            f.source = f.document.toRawText();
+            const auto fragment = imageFragment(f);
+            return fragment.isValid()
+                ? qobject_cast<QTextFrame *>(f.document.object(fragment.charFormat().objectIndex())) : nullptr;
+        };
+        for (int dpi : {96, 144}) for (auto direction : {Qt::LeftToRight, Qt::RightToLeft}) {
+            TableCaptionFixture f(dpi, direction, 120, false, QStringLiteral("<p>Caption</p>"));
+            const auto originalSource = f.document.toRawText();
+            auto *helper = importImage(f); QVERIFY(helper);
+            QCOMPARE(f.document.toRawText(), originalSource);
+            QCOMPARE(f.image->childFrames(), QList<QTextFrame *>{helper});
+            QCOMPARE(helper->parentFrame(), f.image); QVERIFY(helper->childFrames().isEmpty());
+            QCOMPARE(helper->firstPosition(), f.imagePosition + 1); QCOMPARE(helper->lastPosition(), f.imagePosition);
+            const auto neutral = helper->frameFormat();
+            const auto fragment = imageFragment(f); QVERIFY(fragment.isValid());
+            const auto identity = fragment.charFormat();
+            QCOMPARE(identity.objectIndex(), helper->objectIndex());
+            QCOMPARE(identity.anchorHref(), QStringLiteral("wikidict:File:Controlled"));
