+        QCOMPARE(secondHelper->firstPosition(), extraPosition + 1); QCOMPARE(secondHelper->lastPosition(), extraPosition);
+        QCOMPARE(extra.image->childFrames().size(), 2);
+        QVERIFY(extra.image->childFrames().contains(originalHelper)); QVERIFY(extra.image->childFrames().contains(secondHelper));
+        QCOMPARE(imageFragment(extra).charFormat(), originalIdentity);
+        QCOMPARE(extra.document.characterCount(), originalCount + 1);
+        extra.suffixFirst = extra.figure->lastPosition() + 1; extra.end = extra.document.characterCount() - 1;
+        const auto source = extra.document.toRawText();
+        QVERIFY(!extra.layout(300)); QCOMPARE(extra.native->wikidictParagraphBoxLayoutError(), 1);
+        QCOMPARE(extra.native->wikidictParagraphBoxLayoutErrorPosition(), extra.image->firstPosition());
+        QCOMPARE(extra.document.toRawText(), source);
+        QCOMPARE(imageFragment(extra).charFormat(), originalIdentity);
+    }
