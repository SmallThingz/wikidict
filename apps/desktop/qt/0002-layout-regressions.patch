+void tst_QTextDocumentLayout::rubyMixedOrdinaryLinesReserveAnnotationSides()
+{
+    // CSS Ruby 3.6 guarantees room for three equivalent Ruby lines. It does
+    // not require arbitrary fixed-height ordinary FONT envelopes to exclude
+    // annotations. Cold146 retains that stronger failed oracle and its raster.
+    // Here mixed-line ink is observed independently; equivalent Ruby containers
+    // retain the actual no-overlap requirement below.
+    QFont baseFont; baseFont.setPixelSize(20);
+    QFont readingFont = baseFont; readingFont.setPixelSize(12);
+    QTextBlockFormat fixed; fixed.setLineHeight(20, QTextBlockFormat::FixedHeight);
+    const auto native = [&](int start, int readingStart, int end) {
+        QTextRubyLayout::Description ruby;
+        QTextRubyLayout::Child b; b.source = {start, readingStart}; b.ownerFont = baseFont;
+        b.usedAbove = 16; b.usedBelow = 4;
+        QTextRubyLayout::Child a; a.source = {readingStart, end}; a.ownerFont = readingFont;
+        ruby.bases = {b}; ruby.readings = {{a, 0, 1, 0}}; ruby.gaps = {0};
+        return ruby;
+    };
+    const auto flow = [&](int start, int readingStart, int end) {
+        return QVariantMap{{"first", start}, {"last", end}, {"direction", int(Qt::LeftToRight)},
+            {"joins", QVariantList{}}, {"parts", QVariantList{QVariantMap{{"kind", QStringLiteral("ruby")},
+                {"anchor", start}, {"value", QVariant::fromValue(native(start, readingStart, end))}}}}};
+    };
+    const auto geometry = [](QTextDocument &document, int position) {
+        QVariantMap value;
+        if (!QMetaObject::invokeMethod(document.documentLayout(), "wikidictLogicalPosition",
+                Qt::DirectConnection, Q_RETURN_ARG(QVariantMap, value), Q_ARG(int, position)))
+            return QVariantMap();
+        return value;
+    };
+    const auto save = [](QTextDocument &document, const QString &name) {
+        QDir().mkpath(QStringLiteral(".tmp/ui-screenshots"));
+        const QString path = QStringLiteral(".tmp/ui-screenshots/native-inline-list-ruby-") + name + QStringLiteral(".png");
+        QImage image(520, 260, QImage::Format_ARGB32_Premultiplied); image.fill(Qt::white);
+        { QPainter painter(&image); QAbstractTextDocumentLayout::PaintContext context;
+          document.documentLayout()->draw(&painter, context); }
+        const bool saved = image.save(path); qInfo() << "Ruby native capture" << path << "saved" << saved;
+        return saved;
+    };
+    // Actual native glyph positions, not a relocated block bounding rectangle.
+    // These fixtures have no authored shift, decoration, outline or transform.
+    const auto ordinaryInk = [](const QTextBlock &block) -> std::optional<QRectF> {
+        const auto *layout = block.layout(); QRectF result; bool found = false;
+        for (int lineIndex = 0; lineIndex < layout->lineCount(); ++lineIndex) {
+            const auto runs = layout->lineAt(lineIndex).glyphRuns(-1, -1,
+                QTextLayout::RetrieveGlyphIndexes | QTextLayout::RetrieveGlyphPositions);
+            for (const auto &run : runs) {
+                const auto glyphs = run.glyphIndexes(); const auto positions = run.positions();
+                const auto font = run.rawFont();
+                if (!font.isValid() || glyphs.size() != positions.size()) return {};
+                for (qsizetype i = 0; i < glyphs.size(); ++i) {
+                    const auto glyph = font.boundingRect(glyphs[i]).translated(positions[i] + layout->position());
+                    if (glyph.isEmpty()) continue;
+                    result = found ? result.united(glyph) : glyph; found = true;
+                }
+            }
+        }
+        return found ? std::optional<QRectF>(result) : std::nullopt;
+    };
+    const QStringList beforeTexts{QStringLiteral("ordinary before"), QString::fromUtf8("gyp ÉÅ ordinary before")};
+    const QStringList readingTexts{QStringLiteral("above"), QString::fromUtf8("Égj")};
+    bool mixedCaptureSaved = false;
+    for (int sample = 0; sample < beforeTexts.size(); ++sample) {
+        QTextDocument document; document.setDefaultFont(baseFont); document.setTextWidth(400);
+        QTextCursor cursor(&document); cursor.setBlockFormat(fixed);
+        cursor.insertText(beforeTexts[sample]); cursor.insertBlock(fixed);
+        const int start = cursor.position();
+        QTextCharFormat base; base.setFont(baseFont); cursor.insertText(QStringLiteral("X"), base);
+        const int readingStart = cursor.position();
+        QTextCharFormat reading; reading.setFont(readingFont); cursor.insertText(readingTexts[sample], reading);
+        const int end = cursor.position(); cursor.insertBlock(fixed);
+        cursor.insertText(QString::fromUtf8("ÉÅ gyp ordinary after"), base);
+        bool accepted = false; const QVariantList owners{flow(start, readingStart, end)};
+        QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictSetLogicalFlows",
+            Qt::DirectConnection, Q_RETURN_ARG(bool, accepted), Q_ARG(QVariantList, owners)));
+        QVERIFY(accepted); document.documentLayout()->documentSize();
+        if (sample == 1) mixedCaptureSaved = save(document, QStringLiteral("mixed"));
+        const auto annotation = geometry(document, readingStart);
+        QCOMPARE(annotation.value("error", -1).toInt(), 0);
+        const auto prior = document.begin(), following = document.findBlock(end).next();
+        const auto priorInk = ordinaryInk(prior), nextInk = ordinaryInk(following);
+        QVERIFY(priorInk); QVERIFY(nextInk);
+        const auto priorLine = prior.layout()->lineAt(0), nextLine = following.layout()->lineAt(0);
+        const auto priorFont = priorLine.naturalTextRect().translated(prior.layout()->position());
+        const auto nextFont = nextLine.naturalTextRect().translated(following.layout()->position());
+        const auto readingBox = annotation.value("characterRect").toRectF(); QVERIFY(!readingBox.isEmpty());
+        // The reading has one unshifted format. Native glyph bounds are relative
+        // to its measured baseline; the actual layout supplies that baseline.
+        QTextOption option; option.setTextDirection(Qt::LeftToRight);
+        const QList<QTextLayout::FormatRange> formats{{0, int(readingTexts[sample].size()), reading}};
+        auto shaped = QTextRubyGeometry::measureFlatChild(readingTexts[sample], readingFont, formats,
+            option, document.documentLayout()->paintDevice());
+        QVERIFY(shaped && shaped->hasInk);
+        const auto readingInk = shaped->ink.translated(QPointF(readingBox.left(), readingBox.top() - shaped->fontTop));
+        qInfo() << "Ruby mixed sample" << sample << "prior allocation" << document.documentLayout()->blockBoundingRect(prior)
+                << "prior positioned font" << priorFont << "prior ink" << *priorInk
+                << "reading font" << readingBox << "reading ink" << readingInk
+                << "next positioned font" << nextFont << "next ink" << *nextInk << annotation;
+        // Mixed authored fixed-height neighbors have no Ruby non-overlap
+        // guarantee. Preserve their measured ink-envelope gaps as diagnostics;
+        // only equivalent Ruby containers carry that requirement below.
+        qInfo() << "Ruby mixed ink-envelope gaps" << readingInk.top() - priorInk->bottom()
+                << nextInk->top() - readingInk.bottom();
+        const auto size = document.documentLayout()->documentSize();
+        QCOMPARE(document.documentLayout()->documentSize(), size);
+    }
+
+    QTextDocument equivalent; equivalent.setDefaultFont(baseFont); equivalent.setTextWidth(400);
+    QTextCursor cursor(&equivalent); cursor.setBlockFormat(fixed);
+    QList<QPair<int, int>> ranges; QVariantList owners;
+    for (int row = 0; row < 3; ++row) {
+        if (row) cursor.insertBlock(fixed);
+        const int start = cursor.position();
+        QTextCharFormat base; base.setFont(baseFont); cursor.insertText(QStringLiteral("X"), base);
+        const int readingStart = cursor.position();
+        QTextCharFormat reading; reading.setFont(readingFont); cursor.insertText(QStringLiteral("above"), reading);
+        const int end = cursor.position();
+        owners.append(flow(start, readingStart, end)); ranges.append(qMakePair(start, end));
+    }
+    bool accepted = false;
+    QVERIFY(QMetaObject::invokeMethod(equivalent.documentLayout(), "wikidictSetLogicalFlows",
+        Qt::DirectConnection, Q_RETURN_ARG(bool, accepted), Q_ARG(QVariantList, owners)));
+    QVERIFY(accepted); equivalent.documentLayout()->documentSize();
+    const bool equivalentCaptureSaved = save(equivalent, QStringLiteral("equivalent"));
+    QList<QRectF> occupied;
+    for (const auto &range : ranges) {
+        QRectF bounds; bool found = false;
+        for (int position = range.first; position < range.second; ++position) {
+            const auto value = geometry(equivalent, position);
+            QCOMPARE(value.value("error", -1).toInt(), 0);
+            const auto box = value.value("characterRect").toRectF(); QVERIFY(!box.isEmpty());
+            bounds = found ? bounds.united(box) : box; found = true;
+        }
+        QVERIFY(found); occupied.append(bounds);
+    }
+    qInfo() << "Ruby equivalent occupied containers" << occupied;
+    QCOMPARE(occupied.size(), 3);
+    QVERIFY(occupied[1].top() >= occupied[0].bottom() - 1.0 / 64);
+    QVERIFY(occupied[2].top() >= occupied[1].bottom() - 1.0 / 64);
+    QCOMPARE(occupied[0].size(), occupied[1].size()); QCOMPARE(occupied[1].size(), occupied[2].size());
+    const auto size = equivalent.documentLayout()->documentSize();
+    QCOMPARE(equivalent.documentLayout()->documentSize(), size);
+    QVERIFY(mixedCaptureSaved); QVERIFY(equivalentCaptureSaved);
+}
