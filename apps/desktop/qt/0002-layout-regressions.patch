+// Exercise the same query an image intrinsic-size handler uses while its
+// containing logical figure is being laid out. The depth bound is test-only:
+// a recursive callback is recorded as a failure instead of exhausting the stack.
+class FixedImageMemoProxy : public QObject, public QTextObjectInterface
+{
+    Q_OBJECT
+    Q_INTERFACES(QTextObjectInterface)
+public:
+    static constexpr auto declaration = "_wikidictFixedImageIntrinsicDelegateV1";
+    static constexpr int borderProperty = QTextFormat::UserProperty + 0x7110;
+    explicit FixedImageMemoProxy(QAbstractTextDocumentLayout *layout, bool declare = true)
+        : QObject(layout), native(layout), delegateInterface(layout->handlerForObject(QTextFormat::ImageObject))
+    {
+        for (QObject *child : layout->children())
+            if (qobject_cast<QTextObjectInterface *>(child) == delegateInterface) delegate = child;
+        Q_ASSERT(delegate);
+        if (declare) setProperty(declaration, QVariant::fromValue(delegate.data()));
+        layout->registerHandler(QTextFormat::ImageObject, this);
+    }
+    QPointer<QAbstractTextDocumentLayout> native;
+    QPointer<QObject> delegate;
+    QTextObjectInterface *delegateInterface = nullptr;
+    int calls = 0, change = 0;
+    int intrinsicDepth = 0, dirtyApplied = 0;
+    bool dirtyQueued = false, dirtyOutsideIntrinsic = false;
+    QSizeF intrinsicSize(QTextDocument *document, int position, const QTextFormat &format) override
+    {
+        ++calls;
+        ++intrinsicDepth;
+        const auto leave = qScopeGuard([&] { --intrinsicDepth; });
+        if (!delegate) return {};
+        const auto size = delegateInterface->intrinsicSize(document, position, format);
+        const int selected = change; change = 0;
+        if (selected == 1) setProperty(declaration, QVariant());
+        if (selected == 2) native->registerHandler(QTextFormat::ImageObject, delegate);
+        if (selected == 3) delete delegate.data();
+        if (selected == 4) {
+            // Dirtying synchronously would clear the QTextLayout currently
+            // calling this handler. Deliver only after that layout unwinds.
+            dirtyQueued = QMetaObject::invokeMethod(this,
+                [this, document = QPointer<QTextDocument>(document), position] {
+                    dirtyOutsideIntrinsic = intrinsicDepth == 0;
+                    if (document) {
+                        document->markContentsDirty(position, 1);
+                        ++dirtyApplied;
+                    }
+                }, Qt::QueuedConnection);
+        }
+        return size + (format.boolProperty(borderProperty) ? QSizeF(2, 2) : QSizeF(0, 0));
+    }
+    void drawObject(QPainter *p, const QRectF &box, QTextDocument *document, int position, const QTextFormat &format) override
+    {
+        if (!delegate) return;
+        const bool border = format.boolProperty(borderProperty);
+        if (border) p->fillRect(box, QColor("#204060"));
+        delegateInterface->drawObject(p, border ? box.adjusted(1, 1, -1, -1) : box, document, position, format);
+    }
+};
