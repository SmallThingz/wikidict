+    void typedCellCollapsedDoubleWinsWithoutChangingOrdinaryBorders()
+    {
+        for (const qreal stroke : {4.0, 6.0}) for (const bool reverse : {false, true}) {
+            QTextDocument doc; doc.setDefaultFont(QFont(QStringLiteral("DejaVu Sans"), 12));
+            doc.setDocumentMargin(10); doc.setTextWidth(240);
+            QTextTableFormat format; format.setBorder(0); format.setCellSpacing(0); format.setCellPadding(8);
+            format.setBorderCollapse(true); format.setWidth(QTextLength(QTextLength::FixedLength, 160));
+            format.setProperty(QTextFormat::UserProperty + 0x57d0, QStringLiteral("wikidict.table-box/1"));
+            format.setProperty(QTextFormat::UserProperty + 0x57da, QStringLiteral("wikidict.cell-style/1"));
+            QTextCursor cursor(&doc); auto *table = cursor.insertTable(2, 1, format);
+            for (int r = 0; r < 2; ++r) {
+                auto cell = table->cellAt(r, 0); auto f = cell.format().toTableCellFormat();
+                const bool doubleEdge = (r == 0) != reverse;
+                const auto style = doubleEdge ? QTextFrameFormat::BorderStyle_Double : QTextFrameFormat::BorderStyle_Solid;
+                const QBrush brush(doubleEdge ? Qt::blue : Qt::red);
+                if (r == 0) { f.setBottomBorder(stroke); f.setBottomBorderStyle(style); f.setBottomBorderBrush(brush); }
+                else { f.setTopBorder(stroke); f.setTopBorderStyle(style); f.setTopBorderBrush(brush); }
+                cell.setFormat(f); auto text = cell.firstCursorPosition(); text.insertText(QStringLiteral("Cell"));
+            }
+            auto *layout = qobject_cast<QTextDocumentLayout *>(doc.documentLayout()); QVERIFY(layout);
+            layout->documentSize();
+            QCOMPARE(layout->wikidictParagraphBoxLayoutError(), 0);
+            QImage image(260, 180, QImage::Format_ARGB32_Premultiplied); image.fill(Qt::white);
+            QPainter painter(&image); doc.drawContents(&painter); painter.end();
+            const int x = qRound(layout->tableBoundingRect(table).center().x());
+            int blueGroups = 0, redPixels = 0; bool previousBlue = false;
+            for (int y = 0; y < image.height(); ++y) {
+                const QColor color = image.pixelColor(x, y);
+                const bool blue = color.blue() > 220 && color.red() < 30 && color.green() < 30;
+                if (blue && !previousBlue) ++blueGroups;
+                previousBlue = blue;
+                if (color.red() > 220 && color.green() < 30 && color.blue() < 30) ++redPixels;
+            }
+            QVERIFY(QDir().mkpath(QStringLiteral(".tmp/tallrik")));
+            const QString capture = QStringLiteral(".tmp/tallrik/cell-double-%1-width%2-reverse%3").arg(QCoreApplication::applicationPid()).arg(stroke).arg(int(reverse));
+            QVERIFY(image.save(capture + QStringLiteral(".png")));
+            QFile pixels(capture + QStringLiteral(".json")); QVERIFY(pixels.open(QIODevice::WriteOnly | QIODevice::NewOnly));
+            const QByteArray observed = QJsonDocument(QJsonObject{{"stroke", stroke}, {"reverse", reverse}, {"sample_x", x}, {"blue_groups", blueGroups}, {"red_pixels", redPixels}}).toJson();
+            QCOMPARE(pixels.write(observed), qint64(observed.size())); pixels.close();
+            QCOMPARE(blueGroups, 2); QCOMPARE(redPixels, 0);
+            // Without the compiled policy the existing Qt tie-break remains
+            // unchanged: the top cell's bottom edge wins this equal-width tie.
+            auto ordinary = format;
+            ordinary.clearProperty(QTextFormat::UserProperty + 0x57d0);
+            ordinary.clearProperty(QTextFormat::UserProperty + 0x57da);
+            table->setFormat(ordinary); doc.documentLayout()->documentSize();
