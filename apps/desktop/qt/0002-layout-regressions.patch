+void tst_QTextDocumentLayout::rubyCollapsedGapKeepsLogicalTextAndNeighborRanges()
+{
+    using Map = QTextRubyRangeMap;
+    const auto before = Map::Bias::Before, after = Map::Bias::After;
+    const QString logical = QStringLiteral("A\r\nBxy");
+    Map::Segment segment;
+    segment.gap = {0, 0};
+    segment.bases = {{{0, 0}, {{0, 1}, {}}}, {{1, 3}, {{3, 4}, {}}}};
+    segment.annotations = {{0, 1, 0, false, {4, 4}, {{4, 5}, {}}},
+                           {1, 1, 0, false, {5, 5}, {{5, 6}, {}}}};
+    const Map::Owner owner{{0, 6}, {segment}};
+    for (bool omit : {false, true}) {
+        QTextDocument document;
+        document.setPlainText(omit ? QStringLiteral("ABxy") : QStringLiteral("A Bxy"));
+        const int storedGap = omit ? 0 : 1;
+        const QList<Map::Piece> pieces{{{0, 1}, {0, 1}, false},
+            {{1, 3}, {1, 1 + storedGap}, true}, {{3, 6}, {1 + storedGap, 4 + storedGap}, false}};
+        QString error;
+        auto map = Map::create(&document, logical, pieces, owner, 100, &error);
+        QVERIFY2(map, qPrintable(error));
+        QCOMPARE(map->logicalCount(), 6);
+        QCOMPARE(map->text(0, 6), logical);
+        QCOMPARE(map->text(1, 3), QStringLiteral("\r\n"));
+        QCOMPARE(map->toDocument(2, before), 1);
+        QCOMPARE(map->toDocument(2, after), 1 + storedGap);
+        // These are the future action/selection ranges, not URL matching. The
+        // CRLF belongs to neither adjacent base, including at a shared caret.
+        const auto left = map->columnSources(0, 0)[0].range;
+        const auto right = map->columnSources(0, 1)[0].range;
+        QVERIFY(Map::selected(left, 1, 3).empty());
+        QVERIFY(Map::selected(right, 1, 3).empty());
+        QCOMPARE(map->toDocument(left.first, after), 0);
+        QCOMPARE(map->toDocument(left.last, before), 1);
+        QCOMPARE(map->toDocument(right.first, after), 1 + storedGap);
+        QCOMPARE(map->toDocument(right.last, before), 2 + storedGap);
+        QCOMPARE(map->toLogical(1, before), 1);
+        QCOMPARE(map->toLogical(1 + storedGap, after), 3);
+        if (omit) {
+            QCOMPARE(map->toLogical(1, after), 3);
+            QCOMPARE(map->toLogical(1, before), 1);
+        }
+        auto changed = pieces;
+        changed[2].logical.first = 2;
+        QVERIFY(!Map::create(&document, logical, changed, owner, 100, &error));
+        auto wrongOwner = owner;
+        wrongOwner.segments[0].bases[1].gap = {1, 1};
+        wrongOwner.segments[0].bases[1].body.range = {1, 4};
+        QVERIFY(!Map::create(&document, logical, pieces, wrongOwner, 100, &error));
+        QTextCursor cursor(&document);
+        cursor.insertText(QStringLiteral("!"));
+        QCOMPARE(map->logicalCount(), -1);
+        QCOMPARE(map->toDocument(0, before), -1);
+        QVERIFY(map->text(0, 6).isEmpty());
+    }
+    QTextDocument changedBody;
+    changedBody.setPlainText(QStringLiteral("A Cxy"));
+    QString error;
+    const QList<Map::Piece> pieces{{{0, 1}, {0, 1}, false}, {{1, 3}, {1, 2}, true},
+                                   {{3, 6}, {2, 5}, false}};
+    QVERIFY(!Map::create(&changedBody, logical, pieces, owner, 100, &error));
+    // Normalizing into a real QTextDocument paragraph is not the chosen inline
+    // storage projection. An adapter must explicitly emit a collapsed gap.
+    changedBody.setPlainText(logical);
+    QVERIFY(!Map::create(&changedBody, owner, 100, &error));
+}
