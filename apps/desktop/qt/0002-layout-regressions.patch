+// Source-only slot for the existing tst_QTextDocumentLayout target.
+// This calls the real native vertical-entry API at an interior child caret;
+// the original atom-only inverse returns a Ruby boundary instead.
+void tst_QTextDocumentLayout::rubyVerticalEntryKeepsPreferredChildCaret()
+{
+    for (const auto direction : {Qt::LeftToRight, Qt::RightToLeft}) {
+        QTextDocument document;
+        QFont baseFont; baseFont.setPixelSize(20);
+        QFont readingFont = baseFont; readingFont.setPixelSize(12);
+        document.setDefaultFont(baseFont);
+        document.setDocumentMargin(9);
+        document.setTextWidth(400);
+        QTextCursor cursor(&document);
+        cursor.insertText(QStringLiteral("ordinary before"));
+        cursor.insertBlock();
+        QTextBlockFormat block = cursor.blockFormat();
+        block.setLeftMargin(37); block.setRightMargin(13);
+        block.setLayoutDirection(direction); cursor.setBlockFormat(block);
+        const int first = cursor.position();
+        QTextCharFormat base; base.setFont(baseFont);
+        QTextCharFormat reading; reading.setFont(readingFont);
+        const QString baseText = direction == Qt::LeftToRight
+            ? QStringLiteral("ABCDE") : QString::fromUtf16(u"\u05d0\u05d1\u05d2\u05d3\u05d4");
+        cursor.insertText(baseText, base);
+        const int readingFirst = cursor.position();
+        cursor.insertText(QStringLiteral("annotation reading"), reading);
+        const int last = cursor.position();
+        cursor.insertBlock(); cursor.insertText(QStringLiteral("ordinary after"), base);
+        const QString original = document.toRawText();
+        const int originalRevision = document.revision();
+        QTextRubyLayout::Child b;
+        b.source = {first, readingFirst}; b.ownerFont = baseFont;
+        b.usedAbove = 16; b.usedBelow = 4;
+        b.option.setTextDirection(direction); b.option.setWrapMode(QTextOption::NoWrap);
+        QTextRubyLayout::Child a;
+        a.source = {readingFirst, last}; a.ownerFont = readingFont;
+        a.option.setTextDirection(Qt::LeftToRight); a.option.setWrapMode(QTextOption::NoWrap);
+        QTextRubyLayout::Description ruby;
+        ruby.bases = {b}; ruby.readings = {{a, 0, 1, 0}}; ruby.gaps = {0};
+        ruby.direction = direction;
+        const QVariantMap part{{"kind", QStringLiteral("ruby")}, {"anchor", first},
+            {"value", QVariant::fromValue(ruby)}};
+        const QVariantList owners{QVariantMap{{"first", first}, {"last", last},
+            {"direction", int(direction)}, {"joins", QVariantList{}},
+            {"parts", QVariantList{part}}}};
+        bool accepted = false;
+        QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictSetLogicalFlows",
+            Qt::DirectConnection, Q_RETURN_ARG(bool, accepted), Q_ARG(QVariantList, owners)));
+        QVERIFY(accepted);
+        for (const qreal width : {qreal(400), qreal(260), qreal(400)}) {
+            document.setTextWidth(width);
+            QVERIFY(document.documentLayout()->documentSize().height() > 0);
+            const int wanted = first + 2;
+            QVariantMap geometry;
+            QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictLogicalPosition",
+                Qt::DirectConnection, Q_RETURN_ARG(QVariantMap, geometry), Q_ARG(int, wanted)));
+            QCOMPARE(geometry.value("error", -1).toInt(), 0);
+            const QRectF caret = geometry.value("cursorRect").toRectF();
+            const QRectF character = geometry.value("characterRect").toRectF();
+            QVERIFY(!caret.isEmpty()); QVERIFY(!character.isEmpty());
+            QVERIFY(qIsFinite(caret.left()));
+            QVERIFY(wanted > first && wanted < readingFirst);
+            // This is document X, including the document and authored block
+            // margins. Both vertical entry directions must preserve it.
+            const qreal documentX = caret.left();
+            for (const bool fromAbove : {true, false}) {
+                int entered = -999;
+                QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictLogicalVerticalEntry",
+                    Qt::DirectConnection, Q_RETURN_ARG(int, entered), Q_ARG(int, first),
+                    Q_ARG(bool, fromAbove), Q_ARG(qreal, documentX)));
+                QCOMPARE(entered, wanted);
+                QVERIFY(entered != first); // The old placeholder-anchor result.
+                QVariantMap enteredGeometry;
+                QVERIFY(QMetaObject::invokeMethod(document.documentLayout(), "wikidictLogicalPosition",
+                    Qt::DirectConnection, Q_RETURN_ARG(QVariantMap, enteredGeometry), Q_ARG(int, entered)));
+                QCOMPARE(enteredGeometry.value("error", -1).toInt(), 0);
+                QVERIFY(qAbs(enteredGeometry.value("cursorRect").toRectF().left() - documentX) <= 1.0 / 64);
+            }
+            QCOMPARE(document.toRawText(), original);
+            QCOMPARE(document.revision(), originalRevision);
+        }
+    }
+}
