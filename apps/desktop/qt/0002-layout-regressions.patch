+            int ordinaryRed = 0;
+            for (int y = 0; y < image.height(); ++y) {
+                const QColor color = image.pixelColor(x, y);
+                if (color.red() > 220 && color.green() < 30 && color.blue() < 30) ++ordinaryRed;
+            }
+            if (reverse) QVERIFY(ordinaryRed >= 1);
+            else QCOMPARE(ordinaryRed, 0);
+            table->setFormat(format);
+            // Explicit none cannot suppress the opposite real solid edge.
+            auto first = table->cellAt(0, 0); auto firstFormat = first.format().toTableCellFormat();
+            firstFormat.setBottomBorder(100); firstFormat.setBottomBorderStyle(QTextFrameFormat::BorderStyle_None); first.setFormat(firstFormat);
+            auto second = table->cellAt(1, 0); auto secondFormat = second.format().toTableCellFormat();
+            secondFormat.setTopBorder(2); secondFormat.setTopBorderStyle(QTextFrameFormat::BorderStyle_Solid); secondFormat.setTopBorderBrush(Qt::red); second.setFormat(secondFormat);
+            doc.documentLayout()->documentSize(); image.fill(Qt::white);
+            painter.begin(&image); doc.drawContents(&painter); painter.end();
