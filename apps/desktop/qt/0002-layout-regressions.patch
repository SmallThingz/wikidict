+// Existing native layout target; actual shaped child coordinates, not only policy arithmetic.
+void tst_QTextDocumentLayout::rubyAppliesCommonAndReadingShiftExactlyOnce()
+{
+    QTextDocument document;
+    QFont baseFont; baseFont.setPixelSize(24);
+    QFont readingFont = baseFont; readingFont.setPixelSize(12);
+    document.setDefaultFont(baseFont);
+    QTextCursor cursor(&document);
