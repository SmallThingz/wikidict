+static QRectF wikidictFigureAfterRect(const QVariantMap &policy, const QRectF &anchor, qreal scale)
+{
+    const auto after = policy.value(QStringLiteral("after")).toMap();
+    if (after.isEmpty()) return {};
+    const qreal width = after.value(QStringLiteral("width")).toDouble() * scale;
+    const qreal height = after.value(QStringLiteral("height")).toDouble() * scale;
+    const qreal inset = after.value(QStringLiteral("inset")).toDouble() * scale;
+    return QRectF(after.value(QStringLiteral("right")).toBool() ? anchor.right() - inset - width : anchor.left() + inset,
+        anchor.bottom() - after.value(QStringLiteral("bottom")).toDouble() * scale - height, width, height);
+}
+static QRectF wikidictFigureFocusRect(const QVariantMap &policy, const QRectF &anchor, qreal scale)
+{
+    const auto focus = policy.value(QStringLiteral("focus")).toMap();
+    if (focus.isEmpty()) return {};
+    const qreal width = focus.value(QStringLiteral("width")).toDouble() * scale;
+    if (width == 0) return {};
+    const qreal extent = focus.value(QStringLiteral("offset")).toDouble() * scale + width;
+    // CSS UI outline-offset keeps each outside dimension at least twice
+    // the stroke width, including a large negative offset or zero anchor.
+    const QSizeF size(qMax(2 * width, anchor.width() + 2 * extent), qMax(2 * width, anchor.height() + 2 * extent));
+    return QRectF(anchor.center() - QPointF(size.width() / 2, size.height() / 2), size);
+}
+struct WikidictPhysicalEdges {
+    qreal padding[4] = {}; // top, right, bottom, left; CSS pixels before device scaling
