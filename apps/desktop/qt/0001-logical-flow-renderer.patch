+int QTextDocumentLayout::wikidictLogicalVerticalEntry(int position, bool fromAbove, qreal documentX) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return -2;
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return -1;
+    if (d->paragraphBoxError || !qIsFinite(documentX)) return -2;
+    return d->logicalLinePosition(flow, fromAbove ? 0 : flow->textLayout()->lineCount() - 1,
+                                  fromAbove, documentX);
+}
