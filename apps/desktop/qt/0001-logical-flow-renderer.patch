+bool QTextDocumentLayoutPrivate::validateFigureFrame(QTextFrame *frame, qreal availableWidth)
+{
+    const QTextFrameFormat format = frame->frameFormat();
+    const auto fail = [&](int error) {
+        paragraphBoxError = error; paragraphBoxErrorPosition = frame->firstPosition(); return false;
+    };
+    const bool hasContentFloor = format.hasProperty(QTextFormat::UserProperty + 0x57ab);
+    if (!format.hasProperty(QTextFormat::UserProperty + 0x57a0))
+        return !hasContentFloor || fail(1);
+    const QVariant owner = format.property(QTextFormat::UserProperty + 0x57a0);
+    const QVariant clear = format.property(QTextFormat::UserProperty + 0x57a1);
+    const QVariant placement = format.property(QTextFormat::UserProperty + 0x57a2);
+    if (owner.metaType().id() != QMetaType::QString || owner.toString() != QStringLiteral("wikidict.figure-layout/1")
+            || clear.metaType().id() != QMetaType::Int || clear.toInt() < 0 || clear.toInt() > 3
