+double QTextDocumentLayout::wikidictFigureContentWidth(int objectPosition) const
+{
+    if (objectPosition < 0 || objectPosition >= document()->characterCount() - 1
+            || document()->characterAt(objectPosition) != QChar::ObjectReplacementCharacter) return -1;
