+            const QRectF used = cd->wikidictScrollport ? QRectF(QPointF(), cd->size.toSizeF())
+                : cd->wikidictScrollableBoundsPresent ? cd->wikidictScrollableBounds
+                : QRectF(QPointF(), cd->size.toSizeF());
+            include(used.translated(offset));
+            continue;
+        }
+        const auto block = it.currentBlock();
+        if (!block.isValid() || !block.isVisible()) continue;
+        if (localSubtree && isWikidictTableBoundaryCaret(it, previous)) continue;
+        const auto flow = logicalFlowAt(block.position());
+        if (flow && flow->firstPosition() != block.position()) continue;
+        const auto *layout = flow ? flow->textLayout() : block.layout();
+        if (layout->lineCount() == 0) continue;
+        QPointF offset = layout->position();
+        if (table) {
+            const auto cell = table->cellAt(block.position());
+            if (cell.isValid()) offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+        }
+        const auto used = fd->wikidictUsedLineMetrics.constFind(block.position());
+        if (localSubtree && (used == fd->wikidictUsedLineMetrics.cend() || used->size() != layout->lineCount())) {
+            refuseParagraphBox(1, block.position());
+            if (present) *present = false;
+            return {};
+        }
+        for (int index = 0; index < layout->lineCount(); ++index) {
+            const auto line = layout->lineAt(index);
+            QRectF box = line.naturalTextRect();
+            if (localSubtree) {
+                box.setTop(line.y() + used->at(index).first);
+                box.setHeight(used->at(index).second);
+            }
+            include(box.translated(offset));
+        }
+    }
+    if (present) *present = hasBounds;
+    return result;
+}
+
+QRectF QTextDocumentLayoutPrivate::scrollClip(QTextFrame *frame) const
+{
+    QRectF clip; bool present = false;
+    for (; frame; frame = frame->parentFrame()) {
+        const auto *fd = data(frame);
+        if (!fd->wikidictScrollport) continue;
+        const QRectF viewport = fd->wikidictScrollViewport.translated(frameBoundingRectInternal(frame).topLeft());
+        clip = present ? clip.intersected(viewport) : viewport;
+        present = true;
+    }
+    return clip;
+}
+
+bool QTextDocumentLayout::wikidictConfigureScrollports(double gutter)
+{
+    Q_D(QTextDocumentLayout);
+    if (!qIsFinite(gutter) || gutter < 0 || gutter >= QFIXED_MAX / 8
+        || data(document()->rootFrame())->currentLayoutStruct || d->insideDocumentChange) return false;
+    if (d->scrollportGutter == gutter) return true;
+    d->scrollportGutter = gutter;
+    document()->markContentsDirty(0, document()->characterCount());
+    return true;
+}
+
+QVariantList QTextDocumentLayout::wikidictScrollports() const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->docPrivate->canLayout() || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return {};
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return {};
+    QVariantList result;
+    QList<QTextFrame *> pending{document()->rootFrame()};
+    while (!pending.isEmpty()) {
+        auto *frame = pending.takeLast(); pending.append(frame->childFrames());
+        const auto *fd = data(frame);
+        if (!fd->wikidictScrollport || fd->layoutDirty || fd->sizeDirty) continue;
+        const auto origin = d->frameBoundingRectInternal(frame).topLeft();
+        const QRectF viewport = fd->wikidictScrollViewport.translated(origin);
+        const QRectF bar(viewport.left(), viewport.bottom(), viewport.width(),
+            fd->wikidictScrollMinimum < fd->wikidictScrollMaximum ? d->scrollportGutter : 0);
+        const QRectF ancestorClip = d->scrollClip(frame->parentFrame());
+        bool clipped = false;
+        for (auto *parent = frame->parentFrame(); parent; parent = parent->parentFrame()) clipped |= data(parent)->wikidictScrollport;
+        result.append(QVariantMap{{QStringLiteral("owner"), frame->objectIndex()},
+            {QStringLiteral("first"), frame->firstPosition()}, {QStringLiteral("last"), frame->lastPosition()},
+            {QStringLiteral("revision"), document()->revision()}, {QStringLiteral("viewport"), viewport},
+            {QStringLiteral("clip"), d->scrollClip(frame)}, {QStringLiteral("bar"), bar},
+            {QStringLiteral("bar_clip"), clipped ? bar.intersected(ancestorClip) : bar},
+            {QStringLiteral("minimum"), fd->wikidictScrollMinimum}, {QStringLiteral("maximum"), fd->wikidictScrollMaximum},
+            {QStringLiteral("offset"), fd->wikidictScrollOffset}});
+        if (wikidictTableViewportActive(frame)) {
+            auto value = result.last().toMap();
+            value.insert(QStringLiteral("table_viewport"), true);
+            value.insert(QStringLiteral("border_box"), d->frameBoundingRectInternal(frame));
+            value.insert(QStringLiteral("content_viewport"), QRectF(origin + QPointF(
+                (fd->leftMargin + fd->edgeInset(3)).toReal(), (fd->topMargin + fd->edgeInset(0)).toReal()),
+                QSizeF(fd->contentsWidth.toReal(), qMax(qreal(0), viewport.height()
+                    - fd->wikidictPadding[0].toReal() - fd->wikidictPadding[2].toReal()))));
+            value.insert(QStringLiteral("grid_extent"), d->frameBoundingRectInternal(frame->childFrames().first()));
+            result.last() = value;
+        }
+    }
+    return result;
+}
+
+bool QTextDocumentLayout::wikidictScrollportOffset(int owner, int first, int revision, double offset)
+{
+    Q_D(QTextDocumentLayout);
+    if (revision != document()->revision() || !qIsFinite(offset) || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return false;
+    d->ensureLayoutFinished();
+    auto *frame = qobject_cast<QTextFrame *>(document()->object(owner));
+    if (!frame || frame->firstPosition() != first || d->paragraphBoxError) return false;
+    auto *fd = data(frame);
+    if (!fd->wikidictScrollport || fd->sizeDirty || fd->layoutDirty) return false;
+    offset = qBound(fd->wikidictScrollMinimum, offset, fd->wikidictScrollMaximum);
+    if (offset == fd->wikidictScrollOffset) return true;
+    fd->wikidictScrollOffset = offset;
+    emit update(d->frameBoundingRectInternal(frame));
+    return true;
+}
+
+QVariantMap QTextDocumentLayout::wikidictScrollClip(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (position < 0 || position >= document()->characterCount() || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct)
+        return {{QStringLiteral("error"), true}};
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return {{QStringLiteral("error"), true}};
+    auto *frame = document()->frameAt(position);
+    bool present = false;
+    for (auto *parent = frame; parent; parent = parent->parentFrame()) present |= data(parent)->wikidictScrollport;
+    return {{QStringLiteral("handled"), present}, {QStringLiteral("clip"), d->scrollClip(frame)}};
+}
+
+bool QTextDocumentLayout::wikidictRevealScrollPosition(int position)
+{
+    Q_D(QTextDocumentLayout);
+    if (position < 0 || position >= document()->characterCount() || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return false;
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return false;
+    bool changed = false;
+    for (auto *frame = document()->frameAt(position); frame; frame = frame->parentFrame()) {
+        auto *fd = data(frame);
+        if (!fd->wikidictScrollport) continue;
+        QRectF caret;
+        const auto logical = wikidictLogicalPosition(position);
+        if (logical.value(QStringLiteral("handled")).toBool()) {
+            if (logical.value(QStringLiteral("error")).toInt()) return false;
+            caret = logical.value(QStringLiteral("characterRect"), logical.value(QStringLiteral("cursorRect"))).toRectF();
+        } else {
+            const auto block = document()->findBlock(position);
+            const auto line = block.layout()->lineForTextPosition(position - block.position());
+            if (!line.isValid()) return false;
+            const qreal leading = line.cursorToX(position - block.position(), QTextLine::Leading);
+            const qreal trailing = line.cursorToX(position - block.position(), QTextLine::Trailing);
+            caret = QRectF(blockBoundingRect(block).topLeft() + QPointF(qMin(leading, trailing), line.y()),
+                QSizeF(qMax(qreal(qMax(1, d->cursorWidth)), qAbs(trailing - leading)), line.height()));
+        }
+        const QRectF viewport = fd->wikidictScrollViewport.translated(d->frameBoundingRectInternal(frame).topLeft());
+        const qreal delta = caret.left() < viewport.left() ? caret.left() - viewport.left()
+            : qMax(qreal(0), caret.right() - viewport.right());
+        const qreal offset = qBound(fd->wikidictScrollMinimum, fd->wikidictScrollOffset + delta, fd->wikidictScrollMaximum);
+        changed |= offset != fd->wikidictScrollOffset;
+        fd->wikidictScrollOffset = offset;
+    }
+    if (changed) emit update();
+    return true;
+}
+
+// Native registration is atomic and tied to original document revisions. Caption
+// frames remain in the same QTextDocument and retain their actual source ranges.
+bool QTextDocumentLayout::wikidictSetLogicalFlows(const QVariantList &descriptions)
+{
+    Q_D(QTextDocumentLayout);
+    QList<std::shared_ptr<QTextLogicalFlowProjection>> replacement;
+    for (const QVariant &value : descriptions) {
+        if (value.metaType().id() != QMetaType::QVariantMap)
+            return false;
+        QString error;
+        if (!QTextLogicalFlowProjection::createGroup(document(), value.toMap(), &replacement, &error))
+            return false;
+    }
+    std::sort(replacement.begin(), replacement.end(), [](const auto &a, const auto &b) {
+        return a->firstPosition() < b->firstPosition();
+    });
+    QMap<int, std::shared_ptr<QTextLogicalFlowProjection>> index;
+    QMap<int, int> parents;
+    QList<std::shared_ptr<QTextLogicalFlowProjection>> stack;
+    for (const auto &flow : std::as_const(replacement)) {
+        if (index.contains(flow->firstPosition())) return false;
+        while (!stack.isEmpty() && flow->firstPosition() >= stack.last()->lastPosition()) stack.removeLast();
+        if (!stack.isEmpty()) {
+            const auto &parent = stack.last();
+            if (flow->lastPosition() > parent->lastPosition()
+                || !parent->inCaption(flow->firstPosition())
+                || !parent->inCaption(flow->lastPosition() > flow->firstPosition()
+                    ? flow->lastPosition() - 1 : flow->firstPosition())) return false;
+            parents.insert(flow->firstPosition(), parent->firstPosition());
+        }
+        index.insert(flow->firstPosition(), flow);
+        stack.append(flow);
+    }
+    d->logicalFlowRevision = document()->revision();
+    d->logicalFlowIndex = std::move(index);
+    d->logicalFlowParents = std::move(parents);
+    d->logicalFlows = std::move(replacement);
+    // Removing the final owner also invalidates later unowned float-wrap caches.
+    document()->markContentsDirty(0, document()->characterCount());
+    return true; // No member access after the potentially reentrant notification.
+}
+
+std::shared_ptr<QTextLogicalFlowProjection> QTextDocumentLayoutPrivate::logicalFlowAt(int position, bool includeCaption) const
+{
+    auto it = logicalFlowIndex.upperBound(position);
+    if (it == logicalFlowIndex.cbegin()) return {};
+    --it;
+    while (it != logicalFlowIndex.cend()) {
+        const auto &flow = it.value();
+        if (flow->current() && position >= flow->firstPosition() && position <= flow->lastPosition()
+            && (includeCaption || !flow->inCaption(position))) return flow;
+        const auto parent = logicalFlowParents.constFind(it.key());
+        if (parent == logicalFlowParents.cend()) return {};
+        it = logicalFlowIndex.find(parent.value());
+    }
+    return {};
+}
+
+bool QTextDocumentLayout::wikidictIsCurrentFigureCaption(const QTextBlock &block) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!block.isValid() || block.document() != document() || d->insideDocumentChange
+        || d->paragraphBoxError || document()->revision() != d->logicalFlowRevision)
+        return false;
+    QTextFrame *content = d->docPrivate->frameAt(block.position());
+    while (content && content->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("caption-content"))
+        content = content->parentFrame();
+    if (!wikidictFigureTableCaptionFrame(content)
+        || block.position() < content->firstPosition()
+        || block.position() + block.length() - 1 > content->lastPosition())
+        return false;
+    auto *caption = qobject_cast<QTextTable *>(content->parentFrame());
+    auto *figure = wikidictFigureTableCaptionRoot(content);
+    if (!caption || !figure || caption->parentFrame() != figure
+        || !wikidictFigureTableCaptionFrame(caption)
+        || caption->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("caption")
+        || wikidictFigureTableCaptionRoot(caption) != figure
+        || caption->rows() != 1 || caption->columns() != 1
+        || caption->childFrames().size() != 1 || caption->childFrames().first() != content
+        || figure->childFrames().size() != 2 || figure->childFrames().at(1) != caption)
+        return false;
+    // The regular Figure layout path already validates the complete policy.
+    // A dirty/active owner must not acquire geometry authority from role strings.
+    for (const QTextFrame *owner : {figure, static_cast<QTextFrame *>(caption), content}) {
+        const auto *fd = static_cast<const QTextFrameData *>(owner->layoutData());
+        if (!fd || fd->layoutDirty || fd->sizeDirty || fd->currentLayoutStruct)
+            return false;
+    }
+    const int anchor = figure->firstPosition() - 1;
+    const auto flow = d->logicalFlowAt(anchor, true);
+    if (!flow || !flow->current())
+        return false;
+    for (const auto &object : flow->objects())
+        if (object.frame == figure && object.first == anchor
+            && object.last == figure->lastPosition() + 1
+            && block.position() > object.first
+            && block.position() + block.length() - 1 < object.last)
+            return true;
+    return false;
+}
+
+static constexpr int WikidictFigureLinkPolicy = QTextFormat::UserProperty + 0x57b4;
+static constexpr int WikidictFigureLinkOwner = WikidictFigureLinkPolicy + 1;
+static constexpr int WikidictFigureLinkFixed = WikidictFigureLinkPolicy + 5;
+static constexpr int WikidictFigureLinkOutline = WikidictFigureLinkPolicy + 6;
+static constexpr int WikidictFigureLinkAtomic = WikidictFigureLinkPolicy + 7;
+static const QString &wikidictFigureLinkCapability()
+{
+    static const QString value = QStringLiteral("wikidict.figure-link-state/1");
+    return value;
+}
+static bool wikidictFixedFigureLink(const QTextFormat &format)
+{
+    return format.stringProperty(WikidictFigureLinkPolicy) == wikidictFigureLinkCapability()
+        && format.property(WikidictFigureLinkOwner).metaType().id() == QMetaType::LongLong
+        && format.property(WikidictFigureLinkOwner).toLongLong() >= (qint64(1) << 32);
+}
+
+QTextFrame *QTextDocumentLayoutPrivate::currentFigureLinkRoot(QTextFrame *frame) const
+{
+    if (!frame || insideDocumentChange || paragraphBoxError || document->revision() != logicalFlowRevision)
+        return nullptr;
+    for (auto *owner = frame; owner; owner = owner->parentFrame()) {
+        const auto *fd = static_cast<const QTextFrameData *>(owner->layoutData());
+        if (!fd || fd->layoutDirty || fd->sizeDirty || fd->currentLayoutStruct) return nullptr;
+        if (owner->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("figure")) continue;
+        if (!wikidictFigureTableCaptionFrame(owner)) return nullptr;
+        const int first = owner->firstPosition() - 1;
+        const auto flow = logicalFlowAt(first, true);
+        if (!flow || !flow->current()) return nullptr;
+        for (const auto &object : flow->objects())
+            if (object.frame == owner && object.first == first && object.last == owner->lastPosition() + 1)
+                return owner;
+        return nullptr;
+    }
+    return nullptr;
+}
+
+bool QTextDocumentLayoutPrivate::figureLinkPolicyMatches(QTextFrame *frame, const QTextFormat &format, bool missing) const
+{
+    const auto *root = currentFigureLinkRoot(frame);
+    if (!root || !wikidictFixedFigureLink(format)) return false;
+    const auto meta = QJsonDocument::fromJson(root->frameFormat().property(WikidictFigureOwner + 3).toByteArray()).object();
+    const auto source = meta.value(QStringLiteral("figure")).toObject().value(QStringLiteral("table_caption_layout")).toObject();
+    const auto policy = source.value(missing ? QStringLiteral("missing_link_paint") : QStringLiteral("caption_link_paint"));
+    return policy.isObject() && !policy.toObject().isEmpty()
+        && policy.toObject().toVariantMap() == format.property(WikidictFigureLinkFixed).toMap();
+}
+
+QList<QRectF> QTextDocumentLayoutPrivate::figureMissingLinkBoxes(QTextFrame *image, int *position) const
+{
+    if (position) *position = -1;
+    if (!wikidictFigureMediaFrame(image) || !currentFigureLinkRoot(image) || image->childFrames().size() != 1) return {};
+    auto *label = image->childFrames().first();
+    const auto *fd = static_cast<const QTextFrameData *>(image->layoutData());
+    if (!fd || fd->wikidictFixedLinkPosition < 0 || !figureLinkPolicyMatches(label, label->frameFormat(), true)) return {};
+    if (position) *position = fd->wikidictFixedLinkPosition;
+    return fd->wikidictFixedLinkBoxes;
+}
+
+static QRectF wikidictFigureLinkOutlineRect(QRectF box, qreal width, qreal outset)
+{
+    if (!qIsFinite(box.x()) || !qIsFinite(box.y()) || !qIsFinite(box.width()) || !qIsFinite(box.height())
+        || box.width() < 0 || box.height() < 0 || !qIsFinite(width) || width <= 0 || !qIsFinite(outset)) return {};
+    box.adjust(-outset - width / 2, -outset - width / 2, outset + width / 2, outset + width / 2);
+    const auto center = box.center();
+    box.setWidth(qMax(width, box.width())); box.setHeight(qMax(width, box.height())); box.moveCenter(center);
+    return box;
+}
+
+static void wikidictDrawFigureLinkOutline(QPainter *painter, const QList<QRectF> &boxes,
+                                         const QVariantMap &outline, qreal scale, const QPointF &offset,
+                                         const QRectF &clip)
+{
+    const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+    const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+    const qreal radius = qMax(qreal(0), outline.value(QStringLiteral("radius")).toDouble() * scale + outset + width / 2);
+    if (!qIsFinite(width) || width <= 0 || !qIsFinite(outset) || !qIsFinite(radius)) return;
+    QPainterPath contour;
+    for (auto box : boxes) {
+        box = wikidictFigureLinkOutlineRect(box.translated(offset), width, outset);
+        if (!box.isValid()) continue;
+        QPainterPath piece; piece.addRoundedRect(box, radius, radius);
+        contour = contour.isEmpty() ? piece : contour.united(piece);
+    }
+    if (contour.isEmpty()) return;
+    painter->save();
+    if (clip.isValid()) painter->setClipRect(clip, Qt::IntersectClip);
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setBrush(Qt::NoBrush); painter->setPen(QPen(outline.value(QStringLiteral("color")).value<QColor>(), width));
+    painter->drawPath(contour); painter->restore();
+}
+
+static QList<QRectF> wikidictFigureLinkFragmentBoxes(const QTextLayout *layout, int first, int length)
+{
+    QList<QRectF> boxes;
+    auto *engine = layout->engine();
+    QTextLayout::FormatRange selection; selection.start = first; selection.length = length;
+    for (int index = 0; index < engine->lines.size(); ++index) {
+        const auto &line = engine->lines[index];
+        if (line.from >= first + length || line.from + line.length <= first) continue;
+        QTextLineItemIterator iterator(engine, index, QPointF(), &selection);
+        while (!iterator.atEnd()) {
+            iterator.next(); QFixed left, width;
+            if (!iterator.getSelectionBounds(&left, &width) || width < 0) continue;
+            const QRectF box(left.toReal(), line.y.toReal(), width.toReal(), line.height().toReal());
+            if (!boxes.isEmpty() && boxes.last().y() == box.y() && boxes.last().height() == box.height()
+                && boxes.last().right() == box.left()) boxes.last() = boxes.last().united(box);
+            else boxes.append(box);
+        }
+    }
+    return boxes;
+}
+
+static QRectF wikidictFigureLinkTraversal(const QTextBlock &block, const QTextLayout *layout, qreal scale)
+{
+    QRectF result;
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment(); const auto format = fragment.charFormat();
+        if (!wikidictFixedFigureLink(format) || format.boolProperty(WikidictFigureLinkAtomic)) continue;
+        const auto outline = format.property(WikidictFigureLinkOutline).toMap();
+        const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+        const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+        if (!qIsFinite(width) || width <= 0 || !qIsFinite(outset)) continue;
+        for (const auto &box : wikidictFigureLinkFragmentBoxes(layout, fragment.position() - block.position(), fragment.length())) {
+            const auto stroke = wikidictFigureLinkOutlineRect(box, width, outset);
+            if (stroke.isValid()) result |= stroke.adjusted(-width / 2, -width / 2, width / 2, width / 2);
+        }
+    }
+    return result;
+}
+
+void QTextDocumentLayoutPrivate::drawFigureCaptionLinkOutline(const QPointF &offset, QPainter *painter,
+        const QAbstractTextDocumentLayout::PaintContext &context, const QTextBlock &block) const
+{
+    const auto focused = document->property("wikidict.figure.linkFocusOwner");
+    if (!focused.isValid() || focused.toLongLong() < (qint64(1) << 32)) return;
+    auto *frame = document->frameAt(block.position());
+    const auto *layout = block.layout();
+    if (!layout || !currentFigureLinkRoot(frame)) return;
+    QList<QRectF> boxes;
+    QVariantMap outline;
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment(); const auto format = fragment.charFormat();
+        if (!format.isAnchor() || format.boolProperty(WikidictFigureLinkAtomic)
+            || format.property(WikidictFigureLinkOwner).toLongLong() != focused.toLongLong()
+            || !figureLinkPolicyMatches(frame, format, false)) continue;
+        outline = format.property(WikidictFigureLinkOutline).toMap();
+        // Reuse the native selection iterator's shaped bidi/run intervals.
+        boxes.append(wikidictFigureLinkFragmentBoxes(layout, fragment.position() - block.position(), fragment.length()));
+    }
+    wikidictDrawFigureLinkOutline(painter, boxes, outline, scaleToDevice(1), offset + layout->position(),
+        context.clip.isValid() ? (context.clip & clipRect) : clipRect);
+}
+
+qreal QTextDocumentLayoutPrivate::logicalHorizontalMinimum(QTextFrame *ancestor) const
+{
+    // Report authenticated table and plain-container traversal overflow. This
+    // is a signed scroll origin, not a translation of native source coordinates.
+    qreal minimum = 0;
+    if (!paragraphBoxError && plainContainersPresent) {
+        auto *owner = ancestor ? ancestor : document->rootFrame();
+        const auto *fd = data(owner);
+        if (!fd->sizeDirty && fd->wikidictTraversalBounds.isValid()) {
+            const qreal left = frameBoundingRectInternal(owner).left() + fd->wikidictTraversalBounds.left();
+            if (std::isfinite(left) && left > -qreal(QFIXED_MAX)) minimum = qMin(minimum, left);
+        }
+    }
+    if (!paragraphBoxError) for (const auto &flow : std::as_const(logicalFlows)) {
+        if (!flow->current()) continue;
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || !QTextLogicalFlowProjection::inlineTable(object.frame)
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow
+                || data(object.frame)->layoutDirty || data(object.frame)->sizeDirty) continue;
+            auto *table = qobject_cast<QTextTable *>(object.frame.data());
+            if (!table) continue;
+            if (ancestor) {
+                QTextFrame *parent = table;
+                while (parent && parent != ancestor) parent = parent->parentFrame();
+                if (!parent) continue;
+            }
+            bool locallyClipped = false;
+            for (auto *parent = table->parentFrame(); parent && parent != ancestor; parent = parent->parentFrame())
+                locallyClipped |= data(parent)->wikidictScrollport;
+            if (locallyClipped) continue;
+            const qreal left = tableBoundingRectInternal(table).left();
+            if (std::isfinite(left) && left > -qreal(QFIXED_MAX)) minimum = qMin(minimum, left);
+        }
+    }
+    return minimum;
+}
+
+void QTextDocumentLayoutPrivate::updateLogicalHorizontalMinimum()
+{
+    const int rounded = qFloor(logicalHorizontalMinimum());
+    auto *layout = q_func();
+    const QVariant old = layout->property("_wikidictLogicalHorizontalMinimum");
+    if (rounded == 0 && !old.isValid()) return;
+    if (old.metaType().id() == QMetaType::Int && old.toInt() == rounded) return;
+    // A changed signed origin matters even if the reported positive extent
+    // stayed identical. Reuse the normal deferred scrollbar notification.
+    sizeChangedTimer.start(0, layout);
+    layout->setProperty("_wikidictLogicalHorizontalMinimum", rounded);
+}
+
+bool QTextDocumentLayout::wikidictHasLogicalFlows() const
+{
+    Q_D(const QTextDocumentLayout);
+    return !d->logicalFlows.isEmpty();
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalBoundary(int position, bool paragraph) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (d->logicalFlows.isEmpty())
+        return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (d->paragraphBoxError)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError}};
+    const auto range = flow->sourceBoundary(position, paragraph);
+    if (range.start < 0)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 0},
+        {QStringLiteral("start"), range.start}, {QStringLiteral("end"), range.start + range.length},
+        {QStringLiteral("ownerFirst"), flow->firstPosition()}, {QStringLiteral("ownerLast"), flow->lastPosition()}};
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalPosition(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    // Mapped geometry can be queried synchronously while owners are being
+    // installed. A source cell exists before its layout vectors do; never
+    // expose partial geometry or recursively enter an active layout.
+    if (d->logicalFlowAt(position)) {
+        if (!d->docPrivate->canLayout() || d->insideDocumentChange
+            || data(document()->rootFrame())->currentLayoutStruct)
+            return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+        d->ensureLayoutFinished();
+    } else {
+        d->ensureLayoutedByPosition(position);
+    }
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) {
+        QVariantMap result{{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+        if (const auto owner = d->logicalFlowAt(position, true)) {
+            result.insert(QStringLiteral("first"), owner->firstPosition());
+            result.insert(QStringLiteral("last"), owner->lastPosition());
+        }
+        return result;
+    }
+    const int projected = flow->toProjected(position);
+    if (projected < 0)
+        return {};
+    QVariantMap result;
+    result.insert(QStringLiteral("handled"), true);
+    result.insert(QStringLiteral("error"), d->paragraphBoxError);
+    if (d->paragraphBoxError)
+        return result;
+    result.insert(QStringLiteral("position"), position);
+    result.insert(QStringLiteral("projected"), projected);
+    result.insert(QStringLiteral("resolvedDirection"), int(flow->direction()));
+    result.insert(QStringLiteral("first"), flow->firstPosition());
+    result.insert(QStringLiteral("last"), flow->lastPosition());
+    result.insert(QStringLiteral("logicalOwnerFirst"), flow->ownerFirstPosition());
+    result.insert(QStringLiteral("logicalOwnerLast"), flow->ownerLastPosition());
+    const auto geometryReady = [](QTextFrame *frame, int sourcePosition) {
+        for (; frame; frame = frame->parentFrame()) {
+            const auto *fd = data(frame);
+            if (fd->sizeDirty || fd->layoutDirty || fd->currentLayoutStruct) return false;
+            if (auto *table = qobject_cast<QTextTable *>(frame)) {
+                const auto cell = table->cellAt(sourcePosition);
+                if (!cell.isValid()) continue;
+                const auto *td = static_cast<const QTextTableData *>(fd);
+                const int row = cell.row(), column = cell.column();
+                const qint64 index = qint64(row) * td->widths.size() + column;
+                if (row < 0 || column < 0 || row >= td->rowPositions.size()
+                    || column >= td->columnPositions.size() || column >= td->widths.size()
+                    || index < 0 || index >= td->cellVerticalOffsets.size()) return false;
+            }
+        }
+        return true;
+    };
+    if (!geometryReady(document()->frameAt(position), position))
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    for (const auto &object : flow->objects()) {
+        if (object.projectedPosition != projected || !object.frame) continue;
+        if (!geometryReady(object.frame, object.frame->firstPosition()))
+            return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+        if (auto *table = qobject_cast<QTextTable *>(object.frame.data()))
+            result.insert(QStringLiteral("objectRect"), d->tableBoundingRectInternal(table));
+        break;
+    }
+    QPointF offset;
+    QTextFrame *parent = document()->frameAt(position);
+    while (parent) {
+        const QTextFrameData *fd = data(parent);
+        offset += fd->position.toPointF() - QPointF(fd->wikidictScrollOffset, 0);
+        if (auto *table = qobject_cast<QTextTable *>(parent)) {
+            const auto cell = table->cellAt(position);
+            if (cell.isValid())
+                offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+        }
+        parent = parent->parentFrame();
+    }
+    result.insert(QStringLiteral("cursorRect"), flow->cursorRect(position, d->cursorWidth).translated(offset));
+    result.insert(QStringLiteral("contentLeft"), flow->leftEdge() + offset.x());
+    result.insert(QStringLiteral("contentRight"), flow->rightEdge() + offset.x());
+    const QTextLine line = flow->textLayout()->lineForTextPosition(projected);
+    if (line.isValid()) {
+        const qreal leading = line.cursorToX(projected, QTextLine::Leading);
+        const qreal trailing = line.cursorToX(projected, QTextLine::Trailing);
+        const QPointF origin = flow->textLayout()->position() + offset;
+        qreal left = qMin(leading, trailing), right = qMax(leading, trailing);
+#ifndef QT_NO_RAWFONT
+        // A bidi insertion caret can belong to the neighboring isolate, and a
+        // ligature can span several source units. Use the same shaped selection
+        // intervals as painting; retain the established line top and height.
+        bool hasGlyph = false;
+        for (const QGlyphRun &run : line.glyphRuns(projected, 1)) {
+            const QRectF bounds = run.boundingRect();
+            if (!qIsFinite(bounds.left()) || !qIsFinite(bounds.right()))
+                return {};
+            left = hasGlyph ? qMin(left, bounds.left()) : bounds.left();
+            right = hasGlyph ? qMax(right, bounds.right()) : bounds.right();
+            hasGlyph = true;
+        }
+        // Pending wrap spaces, TabOrObject and structural/no-run positions
+        // retain their caret cell, including zero width. No extent is invented.
+#endif
+        result.insert(QStringLiteral("characterRect"), QRectF(origin.x() + left,
+            origin.y() + line.y(), right - left, line.height()));
+        result.insert(QStringLiteral("lineX"), leading);
+        result.insert(QStringLiteral("lineNumber"), line.lineNumber());
+        result.insert(QStringLiteral("lineCount"), flow->textLayout()->lineCount());
+        result.insert(QStringLiteral("lineTextLength"), line.textLength());
+        result.insert(QStringLiteral("lineTextStart"), line.textStart());
+        result.insert(QStringLiteral("lineWidth"), line.width());
+        result.insert(QStringLiteral("lineAdvance"), line.horizontalAdvance());
+        result.insert(QStringLiteral("lineIncludedTrailingSpaceWidth"), flow->includedTrailingSpaceWidth(line).toReal());
+        result.insert(QStringLiteral("lineNaturalWidth"), line.naturalTextWidth());
+        result.insert(QStringLiteral("lineNaturalLeft"), line.naturalTextRect().left() + origin.x());
+        result.insert(QStringLiteral("lineNaturalRight"), line.naturalTextRect().right() + origin.x());
+        result.insert(QStringLiteral("lineLeadingSpaceWidth"), flow->leadingSpaceWidth(line));
+        // Retain the native metrics independently of QVariant QRectF JSON
+        // conversion. These are observations, not alternate layout inputs.
+        result.insert(QStringLiteral("layoutY"), origin.y());
+        result.insert(QStringLiteral("lineY"), line.y());
+        result.insert(QStringLiteral("lineHeight"), line.height());
+        result.insert(QStringLiteral("lineAscent"), line.ascent());
+        result.insert(QStringLiteral("lineDescent"), line.descent());
+        result.insert(QStringLiteral("lineLeading"), line.leading());
+        const auto sourceFormat = document()->findBlock(flow->firstPosition()).blockFormat();
+        result.insert(QStringLiteral("blockLineHeightType"), sourceFormat.lineHeightType());
+        result.insert(QStringLiteral("blockLineHeightValue"), sourceFormat.lineHeight());
+        result.insert(QStringLiteral("leading"), leading + origin.x());
+        result.insert(QStringLiteral("trailing"), trailing + origin.x());
+    }
+    if (projected < flow->sourceMap().size()) {
+        const auto &unit = flow->sourceMap().at(projected);
+        result.insert(QStringLiteral("languagePresent"), unit.languagePresent);
+        if (unit.languagePresent)
+            result.insert(QStringLiteral("language"), unit.language);
+    }
+    return result;
+}
+
+int QTextDocumentLayoutPrivate::logicalLinePosition(
+        const std::shared_ptr<QTextLogicalFlowProjection> &flow, int index, bool down, qreal documentX) const
+{
+        if (index < 0 || index >= flow->textLayout()->lineCount()) {
+            // Nested owners at a real caption boundary return to the enclosing
+            // object's adjacent line, not the enclosing owner's far edge.
+            const auto parentIndex = logicalFlowParents.constFind(flow->firstPosition());
+            if (parentIndex != logicalFlowParents.cend()) {
+                const auto parentFlow = logicalFlowIndex.value(parentIndex.value());
+                if (parentFlow && parentFlow != flow && parentFlow->current()) {
+                    const QTextBlock boundary = document->findBlock(down ? flow->lastPosition() : flow->firstPosition());
+                    for (const auto &object : parentFlow->objects()) {
+                        if (!object.frame || flow->firstPosition() <= object.first || flow->lastPosition() >= object.last
+                            || object.frame->frameFormat().position() != QTextFrameFormat::InFlow) continue;
+                        const QTextBlock edge = down ? object.frame->lastCursorPosition().block()
+                                                     : object.frame->firstCursorPosition().block();
+                        if (boundary != edge) break;
+                        const QTextLine anchor = parentFlow->textLayout()->lineForTextPosition(object.projectedPosition);
+                        if (!anchor.isValid()) return -2;
+                        return logicalLinePosition(parentFlow, anchor.lineNumber() + (down ? 1 : -1), down, documentX);
+                    }
+                }
+            }
+            return down ? -4 : -3;
+        }
+        const QTextLine target = flow->textLayout()->lineAt(index);
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || object.projectedPosition < target.textStart()
+                || object.projectedPosition >= target.textStart() + target.textLength()
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow)
+                continue;
+            const QTextBlock edge = down ? object.frame->firstCursorPosition().block()
+                                         : object.frame->lastCursorPosition().block();
+            const int edgePosition = down ? edge.position() : edge.position() + edge.length() - 1;
+            const auto nested = logicalFlowAt(edgePosition);
+            if (nested && nested != flow)
+                return logicalLinePosition(nested, down ? 0 : nested->textLayout()->lineCount() - 1, down, documentX);
+            const QTextLayout *caption = edge.layout();
+            if (!caption || !caption->lineCount()) return -2;
+            const QTextLine captionLine = caption->lineAt(down ? 0 : caption->lineCount() - 1);
+            if (!captionLine.isValid()) return -2;
+            const qreal captionX = documentX - q_func()->blockBoundingRect(edge).left();
+            const auto captionOwner = logicalFlowAt(edgePosition, true);
+            if (captionOwner && captionOwner->inCaption(edgePosition))
+                return edge.position() + qt_textLineXToCursorWithOrigin(captionLine,
+                    caption->engine(), captionX, QTextLine::CursorBetweenCharacters, true, true);
+            return edge.position() + captionLine.xToCursor(captionX);
+        }
+        return flow->toDocument(target.xToCursor(documentX - q_func()->blockBoundingRect(document->findBlock(flow->firstPosition())).left()));
+}
+
+int QTextDocumentLayout::wikidictLogicalVerticalEntry(int position, bool fromAbove, qreal documentX) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return -2;
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return -1;
+    if (d->paragraphBoxError || !qIsFinite(documentX)) return -2;
+    return d->logicalLinePosition(flow, fromAbove ? 0 : flow->textLayout()->lineCount() - 1,
+                                  fromAbove, documentX);
+}
+
+int QTextDocumentLayout::wikidictLogicalMove(int position, int operation, qreal preferredX) const
+{
+    return wikidictLogicalMove(position, operation, preferredX, false);
+}
+
+int QTextDocumentLayout::wikidictLogicalMove(int position, int operation, qreal preferredX,
+                                            bool documentSpaceX) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return -2;
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position, true);
+    if (!flow)
+        return -1;
+    const bool vertical = operation == QTextCursor::Up || operation == QTextCursor::Down;
+    const bool down = operation == QTextCursor::Down;
+    if (vertical && documentSpaceX && !qIsFinite(preferredX))
+        return -2;
+    const auto documentColumn = [&](qreal origin, qreal caretX) {
+        if (documentSpaceX) return preferredX;
+        return origin + (qIsFinite(preferredX) && preferredX != -1 ? preferredX : caretX);
+    };
+    const QPointF ownerOrigin = blockBoundingRect(document()->findBlock(flow->firstPosition())).topLeft();
+    if (flow->inCaption(position)) {
+        if (!vertical) return -1;
+        // Interior caption/table movement remains native. Only the real frame's
+        // outer edge bridges back into its owning projected paragraph.
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || position <= object.first || position >= object.last
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow)
+                continue;
+            const QTextBlock current = document()->findBlock(position);
+            const QTextBlock edge = down ? object.frame->lastCursorPosition().block()
+                                         : object.frame->firstCursorPosition().block();
+            if (current != edge || !edge.layout()) return -1;
+            const QTextLine line = edge.layout()->lineForTextPosition(position - edge.position());
+            if (!line.isValid() || line.lineNumber() != (down ? edge.layout()->lineCount() - 1 : 0))
+                return -1;
+            const QTextLine anchor = flow->textLayout()->lineForTextPosition(object.projectedPosition);
+            if (!anchor.isValid()) return -2;
+            return d->logicalLinePosition(flow, anchor.lineNumber() + (down ? 1 : -1), down,
+                documentColumn(blockBoundingRect(edge).left(), line.cursorToX(position - edge.position())));
+        }
+        return -1;
+    }
+    if (operation == QTextCursor::StartOfBlock)
+        return flow->firstPosition();
+    if (operation == QTextCursor::EndOfBlock)
+        return flow->lastPosition();
+    if (operation == QTextCursor::Left || operation == QTextCursor::Right) {
+        if (document()->defaultCursorMoveStyle() == Qt::VisualMoveStyle)
+            return flow->visualMove(position, operation == QTextCursor::Right);
+        const bool forward = (operation == QTextCursor::Right) == (flow->direction() == Qt::LeftToRight);
+        return flow->logicalMove(position, forward);
+    }
+    const int projected = flow->toProjected(position);
+    const QTextLine line = flow->textLayout()->lineForTextPosition(projected);
+    if (!line.isValid())
+        return -1;
+    if (operation == QTextCursor::StartOfLine)
+        return flow->toDocument(line.textStart());
+    if (operation == QTextCursor::EndOfLine)
+        return flow->toDocument(line.textStart() + line.textLength());
+    if (operation == QTextCursor::Up || operation == QTextCursor::Down) {
+        return d->logicalLinePosition(flow, line.lineNumber() + (down ? 1 : -1), down,
+            documentColumn(ownerOrigin.x(), line.cursorToX(projected)));
+    }
+    return -1;
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalSelection(int first, int last) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(last);
+    const auto flow = d->logicalFlowAt(first, true);
+    if (!flow || last > flow->lastPosition() || last < first
+        || (flow->inCaption(first) && flow->inCaption(last)))
+        return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    const QTextBlock block = document()->findBlock(flow->firstPosition());
+    const QPointF origin = blockBoundingRect(block).topLeft();
+    QRectF bounds;
+    for (const auto &range : flow->selectionRanges(first, last)) {
+        for (int index = 0; index < flow->textLayout()->lineCount(); ++index) {
+            const QTextLine line = flow->textLayout()->lineAt(index);
+            if (range.start < line.textStart() + line.textLength()
+                && line.textStart() < range.start + range.length)
+                bounds |= line.naturalTextRect().translated(origin);
+        }
+    }
+    for (const auto &object : flow->objects())
+        if (object.frame && first < object.last && last > object.first)
+            bounds |= frameBoundingRect(object.frame);
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError},
+            {QStringLiteral("rect"), bounds.adjusted(-1, -1, 1, 1)}};
+}
+
+bool QTextDocumentLayoutPrivate::prepareLogicalFlow(const std::shared_ptr<QTextLogicalFlowProjection> &flow,
+                                                   QTextLayoutStruct *layoutStruct, int layoutFrom, int layoutTo)
+{
+    if (!flow->current() || flow->parentFrame() != layoutStruct->frame || !flow->refreshLayoutInputs()) {
+        refuseParagraphBox(5, flow->firstPosition());
+        return false;
+    }
+    layoutStruct->fullLayout = true;
+    layoutStruct->wikidictParagraphBoxes = true;
+    const QTextBlockFormat ownerFormat = document->findBlock(flow->firstPosition()).blockFormat();
+    const qreal leftMargin = ownerFormat.leftMargin();
+    const qreal rightMargin = ownerFormat.rightMargin();
+    if (!qIsFinite(leftMargin) || !qIsFinite(rightMargin)
+        || qAbs(leftMargin) >= QFIXED_MAX || qAbs(rightMargin) >= QFIXED_MAX) {
+        refuseParagraphBox(2, flow->firstPosition());
+        return false;
+    }
+    // A native list can compensate its indent with a negative block margin.
+    // Validate the effective edges used by layoutBlock, not the raw margin.
+    QFixed extraMargin;
+    if (docPrivate->defaultTextOption.flags() & QTextOption::AddSpaceForLineAndParagraphSeparators) {
+        QFontMetricsF fm(document->findBlock(flow->firstPosition()).charFormat().font());
+        const qreal separatorAdvance = fm.horizontalAdvance(u'\x21B5');
+        if (!qIsFinite(separatorAdvance) || separatorAdvance < 0 || separatorAdvance >= QFIXED_MAX) {
+            refuseParagraphBox(2, flow->firstPosition());
+            return false;
+        }
+        extraMargin = QFixed::fromReal(separatorAdvance);
+    }
+    qreal indentLevels = ownerFormat.indent();
+    if (const auto *object = document->objectForFormat(ownerFormat))
+        indentLevels += object->format().toListFormat().indent();
+    const qreal indentScale = paintDevice ? qreal(paintDevice->logicalDpiY()) / qreal(qt_defaultDpi()) : 1;
+    const qreal rawIndent = indentLevels * indentScale * document->indentWidth();
+    if (!qIsFinite(rawIndent) || qAbs(rawIndent) >= QFIXED_MAX) {
+        refuseParagraphBox(2, flow->firstPosition());
+        return false;
+    }
+    const QFixed indent = blockIndent(ownerFormat);
+    const bool rtl = flow->direction() == Qt::RightToLeft;
+    const qint64 effectiveLeft = qint64(QFixed::fromReal(leftMargin).value())
+        + (rtl ? extraMargin.value() : indent.value());
+    const qint64 effectiveRight = qint64(QFixed::fromReal(rightMargin).value())
+        + (rtl ? indent.value() : extraMargin.value());
+    const qint64 limit = qint64(QFIXED_MAX) * 64;
+    if (effectiveLeft < 0 || effectiveRight < 0 || effectiveLeft > limit || effectiveRight > limit
+        || effectiveLeft + effectiveRight > limit
+        || !layoutStruct->horizontalPositionInRange(qint64(layoutStruct->x_left.value()) + effectiveLeft)) {
+        refuseParagraphBox(2, flow->firstPosition());
+        return false;
+    }
+    const qint64 available = qint64(layoutStruct->x_right.value()) - layoutStruct->x_left.value()
+        - effectiveLeft - effectiveRight;
+    // QTextEdit uses a zero page width for root NoWrap text. Keep the stock
+    // signed content edges; text shaping derives its natural width. Objects and
+    // nested containing blocks still require a positive available width.
+    const bool rootNoWrap = docPrivate->defaultTextOption.wrapMode() == QTextOption::NoWrap
+        && document->pageSize().width() == 0
+        && layoutStruct->frame == document->rootFrame() && flow->objects().isEmpty();
+    if ((available <= 0 && !rootNoWrap) || available < -limit
+        || (available > 0 && !checkParagraphBoxExtent(available, flow->firstPosition()))) {
+        refuseParagraphBox(2, flow->firstPosition());
+        return false;
+    }
+    for (const auto &object : flow->objects()) {
+        QPointer<QTextFrame> frame = object.frame;
+        if (!frame || !flow->current()) {
+            refuseParagraphBox(5, flow->firstPosition());
+            return false;
+        }
+        QTextFrameData *fd = data(frame);
+        fd->wikidictFigureFlowWidth = QFixed::fromFixed(int(available)).toReal();
+        if (frame->frameFormat().hasProperty(WikidictTableBoxOwner)) {
+            auto *table = qobject_cast<QTextTable *>(frame.data());
+            const qreal containing = layoutStruct->x_right == QFIXED_MAX
+                ? qreal(QFIXED_MAX) : QFixed::fromFixed(int(available)).toReal();
+            if (table) static_cast<QTextTableData *>(fd)->wikidictContainingWidth = containing;
+            else if (isWikidictEmptyTable(frame->frameFormat()) && !isWikidictEmptyGrid(frame->frameFormat()))
+                fd->wikidictEmptyTableFlowWidth = containing;
+            else { refuseParagraphBox(1, object.first); return false; }
+        }
+        fd->sizeDirty = true;
+        layoutFrame(frame, layoutFrom, layoutTo, layoutStruct->frameY + layoutStruct->y);
+        if (!frame || !flow->current() || paragraphBoxError)
+            return false;
+        fd = data(frame);
+        qreal externalAscent = std::numeric_limits<qreal>::quiet_NaN();
+        if (QTextLogicalFlowProjection::inlineTable(frame)) {
+            auto *table = qobject_cast<QTextTable *>(frame.data());
+            if (!table) { refuseParagraphBox(1, object.first); return false; }
+            const auto format = table->format();
+            if (format.intProperty(WikidictTableVerticalAlign) == 2) {
+                // Its final external baseline is resolved by the native top
+                // line solver; zero is a finite projected-frame identity here.
+                externalAscent = 0;
+            } else if (format.intProperty(WikidictTableVerticalAlign) == 1) {
+                const QFontMetricsF font(flow->textLayout()->font(), document->documentLayout()->paintDevice());
+                externalAscent = (fd->size.height.toReal() + font.xHeight()) / 2;
+            } else externalAscent = measuredTableBaseline(table, format.intProperty(WikidictTableDisplay) == 2);
+            if (!std::isfinite(externalAscent) || qAbs(externalAscent) >= qreal(QFIXED_MAX)) {
+                refuseParagraphBox(2, object.first); return false;
+            }
+        }
+        if (!checkParagraphBoxExtent(fd->size.width.value(), object.first)
+            || !checkParagraphBoxExtent(fd->size.height.value(), object.first)
+            || !flow->setObjectSize(frame->objectIndex(), fd->size.toSizeF(), fd->minimumWidth.toReal(),
+                                   frame->frameFormat().position() != QTextFrameFormat::InFlow, externalAscent,
+                                   frame->frameFormat().intProperty(WikidictTableVerticalAlign) == 2)) {
+            refuseParagraphBox(2, object.first);
+            return false;
+        }
+    }
+    flow->finishObjectSizes();
+    return flow->current();
+}
+
+void QTextDocumentLayoutPrivate::drawLogicalFlow(const QPointF &offset, QPainter *painter,
+        const QAbstractTextDocumentLayout::PaintContext &context,
+        const std::shared_ptr<QTextLogicalFlowProjection> &flow) const
+{
+    if (!flow->current())
+        return;
+    QList<QTextLayout::FormatRange> ranges;
+    for (const auto &selection : context.selections) {
+        for (const auto &range : flow->selectionRanges(selection.cursor.selectionStart(), selection.cursor.selectionEnd())) {
+            QTextLayout::FormatRange item;
+            item.start = range.start;
+            item.length = range.length;
+            item.format = selection.format;
+            ranges.append(item);
+        }
+    }
+    const QPen oldPen = painter->pen();
+    painter->setPen(context.palette.color(QPalette::Text));
+    if (usesGlyphInkBounds()) {
+        painter->save();
+        if (context.clip.isValid()) painter->setClipRect(context.clip, Qt::IntersectClip);
+        flow->textLayout()->draw(painter, offset, ranges);
+        painter->restore();
+    } else flow->textLayout()->draw(painter, offset, ranges, context.clip);
+    const int cursor = flow->toProjected(context.cursorPosition);
+    if (cursor >= 0)
