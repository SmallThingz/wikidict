+QList<WikidictFloatExclusion> QTextDocumentLayoutPrivate::floatExclusions(
+    const QTextLayoutStruct *flow, int before, bool inherited) const
+{
+    QList<WikidictFloatExclusion> result;
+    const auto append = [&](const WikidictFloatExclusion &exclusion) {
+        if (!exclusion.owner || exclusion.owner->firstPosition() >= before) return;
+        for (const auto &existing : std::as_const(result))
+            if (existing.owner == exclusion.owner) return;
+        result.append(exclusion);
+    };
+    for (QTextFrame *owner : std::as_const(data(flow->frame)->floats)) {
+        if (!owner || data(owner)->layoutDirty) continue;
+        const auto *fd = data(owner);
+        append({owner, fd->position, fd->size, owner->frameFormat().position()});
+    }
+    if (inherited)
+        for (const auto &exclusion : flow->inheritedExclusions) append(exclusion);
+    for (const auto &exclusion : flow->exportedExclusions) append(exclusion);
+    return result;
+}
