+static bool wikidictTopInlineTableCell(const QTextEngine *engine)
+{
+    auto *document = QTextDocumentPrivate::get(engine->block);
+    auto *table = document ? qobject_cast<QTextTable *>(document->frameAt(engine->block.position())) : nullptr;
+    if (!table || !table->cellAt(engine->block.position()).isValid())
+        return false;
+    const auto format = table->format();
+    const auto owner = format.property(QTextFormat::UserProperty + 0x57d0);
+    const auto display = format.property(QTextFormat::UserProperty + 0x57d6);
+    const auto alignment = format.property(QTextFormat::UserProperty + 0x57d7);
+    return format.position() == QTextFrameFormat::InFlow
+        && owner.metaType().id() == QMetaType::QString && owner.toString() == QLatin1String("wikidict.table-box/1")
+        && display.metaType().id() == QMetaType::Int && (display.toInt() == 1 || display.toInt() == 2)
+        && alignment.metaType().id() == QMetaType::Int && alignment.toInt() == 2;
+}
+
+static bool wikidictCurrentFigureCaption(const QTextEngine *engine)
+{
+    if (!engine || !engine->block.isValid() || engine->projectedDocument)
+        return false;
+    const auto *blockLayout = engine->block.layout();
+    if (!blockLayout || blockLayout->engine() != engine)
+        return false;
+    const auto *document = QTextDocumentPrivate::get(engine->block);
+    const auto *layout = document ? qobject_cast<QTextDocumentLayout *>(document->layout()) : nullptr;
+    return layout && layout->wikidictIsCurrentFigureCaption(engine->block);
+}
