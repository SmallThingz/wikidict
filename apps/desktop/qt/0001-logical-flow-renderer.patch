+QVariantMap QTextDocumentLayoutPrivate::figureMediaGeometry(QTextFrame *frame) const
+{
+    if (!wikidictFigureMediaFrame(frame) || data(frame)->layoutDirty || data(frame)->sizeDirty) return {};
+    const auto fragment = wikidictFigureMediaObject(frame);
+    if (!fragment.isValid()) return {};
+    const auto policy = frame->frameFormat().property(WikidictFigureTableCaption).toMap();
+    const QRectF anchor = frameBoundingRectInternal(frame);
+    QRectF image;
+    const auto block = document->findBlock(fragment.position());
+    const auto *layout = block.layout();
+    const int local = fragment.position() - block.position();
+    const auto line = layout->lineForTextPosition(local);
+    if (line.isValid()) {
+        const auto *engine = layout->engine();
+        const int itemIndex = engine->findItem(local);
+        if (itemIndex >= 0 && itemIndex < engine->layoutData->items.size()) {
+            const auto &item = engine->layoutData->items[itemIndex];
+            const qreal first = line.cursorToX(local), last = line.cursorToX(local + 1);
+            const auto box = policy.value(QStringLiteral("box")).toList();
+            const QPointF origin = anchor.topLeft() + layout->position();
+            const QRectF object(origin.x() + qMin(first, last), origin.y() + line.y() + line.ascent() - item.ascent.toReal(),
+                qAbs(last - first), item.height().toReal());
+            image = object.adjusted(scaleToDevice(box[3].toDouble()), scaleToDevice(box[0].toDouble()),
+                -scaleToDevice(box[1].toDouble()), -scaleToDevice(box[2].toDouble()));
+        }
+    }
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("position"), fragment.position()},
+        {QStringLiteral("revision"), document->revision()}, {QStringLiteral("owner"), frame->objectIndex()},
+        {QStringLiteral("anchor"), anchor}, {QStringLiteral("image"), image},
+        {QStringLiteral("after"), wikidictFigureAfterRect(policy, anchor, scaleToDevice(1))},
+        {QStringLiteral("focus"), wikidictFigureFocusRect(policy, anchor, scaleToDevice(1))},
+        {QStringLiteral("clip"), scrollClip(frame->parentFrame())}};
+}
+QVariantMap QTextDocumentLayout::wikidictFigureMediaGeometry(int objectPosition) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->docPrivate->canLayout() || objectPosition < 0 || objectPosition >= document()->characterCount() - 1) return {};
+    d->ensureLayoutedByPosition(objectPosition);
+    if (d->paragraphBoxError) return {};
+    auto *frame = document()->frameAt(objectPosition);
+    const auto fragment = wikidictFigureMediaObject(frame);
+    if (!fragment.isValid() || fragment.position() != objectPosition) return {};
+    return d->figureMediaGeometry(frame);
+}
