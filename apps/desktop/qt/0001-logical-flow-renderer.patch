+// QTextLayout's public bounds are advance/line boxes. Preserve actual glyph
+// bearings and the baseline offsets applied by QTextLine::draw_internal too.
+// This reads the existing shaping result; it does not create another document.
+static QRectF wikidictTextTraversal(const QTextLayout *layout, const QPointF *hit = nullptr,
+                                   int *character = nullptr, int onlyLine = -1)
+{
+    QRectF bounds = layout->boundingRect();
+#ifndef QT_NO_RAWFONT
+    QTextEngine *engine = layout->engine();
+    for (int lineIndex = 0; lineIndex < layout->lineCount(); ++lineIndex) {
+        if (onlyLine >= 0 && lineIndex != onlyLine) continue;
+        const QTextLine line = layout->lineAt(lineIndex);
+        bounds |= line.naturalTextRect();
+        const auto runs = line.glyphRuns(-1, -1, QTextLayout::RetrieveGlyphIndexes
+            | QTextLayout::RetrieveGlyphPositions | QTextLayout::RetrieveStringIndexes);
+        for (const auto &run : runs) {
+            const auto glyphs = run.glyphIndexes(); const auto positions = run.positions();
+            const auto indexes = run.stringIndexes(); const QRawFont font = run.rawFont();
+            if (!font.isValid()) continue;
+            for (qsizetype i = 0; i < qMin(glyphs.size(), qMin(positions.size(), indexes.size())); ++i) {
+                const int source = int(indexes[i]);
+                const int itemIndex = engine->findItem(source);
+                if (itemIndex < 0 || itemIndex >= engine->layoutData->items.size()) continue;
+                const auto &item = engine->layoutData->items[itemIndex];
+                QTextCharFormat format;
+                if (const auto *collection = engine->formatCollection()) format = collection->defaultTextFormat();
+                format.merge(engine->format(&item));
+                QFixed shift;
+                const auto vertical = format.verticalAlignment();
+                const qreal offset = format.baselineOffset() / 100.0;
+                if (vertical == QTextCharFormat::AlignSuperScript || vertical == QTextCharFormat::AlignSubScript
+                    || !qFuzzyIsNull(offset)) {
+                    const auto *fontEngine = engine->fontEngine(item);
+                    const QFixed height = fontEngine->ascent() + fontEngine->descent();
+                    shift -= height * QFixed::fromReal(offset);
+                    if (vertical == QTextCharFormat::AlignSubScript)
+                        shift += height * QFixed::fromReal(format.subScriptBaseline() / 100.0);
+                    else if (vertical == QTextCharFormat::AlignSuperScript)
+                        shift -= height * QFixed::fromReal(format.superScriptBaseline() / 100.0);
+                }
+                QRectF glyph = font.boundingRect(glyphs[i]).translated(positions[i] + QPointF(0, shift.toReal()));
+                const QPen outline = format.textOutline();
+                if (outline.style() != Qt::NoPen) {
+                    const qreal radius = (outline.widthF() > 0 ? outline.widthF() : 1) / 2;
+                    glyph.adjust(-radius, -radius, radius, radius);
+                }
+                bounds |= glyph;
+                if (hit && character && glyph.contains(*hit)) *character = source;
+                if (run.underline() || run.overline() || run.strikeOut()) {
+                    // Decorations use font metrics at the shifted baseline.
+                    // Their advance is already present in the native line box.
+                    const qreal baseline = positions[i].y() + shift.toReal();
+                    const qreal pen = qMax(qreal(1), font.lineThickness());
+                    bounds |= QRectF(line.naturalTextRect().left(), baseline - font.ascent() - pen,
+                        line.naturalTextRect().width(), font.ascent() + font.descent() + 2 * pen);
+                }
+            }
+        }
+    }
+#endif
+    return bounds;
+}
