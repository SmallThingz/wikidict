+bool QTextDocumentLayoutPrivate::validateEmptyTableBox(QTextFrame *frame, qreal availableWidth)
+{
+    const auto format = frame->frameFormat();
+    const auto fail = [&](int error) { refuseParagraphBox(error, frame->firstPosition()); return false; };
+    if (qobject_cast<QTextTable *>(frame) || !frame->parentFrame()
+        || format.property(WikidictTableBoxOwner).metaType().id() != QMetaType::QString
+        || format.property(WikidictEmptyTableRole).metaType().id() != QMetaType::QString)
+        return fail(1);
+    const QString role = format.stringProperty(WikidictEmptyTableRole);
+    if (role != QStringLiteral("wrapper") && role != QStringLiteral("grid")) return fail(1);
+    if (!std::isfinite(availableWidth) || availableWidth < 0 || availableWidth > qreal(QFIXED_MAX)) return fail(2);
+    const auto finite = [&](qreal value) {
+        const qreal scaled = scaleToDevice(value);
+        return std::isfinite(value) && value >= 0 && std::isfinite(scaled)
+            && scaled >= 0 && scaled < qreal(QFIXED_MAX);
+    };
+    for (qreal value : {format.topMargin(), format.rightMargin(), format.bottomMargin(),
+                       format.leftMargin(), format.border(), format.padding()})
+        if (!finite(value)) return fail(2);
+    if (format.position() != QTextFrameFormat::InFlow && format.position() != QTextFrameFormat::FloatLeft
+        && format.position() != QTextFrameFormat::FloatRight) return fail(1);
+    if (role == QStringLiteral("grid")) {
+        const auto parent = frame->parentFrame()->frameFormat();
+        const QTextBlock block = document->findBlock(frame->firstPosition());
+        if (!isWikidictEmptyTable(parent) || parent.stringProperty(WikidictEmptyTableRole) != QStringLiteral("wrapper")
+            || frame->firstPosition() != frame->lastPosition() || !frame->childFrames().isEmpty()
+            || !block.isValid() || block.length() != 1
+            || block.blockFormat().property(WikidictEmptyTableBoundary).metaType().id() != QMetaType::Bool
+            || !block.blockFormat().boolProperty(WikidictEmptyTableBoundary)
+            || wikidictParagraphBox(block.blockFormat()).owned
+            || format.position() != QTextFrameFormat::InFlow
+            || format.topMargin() != 0 || format.rightMargin() != 0 || format.bottomMargin() != 0
+            || format.leftMargin() != 0 || format.padding() != 0
+            || format.hasProperty(WikidictTableBoxWidth) || format.hasProperty(WikidictTableBoxClear)
+            || format.width().type() != QTextLength::PercentageLength || format.width().rawValue() != 100)
+            return fail(1);
+        const QVariant collapse = format.property(QTextFormat::TableBorderCollapse);
+        const QVariant padding = format.property(WikidictTableBoxPadding);
+        const bool authoredPadding = format.hasProperty(WikidictTableBoxPadding);
+        if (collapse.metaType().id() != QMetaType::Bool || (authoredPadding
+            && (padding.metaType().id() != QMetaType::QVariantList || padding.toList().size() != 4))) return fail(1);
+        const auto edges = authoredPadding ? padding.toList() : QVariantList{0.0, 0.0, 0.0, 0.0};
+        qint64 used[4];
+        for (int i = 0; i < 4; ++i) {
+            if (edges[i].metaType().id() != QMetaType::Double || !std::isfinite(edges[i].toDouble())
+                || edges[i].toDouble() < 0) return fail(1);
+            const qreal value = collapse.toBool() ? 0 : edges[i].toDouble();
+            if (!finite(value)) return fail(2);
+            used[i] = QFixed::fromReal(scaleToDevice(value)).value();
+        }
+        const qint64 border = QFixed::fromReal(scaleToDevice(format.border())).round().value();
+        const qint64 horizontal = 2 * border + used[1] + used[3];
+        const qint64 vertical = 2 * border + used[0] + used[2];
+        if (!checkParagraphBoxExtent(horizontal, frame->firstPosition())
+            || !checkParagraphBoxExtent(vertical, frame->firstPosition())) return false;
+        data(frame)->wikidictEmptyGridWidth = QFixed::fromFixed(int(horizontal));
+        data(frame)->wikidictEmptyGridHeight = QFixed::fromFixed(int(vertical));
+        return true;
+    }
+    // Captions are siblings of the grid inside this wrapper, never cells and
+    // never painted inside the grid's background, border or padding.
+    const auto children = frame->childFrames();
+    int grids = 0;
+    for (QTextFrame *child : children)
+        if (isWikidictEmptyGrid(child->frameFormat())) {
+            ++grids;
+            if (child != children.constLast()) return fail(1);
+            if (!validateEmptyTableBox(child, availableWidth)) return false;
+        }
+    bool afterGrid = false;
+    for (auto it = frame->begin(); !it.atEnd(); ++it) {
+        if (it.currentFrame()) afterGrid |= isWikidictEmptyGrid(it.currentFrame()->frameFormat());
+        else if (afterGrid) {
+            const auto block = it.currentBlock();
+            const auto boundary = block.blockFormat().property(WikidictEmptyTableBoundary);
+            if (!block.isValid() || block.length() != 1 || boundary.metaType().id() != QMetaType::Bool
+                || !boundary.toBool()) return fail(1);
+        }
+    }
+    const QVariant clear = format.property(WikidictTableBoxClear);
+    if (grids != 1 || format.border() != 0 || format.padding() != 0
+        || format.background().style() != Qt::NoBrush || format.hasProperty(WikidictTableBoxPadding)
+        || clear.metaType().id() != QMetaType::Int || clear.toInt() < 0 || clear.toInt() > 3)
+        return fail(1);
+    if (format.hasProperty(WikidictTableBoxWidth)) {
+        const QVariant width = format.property(WikidictTableBoxWidth);
+        const auto spec = width.toMap();
+        const auto unit = spec.value(QStringLiteral("unit"));
+        const auto number = spec.value(QStringLiteral("value"));
+        if (width.metaType().id() != QMetaType::QVariantMap || spec.size() != 2
+            || unit.metaType().id() != QMetaType::QString
+            || (unit.toString() != QStringLiteral("fixed") && unit.toString() != QStringLiteral("percent"))
+            || number.metaType().id() != QMetaType::Double || !std::isfinite(number.toDouble()) || number.toDouble() < 0)
+            return fail(1);
+    } else if (!std::isfinite(format.width().rawValue()) || format.width().rawValue() < 0) {
+        return fail(2);
+    }
+    return true;
+}
+
+QRectF QTextDocumentLayoutPrivate::layoutEmptyTableBox(QTextFrame *frame, int layoutFrom, int layoutTo,
+                                                       QFixed width, QFixed parentY)
+{
+    auto *fd = data(frame);
+    const auto format = frame->frameFormat();
+    if (isWikidictEmptyGrid(format)) {
+        fd->topMargin = fd->rightMargin = fd->bottomMargin = fd->leftMargin = fd->padding = QFixed();
+        fd->border = QFixed::fromReal(scaleToDevice(format.border())).round();
+        fd->minimumWidth = fd->maximumWidth = fd->wikidictEmptyGridWidth;
+        fd->size = QFixedSize(qMax(width, fd->minimumWidth), fd->wikidictEmptyGridHeight);
+        fd->contentsWidth = fd->size.width - 2 * fd->border;
+        fd->contentsHeight = fd->size.height - 2 * fd->border;
+        fd->oldContentsWidth = fd->contentsWidth;
+        const auto *parent = data(frame->parentFrame());
+        const qint64 top = qint64(parent->effectiveTopMargin.value()) + fd->border.value();
+        const qint64 bottom = qint64(parent->effectiveBottomMargin.value()) + fd->border.value();
+        if (!checkParagraphBoxExtent(top, frame->firstPosition())
+            || !checkParagraphBoxExtent(bottom, frame->firstPosition())) return QRectF();
+        fd->effectiveTopMargin = QFixed::fromFixed(int(top));
+        fd->effectiveBottomMargin = QFixed::fromFixed(int(bottom));
+        QTextBlock block = document->findBlock(frame->firstPosition());
+        block.layout()->clearLayout();
+        block.layout()->setPosition(QPointF(fd->border.toReal(), fd->border.toReal()));
+        block.setLineCount(0);
+        fd->sizeDirty = false;
+        return QRectF(QPointF(), fd->size.toSizeF());
+    }
+    const qreal available = fd->wikidictEmptyTableFlowWidth < 0 ? width.toReal() : fd->wikidictEmptyTableFlowWidth;
+    const qint64 margins = qint64(QFixed::fromReal(scaleToDevice(format.leftMargin())).round().value())
+        + QFixed::fromReal(scaleToDevice(format.rightMargin())).round().value();
+    if (!checkParagraphBoxExtent(margins, frame->firstPosition())) return QRectF();
+    const auto *grid = data(frame->childFrames().constLast());
+    QFixed requested;
+    bool hasWidth = false;
+    QString unit;
+    qreal amount = 0;
+    if (format.hasProperty(WikidictTableBoxWidth)) {
+        const auto spec = format.property(WikidictTableBoxWidth).toMap();
+        unit = spec.value(QStringLiteral("unit")).toString();
+        amount = spec.value(QStringLiteral("value")).toDouble();
+        hasWidth = true;
+    } else if (format.width().type() != QTextLength::VariableLength) {
+        unit = format.width().type() == QTextLength::FixedLength ? QStringLiteral("fixed") : QStringLiteral("percent");
+        amount = format.width().rawValue();
+        hasWidth = true;
+    }
+    // A percent is intrinsic-auto until the containing cell has a real width.
+    if (hasWidth && unit == QStringLiteral("percent") && available == qreal(QFIXED_MAX)) hasWidth = false;
+    if (hasWidth) {
+        const qreal resolved = unit == QStringLiteral("fixed") ? scaleToDevice(amount) : available * amount / 100;
+        if (!std::isfinite(resolved) || resolved < 0 || resolved >= qreal(QFIXED_MAX)) {
+            refuseParagraphBox(2, frame->firstPosition()); return QRectF();
+        }
+        requested = QFixed::fromReal(resolved);
+    }
+    const QFixed edgeMinimum = grid->wikidictEmptyGridWidth;
+    const QFixed availableBox = qMax(QFixed(), QFixed::fromReal(available) - QFixed::fromFixed(int(margins)));
+    const QFixed initialBox = qMax(edgeMinimum, hasWidth ? requested : availableBox);
+    if (!checkParagraphBoxExtent(qint64(initialBox.value()) + margins, frame->firstPosition())) return QRectF();
+    fd->wikidictEmptyTableMeasuring = true;
+    const auto restore = qScopeGuard([&] { fd->wikidictEmptyTableMeasuring = false; });
+    const auto dirty = [&](auto &&self, QTextFrame *parent) -> void {
+        for (QTextFrame *child : parent->childFrames()) {
+            data(child)->sizeDirty = true;
+            self(self, child);
+        }
+    };
+    dirty(dirty, frame);
+    QRectF changed = layoutFrame(frame, layoutFrom, layoutTo,
+        QFixed::fromFixed(int(qint64(initialBox.value()) + margins)), -1, parentY);
+    if (paragraphBoxError) return QRectF();
+    const QFixed minimum = qMax(edgeMinimum, fd->minimumWidth);
+    const QFixed preferred = qMax(minimum, fd->maximumWidth);
+    const QFixed used = qMax(minimum, hasWidth ? requested : qMin(availableBox, preferred));
+    if (!checkParagraphBoxExtent(qint64(used.value()) + margins, frame->firstPosition())) return QRectF();
+    if (used != initialBox) {
+        dirty(dirty, frame);
+        fd->sizeDirty = true;
+        changed |= layoutFrame(frame, layoutFrom, layoutTo,
+            QFixed::fromFixed(int(qint64(used.value()) + margins)), -1, parentY);
+        if (paragraphBoxError) return QRectF();
+    }
+    const QFixed intrinsic = qMax(minimum, hasWidth && unit == QStringLiteral("fixed") ? requested : QFixed());
+    if (!checkParagraphBoxExtent(qint64(intrinsic.value()) + margins, frame->firstPosition())) return QRectF();
+    fd->minimumWidth = QFixed::fromFixed(int(qint64(intrinsic.value()) + margins));
+    if (preferred == QFIXED_MAX) fd->maximumWidth = QFIXED_MAX;
+    else {
+        if (!checkParagraphBoxExtent(qint64(preferred.value()) + margins, frame->firstPosition())) return QRectF();
+        fd->maximumWidth = qMax(fd->minimumWidth, QFixed::fromFixed(int(qint64(preferred.value()) + margins)));
+    }
+    return changed;
+}
+
+bool QTextDocumentLayoutPrivate::validateTableBox(QTextFrame *frame, qreal availableWidth)
+{
+    const QTextFrameFormat format = frame->frameFormat();
+    if (isWikidictEmptyTable(format)) return validateEmptyTableBox(frame, availableWidth);
+    if (!format.hasProperty(WikidictTableBoxOwner)) {
+        if (auto *table = qobject_cast<QTextTable *>(frame)) {
+            auto *td = static_cast<QTextTableData *>(data(table));
+            td->wikidictEdges = td->wikidictWidth = td->wikidictGrowWidth = false;
+        }
+        return true;
+    }
+    const auto fail = [&](int error) {
+        refuseParagraphBox(error, frame->firstPosition());
+        return false;
+    };
+    auto *table = qobject_cast<QTextTable *>(frame);
+    if (!table || format.property(WikidictTableBoxOwner).metaType().id() != QMetaType::QString
+        || format.stringProperty(WikidictTableBoxOwner) != QStringLiteral("wikidict.table-box/1")
+        || (!format.hasProperty(WikidictTableBoxPadding) && !format.hasProperty(WikidictTableBoxClear)
+            && !format.hasProperty(WikidictTableBoxWidth) && !format.hasProperty(WikidictTableDisplay)
+            && !format.hasProperty(WikidictTableVerticalAlign) && !format.hasProperty(WikidictTableLineHeight))) return fail(1);
+    for (const int property : {WikidictTableDisplay, WikidictTableVerticalAlign}) {
+        if (!format.hasProperty(property)) continue;
+        const auto value = format.property(property);
+        const int maximum = property == WikidictTableDisplay ? 2 : 1;
+        if (value.metaType().id() != QMetaType::Int || value.toInt() < 0 || value.toInt() > maximum) return fail(1);
+    }
+    if (format.hasProperty(WikidictTableLineHeight)) {
+        const auto value = format.property(WikidictTableLineHeight);
+        if (value.metaType().id() != QMetaType::Double || !std::isfinite(value.toDouble())
+            || value.toDouble() <= 0 || value.toDouble() >= qreal(QFIXED_MAX)) return fail(1);
+    }
+    if (QTextLogicalFlowProjection::inlineTable(frame)) {
+        if (format.position() != QTextFrameFormat::InFlow) return fail(1);
+        bool registered = false;
+        for (const auto &flow : std::as_const(logicalFlows)) for (const auto &object : flow->objects())
+            if (object.frame == frame) registered = true;
+        if (!registered) return fail(1);
+    }
+    auto *td = static_cast<QTextTableData *>(data(table));
+    if (td->wikidictContainingWidth >= 0) availableWidth = td->wikidictContainingWidth;
+    if (!std::isfinite(availableWidth) || availableWidth < 0 || availableWidth > qreal(QFIXED_MAX)) return fail(2);
+    const auto representable = [](qreal value) {
+        return std::isfinite(value) && value >= 0 && value < qreal(QFIXED_MAX);
+    };
+    const auto finiteDouble = [&](const QVariant &value) {
+        return value.metaType().id() == QMetaType::Double
+            && std::isfinite(value.toDouble()) && value.toDouble() >= 0;
+    };
+    td->wikidictEdges = format.hasProperty(WikidictTableBoxPadding);
+    td->wikidictWidth = format.hasProperty(WikidictTableBoxWidth);
+    td->wikidictGrowWidth = td->wikidictWidth;
+    if (format.hasProperty(WikidictTableBoxClear)) {
+        const QVariant clear = format.property(WikidictTableBoxClear);
+        if (clear.metaType().id() != QMetaType::Int || clear.toInt() < 0 || clear.toInt() > 3) return fail(1);
+    }
+    if (td->wikidictEdges) {
+        const QVariant value = format.property(WikidictTableBoxPadding);
+        if (value.metaType().id() != QMetaType::QVariantList) return fail(1);
+        const QVariantList edges = value.toList();
+        if (edges.size() != 4) return fail(1);
+        for (int edge = 0; edge < 4; ++edge) {
+            if (!finiteDouble(edges[edge])) return fail(1);
+            // Collapsed borders have no used table padding. Retain authored
+            // values in the format, including otherwise huge finite values.
+            const qreal used = table->format().borderCollapse() ? 0 : scaleToDevice(edges[edge].toDouble());
+            if (!representable(used)) return fail(2);
+            td->wikidictPadding[edge] = QFixed::fromReal(used);
+        }
+    }
+    // Validate the ordinary metrics before any conversion/addition below.
+    qreal horizontal = 0, vertical = 0;
+    for (qreal value : {format.topMargin(), format.bottomMargin(), format.leftMargin(),
+                       format.rightMargin(), format.border(), format.padding(), table->format().cellPadding(),
+                       table->format().cellSpacing()}) {
+        if (!representable(scaleToDevice(value))) return fail(2);
+    }
+    for (int row = 0; row < table->rows(); ++row) {
+        for (int column = 0; column < table->columns(); ++column) {
+            const auto cell = table->cellAt(row, column);
+            if (cell.row() != row || cell.column() != column) continue;
+            const auto cellFormat = cell.format();
+            for (auto property : {QTextFormat::TableCellTopPadding, QTextFormat::TableCellBottomPadding,
+                    QTextFormat::TableCellLeftPadding, QTextFormat::TableCellRightPadding,
+                    QTextFormat::TableCellTopBorder, QTextFormat::TableCellBottomBorder,
+                    QTextFormat::TableCellLeftBorder, QTextFormat::TableCellRightBorder}) {
+                if (cellFormat.hasProperty(property)
+                    && !representable(scaleToDevice(cellFormat.doubleProperty(property)))) return fail(2);
+            }
+        }
+    }
+    horizontal = scaleToDevice(format.leftMargin()) + scaleToDevice(format.rightMargin())
+        + 2 * scaleToDevice(format.border()) + (td->wikidictEdges
+            ? td->wikidictPadding[1].toReal() + td->wikidictPadding[3].toReal()
+            : 3 * scaleToDevice(format.padding()));
+    vertical = scaleToDevice(format.topMargin()) + scaleToDevice(format.bottomMargin())
+        + 2 * scaleToDevice(format.border()) + (td->wikidictEdges
+            ? td->wikidictPadding[0].toReal() + td->wikidictPadding[2].toReal()
+            : 3 * scaleToDevice(format.padding()));
+    if (!representable(horizontal) || !representable(vertical)) return fail(2);
+    if (td->wikidictWidth) {
+        const QVariant value = format.property(WikidictTableBoxWidth);
+        if (value.metaType().id() != QMetaType::QVariantMap) return fail(1);
+        const QVariantMap width = value.toMap();
+        if (width.size() != 2 || width.value(QStringLiteral("unit")).metaType().id() != QMetaType::QString
+            || !finiteDouble(width.value(QStringLiteral("value")))) return fail(1);
+        const QString unit = width.value(QStringLiteral("unit")).toString();
+        const double number = width.value(QStringLiteral("value")).toDouble();
+        if (unit != QStringLiteral("fixed") && unit != QStringLiteral("percent")) return fail(1);
+        // A percentage has no resolved containing size during intrinsic cell
+        // measurement. Measure its contents, then resolve in the actual cell.
+        const bool intrinsicPercent = unit == QStringLiteral("percent") && availableWidth == qreal(QFIXED_MAX);
+        td->wikidictGrowWidth = !intrinsicPercent;
+        const qreal requested = intrinsicPercent ? availableWidth
+            : unit == QStringLiteral("fixed") ? scaleToDevice(number) : availableWidth * (number / 100.0);
+        if (!intrinsicPercent && (!representable(requested)
+            || !representable(requested + scaleToDevice(format.leftMargin()) + scaleToDevice(format.rightMargin())))) return fail(2);
+        td->wikidictRequestedWidth = requested;
+    } else {
+        const qreal legacyWidth = format.width().type() == QTextLength::FixedLength
+            ? scaleToDevice(format.width().rawValue()) : format.width().value(availableWidth);
+        if (legacyWidth != qreal(QFIXED_MAX) && !representable(legacyWidth)) return fail(2);
+    }
+    if (format.height().type() == QTextLength::FixedLength && !representable(format.height().rawValue())) return fail(2);
+    return true;
+}
