+
+class QTextLogicalFlowProjection
+{
+public:
+    enum class Kind { Text, Frame, Control };
+    struct Unit {
+        Kind kind = Kind::Text;
+        int first = -1;
+        int last = -1;
+        int frameIndex = -1;
+        QString language;
+        bool languagePresent = false;
+    };
+    struct Object {
+        QPointer<QTextFrame> frame;
+        int projectedPosition = -1;
+        int first = -1;
+        int last = -1;
+    };
+    struct Range { int start = 0; int length = 0; };
+    struct Interval {
+        int first = -1;
+        int last = -1;
+        Kind kind = Kind::Text;
+    };
+
+    static std::unique_ptr<QTextLogicalFlowProjection> create(
+            QTextDocument *document, const QVariantMap &description, QString *error)
+    {
+        auto result = std::unique_ptr<QTextLogicalFlowProjection>(new QTextLogicalFlowProjection(document));
+        if (!result->initialize(description, error))
+            return {};
+        return result;
+    }
+
+    // Authored paragraph separators are real layout boundaries. A registration
+    // owner may span them, but each paragraph keeps its original block format
+    // and its own native layout; frame-created storage joins remain intra-line.
+    static bool createGroup(QTextDocument *document, const QVariantMap &description,
+                            QList<std::shared_ptr<QTextLogicalFlowProjection>> *result, QString *error)
+    {
+        int first = -1, last = -1;
+        if (!document || !integer(description.value(QStringLiteral("first")), &first)
+            || !integer(description.value(QStringLiteral("last")), &last)
+            || first < 0 || last < first || last >= document->characterCount())
+            return refuse(error, "invalid logical paragraph-group bounds");
+        QList<QVariantList> paragraphs;
+        QList<int> boundaries;
+        if (!splitParagraphs(description.value(QStringLiteral("parts")), &paragraphs, &boundaries, 0, error))
+            return false;
+        int previousBoundary = first - 1;
+        for (int boundary : std::as_const(boundaries)) {
+            if (boundary <= previousBoundary || boundary < first || boundary >= last
+                || document->characterAt(boundary) != QChar::ParagraphSeparator)
+                return refuse(error, "invalid authored paragraph order");
+            previousBoundary = boundary;
+        }
+        const QVariant joinsValue = description.value(QStringLiteral("joins"));
+        if (joinsValue.metaType().id() != QMetaType::QVariantList)
+            return refuse(error, "joins must be an explicit list");
+        QList<int> joins;
+        for (const QVariant &value : joinsValue.toList()) {
+            int position = -1;
+            if (!integer(value, &position) || position < first || position >= last
+                || std::binary_search(boundaries.cbegin(), boundaries.cend(), position))
+                return refuse(error, "authored paragraph boundary cannot be a storage join");
+            joins.append(position);
+        }
+        std::sort(joins.begin(), joins.end());
+        int joinIndex = 0;
+        // Registration validates structure without requesting cursor geometry.
+        const QPointer<QTextFrame> parent = QTextDocumentPrivate::get(document)->frameAt(first);
+        const auto *table = qobject_cast<QTextTable *>(parent.data());
+        const QTextTableCell cell = table ? table->cellAt(first) : QTextTableCell();
+        QList<std::shared_ptr<QTextLogicalFlowProjection>> replacement;
+        int start = first;
+        for (int index = 0; index < paragraphs.size(); ++index) {
+            const int end = index < boundaries.size() ? boundaries.at(index) : last;
+            if (end < start || end > last || (index < boundaries.size()
+                && (end == last || document->characterAt(end) != QChar::ParagraphSeparator)))
+                return refuse(error, "invalid authored paragraph separator");
+            QVariantList segmentJoins;
+            while (joinIndex < joins.size() && joins.at(joinIndex) < end) {
+                if (joins.at(joinIndex) < start) return refuse(error, "join outside its paragraph");
+                segmentJoins.append(joins.at(joinIndex++));
+            }
+            QVariantMap segment = description;
+            segment.insert(QStringLiteral("first"), start);
+            segment.insert(QStringLiteral("last"), end);
+            segment.insert(QStringLiteral("parts"), paragraphs.at(index));
+            segment.insert(QStringLiteral("joins"), segmentJoins);
+            auto projection = create(document, segment, error);
+            if (!projection || projection->parentFrame() != parent
+                || (cell.isValid() && table->cellAt(start) != cell))
+                return refuse(error, "authored paragraphs cross their original flow container");
+            projection->groupFirst = first;
+            projection->groupLast = last;
+            replacement.append(std::shared_ptr<QTextLogicalFlowProjection>(std::move(projection)));
+            start = end + 1;
+        }
+        result->append(replacement);
+        return true;
+    }
+
+    bool current() const
+    {
+        return document && document->revision() == revision
+            && document->characterCount() == originalCharacterCount;
+    }
+    bool refreshLayoutInputs()
+    {
+        if (!current()) return false;
+        const QPaintDevice *device = document->documentLayout()->paintDevice();
+        const QFont paragraphFont = document->findBlock(first).charFormat().font();
+        const QFont font = device ? QFont(paragraphFont, device) : paragraphFont;
+        layout->setFont(font);
+        return current();
+    }
+    int ownerFirstPosition() const { return groupFirst; }
+    int ownerLastPosition() const { return groupLast; }
+    int firstPosition() const { return first; }
+    int lastPosition() const { return last; }
+    int revisionNumber() const { return revision; }
+    const QString &projectedText() const { return text; }
+    const QList<Unit> &sourceMap() const { return units; }
+    const QList<Object> &objects() const { return frames; }
+    QTextFrame *parentFrame() const { return parent; }
+    QTextLayout *textLayout() const { return layout.get(); }
+    Qt::LayoutDirection direction() const
+    {
+        if (baseDirection != Qt::LayoutDirectionAuto)
+            return baseDirection;
+        // Ordinary explicit block/default context retains priority. Do not use
+        // QTextBlock::textDirection(): the first storage block may be empty and
+        // real caption text belongs to an independent layout, not this body.
+        const auto blockDirection = document->findBlock(first).blockFormat().layoutDirection();
+        if (blockDirection != Qt::LayoutDirectionAuto)
+            return blockDirection;
+        const auto defaultDirection = document->defaultTextOption().textDirection();
+        if (defaultDirection != Qt::LayoutDirectionAuto)
+            return defaultDirection;
+        // Qt's own first-strong resolver ignores isolate contents and neutral
+        // object anchors. Empty/no-strong owners retain ordinary paragraph LTR.
+        return text.isRightToLeft() ? Qt::RightToLeft : Qt::LeftToRight;
+    }
+    void setContentEdges(qreal left, qreal right) { contentLeft = left; contentRight = right; }
+    qreal leftEdge() const { return contentLeft; }
+    qreal rightEdge() const { return contentRight; }
+
+    // Caption positions have their own real frame/block layout. They are not
+    // collapsed onto the object anchor for cursor, text or accessibility queries.
+    bool inCaption(int position) const
+    {
+        auto it = std::upper_bound(frames.cbegin(), frames.cend(), position,
+            [](int value, const Object &object) { return value < object.first; });
+        if (it == frames.cbegin())
+            return false;
+        --it;
+        return position > it->first && position <= it->last - 1;
+    }
+
+    int toProjected(int documentPosition, bool trailing = false) const
+    {
+        if (!current() || documentPosition < first || documentPosition > last || inCaption(documentPosition))
+            return -1;
+        if (sourceIndices.isEmpty() && documentPosition == first)
+            return 0;
+        const auto it = std::lower_bound(sourceIndices.cbegin(), sourceIndices.cend(), documentPosition,
+            [this](int index, int value) { return units.at(index).first < value; });
+        if (it != sourceIndices.cend() && units.at(*it).first == documentPosition)
+            return *it;
+        if (trailing && it != sourceIndices.cend())
+            return *it;
+        if (it != sourceIndices.cbegin()) {
+            const int previous = *std::prev(it);
+            if (units.at(previous).last <= documentPosition)
+                return previous + 1;
+        }
+        return -1;
+    }
+
+    int toDocument(int projectedPosition) const
+    {
+        if (!current() || projectedPosition < 0 || projectedPosition > units.size())
+            return -1;
+        // Inserted isolate controls have no source character and are never
+        // returned as selectable document offsets.
+        for (int i = projectedPosition; i < units.size(); ++i)
+            if (units.at(i).kind != Kind::Control)
+                return units.at(i).first;
+        for (int i = qMin(projectedPosition - 1, int(units.size()) - 1); i >= 0; --i)
+            if (units.at(i).kind != Kind::Control)
+                return units.at(i).last;
+        return first;
+    }
+
+    QList<Range> selectionRanges(int selectionFirst, int selectionLast) const
+    {
+        QList<Range> ranges;
+        if (!current() || selectionLast <= selectionFirst)
+            return ranges;
+        for (int i = 0; i < units.size(); ++i) {
+            const Unit &unit = units.at(i);
+            if (unit.kind == Kind::Control || unit.first >= selectionLast || unit.last <= selectionFirst)
+                continue;
+            // Selecting only caption text must not paint the whole parent object.
+            if (unit.kind == Kind::Frame
+                && selectionFirst > unit.first && selectionLast < unit.last)
+                continue;
+            if (!ranges.isEmpty() && ranges.last().start + ranges.last().length == i)
+                ++ranges.last().length;
+            else
+                ranges.append({i, 1});
+        }
+        return ranges;
+    }
+
+    Range sourceBoundary(int documentPosition, bool paragraph) const
+    {
+        if (!current() || inCaption(documentPosition)) return {-1, 0};
+        // The opening frame marker is structural, not a body text character.
+        // Including it in a prefix range places the selection endpoint inside
+        // another frame, which QTextCursor expands to the whole real caption.
+        for (const Object &object : frames)
+            if (documentPosition == object.first) return {documentPosition, 0};
+        QList<Range> ranges;
+        if (paragraph) {
+            ranges = paragraphRanges;
+        } else {
+            const int source = structuralJoins.contains(documentPosition) ? documentPosition - 1 : documentPosition;
+            const int projected = toProjected(source);
+            const QTextLine line = layout->lineForTextPosition(projected);
+            if (!line.isValid()) return documentPosition == last ? Range{last, 0} : Range{-1, 0};
+            ranges = sourceRanges(line.textStart(), line.textStart() + line.textLength());
+        }
+        for (const Range &range : std::as_const(ranges))
+            if (documentPosition >= range.start && documentPosition < range.start + range.length)
+                return range;
+        // Native paragraph separators and an end-of-document cursor denote the
+        // preceding range without pretending they are caption characters.
+        for (const Range &range : std::as_const(ranges))
+            if (documentPosition == range.start + range.length
+                && (documentPosition == last || structuralJoins.contains(documentPosition)))
+                return range;
+        // A figure-final owner has a real empty storage block after its frame.
+        // It is a valid structural endpoint, not a stale source-map failure.
+        return documentPosition == last ? Range{last, 0} : Range{-1, 0};
+    }
+
+    // Called by the native containing flow after each real frame's ordinary
+    // layout. Dimensions are measured native results, never authored guesses.
+    bool setObjectSize(int frameIndex, QSizeF measured, qreal minimumWidth, bool floating,
+                       qreal externalAscent = std::numeric_limits<qreal>::quiet_NaN(), bool alignTop = false)
+    {
+        if (!current() || !qIsFinite(measured.width()) || !qIsFinite(measured.height())
+            || measured.width() < 0 || measured.height() < 0
+            || !qIsFinite(minimumWidth) || minimumWidth < 0 || minimumWidth > qreal(QFIXED_MAX))
+            return false;
+        const auto found = frameIndices.constFind(frameIndex);
+        if (found == frameIndices.cend())
+            return false;
+        const Object &object = frames.at(found.value());
+        if (!object.frame)
+            return false;
+        {
+            QTextImageFormat image;
+            image.setName(QStringLiteral("wikidict-native-frame:%1").arg(frameIndex));
+            image.setWidth(floating ? 0 : measured.width());
+            image.setHeight(floating ? 0 : measured.height());
+            image.setVerticalAlignment(alignTop ? QTextCharFormat::AlignTop : QTextCharFormat::AlignBottom);
+            if (qIsFinite(externalAscent))
+                layout->engine()->projectedFrameAscents.insert(object.projectedPosition, QFixed::fromReal(externalAscent));
+            else
+                layout->engine()->projectedFrameAscents.remove(object.projectedPosition);
+            formats[object.projectedPosition].format = image;
+            layout->engine()->projectedFrameMinimumWidths.insert(object.projectedPosition, QFixed::fromReal(minimumWidth));
+            if (floating)
+                layout->engine()->projectedFloatingFrames.insert(object.projectedPosition);
+            else
+                layout->engine()->projectedFloatingFrames.remove(object.projectedPosition);
+            return current();
+        }
+        return false;
+    }
+    qreal objectAscent(int position) const {
+        return layout->engine()->projectedFrameAscents.value(position).toReal();
+    }
+    static bool inlineTable(const QTextFrame *frame) {
+        const auto format = frame->frameFormat();
+        return format.stringProperty(QTextFormat::UserProperty + 0x57d0) == QStringLiteral("wikidict.table-box/1")
+            && format.intProperty(QTextFormat::UserProperty + 0x57d6) > 0;
+    }
+    void finishObjectSizes() { layout->setFormats(coalescedFormats()); }
+
+    qreal leadingSpaceWidth(const QTextLine &line) const
+    {
+        return layout->engine()->leadingSpaceWidth(
+            layout->engine()->lines.at(line.lineNumber())).toReal();
+    }
+
+    QFixed includedTrailingSpaceWidth(const QTextLine &line) const
+    {
+        if (!current() || !line.isValid()
+            || !(layout->textOption().flags() & QTextOption::IncludeTrailingSpaces))
+            return {};
+        const auto *engine = layout->engine();
+        if (line.lineNumber() < 0 || line.lineNumber() >= engine->lines.size())
+            return {};
+        const auto &metrics = engine->lines.at(line.lineNumber());
+        if (!metrics.hasTrailingSpaces || metrics.trailingSpaces <= 0)
+            return {};
+        return engine->width(metrics.from + metrics.length, metrics.trailingSpaces);
+    }
+
+    bool onlyIncludedTrailingSpacesOverflow(const QTextLine &line, QFixed available) const
+    {
+        const QFixed spaces = includedTrailingSpaceWidth(line);
+        if (spaces <= 0 || available < 0)
+            return false;
+        const auto &metrics = layout->engine()->lines.at(line.lineNumber());
+        // textWidth includes the final bearing and (with this option) pending
+        // whitespace. Keep both the visible width and advance within the flow;
+        // genuine word/glyph overflow still takes the ordinary findY path.
+        const QFixed visibleWidth = metrics.textWidth - spaces;
+        return metrics.textWidth > available && visibleWidth >= 0
+            && visibleWidth <= available && metrics.textAdvance <= available;
+    }
+
+    int hitTest(QPointF point, Qt::HitTestAccuracy accuracy) const
+    {
+        if (!current())
+            return -1;
+        point -= layout->position();
+        int closest = -1;
+        qreal distance = std::numeric_limits<qreal>::max();
+        for (int i = 0; i < layout->lineCount(); ++i) {
+            const QTextLine line = layout->lineAt(i);
+            const QRectF box = line.naturalTextRect();
+            if (accuracy == Qt::ExactHit && !box.contains(point))
+                continue;
+            const qreal dy = point.y() < box.top() ? box.top() - point.y()
+                : point.y() > box.bottom() ? point.y() - box.bottom() : 0;
+            if (dy > distance)
+                continue;
+            distance = dy;
+            closest = line.xToCursor(point.x(), accuracy == Qt::ExactHit
+                ? QTextLine::CursorOnCharacter : QTextLine::CursorBetweenCharacters);
+            if (!dy)
+                break;
+        }
+        return closest < 0 ? -1 : toDocument(closest);
+    }
+
+    QRectF cursorRect(int documentPosition, qreal cursorWidth = 1) const
+    {
+        const int projected = toProjected(documentPosition);
+        if (projected < 0)
+            return {};
+        const QTextLine line = layout->lineForTextPosition(projected);
+        if (!line.isValid())
+            return {};
+        return QRectF(layout->position().x() + line.cursorToX(projected),
+                      layout->position().y() + line.y(), cursorWidth, line.height());
+    }
+
+    int visualMove(int documentPosition, bool right) const
+    {
+        int position = toProjected(documentPosition);
+        if (position < 0)
+            return -1;
+        const int original = documentPosition;
+        // Qt owns grapheme and bidi movement. Skip only synthetic control stops.
+        for (int count = 0; count <= units.size(); ++count) {
+            const int next = right ? layout->rightCursorPosition(position)
+                                   : layout->leftCursorPosition(position);
+            if (next == position)
+                return -1;
+            position = next;
+            const int mapped = toDocument(position);
+            if (mapped >= 0 && mapped != original)
+                return mapped;
+        }
+        return -1;
+    }
+
+    int logicalMove(int documentPosition, bool forward) const
+    {
+        int position = toProjected(documentPosition);
+        if (position < 0) return -1;
+        if (forward && position < units.size() && units.at(position).kind == Kind::Frame)
+            return units.at(position).first + 1; // Enter the real caption document interval.
+        for (int count = 0; count <= units.size(); ++count) {
+            const int next = forward ? layout->nextCursorPosition(position)
+                                     : layout->previousCursorPosition(position);
+            if (next == position) return -1; // Let native movement leave this owner.
+            position = next;
+            if (!forward && position < units.size() && units.at(position).kind == Kind::Frame)
+                return units.at(position).last - 1;
+            const int mapped = toDocument(position);
+            if (mapped >= 0 && mapped != documentPosition) return mapped;
+        }
+        return -1;
+    }
+
+private:
+    static bool splitParagraphs(const QVariant &value, QList<QVariantList> *paragraphs,
+                                QList<int> *boundaries, int depth, QString *error)
+    {
+        if (depth > 16 || value.metaType().id() != QMetaType::QVariantList)
+            return refuse(error, "invalid authored paragraph parts");
+        paragraphs->append(QVariantList{});
+        for (const QVariant &partValue : value.toList()) {
+            if (partValue.metaType().id() != QMetaType::QVariantMap)
+                return refuse(error, "paragraph part must be a map");
+            QVariantMap part = partValue.toMap();
+            const QString kind = part.value(QStringLiteral("kind")).toString();
+            if (kind == QStringLiteral("paragraph_break")) {
+                int position = -1;
+                if (!integer(part.value(QStringLiteral("position")), &position))
+                    return refuse(error, "authored paragraph break requires an original position");
+                boundaries->append(position);
+                paragraphs->append(QVariantList{});
+            } else if (kind == QStringLiteral("scope")) {
+                QList<QVariantList> nested;
+                QList<int> nestedBoundaries;
+                if (!splitParagraphs(part.value(QStringLiteral("parts")), &nested, &nestedBoundaries, depth + 1, error))
+                    return false;
+                for (int index = 0; index < nested.size(); ++index) {
+                    if (index) {
+                        boundaries->append(nestedBoundaries.at(index - 1));
+                        paragraphs->append(QVariantList{});
+                    }
+                    // Resume the same producer-resolved scope stack in each
+                    // real paragraph. Controls exist only in the projection.
+                    part.insert(QStringLiteral("parts"), nested.at(index));
+                    paragraphs->last().append(part);
+                }
+            } else {
+                paragraphs->last().append(partValue);
+            }
+        }
+        return true;
+    }
+
+    QList<Range> sourceRanges(int begin, int end) const
+    {
+        QList<Range> result;
+        for (int i = begin; i < end; ++i) {
+            const Unit &unit = units.at(i);
+            // Real caption storage has its own native text boundaries. The
+            // frame anchor is exposed separately as an empty structural range.
+            if (unit.kind == Kind::Control || unit.kind == Kind::Frame) continue;
+            const int rangeEnd = unit.last;
+            bool adjacent = !result.isEmpty();
+            if (adjacent) {
+                const int previousEnd = result.last().start + result.last().length;
+                for (int join = previousEnd; adjacent && join < unit.first; ++join)
+                    adjacent = structuralJoins.contains(join);
+            }
+            if (adjacent)
+                result.last().length = rangeEnd - result.last().start;
+            else
+                result.append({unit.first, rangeEnd - unit.first});
+        }
+        return result;
+    }
+
+    QList<QTextLayout::FormatRange> coalescedFormats() const
+    {
+        QList<QTextLayout::FormatRange> result;
+        for (auto range : formats) {
+            // Original-document run IDs remain available to the adapter, but
+            // are not drawing/shaping attributes of this generated layout.
+            range.format = QTextSourceProvenance::shapingFormat(range.format);
+            if (!result.isEmpty() && result.last().format == range.format
+                && result.last().start + result.last().length == range.start)
+                result.last().length += range.length;
+            else
+                result.append(range);
+        }
+        return result;
+    }
+    explicit QTextLogicalFlowProjection(QTextDocument *doc)
+        : document(doc), revision(doc ? doc->revision() : -1),
+          originalCharacterCount(doc ? doc->characterCount() : 0) {}
+
+    static bool integer(const QVariant &value, int *number)
+    {
+        if (value.metaType().id() != QMetaType::Int)
+            return false;
+        *number = value.toInt();
+        return true;
+    }
+    static bool refuse(QString *error, const char *message)
+    {
+        if (error)
+            *error = QString::fromLatin1(message);
+        return false;
+    }
+    void append(QChar character, Unit unit, const QTextCharFormat &format)
+    {
+        QTextLayout::FormatRange range;
+        range.start = text.size();
+        range.length = 1;
+        range.format = format;
+        formats.append(range);
+        if (unit.kind != Kind::Control)
+            sourceIndices.append(units.size());
+        text += character;
+        units.append(unit);
+        if (character == QChar::LineSeparator)
+            lineHasContent = false;
+        else if (unit.kind != Kind::Control)
+            lineHasContent = true;
+    }
+    void blockBoundary()
+    {
+        if (lineHasContent)
+            append(QChar::LineSeparator, {Kind::Control, -1, -1, -1, {}, false}, {});
+        pendingBlockBoundary = false;
+    }
+    bool initialize(const QVariantMap &description, QString *error)
+    {
+        int directionValue = -1;
+        if (!document || !integer(description.value(QStringLiteral("first")), &first)
+            || !integer(description.value(QStringLiteral("last")), &last)
+            || !integer(description.value(QStringLiteral("direction")), &directionValue)
+            || first < 0 || last < first || last >= originalCharacterCount
+            || (directionValue != Qt::LeftToRight && directionValue != Qt::RightToLeft
+                && directionValue != Qt::LayoutDirectionAuto))
+            return refuse(error, "invalid logical-owner bounds or compiled direction");
+        const auto *documentPrivate = QTextDocumentPrivate::get(document);
+        parent = documentPrivate->frameAt(first);
+        if (auto *table = qobject_cast<QTextTable *>(parent.data()))
+            ownerCell = table->cellAt(first);
+        if (document->findBlock(first).position() != first)
+            return refuse(error, "owner must start at its first native storage block");
+        const QTextBlock lastBlock = document->findBlock(last);
+        if (documentPrivate->frameAt(last) != parent
+            || (ownerCell.isValid() && qobject_cast<QTextTable *>(parent.data())->cellAt(last) != ownerCell)
+            || last != lastBlock.position() + lastBlock.length() - 1)
+            return refuse(error, "owner must end at its last native storage block");
+        groupFirst = first; groupLast = last;
+        baseDirection = Qt::LayoutDirection(directionValue);
+        const QVariant inheritedLanguage = description.value(QStringLiteral("language"));
+        if (inheritedLanguage.isValid() && !inheritedLanguage.isNull()
+            && inheritedLanguage.metaType().id() != QMetaType::QString)
+            return refuse(error, "owner language must be null or string");
+        if (!parts(description.value(QStringLiteral("parts")), inheritedLanguage.toString(),
+                   inheritedLanguage.isValid() && !inheritedLanguage.isNull(), 0, error))
+            return false;
+        // Account explicitly for every stored source unit: text, real frame
+        // interval, or adapter-declared structural join. No unlisted text loss.
+        QList<Interval> coverage = intervals;
+        const QVariant joinsValue = description.value(QStringLiteral("joins"));
+        if (joinsValue.metaType().id() != QMetaType::QVariantList)
+            return refuse(error, "joins must be an explicit list");
+        for (const QVariant &value : joinsValue.toList()) {
+            int position = -1;
+            if (!integer(value, &position) || position < first || position >= last
+                || document->characterAt(position) != QChar::ParagraphSeparator)
+                return refuse(error, "invalid structural paragraph join");
+            coverage.append({position, position + 1, Kind::Control});
+            structuralJoins.insert(position);
+        }
+        std::sort(coverage.begin(), coverage.end(), [](const Interval &a, const Interval &b) {
+            return a.first < b.first;
+        });
+        int covered = first;
+        for (const Interval &interval : coverage) {
+            if (interval.first != covered || interval.last <= interval.first)
+                return refuse(error, "logical owner has missing or overlapping source ranges");
+            covered = interval.last;
+        }
+        if (covered != last || !current())
+            return refuse(error, "logical owner is incomplete or stale");
+        paragraphRanges = sourceRanges(0, units.size());
+        layout = std::make_unique<QTextLayout>(text, document->findBlock(first).charFormat().font(), document->documentLayout()->paintDevice());
+        QTextEngine *engine = layout->engine();
+        engine->projectedDocument = document;
+        for (int index = 0; index < units.size(); ++index) {
+            engine->projectedSourcePositions.append(units.at(index).first);
+            if (units.at(index).kind == Kind::Frame)
+                engine->projectedFramePositions.insert(index);
+        }
+        QTextOption option = document->defaultTextOption();
+        option.setTextDirection(direction());
+        layout->setTextOption(option);
+        layout->setFormats(coalescedFormats());
+        return true;
+    }
+    bool parts(const QVariant &value, QString language, bool languagePresent, int depth, QString *error)
+    {
+        if (depth > 16 || value.metaType().id() != QMetaType::QVariantList)
+            return refuse(error, "invalid scope nesting or parts type");
+        for (const QVariant &partValue : value.toList()) {
+            if (partValue.metaType().id() != QMetaType::QVariantMap)
+                return refuse(error, "part must be a native descriptor map");
+            const QVariantMap part = partValue.toMap();
+            const QString kind = part.value(QStringLiteral("kind")).toString();
+            if (kind == QStringLiteral("scope")) {
+                int resolved = -1;
+                const QString mode = part.value(QStringLiteral("mode")).toString();
+                if ((mode != QStringLiteral("isolate") && mode != QStringLiteral("isolate_override"))
+                    || !integer(part.value(QStringLiteral("direction")), &resolved)
+                    || (resolved != Qt::LeftToRight && resolved != Qt::RightToLeft))
+                    return refuse(error, "scope requires resolved direction and supported mode");
+                QString childLanguage = language;
+                bool childPresent = languagePresent;
+                const QVariant lang = part.value(QStringLiteral("language"));
+                if (lang.isValid() && !lang.isNull()) {
+                    if (lang.metaType().id() != QMetaType::QString)
+                        return refuse(error, "language must be null or string");
+                    childLanguage = lang.toString(); // Empty is an explicit reset.
+                    childPresent = true;
+                }
+                Unit control{Kind::Control, -1, -1, -1, childLanguage, childPresent};
+                append(QChar(resolved == Qt::LeftToRight ? 0x2066 : 0x2067), control, {});
+                if (mode == QStringLiteral("isolate_override"))
+                    append(QChar(resolved == Qt::LeftToRight ? 0x202d : 0x202e), control, {});
+                if (!parts(part.value(QStringLiteral("parts")), childLanguage, childPresent, depth + 1, error))
+                    return false;
+                if (mode == QStringLiteral("isolate_override"))
+                    append(QChar(0x202c), control, {});
+                append(QChar(0x2069), control, {});
+            } else if (kind == QStringLiteral("text")) {
+                int begin = -1, end = -1;
+                if (!integer(part.value(QStringLiteral("first")), &begin)
+                    || !integer(part.value(QStringLiteral("last")), &end)
+                    || begin < first || end <= begin || end > last)
+                    return refuse(error, "invalid text range");
+                const auto *documentPrivate = QTextDocumentPrivate::get(document);
+                if (documentPrivate->frameAt(begin) != parent
+                    || document->findBlock(begin) != document->findBlock(end - 1))
+                    return refuse(error, "text range crosses its native block or parent frame");
+                if (ownerCell.isValid()
+                    && (qobject_cast<QTextTable *>(parent.data())->cellAt(begin) != ownerCell
+                        || qobject_cast<QTextTable *>(parent.data())->cellAt(end - 1) != ownerCell))
+                    return refuse(error, "text range crosses a table cell boundary");
+                if (!intervals.isEmpty() && begin < intervals.last().last)
+                    return refuse(error, "source order must be monotonic");
+                intervals.append({begin, end, Kind::Text});
+                if (pendingBlockBoundary)
+                    blockBoundary();
+                for (int position = begin; position < end; ++position) {
+                    const QChar character = document->characterAt(position);
+                    if (character == QChar::ParagraphSeparator || character.unicode() == 0xfdd0 || character.unicode() == 0xfdd1)
+                        return refuse(error, "structural separator was declared as inline text");
+                    // Match charFormat() for the forward one-unit selection,
+                    // including its ObjectIndex removal, without setX()/layout.
+                    const auto fragment = documentPrivate->find(position);
+                    QTextCharFormat format = documentPrivate->formatCollection()->charFormat(fragment.value()->format);
+                    format.clearProperty(QTextFormat::ObjectIndex);
+                    append(character, {Kind::Text, position, position + 1, -1, language, languagePresent}, format);
+                }
+            } else if (kind == QStringLiteral("frame")) {
+                int index = -1;
+                if (!integer(part.value(QStringLiteral("object")), &index))
+                    return refuse(error, "frame requires native object index");
+                auto *frame = qobject_cast<QTextFrame *>(document->object(index));
