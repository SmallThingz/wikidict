 namespace {
+static bool wikidictTablePolicyValuesEqual(const QVariant &left, const QVariant &right)
+{
+    if (left.metaType() != right.metaType())
+        return false;
+    if (left.metaType().id() == QMetaType::QVariantMap) {
+        const auto a = left.toMap(), b = right.toMap();
+        if (a.size() != b.size())
+            return false;
+        auto ai = a.cbegin(), bi = b.cbegin();
+        for (; ai != a.cend(); ++ai, ++bi)
+            if (ai.key() != bi.key() || !wikidictTablePolicyValuesEqual(ai.value(), bi.value()))
+                return false;
+        return true;
+    }
+    if (left.metaType().id() == QMetaType::QVariantList) {
+        const auto a = left.toList(), b = right.toList();
+        if (a.size() != b.size())
+            return false;
+        for (qsizetype i = 0; i < a.size(); ++i)
+            if (!wikidictTablePolicyValuesEqual(a[i], b[i]))
+                return false;
+        return true;
+    }
