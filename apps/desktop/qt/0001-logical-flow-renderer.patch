+QVariantMap QTextDocumentLayout::wikidictLogicalPosition(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) {
+        QVariantMap result{{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+        if (const auto owner = d->logicalFlowAt(position, true)) {
+            result.insert(QStringLiteral("first"), owner->firstPosition());
+            result.insert(QStringLiteral("last"), owner->lastPosition());
+        }
+        return result;
+    }
+    const int projected = flow->toProjected(position);
+    if (projected < 0)
+        return {};
+    QVariantMap result;
+    result.insert(QStringLiteral("handled"), true);
+    result.insert(QStringLiteral("error"), d->paragraphBoxError);
+    if (d->paragraphBoxError)
+        return result;
+    result.insert(QStringLiteral("position"), position);
+    result.insert(QStringLiteral("projected"), projected);
+    result.insert(QStringLiteral("resolvedDirection"), int(flow->direction()));
+    result.insert(QStringLiteral("first"), flow->firstPosition());
+    result.insert(QStringLiteral("last"), flow->lastPosition());
+    result.insert(QStringLiteral("logicalOwnerFirst"), flow->ownerFirstPosition());
+    result.insert(QStringLiteral("logicalOwnerLast"), flow->ownerLastPosition());
+    for (const auto &object : flow->objects()) {
+        if (object.projectedPosition != projected || !object.frame) continue;
+        if (auto *table = qobject_cast<QTextTable *>(object.frame.data()))
+            result.insert(QStringLiteral("objectRect"), d->tableBoundingRectInternal(table));
+        break;
+    }
+    QPointF offset;
+    QTextFrame *parent = document()->frameAt(position);
+    while (parent) {
+        const QTextFrameData *fd = data(parent);
+        offset += fd->position.toPointF();
+        if (auto *table = qobject_cast<QTextTable *>(parent)) {
+            const auto cell = table->cellAt(position);
+            if (cell.isValid())
+                offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+        }
+        parent = parent->parentFrame();
+    }
+    result.insert(QStringLiteral("cursorRect"), flow->cursorRect(position, d->cursorWidth).translated(offset));
+    result.insert(QStringLiteral("contentLeft"), flow->leftEdge() + offset.x());
+    result.insert(QStringLiteral("contentRight"), flow->rightEdge() + offset.x());
+    const QTextLine line = flow->textLayout()->lineForTextPosition(projected);
+    if (line.isValid()) {
+        const qreal leading = line.cursorToX(projected, QTextLine::Leading);
+        const qreal trailing = line.cursorToX(projected, QTextLine::Trailing);
+        const QPointF origin = flow->textLayout()->position() + offset;
+        qreal left = qMin(leading, trailing), right = qMax(leading, trailing);
+#ifndef QT_NO_RAWFONT
+        // A bidi insertion caret can belong to the neighboring isolate, and a
+        // ligature can span several source units. Use the same shaped selection
+        // intervals as painting; retain the established line top and height.
+        bool hasGlyph = false;
+        for (const QGlyphRun &run : line.glyphRuns(projected, 1)) {
+            const QRectF bounds = run.boundingRect();
+            if (!qIsFinite(bounds.left()) || !qIsFinite(bounds.right()))
+                return {};
+            left = hasGlyph ? qMin(left, bounds.left()) : bounds.left();
+            right = hasGlyph ? qMax(right, bounds.right()) : bounds.right();
+            hasGlyph = true;
+        }
+        // Pending wrap spaces, TabOrObject and structural/no-run positions
+        // retain their caret cell, including zero width. No extent is invented.
+#endif
+        result.insert(QStringLiteral("characterRect"), QRectF(origin.x() + left,
+            origin.y() + line.y(), right - left, line.height()));
+        result.insert(QStringLiteral("lineX"), leading);
+        result.insert(QStringLiteral("lineNumber"), line.lineNumber());
+        result.insert(QStringLiteral("lineCount"), flow->textLayout()->lineCount());
+        result.insert(QStringLiteral("lineTextLength"), line.textLength());
+        result.insert(QStringLiteral("lineTextStart"), line.textStart());
+        result.insert(QStringLiteral("lineWidth"), line.width());
+        result.insert(QStringLiteral("lineAdvance"), line.horizontalAdvance());
+        result.insert(QStringLiteral("lineIncludedTrailingSpaceWidth"), flow->includedTrailingSpaceWidth(line).toReal());
+        result.insert(QStringLiteral("lineNaturalWidth"), line.naturalTextWidth());
+        result.insert(QStringLiteral("lineNaturalLeft"), line.naturalTextRect().left() + origin.x());
+        result.insert(QStringLiteral("lineNaturalRight"), line.naturalTextRect().right() + origin.x());
+        result.insert(QStringLiteral("lineLeadingSpaceWidth"), flow->leadingSpaceWidth(line));
+        // Retain the native metrics independently of QVariant QRectF JSON
+        // conversion. These are observations, not alternate layout inputs.
+        result.insert(QStringLiteral("layoutY"), origin.y());
+        result.insert(QStringLiteral("lineY"), line.y());
+        result.insert(QStringLiteral("lineHeight"), line.height());
+        result.insert(QStringLiteral("lineAscent"), line.ascent());
+        result.insert(QStringLiteral("lineDescent"), line.descent());
+        result.insert(QStringLiteral("lineLeading"), line.leading());
+        const auto sourceFormat = document()->findBlock(flow->firstPosition()).blockFormat();
+        result.insert(QStringLiteral("blockLineHeightType"), sourceFormat.lineHeightType());
+        result.insert(QStringLiteral("blockLineHeightValue"), sourceFormat.lineHeight());
+        result.insert(QStringLiteral("leading"), leading + origin.x());
+        result.insert(QStringLiteral("trailing"), trailing + origin.x());
+    }
+    if (projected < flow->sourceMap().size()) {
+        const auto &unit = flow->sourceMap().at(projected);
+        result.insert(QStringLiteral("languagePresent"), unit.languagePresent);
+        if (unit.languagePresent)
+            result.insert(QStringLiteral("language"), unit.language);
+    }
+    return result;
+}
