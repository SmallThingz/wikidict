+QRectF QTextDocumentLayoutPrivate::layoutFigureTableCaption(QTextFrame *frame, int layoutFrom, int layoutTo,
+                                                           QFixed width, QFixed parentY)
+{
+    auto *fd = data(frame);
+    const auto format = frame->frameFormat();
+    const qreal flow = fd->wikidictFigureFlowWidth;
+    if (!qIsFinite(flow) || flow < 0 || flow > qreal(QFIXED_MAX)) {
+        refuseParagraphBox(2, frame->firstPosition()); return QRectF();
+    }
+    const qint64 marginRaw = qint64(QFixed::fromReal(scaleToDevice(format.leftMargin())).round().value())
+        + QFixed::fromReal(scaleToDevice(format.rightMargin())).round().value();
+    if (!checkParagraphBoxExtent(marginRaw, frame->firstPosition())) return QRectF();
+    const QFixed margins = QFixed::fromFixed(int(marginRaw));
+    const QFixed available = qMax(QFixed(), QFixed::fromReal(flow) - margins);
+    auto *grid = qobject_cast<QTextTable *>(frame->childFrames().at(0));
+    auto *caption = qobject_cast<QTextTable *>(frame->childFrames().at(1));
+    fd->wikidictFigureTableMeasuring = true;
+    const auto restore = qScopeGuard([&] { fd->wikidictFigureTableMeasuring = false; });
+    const auto dirty = [&](auto &&self, QTextFrame *owner) -> void {
+        data(owner)->sizeDirty = true;
+        for (auto *child : owner->childFrames()) self(self, child);
+    };
+    // This is the ordinary table intrinsic pass, including its QFIXED_MAX
+    // cell measurement, not the caption's currently assigned or ink width.
+    const QFixed initial = qMax(QFixed(1), available);
+    if (!checkParagraphBoxExtent(qint64(initial.value()) + margins.value(), frame->firstPosition())) return QRectF();
+    dirty(dirty, frame);
+    QRectF changed = layoutFrame(frame, layoutFrom, layoutTo, initial + margins, -1, parentY);
+    if (paragraphBoxError) return QRectF();
+    const QFixed minimum = qMax(data(grid)->minimumWidth, data(caption)->minimumWidth);
+    const QFixed maximum = qMax(minimum, data(grid)->maximumWidth);
+    const QFixed used = qMax(minimum, qMin(available, maximum));
+    if (!checkParagraphBoxExtent(qint64(used.value()) + margins.value(), frame->firstPosition())) return QRectF();
+    if (used != initial) {
+        dirty(dirty, frame);
+        changed |= layoutFrame(frame, layoutFrom, layoutTo, used + margins, -1, parentY);
+        if (paragraphBoxError) return QRectF();
+    }
+    if (!checkParagraphBoxExtent(qint64(minimum.value()) + marginRaw, frame->firstPosition())
+        || (maximum != QFixed(QFIXED_MAX)
+            && !checkParagraphBoxExtent(qint64(maximum.value()) + marginRaw, frame->firstPosition()))) return QRectF();
+    fd->minimumWidth = QFixed::fromFixed(int(qint64(minimum.value()) + marginRaw));
+    fd->maximumWidth = maximum == QFixed(QFIXED_MAX) ? maximum
+        : QFixed::fromFixed(int(qint64(maximum.value()) + marginRaw));
+    return changed;
+}
