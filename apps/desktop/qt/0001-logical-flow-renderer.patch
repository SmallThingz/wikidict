+QVariantMap QTextDocumentLayout::wikidictLogicalBoundary(int position, bool paragraph) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (d->logicalFlows.isEmpty())
+        return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (d->paragraphBoxError)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError}};
+    const auto range = flow->sourceBoundary(position, paragraph);
+    if (range.start < 0)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 0},
+        {QStringLiteral("start"), range.start}, {QStringLiteral("end"), range.start + range.length},
+        {QStringLiteral("ownerFirst"), flow->firstPosition()}, {QStringLiteral("ownerLast"), flow->lastPosition()}};
+}
