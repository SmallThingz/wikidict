+static QTextFragment wikidictFigureMediaObject(const QTextFrame *frame)
+{
+    QTextFragment result;
+    if (!wikidictFigureMediaFrame(frame)) return result;
+    for (auto it = frame->begin(); !it.atEnd(); ++it) {
+        const auto block = it.currentBlock(); if (!block.isValid()) continue;
+        for (auto piece = block.begin(); !piece.atEnd(); ++piece) {
+            const auto fragment = piece.fragment();
+            if (!fragment.isValid() || fragment.length() != 1 || !fragment.charFormat().isImageFormat() || result.isValid()) return {};
+            result = fragment;
+        }
+    }
+    return result;
+}
+static bool wikidictFigureMediaChildren(const QTextFrame *frame, const QTextFragment &fragment)
+{
+    if (!fragment.isValid()) return false;
+    const auto children = frame->childFrames();
+    const int index = fragment.charFormat().objectIndex();
+    if (children.isEmpty()) return index == -1;
+    if (children.size() != 1 || index < 0) return false;
+    const auto *helper = children.first();
+    // Qt's HTML importer calls insertImage(format, InFlow). Its image object
+    // owns an empty native frame at the same character; it is not a child box.
+    QTextFrameFormat neutral;
+    neutral.setPosition(QTextFrameFormat::InFlow);
+    return helper->document() == frame->document() && helper->parentFrame() == frame
+        && !qobject_cast<const QTextTable *>(helper) && helper->childFrames().isEmpty()
+        && frame->document()->object(index) == helper && helper->objectIndex() == index
+        && helper->firstPosition() == fragment.position() + 1
+        && helper->lastPosition() == fragment.position() && helper->frameFormat() == neutral;
+}
