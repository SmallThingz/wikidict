+QFixed QTextDocumentLayoutPrivate::adjoiningMargin(QTextFrame *frame, int side) const
+{
+    const auto format = frame->frameFormat();
+    const auto values = wikidictTableViewportActive(frame)
+        ? format.property(WikidictTableViewport).toMap().value(QStringLiteral("margins")).toList()
+        : format.property(WikidictContainerMargins).toMap().value(QStringLiteral("edges")).toList();
+    return values.size() == 4 ? QFixed::fromReal(scaleToDevice(values[side].toDouble())) : QFixed();
+}
+
+QFixed QTextDocumentLayoutPrivate::adjoiningInset(QTextFrame *frame, int side) const
+{
+    const auto format = frame->frameFormat();
+    const qreal margins[] = {format.topMargin(), format.rightMargin(), format.bottomMargin(), format.leftMargin()};
+    const QFixed margin = QFixed::fromReal(scaleToDevice(margins[side])).round();
+    if (!format.hasProperty(WikidictContainerPhysicalEdges))
+        return margin + QFixed::fromReal(scaleToDevice(format.border())).round() + QFixed::fromReal(scaleToDevice(format.padding())).round();
+    WikidictPhysicalEdges edges;
+    if (!wikidictPhysicalEdges(format.property(WikidictContainerPhysicalEdges), &edges)) return QFixed();
+    return margin + QFixed::fromReal(scaleToDevice(edges.width[side])).round() + QFixed::fromReal(scaleToDevice(edges.padding[side])).round();
+}
+
+QFixed QTextDocumentLayoutPrivate::adjoiningWidth(QTextFrame *frame, QFixed available)
+{
+    const auto format = frame->frameFormat();
+    const auto margins = format.property(WikidictContainerMargins).toMap();
+    if (wikidictTableViewport(frame) && !wikidictTableViewportActive(frame)) return available;
+    if (format.hasProperty(WikidictContainerAutoMargins) || wikidictTableViewportActive(frame)) {
+        const auto spec = format.property(wikidictTableViewportActive(frame) ? WikidictTableViewport : WikidictContainerAutoMargins).toMap();
+        const auto width = spec.value(QStringLiteral("width")).toMap();
+        const auto maximum = spec.value(QStringLiteral("max_width")).toMap();
+        const qreal edges = (adjoiningInset(frame, 1) + adjoiningInset(frame, 3)).toReal();
+        const bool intrinsic = available == QFixed(QFIXED_MAX);
+        const bool borderBox = spec.value(QStringLiteral("border_box")).toBool();
+        const auto resolve = [&](const QVariantMap &request, qreal fallback) {
+            const auto unit = request.value(QStringLiteral("unit")).toString();
+            if (unit == QStringLiteral("auto") || unit == QStringLiteral("none")
+                || (intrinsic && unit == QStringLiteral("percent"))) return fallback;
+            const qreal requested = unit == QStringLiteral("fixed")
+                ? scaleToDevice(request.value(QStringLiteral("value")).toDouble())
+                : available.toReal() * (request.value(QStringLiteral("value")).toDouble() / 100);
+            return qMax(edges, requested + (borderBox ? 0 : edges));
+        };
+        const qreal fill = intrinsic ? available.toReal() : qMax(edges,
+            available.toReal() - adjoiningMargin(frame, 1).toReal() - adjoiningMargin(frame, 3).toReal());
+        const qreal used = qMin(resolve(width, fill), resolve(maximum, qreal(QFIXED_MAX)));
+        if (!qIsFinite(used) || used < edges || used > QFIXED_MAX) { refuseParagraphBox(2, frame->firstPosition()); return {}; }
+        return QFixed::fromReal(used);
+    }
+    if (margins.value(QStringLiteral("auto_width")).toBool()) {
+        // Table intrinsic measurement supplies an unbounded-width sentinel,
+        // not a used containing width. Signed external margins contribute to
+        // the measured minimum below; subtracting them from this sentinel can
+        // overflow even though every authored extent and used width is finite.
+        if (available == QFixed(QFIXED_MAX))
+            return available;
+        const qint64 edges = qint64(adjoiningInset(frame, 1).value()) + adjoiningInset(frame, 3).value();
+        const qint64 used = qMax(edges, qint64(available.value()) - adjoiningMargin(frame, 1).value() - adjoiningMargin(frame, 3).value());
+        if (!checkParagraphBoxExtent(used, frame->firstPosition())) return {};
+        return QFixed::fromFixed(int(used));
+    }
+    const qreal used = format.width().type() == QTextLength::FixedLength ? scaleToDevice(format.width().rawValue())
+        : format.width().value(available.toReal());
+    if (!qIsFinite(used) || used < 0 || used > QFIXED_MAX) { refuseParagraphBox(2, frame->firstPosition()); return {}; }
+    return qMax(QFixed::fromReal(used), adjoiningInset(frame, 1) + adjoiningInset(frame, 3));
+}
+
+WikidictAdjoining QTextDocumentLayoutPrivate::adjoiningProfile(QTextFrame *frame)
+{
+    WikidictAdjoining out;
+    if (!wikidictPlainContainer(frame)) {
+        const auto format = frame->frameFormat();
+        if (format.position() == QTextFrameFormat::InFlow
+            && (format.hasProperty(WikidictTableBoxOwner)
+                || wikidictTableViewport(frame)
+                || format.stringProperty(QTextFormat::UserProperty + 0x57a0) == QStringLiteral("wikidict.figure-layout/1"))) {
+            const qreal top = wikidictTableViewportActive(frame) ? adjoiningMargin(frame, 0).toReal() : scaleToDevice(format.topMargin());
+            const qreal bottom = wikidictTableViewportActive(frame) ? adjoiningMargin(frame, 2).toReal() : scaleToDevice(format.bottomMargin());
+            if (!qIsFinite(top) || !qIsFinite(bottom) || top < 0 || bottom < 0 || top >= QFIXED_MAX / 8 || bottom >= QFIXED_MAX / 8) {
+                refuseParagraphBox(2, frame->firstPosition()); return out;
+            }
+            out.before = WikidictMarginStrut::from(QFixed::fromReal(top)); out.after = WikidictMarginStrut::from(QFixed::fromReal(bottom));
+            out.beforeAdjoins = !adjoiningClearances.contains(frame);
+        }
+        return out;
+    }
+    if (frame->frameFormat().hasProperty(QTextFormat::UserProperty + 0x57e5)) return out;
+    if (!validatePlainContainer(frame)) return out;
+    const auto format = frame->frameFormat();
+    QList<WikidictAdjoining> children;
+    for (auto it = frame->begin(); !it.atEnd(); ++it) {
+        if (auto *child = it.currentFrame()) {
+            if (child->frameFormat().position() != QTextFrameFormat::InFlow || isFrameFromInlineObject(child)) continue;
+            children.append(adjoiningProfile(child));
+        } else if (const auto block = it.currentBlock(); block.isValid() && block.isVisible()) {
+            const auto logical = logicalFlowAt(block.position());
+            if (logical && logical->firstPosition() != block.position()) continue;
+            const auto box = wikidictParagraphBox(block.blockFormat());
+            WikidictAdjoining paragraph;
+            paragraph.through = box.owned && !box.error && box.empty && box.start == 0 && box.end == 0;
+            children.append(paragraph);
+        }
+    }
+    WikidictAdjoining inner; inner.through = true;
+    for (const auto &child : std::as_const(children)) {
+        inner.through = inner.through && child.through && child.beforeAdjoins && child.afterAdjoins;
+    }
+    for (const auto &child : std::as_const(children)) {
+        if (!child.beforeAdjoins) break;
+        inner.before.join(child.before);
+        if (!child.through) break;
+        inner.before.join(child.after);
+    }
+    for (auto it = children.crbegin(); it != children.crend(); ++it) {
+        if (!it->afterAdjoins) { inner.after = {}; break; }
+        inner.after.join(it->after);
+        if (!it->through) break;
+        inner.after.join(it->before);
+    }
+    const bool positiveMinimum = format.property(WikidictContainerMinimumHeight).toMap()
+        .value(QStringLiteral("computed")).toDouble() > 0;
+    out.before = WikidictMarginStrut::from(adjoiningMargin(frame, 0));
+    out.after = WikidictMarginStrut::from(adjoiningMargin(frame, 2));
+    out.collapseTop = !format.hasProperty(WikidictContainerScrollport) && !wikidictFixedContainerFloat(frame) && adjoiningInset(frame, 0) == 0;
+    out.collapseBottom = !format.hasProperty(WikidictContainerScrollport) && !wikidictFixedContainerFloat(frame) && adjoiningInset(frame, 2) == 0 && format.height().type() == QTextLength::VariableLength
+        && !(positiveMinimum && inner.through && out.collapseTop);
+    if (out.collapseTop) out.before.join(inner.before);
+    if (out.collapseBottom) out.after.join(inner.after);
+    out.through = inner.through && out.collapseTop && adjoiningInset(frame, 2) == 0 && !positiveMinimum
+        && (format.height().type() == QTextLength::VariableLength || format.height().rawValue() == 0);
+    if (adjoiningClearances.contains(frame)) {
+        out.beforeAdjoins = false; out.afterAdjoins = !out.through;
+    }
+    return out;
+}
+
+// This pass visits only the leading adjoining chain. It may measure an isolated
+// float once, but never shapes ordinary child text at a provisional parent origin.
+bool QTextDocumentLayoutPrivate::prepareAdjoiningLeading(QTextFrame *frame, QFixed width, QFixed absoluteTop,
+    QList<WikidictFloatExclusion> *exclusions, int layoutFrom, int layoutTo)
+{
+    if (frame->frameFormat().hasProperty(WikidictContainerScrollport) || wikidictFixedContainerFloat(frame)
+        || adjoiningInset(frame, 0) != 0) return true;
+    const QFixed left = adjoiningInset(frame, 3), content = qMax(QFixed(), width - left - adjoiningInset(frame, 1));
+    QTextLayoutStruct query; query.frame = frame; query.frameY = absoluteTop;
+    query.x_left = left; query.x_right = left + content;
+    query.pageHeight = query.pageBottom = QFixed(QFIXED_MAX); query.wikidictParagraphBoxes = true;
+    query.inheritedExclusions = *exclusions;
+    auto *fd = data(frame); const auto savedWidth = fd->contentsWidth; auto *savedFlow = fd->currentLayoutStruct;
+    fd->contentsWidth = content; fd->currentLayoutStruct = &query;
+    const auto restore = qScopeGuard([&] { fd->contentsWidth = savedWidth; fd->currentLayoutStruct = savedFlow; });
+    WikidictMarginCursor cursor; cursor.leading = true; cursor.collapseBottom = true;
+    const auto clearBottom = [&](int clear, int before, QFixed *bottom) {
+        bool found = false;
+        for (const auto &exclusion : floatExclusions(&query, before)) {
+            if ((clear & 1 && exclusion.side == QTextFrameFormat::FloatLeft)
+                || (clear & 2 && exclusion.side == QTextFrameFormat::FloatRight)) {
+                const QFixed end = exclusion.position.y + exclusion.size.height;
+                *bottom = found ? qMax(*bottom, end) : end; found = true;
+            }
+        }
+        return found;
+    };
+    for (auto it = frame->begin(); !it.atEnd() && !paragraphBoxError; ++it) {
+        auto *child = it.currentFrame();
+        if (!child) {
+            const auto block = it.currentBlock(); if (!block.isValid() || !block.isVisible()) continue;
+            const auto logical = logicalFlowAt(block.position());
+            if (logical && logical->firstPosition() != block.position()) continue;
+            const auto box = wikidictParagraphBox(block.blockFormat());
+            if (box.owned && !box.error && box.empty && box.start == 0 && box.end == 0) continue;
+            return true;
+        }
+        if (isFrameFromInlineObject(child)) continue;
+        const auto format = child->frameFormat();
+        const int clear = wikidictPlainContainer(child) ? format.intProperty(WikidictPlainContainerClear)
+            : format.hasProperty(WikidictTableBoxOwner) ? format.intProperty(WikidictTableBoxClear)
+            : format.intProperty(QTextFormat::UserProperty + 0x57a1);
+        QFixed bottom; const bool hasClear = clearBottom(clear, child->firstPosition(), &bottom);
+        if (format.position() != QTextFrameFormat::InFlow) {
+            auto *cd = data(child); query.y = cursor.floatTop();
+            if (hasClear) query.y = qMax(query.y, bottom);
+            if (auto *table = qobject_cast<QTextTable *>(child)) {
+                auto *td = static_cast<QTextTableData *>(cd); td->wikidictContainingWidth = content.toReal();
+            } else if (format.stringProperty(QTextFormat::UserProperty + 0x57a0) == QStringLiteral("wikidict.figure-layout/1"))
+                cd->wikidictFigureFlowWidth = content.toReal();
+            else if (wikidictFixedContainerFloat(child)) {
+                if (!validatePlainContainer(child)) return false;
+            } else {
+                bool fixed = format.width().type() == QTextLength::FixedLength && format.height().type() == QTextLength::FixedLength;
+                for (qreal value : {format.width().rawValue(), format.height().rawValue(), format.topMargin(), format.bottomMargin(),
+                        format.leftMargin(), format.rightMargin(), format.padding(), format.border()})
+                    fixed = fixed && qIsFinite(value) && value >= 0 && scaleToDevice(value) < QFIXED_MAX;
+                if (!fixed) { refuseParagraphBox(1, child->firstPosition()); return false; }
+            }
+            if (adjoiningFloatWidths.contains(child)) {
+                if (adjoiningFloatWidths.value(child) != content || cd->sizeDirty) { refuseParagraphBox(1, child->firstPosition()); return false; }
+            } else {
+                cd->sizeDirty = true;
+                layoutFrame(child, layoutFrom, layoutTo, absoluteTop);
+                if (paragraphBoxError) return false;
+                adjoiningFloatWidths.insert(child, content);
+            }
+            QFixed y = findY(query.y, &query, cd->size.width), a, b;
+            floatMargins(y, &query, &a, &b);
+            WikidictFloatExclusion own{child, {format.position() == QTextFrameFormat::FloatLeft ? a : b - cd->size.width, y},
+                cd->size, format.position()};
+            query.exportedExclusions.append(own); exclusions->append(own);
+            continue;
+        }
+        const bool ordinary = wikidictPlainContainer(child) && !format.hasProperty(QTextFormat::UserProperty + 0x57e5);
+        const bool atomic = format.hasProperty(WikidictTableBoxOwner)
+            || format.stringProperty(QTextFormat::UserProperty + 0x57a0) == QStringLiteral("wikidict.figure-layout/1");
+        if (!ordinary && !atomic) return true;
+        auto profile = adjoiningProfile(child);
+        if (adjoiningClearances.contains(child)) return true;
+        const auto placement = cursor.preview(profile, bottom, hasClear, false);
+        if (placement.clearance) { adjoiningClearances.insert(child); return true; }
+        if (atomic) return true; // Its external margin participates; its own children are isolated.
+        const QFixed childWidth = adjoiningWidth(child, content);
+        const QFixed x = format.layoutDirection() == Qt::RightToLeft ? query.x_right - adjoiningMargin(child, 1) - childWidth
+            : left + adjoiningMargin(child, 3);
+        QList<WikidictFloatExclusion> incoming = floatExclusions(&query, child->firstPosition());
+        for (auto &exclusion : incoming) exclusion.position = exclusion.position - QFixedPoint(x, placement.top);
+        const int revision = adjoiningClearances.size();
+        const auto incomingCount = incoming.size();
+        if (!prepareAdjoiningLeading(child, childWidth, absoluteTop + placement.top, &incoming, layoutFrom, layoutTo)) return false;
+        if (revision != adjoiningClearances.size()) return true;
+        for (qsizetype index = incomingCount; index < incoming.size(); ++index) {
+            auto own = incoming[index]; own.position = own.position + QFixedPoint(x, placement.top);
+            query.exportedExclusions.append(own); exclusions->append(own);
+        }
+        if (!profile.through) return true;
+        cursor.end(placement, QFixed(), profile);
+    }
+    return !paragraphBoxError;
+}
+
+bool QTextDocumentLayoutPrivate::prepareAdjoining(QTextFrame *frame, QTextLayoutStruct *parent,
+    const WikidictMarginCursor &cursor, int layoutFrom, int layoutTo,
+    WikidictAdjoining *profile, WikidictMarginPlacement *placement)
+{
+    for (;;) {
+        const int revision = adjoiningClearances.size();
+        *profile = adjoiningProfile(frame);
+        QFixed bottom; bool hasClear = false;
+        const int clear = frame->frameFormat().intProperty(WikidictPlainContainerClear);
+        auto incoming = floatExclusions(parent, frame->firstPosition());
+        for (const auto &exclusion : std::as_const(incoming)) {
+            if ((clear & 1 && exclusion.side == QTextFrameFormat::FloatLeft)
+                || (clear & 2 && exclusion.side == QTextFrameFormat::FloatRight)) {
+                const QFixed end = exclusion.position.y + exclusion.size.height;
+                bottom = hasClear ? qMax(bottom, end) : end; hasClear = true;
+            }
+        }
+        *placement = cursor.preview(*profile, bottom, hasClear, adjoiningClearances.contains(frame));
+        if (placement->clearance) adjoiningClearances.insert(frame);
+        const QFixed width = adjoiningWidth(frame, parent->x_right - parent->x_left);
+        const QFixed x = frame->frameFormat().layoutDirection() == Qt::RightToLeft
+            ? parent->x_right - adjoiningMargin(frame, 1) - width : parent->x_left + adjoiningMargin(frame, 3);
+        for (auto &exclusion : incoming) exclusion.position = exclusion.position - QFixedPoint(x, placement->top);
+        if (!prepareAdjoiningLeading(frame, width, parent->frameY + placement->top, &incoming, layoutFrom, layoutTo)) return false;
+        if (revision == adjoiningClearances.size()) return true;
+    }
+}
