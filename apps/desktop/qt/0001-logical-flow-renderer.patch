+qreal QTextDocumentLayoutPrivate::logicalHorizontalMinimum(QTextFrame *ancestor) const
+{
+    // Report only authenticated owned table overflow. This is a signed scroll
+    // origin, not a translation of document, line, or source coordinates.
+    qreal minimum = 0;
+    if (!paragraphBoxError) for (const auto &flow : std::as_const(logicalFlows)) {
+        if (!flow->current()) continue;
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || !QTextLogicalFlowProjection::inlineTable(object.frame)
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow
+                || data(object.frame)->layoutDirty || data(object.frame)->sizeDirty) continue;
+            auto *table = qobject_cast<QTextTable *>(object.frame.data());
+            if (!table) continue;
+            if (ancestor) {
+                QTextFrame *parent = table;
+                while (parent && parent != ancestor) parent = parent->parentFrame();
+                if (!parent) continue;
+            }
+            const qreal left = tableBoundingRectInternal(table).left();
+            if (std::isfinite(left) && left > -qreal(QFIXED_MAX)) minimum = qMin(minimum, left);
+        }
+    }
+    return minimum;
+}
+
+void QTextDocumentLayoutPrivate::updateLogicalHorizontalMinimum()
+{
+    const int rounded = qFloor(logicalHorizontalMinimum());
+    auto *layout = q_func();
+    const QVariant old = layout->property("_wikidictLogicalHorizontalMinimum");
+    if (rounded == 0 && !old.isValid()) return;
+    if (old.metaType().id() == QMetaType::Int && old.toInt() == rounded) return;
+    // A changed signed origin matters even if the reported positive extent
+    // stayed identical. Reuse the normal deferred scrollbar notification.
+    sizeChangedTimer.start(0, layout);
+    layout->setProperty("_wikidictLogicalHorizontalMinimum", rounded);
+}
