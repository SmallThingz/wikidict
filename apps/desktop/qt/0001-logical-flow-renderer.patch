+                    found = y + text->position().y() + line.y() + line.ascent();
+                    if (firstRow) break;
+                }
+            }
+            return found;
+        };
+        baseline = qMax(baseline, visit(visit, cell.begin(), cell.end(), cellY));
+    }
+    // An empty inline box has its baseline on its bottom margin edge.
+    return baseline < 0 ? td->size.height.toReal() : baseline;
