+class QTextLogicalFlowProjection
+{
+public:
+    enum class Kind { Text, Frame, Control };
+    struct Unit {
+        Kind kind = Kind::Text;
+        int first = -1;
+        int last = -1;
+        int frameIndex = -1;
+        QString language;
+        bool languagePresent = false;
+    };
+    struct Object {
+        QPointer<QTextFrame> frame;
+        int projectedPosition = -1;
+        int first = -1;
+        int last = -1;
+    };
+    struct Range { int start = 0; int length = 0; };
+    struct Interval {
+        int first = -1;
+        int last = -1;
+        Kind kind = Kind::Text;
+    };
+
+    static std::unique_ptr<QTextLogicalFlowProjection> create(
+            QTextDocument *document, const QVariantMap &description, QString *error)
+    {
+        auto result = std::unique_ptr<QTextLogicalFlowProjection>(new QTextLogicalFlowProjection(document));
+        if (!result->initialize(description, error))
+            return {};
+        return result;
+    }
+
+    // Authored paragraph separators are real layout boundaries. A registration
+    // owner may span them, but each paragraph keeps its original block format
+    // and its own native layout; frame-created storage joins remain intra-line.
+    static bool createGroup(QTextDocument *document, const QVariantMap &description,
+                            QList<std::shared_ptr<QTextLogicalFlowProjection>> *result, QString *error)
+    {
+        int first = -1, last = -1;
+        if (!document || !integer(description.value(QStringLiteral("first")), &first)
+            || !integer(description.value(QStringLiteral("last")), &last)
+            || first < 0 || last < first || last >= document->characterCount())
+            return refuse(error, "invalid logical paragraph-group bounds");
+        QList<QVariantList> paragraphs;
+        QList<int> boundaries;
+        if (!splitParagraphs(description.value(QStringLiteral("parts")), &paragraphs, &boundaries, 0, error))
+            return false;
+        int previousBoundary = first - 1;
+        for (int boundary : std::as_const(boundaries)) {
+            if (boundary <= previousBoundary || boundary < first || boundary >= last
+                || document->characterAt(boundary) != QChar::ParagraphSeparator)
+                return refuse(error, "invalid authored paragraph order");
+            previousBoundary = boundary;
+        }
+        const QVariant joinsValue = description.value(QStringLiteral("joins"));
+        if (joinsValue.metaType().id() != QMetaType::QVariantList)
+            return refuse(error, "joins must be an explicit list");
+        QList<int> joins;
+        for (const QVariant &value : joinsValue.toList()) {
+            int position = -1;
+            if (!integer(value, &position) || position < first || position >= last
+                || std::binary_search(boundaries.cbegin(), boundaries.cend(), position))
+                return refuse(error, "authored paragraph boundary cannot be a storage join");
+            joins.append(position);
+        }
+        std::sort(joins.begin(), joins.end());
+        int joinIndex = 0;
+        // Registration validates structure without requesting cursor geometry.
+        const QPointer<QTextFrame> parent = QTextDocumentPrivate::get(document)->frameAt(first);
+        const auto *table = qobject_cast<QTextTable *>(parent.data());
+        const QTextTableCell cell = table ? table->cellAt(first) : QTextTableCell();
+        QList<std::shared_ptr<QTextLogicalFlowProjection>> replacement;
+        int start = first;
+        for (int index = 0; index < paragraphs.size(); ++index) {
+            const int end = index < boundaries.size() ? boundaries.at(index) : last;
+            if (end < start || end > last || (index < boundaries.size()
+                && (end == last || document->characterAt(end) != QChar::ParagraphSeparator)))
+                return refuse(error, "invalid authored paragraph separator");
+            QVariantList segmentJoins;
+            while (joinIndex < joins.size() && joins.at(joinIndex) < end) {
+                if (joins.at(joinIndex) < start) return refuse(error, "join outside its paragraph");
+                segmentJoins.append(joins.at(joinIndex++));
+            }
+            QVariantMap segment = description;
+            segment.insert(QStringLiteral("first"), start);
+            segment.insert(QStringLiteral("last"), end);
+            segment.insert(QStringLiteral("parts"), paragraphs.at(index));
+            segment.insert(QStringLiteral("joins"), segmentJoins);
+            auto projection = create(document, segment, error);
+            if (!projection || projection->parentFrame() != parent
+                || (cell.isValid() && table->cellAt(start) != cell))
+                return refuse(error, "authored paragraphs cross their original flow container");
+            projection->groupFirst = first;
+            projection->groupLast = last;
+            replacement.append(std::shared_ptr<QTextLogicalFlowProjection>(std::move(projection)));
+            start = end + 1;
+        }
+        result->append(replacement);
+        return true;
+    }
+
+    bool current() const
+    {
+        return document && document->revision() == revision
+            && document->characterCount() == originalCharacterCount;
+    }
+    bool refreshLayoutInputs()
+    {
+        if (!current()) return false;
+        const QPaintDevice *device = document->documentLayout()->paintDevice();
+        const QFont paragraphFont = document->findBlock(first).charFormat().font();
+        const QFont font = device ? QFont(paragraphFont, device) : paragraphFont;
+        layout->setFont(font);
+        return current();
+    }
+    int ownerFirstPosition() const { return groupFirst; }
+    int ownerLastPosition() const { return groupLast; }
+    int firstPosition() const { return first; }
+    int lastPosition() const { return last; }
+    int revisionNumber() const { return revision; }
+    const QString &projectedText() const { return text; }
+    const QList<Unit> &sourceMap() const { return units; }
+    const QList<Object> &objects() const { return frames; }
+    QTextFrame *parentFrame() const { return parent; }
+    QTextLayout *textLayout() const { return layout.get(); }
+    Qt::LayoutDirection direction() const
+    {
+        if (baseDirection != Qt::LayoutDirectionAuto)
+            return baseDirection;
+        // Ordinary explicit block/default context retains priority. Do not use
+        // QTextBlock::textDirection(): the first storage block may be empty and
+        // real caption text belongs to an independent layout, not this body.
+        const auto blockDirection = document->findBlock(first).blockFormat().layoutDirection();
+        if (blockDirection != Qt::LayoutDirectionAuto)
+            return blockDirection;
+        const auto defaultDirection = document->defaultTextOption().textDirection();
+        if (defaultDirection != Qt::LayoutDirectionAuto)
+            return defaultDirection;
