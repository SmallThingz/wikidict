+// Private, versioned renderer-to-layout protocol. These are resolved placement
+// metrics, not source margins/padding. Unmarked blocks use the stock path.
+namespace {
+constexpr int WikidictParagraphBoxOwner = QTextFormat::UserProperty + 0x5760;
+constexpr int WikidictParagraphBoxStart = QTextFormat::UserProperty + 0x5761;
+constexpr int WikidictParagraphBoxEnd = QTextFormat::UserProperty + 0x5762;
+constexpr int WikidictParagraphBoxEmpty = QTextFormat::UserProperty + 0x5763;
+
+struct WikidictParagraphBoxMetrics {
+    bool owned = false;
+    bool empty = false;
+    int error = 0;
+    QFixed start;
+    QFixed end;
+};
+
+WikidictParagraphBoxMetrics wikidictParagraphBox(const QTextBlockFormat &format)
+{
+    WikidictParagraphBoxMetrics result;
+    if (format.property(WikidictParagraphBoxOwner).toString()
+        != QStringLiteral("wikidict.paragraph-box/2"))
+        return result;
+    const QVariant startValue = format.property(WikidictParagraphBoxStart);
+    const QVariant endValue = format.property(WikidictParagraphBoxEnd);
+    const QVariant emptyValue = format.property(WikidictParagraphBoxEmpty);
+    const qreal start = startValue.toDouble();
+    const qreal end = endValue.toDouble();
+    const qreal left = format.leftMargin();
+    const qreal right = format.rightMargin();
+    result.owned = true;
+    if (startValue.metaType().id() != QMetaType::Double
+        || endValue.metaType().id() != QMetaType::Double
+        || emptyValue.metaType().id() != QMetaType::Bool) {
+        result.error = 1; // malformed private projection, not a wire verdict
+        return result;
+    }
+    // Reject before conversion; finite source f32 values can exceed QFixed.
+    if (!qIsFinite(start) || !qIsFinite(end) || start < 0 || end < 0
+        || start > QFIXED_MAX || end > QFIXED_MAX
+        || !qIsFinite(left) || !qIsFinite(right) || left < 0 || right < 0
+        || left > QFIXED_MAX || right > QFIXED_MAX) {
+        result.error = 2; // unsupported platform geometry, never clamp
+        return result;
+    }
+    if (left + right > QFIXED_MAX) {
+        result.error = 4;
+        return result;
+    }
+    result.empty = emptyValue.toBool();
+    result.start = QFixed::fromReal(start);
+    result.end = QFixed::fromReal(end);
+    return result;
+}
