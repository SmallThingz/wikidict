+static qreal measuredTableBaseline(QTextTable *table, bool firstRow)
+{
+    auto *td = static_cast<QTextTableData *>(data(table));
+    qreal baseline = -1;
+    const int endRow = firstRow ? qMin(1, table->rows()) : table->rows();
+    for (int row = 0; row < endRow; ++row) for (int column = 0; column < table->columns(); ++column) {
+        const auto cell = table->cellAt(row, column);
+        if (cell.row() != row || cell.column() != column) continue;
+        const qreal cellY = td->cellPosition(table, cell).y.toReal();
+        const auto visit = [&](auto &&self, QTextFrame::iterator it, QTextFrame::iterator end, qreal y) -> qreal {
+            qreal found = -1;
+            for (; it != end; ++it) {
+                if (auto *child = it.currentFrame()) {
+                    if (child->frameFormat().position() != QTextFrameFormat::InFlow) continue;
+                    const qreal nested = qobject_cast<QTextTable *>(child)
+                        ? y + data(child)->position.y.toReal() + measuredTableBaseline(qobject_cast<QTextTable *>(child), firstRow)
+                        : self(self, child->begin(), child->end(), y + data(child)->position.y.toReal());
