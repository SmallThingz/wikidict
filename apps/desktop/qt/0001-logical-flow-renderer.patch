+static bool wikidictBalanceColumns(QList<WikidictColumnLine> &lines, int count,
+                                  QFixed stride, QFixed origin, bool rtl, QFixed *height)
+{
+    *height = QFixed();
+    if (lines.isEmpty()) return true;
+    const qsizetype size = lines.size();
+    QList<bool> legal(size + 1, false); legal[0] = legal[size] = true;
+    for (qsizetype begin = 0; begin < size;) {
+        qsizetype end = begin + 1;
+        while (end < size && lines[end].layout == lines[begin].layout) ++end;
+        legal[end] = true;
+        // Initial domain uses the native default two-line orphans/widows.
+        for (qsizetype split = begin + 2; split + 2 <= end; ++split) legal[split] = true;
+        begin = end;
+    }
+    qint64 upper = 0;
+    for (qsizetype i = 0; i < size; ++i) {
+        if (!lines[i].layout || lines[i].line < 0 || lines[i].line >= lines[i].layout->lineCount()
+            || lines[i].bottom < lines[i].top || (i && lines[i].top < lines[i - 1].top)) return false;
+        upper = qMax(upper, qint64(lines[i].bottom.value()) - lines[0].top.value());
+    }
+    const auto partition = [&](qint64 available, QList<qsizetype> *breaks) {
+        // Every reachable legal source boundary contributes an interval of
+        // fitting next boundaries. Keep the least-column predecessor for each
+        // boundary; a locally longest fragment can strand a widow later.
+        QList<qsizetype> fitEnd(size); std::deque<qsizetype> maxima;
+        qsizetype end = 0;
+        for (qsizetype start = 0; start < size; ++start) {
+            while (!maxima.empty() && maxima.front() < start) maxima.pop_front();
+            end = qMax(end, start);
+            const qint64 limit = qint64(lines[start].top.value()) + available;
+            while (end < size) {
+                const qint64 maximum = maxima.empty() ? lines[end].bottom.value()
+                    : qMax(lines[maxima.front()].bottom.value(), lines[end].bottom.value());
+                if (maximum > limit) break;
+                while (!maxima.empty() && lines[maxima.back()].bottom <= lines[end].bottom) maxima.pop_back();
+                maxima.push_back(end++);
+            }
+            fitEnd[start] = end;
+        }
+        struct Candidate { int cost; qsizetype end; qsizetype from; };
+        const auto later = [](const Candidate &a, const Candidate &b) {
+            return a.cost != b.cost ? a.cost > b.cost : a.from > b.from;
+        };
+        std::priority_queue<Candidate, std::vector<Candidate>, decltype(later)> active(later);
+        QList<QList<Candidate>> pending(size + 1);
+        QList<int> cost(size + 1, std::numeric_limits<int>::max());
+        QList<qsizetype> previous(size + 1, -1); cost[0] = 0;
+        const auto schedule = [&](qsizetype start) {
+            if (start == size || cost[start] >= count) return;
+            qsizetype first = start + 1;
+            const bool startsInside = start > 0 && lines[start - 1].layout == lines[start].layout;
+            const bool endsInside = first < size && lines[first].layout == lines[start].layout;
+            if (startsInside || endsInside) ++first;
+            if (first <= fitEnd[start]) pending[first].append({cost[start] + 1, fitEnd[start], start});
+        };
+        schedule(0);
+        for (qsizetype boundary = 1; boundary <= size; ++boundary) {
+            for (const auto &candidate : pending[boundary]) active.push(candidate);
+            while (!active.empty() && active.top().end < boundary) active.pop();
+            if (!legal[boundary] || active.empty()) continue;
+            cost[boundary] = active.top().cost; previous[boundary] = active.top().from;
+            schedule(boundary);
+        }
+        if (cost[size] > count) return false;
+        if (breaks) {
+            for (qsizetype boundary = size; boundary > 0; boundary = previous[boundary]) {
+                if (previous[boundary] < 0 || previous[boundary] >= boundary) return false;
+                breaks->prepend(boundary);
+            }
+        }
+        return true;
+    };
+    qint64 low = 0, high = upper;
+    while (low < high) {
+        const qint64 middle = low + (high - low) / 2;
+        if (partition(middle, nullptr)) high = middle; else low = middle + 1;
+    }
+    QList<qsizetype> breaks;
+    if (!partition(low, &breaks)) return false;
+    qsizetype start = 0;
+    for (qsizetype column = 0; column < breaks.size(); ++column) {
+        const int physical = rtl ? count - 1 - int(column) : int(column);
+        const qint64 x = qint64(physical) * stride.value();
+        if (x < 0 || x >= qint64(QFIXED_MAX) * 64) return false;
+        const QFixed top = lines[start].top;
+        for (qsizetype i = start; i < breaks[column]; ++i) {
+            const auto &fragment = lines[i];
+            QTextLine line = fragment.layout->lineAt(fragment.line);
+            // Move the actual native shaped line; its original string indexes,
+            // bidi runs, paragraph-end context and baseline offset stay intact.
+            line.setPosition(line.position() + QPointF(QFixed::fromFixed(int(x)).toReal(),
+                (origin - top).toReal()));
+            *height = qMax(*height, fragment.bottom - top);
+        }
+        start = breaks[column];
+    }
+    QSet<QTextLayout *> rebased;
+    for (const auto &fragment : lines) {
+        if (rebased.contains(fragment.layout)) continue;
+        rebased.insert(fragment.layout);
+        // Rebase only y so old flow height cannot inflate ink. Keep the common
+        // horizontal origin: a first RTL fragment is in the right column, and
+        // native cursorToX clamps negative ordinary line-local x to zero.
+        const QPointF delta(0, fragment.layout->lineAt(0).y());
+        fragment.layout->setPosition(fragment.layout->position() + delta);
+        for (int index = 0; index < fragment.layout->lineCount(); ++index) {
+            QTextLine line = fragment.layout->lineAt(index);
+            line.setPosition(line.position() - delta);
+        }
+    }
+    return true;
+}
