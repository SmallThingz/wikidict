+namespace QTextSourceProvenance {
+// Private generated-HTML protocol. Paired shaping ignores only valid Run metadata.
+inline constexpr int Run = QTextFormat::UserProperty + 0x57c0;
+inline constexpr int SeparatorRun = QTextFormat::UserProperty + 0x57c2;
+inline bool validRun(const QTextCharFormat &format)
+{
+    const QVariant run = format.property(Run);
+    return run.metaType().id() == QMetaType::Int && run.toInt() >= 0;
+}
+inline QTextCharFormat shapingFormat(QTextCharFormat format)
+{
+    if (validRun(format)) format.clearProperty(Run);
+    return format;
+}
+inline bool sameIgnoringRun(const QTextCharFormat &a, const QTextCharFormat &b)
+{
+    if ((!validRun(a) && !validRun(b))
+        || (a.hasProperty(Run) && !validRun(a))
+        || (b.hasProperty(Run) && !validRun(b)))
+        return false;
+    return shapingFormat(a) == shapingFormat(b);
+}
+}
+QT_END_NAMESPACE
