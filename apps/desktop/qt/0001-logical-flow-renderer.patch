+        }
+        return false;
+    }
+    qreal objectAscent(int position) const {
+        return layout->engine()->projectedFrameAscents.value(position).toReal();
+    }
+    static bool inlineTable(const QTextFrame *frame) {
+        const auto format = frame->frameFormat();
+        return format.stringProperty(QTextFormat::UserProperty + 0x57d0) == QStringLiteral("wikidict.table-box/1")
+            && format.intProperty(QTextFormat::UserProperty + 0x57d6) > 0;
+    }
+    void finishObjectSizes() { layout->setFormats(coalescedFormats()); }
+
+    qreal leadingSpaceWidth(const QTextLine &line) const
+    {
+        return layout->engine()->leadingSpaceWidth(
+            layout->engine()->lines.at(line.lineNumber())).toReal();
+    }
+
+    QFixed includedTrailingSpaceWidth(const QTextLine &line) const
+    {
+        if (!current() || !line.isValid()
+            || !(layout->textOption().flags() & QTextOption::IncludeTrailingSpaces))
+            return {};
+        const auto *engine = layout->engine();
+        if (line.lineNumber() < 0 || line.lineNumber() >= engine->lines.size())
+            return {};
+        const auto &metrics = engine->lines.at(line.lineNumber());
+        if (!metrics.hasTrailingSpaces || metrics.trailingSpaces <= 0)
+            return {};
+        return engine->width(metrics.from + metrics.length, metrics.trailingSpaces);
+    }
+
+    bool onlyIncludedTrailingSpacesOverflow(const QTextLine &line, QFixed available) const
+    {
+        const QFixed spaces = includedTrailingSpaceWidth(line);
+        if (spaces <= 0 || available < 0)
+            return false;
+        const auto &metrics = layout->engine()->lines.at(line.lineNumber());
+        // textWidth includes the final bearing and (with this option) pending
+        // whitespace. Keep both the visible width and advance within the flow;
+        // genuine word/glyph overflow still takes the ordinary findY path.
+        const QFixed visibleWidth = metrics.textWidth - spaces;
+        return metrics.textWidth > available && visibleWidth >= 0
+            && visibleWidth <= available && metrics.textAdvance <= available;
+    }
+
+    int hitTest(QPointF point, Qt::HitTestAccuracy accuracy) const
+    {
+        if (!current())
+            return -1;
+        point -= layout->position();
+        int closest = -1;
+        qreal distance = std::numeric_limits<qreal>::max();
+        for (int i = 0; i < layout->lineCount(); ++i) {
+            const QTextLine line = layout->lineAt(i);
+            const QRectF box = line.naturalTextRect();
+            if (accuracy == Qt::ExactHit && !box.contains(point))
+                continue;
+            const qreal dy = point.y() < box.top() ? box.top() - point.y()
+                : point.y() > box.bottom() ? point.y() - box.bottom() : 0;
+            if (dy > distance)
+                continue;
+            distance = dy;
+            closest = line.xToCursor(point.x(), accuracy == Qt::ExactHit
+                ? QTextLine::CursorOnCharacter : QTextLine::CursorBetweenCharacters);
+            if (!dy)
+                break;
+        }
+        return closest < 0 ? -1 : toDocument(closest);
+    }
+
+    QRectF cursorRect(int documentPosition, qreal cursorWidth = 1) const
+    {
+        const int projected = toProjected(documentPosition);
+        if (projected < 0)
+            return {};
+        const QTextLine line = layout->lineForTextPosition(projected);
+        if (!line.isValid())
+            return {};
+        return QRectF(layout->position().x() + line.cursorToX(projected),
+                      layout->position().y() + line.y(), cursorWidth, line.height());
+    }
+
+    int visualMove(int documentPosition, bool right) const
+    {
+        int position = toProjected(documentPosition);
+        if (position < 0)
+            return -1;
+        const int original = documentPosition;
+        // Qt owns grapheme and bidi movement. Skip only synthetic control stops.
+        for (int count = 0; count <= units.size(); ++count) {
+            const int next = right ? layout->rightCursorPosition(position)
+                                   : layout->leftCursorPosition(position);
+            if (next == position)
+                return -1;
+            position = next;
+            const int mapped = toDocument(position);
+            if (mapped >= 0 && mapped != original)
+                return mapped;
+        }
+        return -1;
+    }
+
+    int logicalMove(int documentPosition, bool forward) const
+    {
+        int position = toProjected(documentPosition);
+        if (position < 0) return -1;
+        if (forward && position < units.size() && units.at(position).kind == Kind::Frame)
+            return units.at(position).first + 1; // Enter the real caption document interval.
+        for (int count = 0; count <= units.size(); ++count) {
+            const int next = forward ? layout->nextCursorPosition(position)
+                                     : layout->previousCursorPosition(position);
+            if (next == position) return -1; // Let native movement leave this owner.
+            position = next;
+            if (!forward && position < units.size() && units.at(position).kind == Kind::Frame)
+                return units.at(position).last - 1;
+            const int mapped = toDocument(position);
+            if (mapped >= 0 && mapped != documentPosition) return mapped;
+        }
+        return -1;
+    }
