+bool QTextDocumentLayoutPrivate::validateTableFloatViewport(QTextFrame *frame)
+{
+    const auto format = frame->frameFormat();
+    if (!format.hasProperty(WikidictTableFloatViewport)) return true;
+    const auto fail = [&](int error) { refuseParagraphBox(error, frame->firstPosition()); return false; };
+#if !QT_CONFIG(harfbuzz)
+    return fail(1);
+#endif
+    auto *table = qobject_cast<QTextTable *>(frame);
+    const auto raw = format.property(WikidictTableFloatViewport);
+    const auto policy = raw.toMap();
+    if (!table || table->document() != document || table->parentFrame() != document->rootFrame()
+        || table->rows() < 1 || table->columns() < 1
+        || document->object(table->objectIndex()) != table
+        || (format.hasProperty(QTextFormat::ObjectIndex) && format.objectIndex() != table->objectIndex())
+        || format.stringProperty(WikidictTableBoxOwner) != QStringLiteral("wikidict.table-box/1")
+        || format.hasProperty(WikidictTableViewport) || format.hasProperty(WikidictTableViewportGrid)
+        || format.hasProperty(WikidictTableAutoMargins) || format.hasProperty(WikidictTableHasCaption)
+        || format.hasProperty(WikidictTableDisplay) || format.hasProperty(WikidictTableVerticalAlign)
+        || format.hasProperty(WikidictTableLineHeight) || format.hasProperty(WikidictTableBoxWidth)
+        || format.hasProperty(WikidictTableBoxPadding) || QTextLogicalFlowProjection::inlineTable(table)
+        || raw.metaType().id() != QMetaType::QVariantMap || policy.size() != 11)
+        return fail(1);
+    const auto exact = [&](const char *key, int type) { return policy.value(QLatin1StringView(key)).metaType().id() == type; };
+    if (!exact("capability", QMetaType::QString) || !exact("source", QMetaType::QByteArray)
+        || !exact("threshold", QMetaType::Double) || !exact("viewport", QMetaType::Double)
+        || !exact("active", QMetaType::Bool) || !exact("body_pixels", QMetaType::Double)
+        || !exact("direction", QMetaType::Int) || !exact("grid_direction", QMetaType::Int)
+        || !exact("language", QMetaType::QString) || !exact("margins", QMetaType::QVariantList)
+        || !exact("base_format", QMetaType::QTextFormat)
+        || policy.value(QStringLiteral("capability")).toString() != QStringLiteral("wikidict.table-float-viewport/1"))
+        return fail(1);
+    const qreal threshold = policy.value(QStringLiteral("threshold")).toDouble();
+    const qreal viewport = policy.value(QStringLiteral("viewport")).toDouble();
+    const qreal body = policy.value(QStringLiteral("body_pixels")).toDouble();
+    const int direction = policy.value(QStringLiteral("direction")).toInt();
+    const int gridDirection = policy.value(QStringLiteral("grid_direction")).toInt();
+    const auto language = policy.value(QStringLiteral("language")).toString();
+    if (!qIsFinite(threshold) || threshold <= 0 || threshold > 4294967295.0 || std::floor(threshold) != threshold
+        || !qIsFinite(viewport) || viewport < 0 || !qIsFinite(body) || body <= 0
+        || (direction != Qt::LeftToRight && direction != Qt::RightToLeft)
+        || (gridDirection != Qt::LeftToRight && gridDirection != Qt::RightToLeft)
+        || !wikidictSourceLanguageTag(language)) return fail(1);
+    const bool active = policy.value(QStringLiteral("active")).toBool();
+    if (active != (viewport <= threshold)
+        || format.position() != (active ? QTextFrameFormat::InFlow : QTextFrameFormat::FloatRight)
+        || format.layoutDirection() != gridDirection
+        || format.property(QTextFormat::UserProperty + 0x57fa).metaType().id() != QMetaType::QString
+        || format.stringProperty(QTextFormat::UserProperty + 0x57fa) != language)
+        return fail(1);
+    const auto decoded = QJsonDocument::fromJson(policy.value(QStringLiteral("source")).toByteArray());
+    const auto source = decoded.object();
+    const auto sourcePolicy = source.value(QStringLiteral("float_viewport")).toObject();
+    const auto style = source.value(QStringLiteral("style")).toObject();
+    const auto sourceRows = source.value(QStringLiteral("rows")).toArray();
+    if (!decoded.isObject() || source.size() != 3 || sourcePolicy.size() != 4 || style.isEmpty()
+        || !source.value(QStringLiteral("rows")).isArray() || sourceRows.size() != table->rows()
+        || !sourcePolicy.value(QStringLiteral("max_viewport_width_px")).isDouble()
+        || sourcePolicy.value(QStringLiteral("max_viewport_width_px")).toDouble() != threshold
+        || sourcePolicy.value(QStringLiteral("containing_direction")) != (direction == Qt::RightToLeft ? QStringLiteral("rtl") : QStringLiteral("ltr"))
+        || sourcePolicy.value(QStringLiteral("grid_direction")) != (gridDirection == Qt::RightToLeft ? QStringLiteral("rtl") : QStringLiteral("ltr"))
+        || sourcePolicy.value(QStringLiteral("language")) != language
+        || style.value(QStringLiteral("float_side")) != QStringLiteral("right")) return fail(1);
+    const QStringList styleFields{"background", "border", "collapse", "margins", "margin_values", "containing_direction",
+        "float_side", "width", "padding", "clear", "display", "vertical_align", "line_height"};
+    for (auto it = style.begin(); it != style.end(); ++it)
+        if (!styleFields.contains(it.key())) return fail(1);
+    for (const auto *key : {"width", "padding", "margin_values", "containing_direction", "display", "vertical_align", "line_height"}) {
+        const auto value = style.value(QLatin1StringView(key));
+        if (!value.isUndefined() && !value.isNull()) return fail(1);
+    }
+    const auto sourceMargins = style.value(QStringLiteral("margins")).toObject();
+    const auto margins = policy.value(QStringLiteral("margins")).toList();
+    if (sourceMargins.size() != 4 || margins.size() != 4) return fail(1);
+    const qreal actual[] = {format.topMargin(), format.rightMargin(), format.bottomMargin(), format.leftMargin()};
+    int side = 0;
+    for (const auto *name : {"top", "right", "bottom", "left"}) {
+        const auto length = sourceMargins.value(QLatin1StringView(name)).toObject();
+        const auto unit = length.value(QStringLiteral("unit"));
+        const auto amount = length.value(QStringLiteral("value"));
+        if (length.size() != 2 || !unit.isString() || (unit != QStringLiteral("px") && unit != QStringLiteral("em"))
+            || !amount.isDouble() || !qIsFinite(amount.toDouble()) || amount.toDouble() < 0
+            || margins[side].metaType().id() != QMetaType::Double) return fail(1);
+        const qreal resolved = amount.toDouble() * (unit == QStringLiteral("em") ? body : 1.0);
+        const qreal deviceMargin = scaleToDevice(resolved);
+        if (!qIsFinite(resolved) || resolved < 0 || !qIsFinite(deviceMargin)
+            || deviceMargin < 0 || deviceMargin >= qreal(QFIXED_MAX)) return fail(2);
+        if (margins[side].toDouble() != resolved || actual[side] != resolved) return fail(1);
+        ++side;
+    }
+    auto expected = policy.value(QStringLiteral("base_format")).value<QTextFormat>();
+    if (!expected.isTableFormat() || expected.hasProperty(WikidictTableFloatViewport)
+        || expected.hasProperty(QTextFormat::ObjectIndex)) return fail(1);
+    auto expectedTable = expected.toTableFormat();
+    expectedTable.setPosition(active ? QTextFrameFormat::InFlow : QTextFrameFormat::FloatRight);
+    auto current = format; current.clearProperty(QTextFormat::ObjectIndex); current.clearProperty(WikidictTableFloatViewport);
+    if (QTextFormat(current) != QTextFormat(expectedTable)) return fail(1);
+    // Source owner language is independent of the document/UI language. The
+    // existing imported run language property may carry explicit span overrides.
+    for (int row = 0; row < table->rows(); ++row) {
+        if (!sourceRows[row].isArray()) return fail(1);
+        const auto cells = sourceRows[row].toArray();
+        int sourceIndex = 0;
+        for (int column = 0; column < table->columns(); ++column) {
+            const auto cell = table->cellAt(row, column);
+            if (cell.row() != row || cell.column() != column) continue;
+            const auto cellFormat = cell.format().toTableCellFormat();
+            if (cellFormat.property(QTextFormat::UserProperty + 0x57fa).metaType().id() != QMetaType::QString
+                || cellFormat.stringProperty(QTextFormat::UserProperty + 0x57fa) != language)
+                return fail(1);
+            if (sourceIndex < cells.size()) {
+                const auto shape = cells[sourceIndex++].toObject();
+                if (shape.value(QStringLiteral("rowspan")).toInt() != cell.rowSpan()
+                    || shape.value(QStringLiteral("colspan")).toInt() != cell.columnSpan()
+                    || cellFormat.hasProperty(WikidictTableFloatViewportFiller)) return fail(1);
+                continue;
+            }
+            // These are the native rectangularization slots, not authored
+            // empty cells. Their source row has no remaining cell record.
+            const auto marker = cellFormat.property(WikidictTableFloatViewportFiller);
+            const auto block = document->findBlock(cell.firstPosition());
+            if (marker.metaType().id() != QMetaType::Bool || !marker.toBool()
+                || cell.rowSpan() != 1 || cell.columnSpan() != 1
+                || cell.firstPosition() != cell.lastPosition() || !block.isValid()
+                || block.position() != cell.firstPosition() || block.length() != 1
+                || !block.text().isEmpty() || !block.charFormat().anchorNames().isEmpty()
+                || !block.charFormat().anchorHref().isEmpty()
+                || cellFormat.topPadding() != 0 || cellFormat.rightPadding() != 0
+                || cellFormat.bottomPadding() != 0 || cellFormat.leftPadding() != 0
+                || cellFormat.topBorder() != 0 || cellFormat.rightBorder() != 0
+                || cellFormat.bottomBorder() != 0 || cellFormat.leftBorder() != 0
+                || cellFormat.topBorderStyle() != QTextFrameFormat::BorderStyle_None
+                || cellFormat.rightBorderStyle() != QTextFrameFormat::BorderStyle_None
+                || cellFormat.bottomBorderStyle() != QTextFrameFormat::BorderStyle_None
+                || cellFormat.leftBorderStyle() != QTextFrameFormat::BorderStyle_None
+                || cellFormat.topBorderBrush() != QBrush(QColor(Qt::transparent))
+                || cellFormat.rightBorderBrush() != QBrush(QColor(Qt::transparent))
+                || cellFormat.bottomBorderBrush() != QBrush(QColor(Qt::transparent))
+                || cellFormat.leftBorderBrush() != QBrush(QColor(Qt::transparent))
+                || cellFormat.hasProperty(QTextFormat::UserProperty + 0x57f0)
+                || cellFormat.hasProperty(WikidictCellHiddenEdges)
+                || cellFormat.hasProperty(WikidictCellLineHeight)
+                || cellFormat.hasProperty(WikidictCellWidth)
+                || cellFormat.hasProperty(WikidictCellMinimumWidth)) return fail(1);
+            auto it = cell.begin();
+            if (it.atEnd() || it.currentFrame() || it.currentBlock() != block) return fail(1);
+            if (++it != cell.end()) return fail(1);
+        }
+        if (sourceIndex != cells.size()) return fail(1);
+    }
+    return true;
+}
+
+bool QTextDocumentLayoutPrivate::tableAutoMarginPosition(QTextFrame *frame, QFixed left, QFixed right, QFixed *position)
+{
+    const auto format = frame->frameFormat();
+    if (wikidictTableViewportGrid(frame) && wikidictTableViewportActive(frame->parentFrame())) {
+        if (!validateTableViewport(frame->parentFrame())) return false;
+        const auto policy = frame->parentFrame()->frameFormat().property(WikidictTableViewport).toMap();
+        const qint64 solved = policy.value(QStringLiteral("grid_direction")).toInt() == Qt::RightToLeft
+            && right - left != QFixed(QFIXED_MAX) ? qint64(right.value()) - data(frame)->size.width.value() : left.value();
+        if (!checkParagraphBoxExtent(qAbs(solved), frame->firstPosition())) return false;
+        *position = QFixed::fromFixed(int(solved)); return true;
+    }
+    if (format.hasProperty(WikidictTableFloatViewport)) {
+        if (!validateTableFloatViewport(frame)) return false;
+        const auto policy = format.property(WikidictTableFloatViewport).toMap();
+        const auto *fd = data(frame);
+        const qint64 width = fd->size.width.value();
+        const qint64 available = qint64(right.value()) - left.value();
+        const bool fromRight = format.position() == QTextFrameFormat::FloatRight
+            || policy.value(QStringLiteral("direction")).toInt() == Qt::RightToLeft;
+        const qint64 solved = fromRight && available != QFixed(QFIXED_MAX).value()
+            ? qint64(right.value()) - width : left.value();
+        // The frame size includes fixed margins; bound every physical edge
+        // before narrowing the signed overflow origin back to QFixed.
+        if (!checkParagraphBoxExtent(width, frame->firstPosition())
+            || !checkParagraphBoxExtent(qAbs(solved), frame->firstPosition())
+            || !checkParagraphBoxExtent(qAbs(solved + width), frame->firstPosition())
+            || !checkParagraphBoxExtent(qAbs(solved + fd->leftMargin.value()), frame->firstPosition())
+            || !checkParagraphBoxExtent(qAbs(solved + width - fd->rightMargin.value()), frame->firstPosition())) return false;
+        *position = QFixed::fromFixed(int(solved)); return true;
+    }
+    if (!format.hasProperty(WikidictTableAutoMargins) || format.position() != QTextFrameFormat::InFlow
+        || QTextLogicalFlowProjection::inlineTable(frame)) return true;
+    if (!wikidictTableAutoMargins(format)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+    const auto policy = format.property(WikidictTableAutoMargins).toMap();
+    const auto autos = policy.value(QStringLiteral("autos")).toList();
+    const auto direction = Qt::LayoutDirection(policy.value(QStringLiteral("direction")).toInt());
+    // Native size includes the two fixed margins. Automatic margins were zero
+    // during table measurement, so this uses its final intrinsic/used width.
+    const qint64 remaining = qint64(right.value()) - left.value() - data(frame)->size.width.value();
+    qint64 offset = 0;
+    if (right - left != QFixed(QFIXED_MAX)) {
+        if (remaining >= 0 && autos[3].toBool()) offset = autos[1].toBool() ? remaining / 2 : remaining;
+        else if (remaining < 0 && direction == Qt::RightToLeft) offset = remaining;
+    }
+    const qint64 solved = qint64(left.value()) + offset;
+    if (!checkParagraphBoxExtent(qAbs(solved), frame->firstPosition())) return false;
+    *position = QFixed::fromFixed(int(solved));
+    return true;
+}
+
+bool QTextDocumentLayoutPrivate::validateTableBox(QTextFrame *frame, qreal availableWidth)
+{
+    if (!validateTableFloatViewport(frame)) return false;
+    const QTextFrameFormat format = frame->frameFormat();
+    if (format.hasProperty(WikidictTableViewportGrid)
+        && (!wikidictTableViewportGrid(frame) || !validateTableViewport(frame->parentFrame()))) {
+        refuseParagraphBox(1, frame->firstPosition()); return false;
+    }
+    if (!wikidictTableAutoMargins(format)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+    if (isWikidictEmptyTable(format)) {
+        if (format.hasProperty(WikidictTablePhysicalEdges)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+        return validateEmptyTableBox(frame, availableWidth);
+    }
+    if (!format.hasProperty(WikidictTableBoxOwner)) {
+        if (format.hasProperty(WikidictTableAutoMargins)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+        if (format.hasProperty(WikidictTablePhysicalEdges)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+        if (auto *table = qobject_cast<QTextTable *>(frame)) {
+            for (int row = 0; row < table->rows(); ++row) for (int column = 0; column < table->columns(); ++column)
+                if (table->cellAt(row, column).format().hasProperty(WikidictCellHiddenEdges)) {
+                    refuseParagraphBox(1, frame->firstPosition()); return false;
+                }
+            auto *td = static_cast<QTextTableData *>(data(table));
+            td->wikidictEdges = td->wikidictWidth = td->wikidictGrowWidth = false;
+        }
+        return true;
+    }
+    const auto fail = [&](int error) {
+        refuseParagraphBox(error, frame->firstPosition());
+        return false;
+    };
+    auto *table = qobject_cast<QTextTable *>(frame);
+    if (!table || format.property(WikidictTableBoxOwner).metaType().id() != QMetaType::QString
+        || format.stringProperty(WikidictTableBoxOwner) != QStringLiteral("wikidict.table-box/1")
+        || (!format.hasProperty(WikidictTableBoxPadding) && !format.hasProperty(WikidictTableBoxClear)
+            && !format.hasProperty(WikidictTableBoxWidth) && !format.hasProperty(WikidictTableDisplay)
+            && !format.hasProperty(WikidictTableVerticalAlign) && !format.hasProperty(WikidictTableLineHeight)
+            && !format.hasProperty(WikidictCellStylePolicy) && !format.hasProperty(WikidictTableAutoMargins))) return fail(1);
+    if (format.hasProperty(WikidictCellStylePolicy)
+        && (format.property(WikidictCellStylePolicy).metaType().id() != QMetaType::QString
+            || format.stringProperty(WikidictCellStylePolicy) != QStringLiteral("wikidict.cell-style/1"))) return fail(1);
+    for (const int property : {WikidictTableDisplay, WikidictTableVerticalAlign}) {
+        if (!format.hasProperty(property)) continue;
+        const auto value = format.property(property);
+        const int maximum = 2;
+        if (value.metaType().id() != QMetaType::Int || value.toInt() < 0 || value.toInt() > maximum) return fail(1);
+    }
+    if (format.intProperty(WikidictTableVerticalAlign) == 2 && !QTextLogicalFlowProjection::inlineTable(frame))
+        return fail(1);
+    if (format.hasProperty(WikidictTableLineHeight)) {
+        const auto value = format.property(WikidictTableLineHeight);
+        if (value.metaType().id() != QMetaType::Double || !std::isfinite(value.toDouble())
+            || value.toDouble() <= 0 || value.toDouble() >= qreal(QFIXED_MAX)) return fail(1);
+    }
+    if (QTextLogicalFlowProjection::inlineTable(frame)) {
+        if (format.position() != QTextFrameFormat::InFlow) return fail(1);
+        bool registered = false;
+        for (const auto &flow : std::as_const(logicalFlows)) for (const auto &object : flow->objects())
+            if (object.frame == frame) registered = true;
+        if (!registered) return fail(1);
+    }
+    auto *td = static_cast<QTextTableData *>(data(table));
+    if (format.hasProperty(WikidictTableHasCaption)) {
+        const auto marker = format.property(WikidictTableHasCaption);
+        if (marker.metaType().id() != QMetaType::Bool || !marker.toBool()
+            || (!format.hasProperty(WikidictTableAutoMargins) && !wikidictTableViewportGrid(frame))
+            || wikidictTableCaptionBlocks(table).isEmpty()) return fail(1);
+    } else td->wikidictCaptionMinimum = QFixed();
+    if (td->wikidictContainingWidth >= 0) availableWidth = td->wikidictContainingWidth;
+    if (!std::isfinite(availableWidth) || availableWidth < 0 || availableWidth > qreal(QFIXED_MAX)) return fail(2);
+    const auto representable = [](qreal value) {
+        return std::isfinite(value) && value >= 0 && value < qreal(QFIXED_MAX);
+    };
+    const auto finiteDouble = [&](const QVariant &value) {
+        return value.metaType().id() == QMetaType::Double
+            && std::isfinite(value.toDouble()) && value.toDouble() >= 0;
+    };
+    if (format.hasProperty(WikidictTablePhysicalEdges)) {
+        WikidictPhysicalEdges edges;
+        if (format.border() != 0 || format.borderStyle() != QTextFrameFormat::BorderStyle_None
+            || format.stringProperty(WikidictCellStylePolicy) != QStringLiteral("wikidict.cell-style/1")
+            || !wikidictPhysicalEdges(format.property(WikidictTablePhysicalEdges), &edges)
+            || document->pageSize().height() > 0) return fail(1);
+        for (int i = 0; i < 4; ++i)
+            if (edges.padding[i] != 0 || !representable(scaleToDevice(edges.width[i]))) return fail(2);
+#ifdef QT_NO_CSSPARSER
+        return fail(1);
+#endif
+    }
+    td->wikidictEdges = format.hasProperty(WikidictTableBoxPadding);
+    td->wikidictWidth = format.hasProperty(WikidictTableBoxWidth);
+    td->wikidictGrowWidth = td->wikidictWidth;
+    if (format.hasProperty(WikidictTableBoxClear)) {
+        const QVariant clear = format.property(WikidictTableBoxClear);
+        if (clear.metaType().id() != QMetaType::Int || clear.toInt() < 0 || clear.toInt() > 3) return fail(1);
+    }
+    if (td->wikidictEdges) {
+        const QVariant value = format.property(WikidictTableBoxPadding);
+        if (value.metaType().id() != QMetaType::QVariantList) return fail(1);
+        const QVariantList edges = value.toList();
+        if (edges.size() != 4) return fail(1);
+        for (int edge = 0; edge < 4; ++edge) {
+            if (!finiteDouble(edges[edge])) return fail(1);
+            // Collapsed borders have no used table padding. Retain authored
+            // values in the format, including otherwise huge finite values.
+            const qreal used = table->format().borderCollapse() ? 0 : scaleToDevice(edges[edge].toDouble());
+            if (!representable(used)) return fail(2);
+            td->wikidictPadding[edge] = QFixed::fromReal(used);
+        }
+    }
+    // Validate the ordinary metrics before any conversion/addition below.
+    qreal horizontal = 0, vertical = 0;
+    for (qreal value : {format.topMargin(), format.bottomMargin(), format.leftMargin(),
+                       format.rightMargin(), format.border(), format.padding(), table->format().cellPadding(),
+                       table->format().cellSpacing()}) {
+        if (!representable(scaleToDevice(value))) return fail(2);
+    }
+    for (int row = 0; row < table->rows(); ++row) {
+        for (int column = 0; column < table->columns(); ++column) {
+            const auto cell = table->cellAt(row, column);
+            if (cell.row() != row || cell.column() != column) continue;
+            const auto cellFormat = cell.format();
+            if (cellFormat.hasProperty(WikidictCellHiddenEdges)) {
+                const auto mask = cellFormat.property(WikidictCellHiddenEdges);
+                if (format.stringProperty(WikidictCellStylePolicy) != QStringLiteral("wikidict.cell-style/1")
+                    || mask.metaType().id() != QMetaType::Int || mask.toInt() < 0 || mask.toInt() > 15) return fail(1);
+                const int widths[] = {QTextFormat::TableCellTopBorder, QTextFormat::TableCellRightBorder,
+                    QTextFormat::TableCellBottomBorder, QTextFormat::TableCellLeftBorder};
+                const int styles[] = {QTextFormat::TableCellTopBorderStyle, QTextFormat::TableCellRightBorderStyle,
+                    QTextFormat::TableCellBottomBorderStyle, QTextFormat::TableCellLeftBorderStyle};
+                for (int i = 0; i < 4; ++i) if ((mask.toInt() & (1 << i))
+                    && (cellFormat.doubleProperty(widths[i]) != 0 || cellFormat.intProperty(styles[i]) != QTextFrameFormat::BorderStyle_None)) return fail(1);
+            }
+            for (auto property : {QTextFormat::TableCellTopPadding, QTextFormat::TableCellBottomPadding,
+                    QTextFormat::TableCellLeftPadding, QTextFormat::TableCellRightPadding,
+                    QTextFormat::TableCellTopBorder, QTextFormat::TableCellBottomBorder,
+                    QTextFormat::TableCellLeftBorder, QTextFormat::TableCellRightBorder}) {
+                if (cellFormat.hasProperty(property)
+                    && !representable(scaleToDevice(cellFormat.doubleProperty(property)))) return fail(2);
+            }
+        }
+    }
+    horizontal = scaleToDevice(format.leftMargin()) + scaleToDevice(format.rightMargin())
+        + 2 * scaleToDevice(format.border()) + (td->wikidictEdges
+            ? td->wikidictPadding[1].toReal() + td->wikidictPadding[3].toReal()
+            : 3 * scaleToDevice(format.padding()));
+    vertical = scaleToDevice(format.topMargin()) + scaleToDevice(format.bottomMargin())
+        + 2 * scaleToDevice(format.border()) + (td->wikidictEdges
+            ? td->wikidictPadding[0].toReal() + td->wikidictPadding[2].toReal()
+            : 3 * scaleToDevice(format.padding()));
+    if (!representable(horizontal) || !representable(vertical)) return fail(2);
+    if (td->wikidictWidth) {
+        const QVariant value = format.property(WikidictTableBoxWidth);
+        if (value.metaType().id() != QMetaType::QVariantMap) return fail(1);
+        const QVariantMap width = value.toMap();
+        if (width.size() != 2 || width.value(QStringLiteral("unit")).metaType().id() != QMetaType::QString
+            || !finiteDouble(width.value(QStringLiteral("value")))) return fail(1);
+        const QString unit = width.value(QStringLiteral("unit")).toString();
+        const double number = width.value(QStringLiteral("value")).toDouble();
+        if (unit != QStringLiteral("fixed") && unit != QStringLiteral("percent")) return fail(1);
+        // A percentage has no resolved containing size during intrinsic cell
+        // measurement. Measure its contents, then resolve in the actual cell.
+        const bool intrinsicPercent = unit == QStringLiteral("percent") && availableWidth == qreal(QFIXED_MAX);
+        td->wikidictGrowWidth = !intrinsicPercent;
+        const qreal requested = intrinsicPercent ? availableWidth
+            : unit == QStringLiteral("fixed") ? scaleToDevice(number) : availableWidth * (number / 100.0);
+        if (!intrinsicPercent && (!representable(requested)
+            || !representable(requested + scaleToDevice(format.leftMargin()) + scaleToDevice(format.rightMargin())))) return fail(2);
+        td->wikidictRequestedWidth = requested;
+    } else {
+        const qreal legacyWidth = format.width().type() == QTextLength::FixedLength
+            ? scaleToDevice(format.width().rawValue()) : format.width().value(availableWidth);
+        if (legacyWidth != qreal(QFIXED_MAX) && !representable(legacyWidth)) return fail(2);
+    }
+    if (format.height().type() == QTextLength::FixedLength && !representable(format.height().rawValue())) return fail(2);
+    return true;
+}
+
+bool QTextDocumentLayoutPrivate::validateMissingFigureLabel(const QTextBlock &block) const
+{
+    constexpr int ownerProperty = QTextFormat::UserProperty + 0x57a0;
+    constexpr int roleProperty = ownerProperty + 4;
+    constexpr int helperOwnerProperty = ownerProperty + 8;
+    const auto marker = block.blockFormat().property(ownerProperty + 12);
+    if (marker.metaType().id() != QMetaType::QString
+        || marker.toString() != QStringLiteral("wikidict.figure-missing-word-wrap/1")
+        || block.blockFormat().nonBreakableLines()) return false;
+    QTextFrame *label = document->frameAt(block.position());
+    QTextFrame *image = label ? label->parentFrame() : nullptr;
+    QTextFrame *figure = image ? image->parentFrame() : nullptr;
+    if (wikidictFigureTableCaptionFrame(image)) figure = wikidictFigureTableCaptionRoot(image);
+    if (!figure || !label->childFrames().isEmpty()) return false;
+    const auto role = [&](QTextFrame *frame, const QString &expected, bool helper) {
+        const auto format = frame->frameFormat();
+        const auto owner = format.property(ownerProperty);
+        const auto actualRole = format.property(roleProperty);
+        const auto parent = format.property(helperOwnerProperty);
+        return owner.metaType().id() == QMetaType::QString
+            && owner.toString() == QStringLiteral("wikidict.figure-layout/1")
+            && actualRole.metaType().id() == QMetaType::QString && actualRole.toString() == expected
+            && (!helper || (parent.metaType().id() == QMetaType::Int
+                && parent.toInt() == figure->objectIndex()
+                && format.position() == QTextFrameFormat::InFlow));
+    };
+    if (!role(label, QStringLiteral("missing-label"), true)
+        || !role(image, QStringLiteral("image"), true)
+        || !role(figure, QStringLiteral("figure"), false)) return false;
+    const auto width = label->frameFormat().width();
+    if (width.type() != QTextLength::FixedLength || !qIsFinite(width.rawValue())
+        || width.rawValue() <= 0 || width.rawValue() >= QFIXED_MAX) return false;
+    const auto metadata = figure->frameFormat().property(ownerProperty + 3);
+    if (metadata.metaType().id() != QMetaType::QByteArray) return false;
+    QJsonParseError error;
+    const auto json = QJsonDocument::fromJson(metadata.toByteArray(), &error);
+    if (error.error != QJsonParseError::NoError || !json.isObject()) return false;
+    const auto sourceFigure = json.object().value(QStringLiteral("figure"));
+    if (!sourceFigure.isObject()) return false;
+    const auto source = sourceFigure.toObject();
+    if (!source.value(QStringLiteral("missing_content")).isObject()
+        || source.contains(QStringLiteral("image_span")) || source.contains(QStringLiteral("sizing"))) return false;
+    for (auto it = label->begin(); !it.atEnd(); ++it) {
+        const auto child = it.currentBlock();
+        if (!child.isValid()) return false;
+        for (auto fragment = child.begin(); !fragment.atEnd(); ++fragment)
+            if (fragment.fragment().charFormat().isImageFormat()) return false;
+    }
+    // Properties alone cannot opt ordinary text into this source-specific rule.
+    // The actual outer frame must belong to a current registered logical flow.
+    for (const auto &flow : logicalFlows) {
+        if (!flow->current()) continue;
+        for (const auto &object : flow->objects())
+            if (object.frame == figure) return true;
+    }
+    return false;
+}
+
+bool QTextDocumentLayoutPrivate::validateFigureTableCaption(QTextFrame *frame)
+{
+    Q_Q(QTextDocumentLayout);
+    const auto format = frame->frameFormat();
+    if (!format.hasProperty(WikidictFigureTableCaption)) return true;
+    const auto fail = [&] { refuseParagraphBox(1, frame->firstPosition()); return false; };
+    auto *figure = wikidictFigureTableCaptionRoot(frame);
+    if (!figure) return fail();
+    const auto metadata = figure->frameFormat().property(WikidictFigureOwner + 3);
+    if (metadata.metaType().id() != QMetaType::QByteArray) return fail();
+    QJsonParseError error;
+    const auto meta = QJsonDocument::fromJson(metadata.toByteArray(), &error);
+    const auto source = meta.object().value(QStringLiteral("figure")).toObject();
+    const auto layout = source.value(QStringLiteral("table_caption_layout")).toObject();
+    if (error.error != QJsonParseError::NoError || !meta.isObject()
+        || layout.value(QStringLiteral("collapse")) != QStringLiteral("collapse")
+        || source.value(QStringLiteral("frame_border")).toObject().value(QStringLiteral("kind")) != QStringLiteral("none")
+        || source.value(QStringLiteral("image_span")).toObject().value(QStringLiteral("image")).toObject()
+            .value(QStringLiteral("static_poster")).isObject()) return fail();
+    bool registered = false;
+    for (const auto &flow : logicalFlows) if (flow->current())
+        for (const auto &object : flow->objects()) registered |= object.frame == figure;
+    if (!registered) return fail();
+    const auto policy = format.property(WikidictFigureTableCaption).toMap();
+    const QString role = format.stringProperty(WikidictFigureRole);
+    const auto finite = [&](const QVariant &value) {
+        return value.metaType().id() == QMetaType::Double && qIsFinite(value.toDouble())
+            && value.toDouble() >= 0 && value.toDouble() < qreal(QFIXED_MAX)
+            && qIsFinite(scaleToDevice(value.toDouble())) && scaleToDevice(value.toDouble()) < qreal(QFIXED_MAX);
+    };
+    if (role == QStringLiteral("figure")) {
+        const auto value = policy.value(QStringLiteral("autos"));
+        if (frame != figure || policy.size() != 3 || policy.value(QStringLiteral("palette")).metaType().id() != QMetaType::QPalette || value.metaType().id() != QMetaType::QVariantList) return fail();
+        const auto autos = value.toList();
+        if (autos.size() != 4) return fail();
+        for (const auto &side : autos) if (side.metaType().id() != QMetaType::Bool) return fail();
+        if (autos[0].toBool() || autos[2].toBool() || format.border() != 0 || format.padding() != 0) return fail();
+        if (figure->childFrames().size() != 2) return fail();
+        const QStringList roles{QStringLiteral("media-grid"), QStringLiteral("caption")};
+        for (int i = 0; i < 2; ++i) {
+            auto *child = figure->childFrames().at(i);
+            auto *table = qobject_cast<QTextTable *>(child);
+            if (!table || table->rows() != 1 || table->columns() != 1
+                || !wikidictFigureTableCaptionFrame(child)
+                || child->frameFormat().stringProperty(WikidictFigureRole) != roles[i]
+                || child->frameFormat().intProperty(WikidictFigureHelper) != figure->objectIndex()) return fail();
+        }
+    } else if (role == QStringLiteral("media-grid") || role == QStringLiteral("caption")) {
+        auto *table = qobject_cast<QTextTable *>(frame);
+        if (!table || frame->parentFrame() != figure || table->rows() != 1 || table->columns() != 1
+            || policy.size() != 1 || table->format().cellSpacing() != 0 || table->format().cellPadding() != 0
+            || table->format().borderCollapse() != (role == QStringLiteral("media-grid"))
+            || !format.hasProperty(WikidictTablePhysicalEdges) || frame->childFrames().size() != 1) return fail();
+        const auto cell = table->cellAt(0, 0).format().toTableCellFormat();
+        for (qreal value : {cell.topPadding(), cell.rightPadding(), cell.bottomPadding(), cell.leftPadding(),
+                cell.topBorder(), cell.rightBorder(), cell.bottomBorder(), cell.leftBorder()})
+            if (value != 0) return fail();
+        const auto *child = frame->childFrames().first();
+        if (!wikidictFigureTableCaptionFrame(child)
+            || child->frameFormat().stringProperty(WikidictFigureRole)
+                != (role == QStringLiteral("media-grid") ? QStringLiteral("image") : QStringLiteral("caption-content"))) return fail();
+    } else if (role == QStringLiteral("image")) {
+        if (policy.size() != (policy.contains(QStringLiteral("subtract")) ? 14 : 13)
+            || !finite(policy.value(QStringLiteral("source_width"))) || policy.value(QStringLiteral("source_width")).toDouble() <= 0
+            || frame->parentFrame()->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("media-grid")
+            || policy.value(QStringLiteral("source_media")).metaType().id() != QMetaType::QJsonObject
+            || policy.value(QStringLiteral("strut_font")).metaType().id() != QMetaType::QFont
+            || policy.value(QStringLiteral("strut_zero")).metaType().id() != QMetaType::Bool
+            || policy.value(QStringLiteral("middle")).metaType().id() != QMetaType::Bool
+            || policy.value(QStringLiteral("positioned")).metaType().id() != QMetaType::Bool
+            || policy.value(QStringLiteral("direction")).metaType().id() != QMetaType::Int
+            || (policy.value(QStringLiteral("direction")).toInt() != Qt::LeftToRight && policy.value(QStringLiteral("direction")).toInt() != Qt::RightToLeft)
+            || policy.value(QStringLiteral("language")).metaType().id() != QMetaType::QString
+            || policy.value(QStringLiteral("box")).metaType().id() != QMetaType::QVariantList
+            || policy.value(QStringLiteral("image_paint")).metaType().id() != QMetaType::QVariantMap
+            || policy.value(QStringLiteral("after")).metaType().id() != QMetaType::QVariantMap
+            || policy.value(QStringLiteral("focus")).metaType().id() != QMetaType::QVariantMap) return fail();
+        const auto media = policy.value(QStringLiteral("source_media")).value<QJsonObject>();
+        bool sourceMatch = layout.value(QStringLiteral("media")).toObject() == media;
+        for (const auto &state : layout.value(QStringLiteral("viewport_states")).toArray())
+            sourceMatch |= state.toObject().value(QStringLiteral("media")).toObject() == media;
+        if (!sourceMatch || format.border() != 0 || format.padding() != 0
+            || format.leftMargin() != 0 || format.rightMargin() != 0 || format.topMargin() != 0 || format.bottomMargin() != 0) return fail();
+        const auto box = policy.value(QStringLiteral("box")).toList();
+        if (box.size() != 4) return fail();
+        for (const auto &edge : box) if (!finite(edge)) return fail();
+        const auto imagePaint = policy.value(QStringLiteral("image_paint")).toMap();
+        if (imagePaint.size() != 3 || !finite(imagePaint.value(QStringLiteral("border_width")))
+            || imagePaint.value(QStringLiteral("border_color")).metaType().id() != QMetaType::QColor
+            || imagePaint.value(QStringLiteral("background")).metaType().id() != QMetaType::QColor
+            || !imagePaint.value(QStringLiteral("border_color")).value<QColor>().isValid()
+            || !imagePaint.value(QStringLiteral("background")).value<QColor>().isValid()) return fail();
+        const auto font = policy.value(QStringLiteral("strut_font")).value<QFont>();
+        const QFontMetricsF metrics(font, q->paintDevice());
+        for (qreal n : {metrics.ascent(), metrics.descent(), metrics.xHeight()})
+            if (!qIsFinite(n) || n < 0 || n >= qreal(QFIXED_MAX)) return fail();
+        const bool missing = source.value(QStringLiteral("missing_content")).isObject();
