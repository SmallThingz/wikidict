+bool QTextDocumentLayoutPrivate::checkParagraphBoxExtent(qint64 extent, int position)
+{
+    if (!paragraphBoxesPresent)
+        return true;
+    if (paragraphBoxError)
+        return false;
+    if (extent < 0 || extent > qint64(QFIXED_MAX) * 64) {
+        refuseParagraphBox(4, position);
+        return false;
+    }
+    return true;
+}
+
+bool QTextDocumentLayoutPrivate::checkParagraphBoxPosition(QTextLayoutStruct *flow,
+                                                          qint64 next, int position, bool advance)
+{
+    if (!paragraphBoxesPresent)
+        return true;
+    if (paragraphBoxError)
+        return false;
+    const qint64 limit = qint64(QFIXED_MAX) * 64;
+    const qint64 absolute = next + qint64(flow->frameY.value());
+    if (next < 0 || next > limit || absolute < 0 || absolute > limit) {
+        refuseParagraphBox(4, position); // aggregate native-coordinate extent
+        return false;
+    }
+    if (advance)
+        flow->y = QFixed::fromFixed(int(next)); // checked before narrowing
+    return true;
+}
