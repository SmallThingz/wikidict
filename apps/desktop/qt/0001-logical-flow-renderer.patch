+int QTextDocumentLayoutPrivate::logicalLinePosition(
+        const std::shared_ptr<QTextLogicalFlowProjection> &flow, int index, bool down, qreal documentX) const
+{
+        if (index < 0 || index >= flow->textLayout()->lineCount()) {
+            // Nested owners at a real caption boundary return to the enclosing
+            // object's adjacent line, not the enclosing owner's far edge.
+            const auto parentIndex = logicalFlowParents.constFind(flow->firstPosition());
+            if (parentIndex != logicalFlowParents.cend()) {
+                const auto parentFlow = logicalFlowIndex.value(parentIndex.value());
+                if (parentFlow && parentFlow != flow && parentFlow->current()) {
+                    const QTextBlock boundary = document->findBlock(down ? flow->lastPosition() : flow->firstPosition());
+                    for (const auto &object : parentFlow->objects()) {
+                        if (!object.frame || flow->firstPosition() <= object.first || flow->lastPosition() >= object.last
+                            || object.frame->frameFormat().position() != QTextFrameFormat::InFlow) continue;
+                        const QTextBlock edge = down ? object.frame->lastCursorPosition().block()
+                                                     : object.frame->firstCursorPosition().block();
+                        if (boundary != edge) break;
+                        const QTextLine anchor = parentFlow->textLayout()->lineForTextPosition(object.projectedPosition);
+                        if (!anchor.isValid()) return -2;
+                        return logicalLinePosition(parentFlow, anchor.lineNumber() + (down ? 1 : -1), down, documentX);
+                    }
+                }
+            }
+            return down ? -4 : -3;
+        }
+        const QTextLine target = flow->textLayout()->lineAt(index);
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || object.projectedPosition < target.textStart()
+                || object.projectedPosition >= target.textStart() + target.textLength()
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow)
+                continue;
+            const QTextBlock edge = down ? object.frame->firstCursorPosition().block()
+                                         : object.frame->lastCursorPosition().block();
+            const int edgePosition = down ? edge.position() : edge.position() + edge.length() - 1;
+            const auto nested = logicalFlowAt(edgePosition);
+            if (nested && nested != flow)
+                return logicalLinePosition(nested, down ? 0 : nested->textLayout()->lineCount() - 1, down, documentX);
+            const QTextLayout *caption = edge.layout();
+            if (!caption || !caption->lineCount()) return -2;
+            const QTextLine captionLine = caption->lineAt(down ? 0 : caption->lineCount() - 1);
+            if (!captionLine.isValid()) return -2;
+            const qreal captionX = documentX - q_func()->blockBoundingRect(edge).left();
+            const auto captionOwner = logicalFlowAt(edgePosition, true);
+            if (captionOwner && captionOwner->inCaption(edgePosition))
+                return edge.position() + qt_textLineXToCursorWithOrigin(captionLine,
+                    caption->engine(), captionX, QTextLine::CursorBetweenCharacters, true, true);
+            return edge.position() + captionLine.xToCursor(captionX);
+        }
+        return flow->toDocument(target.xToCursor(documentX - q_func()->blockBoundingRect(document->findBlock(flow->firstPosition())).left()));
+}
