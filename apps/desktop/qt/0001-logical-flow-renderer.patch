+bool QTextDocumentLayoutPrivate::clearFloats(QTextLayoutStruct *flow, int clear, int before, QFixed margin)
+{
+    qint64 next = flow->y.value();
+    for (const auto &exclusion : floatExclusions(flow, before)) {
+        if ((clear & 1 && exclusion.side == QTextFrameFormat::FloatLeft)
+            || (clear & 2 && exclusion.side == QTextFrameFormat::FloatRight))
+            next = qMax(next, qint64(exclusion.position.y.value()) + exclusion.size.height.value() - margin.value());
+    }
+    if (!paragraphBoxesPresent) {
+        flow->y = QFixed::fromFixed(int(next));
+        return true;
+    }
+    return checkParagraphBoxPosition(flow, next, before, true);
+}
