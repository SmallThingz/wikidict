+static bool wikidictPhysicalEdges(const QVariant &value, WikidictPhysicalEdges *out)
+{
+    const auto spec = value.toMap();
+    const auto paddingValue = spec.value(QStringLiteral("padding"));
+    const auto bordersValue = spec.value(QStringLiteral("borders"));
+    const auto padding = paddingValue.toList(), borders = bordersValue.toList();
+    if (value.metaType().id() != QMetaType::QVariantMap || spec.size() != 2
+        || paddingValue.metaType().id() != QMetaType::QVariantList || padding.size() != 4
+        || bordersValue.metaType().id() != QMetaType::QVariantList || borders.size() != 4) return false;
+    for (int i = 0; i < 4; ++i) {
+        const auto border = borders[i].toMap();
+        const auto width = border.value(QStringLiteral("width"));
+        const auto style = border.value(QStringLiteral("style"));
+        const auto color = border.value(QStringLiteral("color"));
+        if (padding[i].metaType().id() != QMetaType::Double || !qIsFinite(padding[i].toDouble())
+            || padding[i].toDouble() < 0 || padding[i].toDouble() > QFIXED_MAX
+            || borders[i].metaType().id() != QMetaType::QVariantMap || border.size() != 3
+            || width.metaType().id() != QMetaType::Double || !qIsFinite(width.toDouble())
+            || width.toDouble() < 0 || width.toDouble() > QFIXED_MAX
+            || style.metaType().id() != QMetaType::Int || style.toInt() < 0 || style.toInt() > 3
+            || (style.toInt() < 2 && width.toDouble() != 0)
+            || color.metaType().id() != QMetaType::QColor || !color.value<QColor>().isValid()) return false;
+        out->padding[i] = padding[i].toDouble(); out->width[i] = width.toDouble();
+        out->style[i] = style.toInt(); out->color[i] = color.value<QColor>();
+    }
+    return true;
+}
