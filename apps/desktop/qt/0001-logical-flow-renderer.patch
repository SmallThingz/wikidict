+        // object anchors. Empty/no-strong owners retain ordinary paragraph LTR.
+        return text.isRightToLeft() ? Qt::RightToLeft : Qt::LeftToRight;
+    }
+    void setContentEdges(qreal left, qreal right) { contentLeft = left; contentRight = right; }
+    qreal leftEdge() const { return contentLeft; }
+    qreal rightEdge() const { return contentRight; }
+
+    // Caption positions have their own real frame/block layout. They are not
+    // collapsed onto the object anchor for cursor, text or accessibility queries.
+    bool inCaption(int position) const
+    {
+        auto it = std::upper_bound(frames.cbegin(), frames.cend(), position,
+            [](int value, const Object &object) { return value < object.first; });
+        if (it == frames.cbegin())
+            return false;
+        --it;
+        return position > it->first && position <= it->last - 1;
+    }
+
+    int toProjected(int documentPosition, bool trailing = false) const
+    {
+        if (!current() || documentPosition < first || documentPosition > last || inCaption(documentPosition))
+            return -1;
+        if (sourceIndices.isEmpty() && documentPosition == first)
+            return 0;
+        const auto it = std::lower_bound(sourceIndices.cbegin(), sourceIndices.cend(), documentPosition,
+            [this](int index, int value) { return units.at(index).first < value; });
+        if (it != sourceIndices.cend() && units.at(*it).first == documentPosition)
+            return *it;
+        if (trailing && it != sourceIndices.cend())
+            return *it;
+        if (it != sourceIndices.cbegin()) {
+            const int previous = *std::prev(it);
+            if (units.at(previous).last <= documentPosition)
+                return previous + 1;
+        }
+        return -1;
+    }
+
+    int toDocument(int projectedPosition) const
+    {
+        if (!current() || projectedPosition < 0 || projectedPosition > units.size())
+            return -1;
+        // Inserted isolate controls have no source character and are never
+        // returned as selectable document offsets.
+        for (int i = projectedPosition; i < units.size(); ++i)
+            if (units.at(i).kind != Kind::Control)
+                return units.at(i).first;
+        for (int i = qMin(projectedPosition - 1, int(units.size()) - 1); i >= 0; --i)
+            if (units.at(i).kind != Kind::Control)
+                return units.at(i).last;
+        return first;
+    }
+
+    QList<Range> selectionRanges(int selectionFirst, int selectionLast) const
+    {
+        QList<Range> ranges;
+        if (!current() || selectionLast <= selectionFirst)
+            return ranges;
+        for (int i = 0; i < units.size(); ++i) {
+            const Unit &unit = units.at(i);
+            if (unit.kind == Kind::Control || unit.first >= selectionLast || unit.last <= selectionFirst)
+                continue;
+            // Selecting only caption text must not paint the whole parent object.
+            if (unit.kind == Kind::Frame
+                && selectionFirst > unit.first && selectionLast < unit.last)
+                continue;
+            if (!ranges.isEmpty() && ranges.last().start + ranges.last().length == i)
+                ++ranges.last().length;
+            else
+                ranges.append({i, 1});
+        }
+        return ranges;
+    }
+
+    Range sourceBoundary(int documentPosition, bool paragraph) const
+    {
+        if (!current() || inCaption(documentPosition)) return {-1, 0};
+        // The opening frame marker is structural, not a body text character.
+        // Including it in a prefix range places the selection endpoint inside
+        // another frame, which QTextCursor expands to the whole real caption.
+        for (const Object &object : frames)
+            if (documentPosition == object.first) return {documentPosition, 0};
+        QList<Range> ranges;
+        if (paragraph) {
+            ranges = paragraphRanges;
+        } else {
+            const int source = structuralJoins.contains(documentPosition) ? documentPosition - 1 : documentPosition;
+            const int projected = toProjected(source);
+            const QTextLine line = layout->lineForTextPosition(projected);
+            if (!line.isValid()) return documentPosition == last ? Range{last, 0} : Range{-1, 0};
+            ranges = sourceRanges(line.textStart(), line.textStart() + line.textLength());
+        }
+        for (const Range &range : std::as_const(ranges))
+            if (documentPosition >= range.start && documentPosition < range.start + range.length)
+                return range;
+        // Native paragraph separators and an end-of-document cursor denote the
+        // preceding range without pretending they are caption characters.
+        for (const Range &range : std::as_const(ranges))
+            if (documentPosition == range.start + range.length
+                && (documentPosition == last || structuralJoins.contains(documentPosition)))
+                return range;
+        // A figure-final owner has a real empty storage block after its frame.
+        // It is a valid structural endpoint, not a stale source-map failure.
+        return documentPosition == last ? Range{last, 0} : Range{-1, 0};
+    }
+
+    // Called by the native containing flow after each real frame's ordinary
+    // layout. Dimensions are measured native results, never authored guesses.
+    bool setObjectSize(int frameIndex, QSizeF measured, qreal minimumWidth, bool floating,
+                       qreal externalAscent = std::numeric_limits<qreal>::quiet_NaN())
+    {
+        if (!current() || !qIsFinite(measured.width()) || !qIsFinite(measured.height())
