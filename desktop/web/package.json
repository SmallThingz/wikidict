{
  "name": "dict-web-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test blob.test.mjs alias.test.mjs validate.test.mjs preview.test.mjs reference-blocks.test.mjs table-styles.test.mjs inline-images.test.mjs typed-content.test.mjs",
    "test:browser": "node browser.test.mjs && node reference-blocks.browser.test.mjs && node table-styles.browser.test.mjs && node inline-images.browser.test.mjs",
    "test:container-fonts": "node container-fonts.browser.test.mjs",
    "test:swatch": "node color-swatch.browser.test.mjs",
    "test:poem": "node poem.browser.test.mjs",
    "test:errors": "node action-errors.browser.test.mjs",
    "test:error-contrast": "node error-contrast.browser.test.mjs",
    "test:stale-errors": "node stale-errors.browser.test.mjs",
    "test:link-order": "node link-order.browser.test.mjs",
    "test:placeholder-contrast": "node placeholder-contrast.browser.test.mjs",
    "test:self-heading": "node self-heading.browser.test.mjs",
    "test:learn": "node learn.browser.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "xz-decompress": "0.2.3"
  }
}
