+void QTextDocumentLayoutPrivate::drawLogicalFlow(const QPointF &offset, QPainter *painter,
+        const QAbstractTextDocumentLayout::PaintContext &context,
+        const std::shared_ptr<QTextLogicalFlowProjection> &flow) const
+{
+    if (!flow->current())
+        return;
+    QList<QTextLayout::FormatRange> ranges;
+    for (const auto &selection : context.selections) {
+        for (const auto &range : flow->selectionRanges(selection.cursor.selectionStart(), selection.cursor.selectionEnd())) {
+            QTextLayout::FormatRange item;
+            item.start = range.start;
+            item.length = range.length;
+            item.format = selection.format;
+            ranges.append(item);
+        }
+    }
+    const QPen oldPen = painter->pen();
+    painter->setPen(context.palette.color(QPalette::Text));
+    wikidictDrawInlineActionBands(painter, flow->textLayout(), offset, ranges, document->documentLayout()->paintDevice(),
+        context.clip.isValid() ? (context.clip & clipRect) : clipRect, true);
+    if (usesGlyphInkBounds()) {
+        painter->save();
+        if (context.clip.isValid()) painter->setClipRect(context.clip, Qt::IntersectClip);
+        flow->textLayout()->draw(painter, offset, ranges);
+        painter->restore();
+    } else flow->textLayout()->draw(painter, offset, ranges, context.clip);
+    flow->drawRuby(painter, offset, context, cursorWidth);
+    wikidictDrawInlineActionBands(painter, flow->textLayout(), offset, ranges, document->documentLayout()->paintDevice(),
+        context.clip.isValid() ? (context.clip & clipRect) : clipRect, false);
+    const int cursor = flow->toProjected(context.cursorPosition);
+    if (cursor >= 0 && !flow->isRubyPosition(context.cursorPosition))
+        flow->textLayout()->drawCursor(painter, offset, cursor, cursorWidth);
+    painter->setPen(oldPen);
+    const auto focused = document->property("wikidict.figure.linkFocusOwner");
+    if (focused.metaType().id() == QMetaType::LongLong && currentOrdinaryLinkFrame(flow->parentFrame())) {
+        QList<QRectF> boxes; QVariantMap outline;
+        for (const auto &item : wikidictOrdinaryFlowLinks(*flow)) {
+            if (item.format.property(WikidictFigureLinkOwner) != focused) continue;
+            outline = wikidictSelectedReferenceOutline(item.format, document);
+            boxes.append(wikidictFigureLinkFragmentBoxes(flow->textLayout(), item.start, item.length));
+        }
+        for (const auto &link : flow->rubyLinkBoxes()) {
+            if (!wikidictOrdinaryLink(link.format) || link.format.property(WikidictFigureLinkOwner) != focused) continue;
+            outline = wikidictSelectedReferenceOutline(link.format, document);
+            boxes.append(link.rect);
+        }
+        wikidictDrawFigureLinkOutline(painter, boxes, outline, scaleToDevice(1), offset + flow->textLayout()->position(),
+            context.clip.isValid() ? (context.clip & clipRect) : clipRect);
+    }
+    // Real frame/caption contents are painted by the ordinary child-frame path,
+    // with the unmodified document selection. No caption is rasterized here.
+}
 
