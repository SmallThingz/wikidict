+        measured.minimumWidth = measured.advance;
+        measured.baseAscent = QFixed::fromReal(usedAbove);
+        measured.baseDescent = QFixed::fromReal(usedBelow);
+        measured.baseLeading = QFixed();
+        measured.occupiedTop = QFixed::fromReal(stacked->top);
+        measured.occupiedBottom = QFixed::fromReal(stacked->bottom);
+        measured.visibleAnnotation = hasNestedAnnotation || std::any_of(description.readings.cbegin(), description.readings.cend(),
+            [](const auto &reading) { return !reading.hidden; });
