+inline QVariant nowrapOwner(const QTextCharFormat &format)
+{
+    // Full source/custody validation happens before native document layout.
+    // Keep boundary lookup cheap and independent of shaping format splitting.
+    const auto p = format.property(CitationProperty).toMap();
+    if (format.objectType() != QTextFormat::NoObject || p.size() != 6
+        || p.value(u"capability"_s) != QVariant(QString::fromLatin1(Capability))
+        || p.value(u"nowrap"_s).metaType().id() != QMetaType::Bool || !p.value(u"nowrap"_s).toBool()
