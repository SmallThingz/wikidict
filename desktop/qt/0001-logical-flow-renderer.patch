+bool QTextDocumentLayoutPrivate::validateFigureFrame(QTextFrame *frame, qreal availableWidth)
+{
+    const QTextFrameFormat format = frame->frameFormat();
+    const auto fail = [&](int error) {
+        paragraphBoxError = error; paragraphBoxErrorPosition = frame->firstPosition(); return false;
+    };
+    if (!validateFigureTableCaption(frame) || !validateFigureBlockMedia(frame)) return false;
+    if (format.hasProperty(WikidictFigureBlockMedia)) {
+        // The separately authenticated block domain has auto width, signed
+        // margins and its own nonzero source strut; legacy fixed Figure checks
+        // below remain unchanged.
+        if (!wikidictFigureBlockMediaFrame(frame) || !qIsFinite(availableWidth)
+            || availableWidth < 0 || availableWidth > qreal(QFIXED_MAX)) return fail(2);
+        for (qreal value : {format.topMargin(), format.rightMargin(), format.bottomMargin(), format.leftMargin()})
+            if (!qIsFinite(scaleToDevice(value)) || qAbs(scaleToDevice(value)) >= qreal(QFIXED_MAX)) return fail(2);
+        return true;
+    }
+    const bool tableCaption = wikidictFigureTableCaptionFrame(frame);
+    const bool posterCaption = format.hasProperty(QTextFormat::UserProperty + 0x57ad);
+    if (posterCaption && tableCaption) return fail(1);
+    if (posterCaption) {
+        const auto caption = frame->parentFrame();
+        const auto figure = caption ? caption->parentFrame() : nullptr;
+        const auto owned = [](const QTextFrame *value, const QString &role) {
+            return value && value->frameFormat().stringProperty(QTextFormat::UserProperty + 0x57a0)
+                    == QStringLiteral("wikidict.figure-layout/1")
+                && value->frameFormat().stringProperty(QTextFormat::UserProperty + 0x57a4) == role;
+        };
+        const QVariant policy = format.property(QTextFormat::UserProperty + 0x57ad);
+        if (policy.metaType().id() != QMetaType::QString
+            || policy.toString() != QStringLiteral("wikidict.stl-caption-exclusion/1")
+            || !owned(frame, QStringLiteral("caption-content"))
+            || !owned(caption, QStringLiteral("caption")) || !owned(figure, QStringLiteral("figure"))
+            || format.intProperty(QTextFormat::UserProperty + 0x57a8) != figure->objectIndex()
+            || caption->frameFormat().intProperty(QTextFormat::UserProperty + 0x57a8) != figure->objectIndex()) return fail(1);
+        const auto metadata = figure->frameFormat().property(QTextFormat::UserProperty + 0x57a3);
+        if (metadata.metaType().id() != QMetaType::QByteArray) return fail(1);
+        QJsonParseError parseError;
+        const auto json = QJsonDocument::fromJson(metadata.toByteArray(), &parseError);
