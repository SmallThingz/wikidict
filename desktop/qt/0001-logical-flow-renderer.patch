+static bool wikidictCellLineHeight(const QTextTable *table, const QTextTableCell &cell,
+                                    QVariantMap *policy)
+{
+    policy->clear();
+    const auto stored = cell.format().property(WikidictCellLineHeight);
+    if (!stored.isValid()) return true;
+    const auto value = stored.toMap();
+    const auto kind = value.value(QStringLiteral("kind"));
+    const auto amount = value.value(QStringLiteral("value"));
+    const auto owner = value.value(QStringLiteral("owner_px"));
+    if (table->format().stringProperty(WikidictTableBoxOwner) != QStringLiteral("wikidict.table-box/1")
+        || stored.metaType().id() != QMetaType::QVariantMap || value.size() != 6
+        || value.value(QStringLiteral("capability")).metaType().id() != QMetaType::QString
+        || value.value(QStringLiteral("capability")).toString() != QStringLiteral("wikidict.cell-line-height/1")
+        || value.value(QStringLiteral("font")).metaType().id() != QMetaType::QFont
+        || value.value(QStringLiteral("empty")).metaType().id() != QMetaType::Bool
+        || kind.metaType().id() != QMetaType::QString
+        || (kind.toString() != QStringLiteral("normal") && kind.toString() != QStringLiteral("multiplier") && kind.toString() != QStringLiteral("length"))
+        || amount.metaType().id() != QMetaType::Double || !qIsFinite(amount.toDouble()) || amount.toDouble() < 0
+        || (kind.toString() == QStringLiteral("normal") && amount.toDouble() != 0)
+        || owner.metaType().id() != QMetaType::Double || !qIsFinite(owner.toDouble()) || owner.toDouble() < 0)
+        return false;
+    const QFont font = value.value(QStringLiteral("font")).value<QFont>();
+    const QFontMetricsF metrics(font);
+    const qreal pixels = metrics.ascent() == 0 && metrics.descent() == 0 ? 0
+        : font.pixelSize() > 0 ? qreal(font.pixelSize()) : font.pointSizeF() * metrics.fontDpi() / 72;
+    if (!qIsFinite(pixels) || pixels < 0 || pixels != owner.toDouble()) return false;
+    if (value.value(QStringLiteral("empty")).toBool()) {
+        // A cursor computes its x coordinate and can re-enter native layout.
+        // Validate the storage block directly while this cell is being laid out.
+        const auto first = table->document()->findBlock(cell.firstPosition());
+        if (!first.isValid() || first.document() != table->document()
+            || first.position() != cell.firstPosition() || cell.firstPosition() != cell.lastPosition()
+            || !first.text().isEmpty() || !first.charFormat().anchorNames().isEmpty()
+            || !first.charFormat().anchorHref().isEmpty()) return false;
+        auto it = cell.begin();
+        if (it.atEnd() || it.currentFrame() || it.currentBlock() != first) return false;
+        ++it;
+        if (it != cell.end()) return false;
+    }
+    *policy = value;
+    return true;
+}
+
+static bool wikidictCellLineHeight(const QTextBlock &block, QVariantMap *policy)
+{
+    policy->clear();
+    const auto *document = block.document();
+    for (auto *frame = document ? document->frameAt(block.position()) : nullptr; frame; frame = frame->parentFrame()) {
+        // The admitted Figure protocol requires caption_line_height; its
+        // materializer installs that nearer Fixed/MinimumHeight before layout.
+        // Media likewise owns its explicit Figure strut, independently of Cell.
+        if (wikidictFigureTableCaptionFrame(frame)) return true;
+        if (auto *table = qobject_cast<QTextTable *>(frame)) {
+            const auto cell = table->cellAt(block.position());
+            if (!cell.isValid() || !wikidictCellLineHeight(table, cell, policy)) return false;
+            if (!policy->isEmpty()) return true;
+            // A nearer table's explicit declaration replaces an inherited cell policy.
+            if (table->format().hasProperty(WikidictTableLineHeight)) return true;
+        }
+    }
+    return true;
+}
