+bool QTextDocumentLayoutPrivate::flexRequest(const QJsonValue &request, qreal available, qreal em, bool intrinsic, qreal *value)
+{
+    if (request.isNull() || request.isUndefined()) return true;
+    if (!request.isObject() || request.toObject().size() != 1) return false;
+    const auto object = request.toObject();
+    if (object.contains(QStringLiteral("auto")) || object.contains(QStringLiteral("none"))) return true;
+    const auto length = object.value(QStringLiteral("length")).toObject();
+    const auto unit = length.value(QStringLiteral("unit")).toString();
+    const qreal number = length.value(QStringLiteral("value")).toDouble(-1);
+    if (length.size() != 2 || !qIsFinite(number) || number < 0
+        || (unit != QStringLiteral("px") && unit != QStringLiteral("em") && unit != QStringLiteral("percent"))) return false;
+    if (intrinsic && unit == QStringLiteral("percent")) return true;
+    *value = unit == QStringLiteral("percent") ? available * (number / 100) : scaleToDevice(number * (unit == QStringLiteral("em") ? em : 1));
+    return qIsFinite(*value) && *value >= 0 && *value < QFIXED_MAX;
