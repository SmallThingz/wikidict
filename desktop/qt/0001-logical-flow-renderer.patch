+bool QTextDocumentLayoutPrivate::positionAbsoluteContainer(QTextFrame *frame,
+    QTextLayoutStruct *parentFlow, int layoutFrom, int layoutTo)
+{
+    if (!validatePlainContainer(frame)) return false;
+    const auto spec = frame->frameFormat().property(WikidictContainerAbsolute).toMap();
+    auto *relative = qobject_cast<QTextFrame *>(document->object(spec.value(QStringLiteral("containing")).toInt()));
+    if (!relative) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+    const auto *containing = data(relative);
+    // Frame data is already in device units. CSS offsets are density-scaled
+    // once; the containing padding-box begins inside its real border edge.
+    qint64 x = qint64(containing->leftMargin.value()) + containing->borderInset(3).value()
+        + QFixed::fromReal(scaleToDevice(spec.value(QStringLiteral("left")).toDouble())).value();
+    qint64 y = qint64(containing->topMargin.value()) + containing->borderInset(0).value()
+        + QFixed::fromReal(scaleToDevice(spec.value(QStringLiteral("top")).toDouble())).value();
+    for (auto *parent = frame->parentFrame(); parent != relative; parent = parent->parentFrame()) {
+        if (!parent || !wikidictPlainContainer(parent) || qobject_cast<QTextTable *>(parent)) {
+            refuseParagraphBox(1, frame->firstPosition()); return false;
+        }
+        x -= data(parent)->position.x.value(); y -= data(parent)->position.y.value();
+    }
+    if (!checkParagraphBoxExtent(qAbs(x), frame->firstPosition())
+        || !checkParagraphBoxExtent(qAbs(y), frame->firstPosition())) return false;
+    auto *fd = data(frame);
+    fd->position = QFixedPoint(QFixed::fromFixed(int(x)), QFixed::fromFixed(int(y)));
+    fd->sizeDirty = true;
+    // Existing width/height/declaring-font authorities remain the only ones.
+    // This child's local BFC neither imports nor exports normal-flow floats.
+    layoutFrame(frame, layoutFrom, layoutTo, parentFlow->frameY);
+    if (paragraphBoxError) return false;
+    fd->layoutDirty = false;
