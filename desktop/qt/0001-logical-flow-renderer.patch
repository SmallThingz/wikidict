+std::optional<QRectF> QTextDocumentLayoutPrivate::authoredRuleRect(const QTextBlock &block) const
+{
+    if (paragraphBoxError || !block.blockFormat().hasProperty(WikidictAuthoredRule) || !block.isVisible()) return std::nullopt;
+    auto *owner = document->frameAt(block.position());
+    if (!owner) return std::nullopt;
+    const auto &geometries = data(owner)->wikidictRuleGeometry;
+    const auto found = geometries.constFind(block.position());
+    if (found == geometries.cend() || found->first != block.blockFormat()) return std::nullopt;
+    return found->second;
+}
