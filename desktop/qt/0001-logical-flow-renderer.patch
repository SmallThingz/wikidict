+        measured.breakAfter = description.breakAfter;
+        return measured.valid() && current();
+    }
+
+    static bool distribute(Box *box)
+    {
+        auto &child = *box->shaped;
+        auto *layout = box->composite ? box->composite->textLayout() : child.layout.get();
+        const auto text = layout->text();
+        auto *engine = layout->engine();
+        struct Opportunity { int item, glyph; };
+        QList<Opportunity> opportunities;
+        QSet<int> clusters;
+        for (const auto &run : layout->glyphRuns(0, text.size(), QTextLayout::RetrieveStringIndexes))
+            for (auto index : run.stringIndexes()) clusters.insert(int(index));
+        const auto scalarAt = [&](int position) {
+            const auto high = text.at(position);
+            return high.isHighSurrogate() && position + 1 < text.size()
+                && text.at(position + 1).isLowSurrogate()
+                ? QChar::surrogateToUcs4(high, text.at(position + 1)) : char32_t(high.unicode());
+        };
+        // Common punctuation follows the shaped item's resolved script. The
+        // policy deliberately excludes separator/Bopomofo/cursive expansion;
+        // never use Qt's generic LetterOrNumber justification set here.
+        const auto eligible = [&](int position) {
+            // An inner measured Ruby segment has its own native distribution.
+            if (engine->projectedRubyMetrics().contains(position)) return false;
+            const char32_t scalar = scalarAt(position);
+            if (QChar::isSpace(scalar) || scalar == 0x2014 || scalar == 0x2026) return false;
+            const int index = engine->findItem(position);
+            if (index < 0) return false;
+            const auto script = QChar::script(scalar) == QChar::Script_Common
+                ? QChar::Script(engine->layoutData->items[index].analysis.script) : QChar::script(scalar);
+            return script == QChar::Script_Han || script == QChar::Script_Hiragana
+                || script == QChar::Script_Katakana || script == QChar::Script_Hangul;
+        };
+        for (int boundary = 1; boundary < text.size(); ++boundary) {
+            if (!layout->isValidCursorPosition(boundary) || !clusters.contains(boundary)) continue;
+            int previous = boundary - 1;
+            if (text[previous].isLowSurrogate() && previous > 0 && text[previous - 1].isHighSurrogate()) --previous;
+            if (!eligible(previous) || !eligible(boundary)) continue;
+            const int index = engine->findItem(previous);
+            const auto &item = engine->layoutData->items[index];
+            const auto glyphs = engine->shapedGlyphs(&item);
+            const auto cluster = engine->logClusters(&item)[previous - item.position];
+            if (cluster >= glyphs.numGlyphs || !glyphs.attributes[cluster].clusterStart) return false;
+            int end = cluster + 1;
+            while (end < glyphs.numGlyphs && !glyphs.attributes[end].clusterStart) ++end;
+            if (glyphs.attributes[end - 1].dontPrint) return false;
+            opportunities.append({index, end - 1});
+        }
+        const auto spacing = QTextRubyGeometry::spaceAround(child.advance, box->width, opportunities.size());
+        if (!spacing) return false;
+        box->edge = spacing->edgeBefore + box->paddingLeft;
+        if (opportunities.isEmpty()) return true;
+        const auto addition = QFixed::fromReal(spacing->between);
+        if (addition < 0 || addition.value() > ((1 << 24) - 1)) return false;
+        for (const auto &point : opportunities) {
+            const auto glyphs = engine->shapedGlyphs(&engine->layoutData->items[point.item]);
+            auto &justification = glyphs.justifications[point.glyph];
+            if (justification.space_18d6 || justification.nKashidas) return false;
+            justification.type = QGlyphJustification::JustifySpace;
+            justification.space_18d6 = addition.value();
+        }
+        auto &line = engine->lines[0];
+        line.justified = true; line.gridfitted = true;
+        const QFixed increase = addition * int(opportunities.size());
+        line.textAdvance += increase; line.textWidth += increase;
+        // Fixed-point interior spacing can lose fractions; retain the exact
+        // allocated width by sharing that remainder between the two edges.
+        box->edge = (box->width - child.advance - increase.toReal()) / 2 + box->paddingLeft;
+        return QTextRubyGeometry::length(box->edge);
+    }
+
+    QPointer<QTextDocument> document;
+    int revision = -1, characterCount = 0;
+    QPointer<QAbstractTextDocumentLayout> layout;
+    const QPaintDevice *paintDevice = nullptr;
+    int dpiX = 0, dpiY = 0;
+    QFont originalDefaultFont;
+    QTextEngine::ProjectedRubyMetrics measured;
+    std::vector<Box> boxes;
+    QList<Range> ranges;
+};
+
+QT_END_NAMESPACE
+Q_DECLARE_METATYPE(QT_PREPEND_NAMESPACE(QTextRubyLayout::Description))
+#endif
