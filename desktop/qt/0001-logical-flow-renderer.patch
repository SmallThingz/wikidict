+        && state.value(u"kind"_s) == u"citation"_s
+        && state.value(u"owner"_s).metaType().id() == QMetaType::LongLong
+        && state.value(u"owner"_s).toLongLong() == citation.owner
+        && state.value(u"source"_s).metaType().id() == QMetaType::QByteArray
+        && state.value(u"source"_s).toByteArray() == citation.source;
+}
+} // namespace QCompiledReference
