+struct WikidictFlexMeasure {
+    QTextFrame *frame = nullptr;
+    WikidictFlexStyle style;
+    qreal minimum = 0, basis = 0, used = 0, cap = QFIXED_MAX, inset = 0;
+    qreal margins[4] = {};
+    bool frozen = false;
