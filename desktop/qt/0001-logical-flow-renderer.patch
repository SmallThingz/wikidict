+// Scrollable used boxes deliberately exclude glyph ink. A nested local owner
+// contributes its viewport box; its hidden content never enlarges this range.
+QRectF QTextDocumentLayoutPrivate::scrollableBounds(QTextFrame *frame, bool includeOwner, bool *present)
+{
+    const auto *fd = data(frame);
+    QRectF result = includeOwner ? QRectF(QPointF(), fd->size.toSizeF()) : QRectF();
+    bool hasBounds = includeOwner;
+    const auto include = [&](const QRectF &box) {
+        // Zero used height still carries horizontal advances. QRectF::united
+        // drops empty rectangles, so accumulate the independent axes here.
+        if (!hasBounds) result = box;
+        else result = QRectF(QPointF(qMin(result.left(), box.left()), qMin(result.top(), box.top())),
+            QPointF(qMax(result.right(), box.right()), qMax(result.bottom(), box.bottom())));
+        hasBounds = true;
+    };
+    bool localSubtree = false;
+    for (auto *owner = frame; owner; owner = owner->parentFrame())
+        localSubtree |= owner->frameFormat().hasProperty(WikidictContainerScrollport);
+    auto *table = qobject_cast<QTextTable *>(frame);
+    QTextFrame *previousFrame = nullptr;
+    for (auto it = frame->begin(); !it.atEnd(); ++it) {
+        const auto *previous = previousFrame;
+        previousFrame = it.currentFrame();
+        if (auto *child = it.currentFrame()) {
+            const auto *cd = data(child);
+            if (cd->layoutDirty || cd->sizeDirty) continue;
+            QPointF offset = cd->position.toPointF();
+            if (table) {
+                const auto cell = table->cellAt(child->firstPosition());
+                if (cell.isValid()) offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+            }
+            const QRectF used = cd->wikidictScrollport ? QRectF(QPointF(), cd->size.toSizeF())
+                : cd->wikidictScrollableBoundsPresent ? cd->wikidictScrollableBounds
+                : QRectF(QPointF(), cd->size.toSizeF());
+            include(used.translated(offset));
+            continue;
+        }
+        const auto block = it.currentBlock();
+        if (!block.isValid() || !block.isVisible()) continue;
+        if ((localSubtree || fd->wikidictOwnedTableTraversal)
+            && isWikidictTableBoundaryCaret(it, previous)) continue;
+        const auto flow = logicalFlowAt(block.position());
+        if (flow && flow->firstPosition() != block.position()) continue;
+        const auto *layout = flow ? flow->textLayout() : block.layout();
+        if (layout->lineCount() == 0) continue;
+        QPointF offset = layout->position();
+        if (table) {
+            const auto cell = table->cellAt(block.position());
+            if (cell.isValid()) offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+        }
+        const auto used = fd->wikidictUsedLineMetrics.constFind(block.position());
+        if (localSubtree && (used == fd->wikidictUsedLineMetrics.cend() || used->size() != layout->lineCount())) {
+            refuseParagraphBox(1, block.position());
+            if (present) *present = false;
+            return {};
+        }
+        for (int index = 0; index < layout->lineCount(); ++index) {
+            const auto line = layout->lineAt(index);
+            QRectF box = line.naturalTextRect();
+            if (localSubtree) {
+                box.setTop(line.y() + used->at(index).first);
+                box.setHeight(used->at(index).second);
+            }
+            include(box.translated(offset));
+        }
+    }
+    if (present) *present = hasBounds;
+    return result;
+}
+
+QRectF QTextDocumentLayoutPrivate::scrollClip(QTextFrame *frame) const
+{
+    QRectF clip; bool present = false;
+    for (; frame; frame = frame->parentFrame()) {
+        const auto *fd = data(frame);
+        if (!fd->wikidictScrollport) continue;
+        const QRectF viewport = fd->wikidictScrollViewport.translated(frameBoundingRectInternal(frame).topLeft());
+        clip = present ? clip.intersected(viewport) : viewport;
+        present = true;
+    }
+    return clip;
+}
+
+bool QTextDocumentLayoutPrivate::hasRoundedScrollClip(QTextFrame *frame) const
+{
+    for (; frame; frame = frame->parentFrame())
+        if (data(frame)->wikidictScrollport && frame->frameFormat().hasProperty(WikidictTableCornerRadii)) return true;
+    return false;
+}
+QPainterPath QTextDocumentLayoutPrivate::roundedScrollPadding(QTextFrame *frame, const QPointF &origin) const
+{
+    const auto *fd = data(frame);
+    const QRectF box = QRectF(origin, fd->size.toSizeF()).adjusted(fd->leftMargin.toReal(), fd->topMargin.toReal(),
+        -fd->rightMargin.toReal(), -fd->bottomMargin.toReal());
+    QPainterPath outer, inner;
+    WikidictTableCorners radii;
+    if (!wikidictTableCorners(frame->frameFormat(), &radii)
+        || !wikidictTableCornerPaths(box, radii, scaleToDevice(1), fd->borderInset(0).toReal(), &outer, &inner)) return {};
+    return inner;
+}
+QPainterPath QTextDocumentLayoutPrivate::scrollClipPath(QTextFrame *frame) const
+{
+    QPainterPath result; bool present = false;
+    for (; frame; frame = frame->parentFrame()) {
+        const auto *fd = data(frame);
+        if (!fd->wikidictScrollport) continue;
+        const QPointF origin = frameBoundingRectInternal(frame).topLeft();
+        QPainterPath own; own.addRect(fd->wikidictScrollViewport.translated(origin));
+        if (frame->frameFormat().hasProperty(WikidictTableCornerRadii)) own = own.intersected(roundedScrollPadding(frame, origin));
+        result = present ? result.intersected(own) : own;
+        present = true;
+    }
+    return result;
+}
+
+bool QTextDocumentLayout::wikidictConfigureScrollports(double gutter)
+{
+    Q_D(QTextDocumentLayout);
+    if (!qIsFinite(gutter) || gutter < 0 || gutter >= QFIXED_MAX / 8
+        || data(document()->rootFrame())->currentLayoutStruct || d->insideDocumentChange) return false;
+    if (d->scrollportGutter == gutter) return true;
+    d->scrollportGutter = gutter;
+    document()->markContentsDirty(0, document()->characterCount());
+    return true;
+}
+
+QVariantList QTextDocumentLayout::wikidictScrollports() const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->docPrivate->canLayout() || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return {};
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return {};
+    QVariantList result;
+    QList<QTextFrame *> pending{document()->rootFrame()};
+    while (!pending.isEmpty()) {
+        auto *frame = pending.takeLast(); pending.append(frame->childFrames());
+        const auto *fd = data(frame);
+        if (fd->layoutDirty || fd->sizeDirty) continue;
+        if (!fd->wikidictScrollport) {
+            if (wikidictTableViewportFocus(frame) && !wikidictTableViewportActive(frame)) {
+                const auto policy = frame->frameFormat().property(WikidictTableViewport).toMap();
+                const auto bounds = d->frameBoundingRectInternal(frame);
+                bool clipped = false;
+                for (auto *parent = frame->parentFrame(); parent; parent = parent->parentFrame()) clipped |= data(parent)->wikidictScrollport;
+                result.append(QVariantMap{{QStringLiteral("owner"), frame->objectIndex()},
+                    {QStringLiteral("first"), frame->firstPosition()}, {QStringLiteral("last"), frame->lastPosition()},
+                    {QStringLiteral("revision"), document()->revision()}, {QStringLiteral("source"), policy.value(QStringLiteral("source"))},
+                    {QStringLiteral("focus_paint"), policy.value(QStringLiteral("focus_paint"))}, {QStringLiteral("focus_active"), false},
+                    {QStringLiteral("focus_clip"), clipped ? bounds.intersected(d->scrollClip(frame->parentFrame())) : bounds},
+                    {QStringLiteral("border_box"), bounds}, {QStringLiteral("minimum"), 0.0}, {QStringLiteral("maximum"), 0.0},
+                    {QStringLiteral("offset"), fd->wikidictScrollOffset}});
+            }
+            continue;
+        }
+        const auto origin = d->frameBoundingRectInternal(frame).topLeft();
+        const QRectF viewport = fd->wikidictScrollViewport.translated(origin);
+        const QRectF bar(viewport.left(), viewport.bottom(), viewport.width(),
+            fd->wikidictScrollMinimum < fd->wikidictScrollMaximum ? d->scrollportGutter : 0);
+        const QRectF ancestorClip = d->scrollClip(frame->parentFrame());
+        bool clipped = false;
+        for (auto *parent = frame->parentFrame(); parent; parent = parent->parentFrame()) clipped |= data(parent)->wikidictScrollport;
+        result.append(QVariantMap{{QStringLiteral("owner"), frame->objectIndex()},
+            {QStringLiteral("first"), frame->firstPosition()}, {QStringLiteral("last"), frame->lastPosition()},
+            {QStringLiteral("revision"), document()->revision()}, {QStringLiteral("viewport"), viewport},
+            {QStringLiteral("clip"), d->scrollClip(frame)}, {QStringLiteral("bar"), bar},
+            {QStringLiteral("bar_clip"), clipped ? bar.intersected(ancestorClip) : bar},
+            {QStringLiteral("minimum"), fd->wikidictScrollMinimum}, {QStringLiteral("maximum"), fd->wikidictScrollMaximum},
+            {QStringLiteral("offset"), fd->wikidictScrollOffset}});
+        if (d->hasRoundedScrollClip(frame)) {
+            auto value = result.last().toMap();
+            value.insert(QStringLiteral("clip_path"), QVariant::fromValue(d->scrollClipPath(frame)));
+            QPainterPath barPath; barPath.addRect(bar);
+            if (frame->frameFormat().hasProperty(WikidictTableCornerRadii))
+                barPath = barPath.intersected(d->roundedScrollPadding(frame, origin));
+            if (clipped) barPath = barPath.intersected(d->scrollClipPath(frame->parentFrame()));
+            value.insert(QStringLiteral("bar_clip_path"), QVariant::fromValue(barPath));
+            result.last() = value;
+        }
+        if (wikidictTableViewportActive(frame)) {
+            auto value = result.last().toMap();
+            value.insert(QStringLiteral("table_viewport"), true);
+            value.insert(QStringLiteral("border_box"), d->frameBoundingRectInternal(frame));
+            value.insert(QStringLiteral("content_viewport"), QRectF(origin + QPointF(
+                (fd->leftMargin + fd->edgeInset(3)).toReal(), (fd->topMargin + fd->edgeInset(0)).toReal()),
+                QSizeF(fd->contentsWidth.toReal(), qMax(qreal(0), viewport.height()
+                    - fd->wikidictPadding[0].toReal() - fd->wikidictPadding[2].toReal()))));
+            value.insert(QStringLiteral("grid_extent"), d->frameBoundingRectInternal(frame->childFrames().first()));
+            if (wikidictTableViewportFocus(frame)) {
+                const auto policy = frame->frameFormat().property(WikidictTableViewport).toMap();
+                value.insert(QStringLiteral("source"), policy.value(QStringLiteral("source")));
+                value.insert(QStringLiteral("focus_paint"), policy.value(QStringLiteral("focus_paint")));
+                value.insert(QStringLiteral("focus_active"), true);
+                value.insert(QStringLiteral("focus_clip"), clipped
+                    ? d->frameBoundingRectInternal(frame).intersected(ancestorClip) : d->frameBoundingRectInternal(frame));
+            }
+            result.last() = value;
+        }
+    }
+    return result;
+}
+
+bool QTextDocumentLayout::wikidictScrollportOffset(int owner, int first, int revision, double offset)
+{
+    Q_D(QTextDocumentLayout);
+    if (revision != document()->revision() || !qIsFinite(offset) || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return false;
+    d->ensureLayoutFinished();
+    auto *frame = qobject_cast<QTextFrame *>(document()->object(owner));
+    if (!frame || frame->firstPosition() != first || d->paragraphBoxError) return false;
+    auto *fd = data(frame);
+    if (!fd->wikidictScrollport || fd->sizeDirty || fd->layoutDirty) return false;
+    offset = qBound(fd->wikidictScrollMinimum, offset, fd->wikidictScrollMaximum);
+    if (offset == fd->wikidictScrollOffset) return true;
+    fd->wikidictScrollOffset = offset;
+    emit update(d->frameBoundingRectInternal(frame));
+    return true;
+}
+
+QVariantMap QTextDocumentLayout::wikidictScrollClip(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (position < 0 || position >= document()->characterCount() || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct)
+        return {{QStringLiteral("error"), true}};
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return {{QStringLiteral("error"), true}};
+    auto *frame = document()->frameAt(position);
+    bool present = false;
+    for (auto *parent = frame; parent; parent = parent->parentFrame()) present |= data(parent)->wikidictScrollport;
+    QVariantMap result{{QStringLiteral("handled"), present}, {QStringLiteral("clip"), d->scrollClip(frame)}};
+    if (d->hasRoundedScrollClip(frame)) result.insert(QStringLiteral("clip_path"), QVariant::fromValue(d->scrollClipPath(frame)));
+    return result;
+}
+
+bool QTextDocumentLayout::wikidictRevealScrollPosition(int position)
+{
+    Q_D(QTextDocumentLayout);
+    if (position < 0 || position >= document()->characterCount() || !d->docPrivate->canLayout()
+        || d->insideDocumentChange || data(document()->rootFrame())->currentLayoutStruct) return false;
+    d->ensureLayoutFinished();
+    if (d->paragraphBoxError) return false;
+    bool changed = false;
+    for (auto *frame = document()->frameAt(position); frame; frame = frame->parentFrame()) {
+        auto *fd = data(frame);
+        if (!fd->wikidictScrollport) continue;
+        QRectF caret;
+        const auto logical = wikidictLogicalPosition(position);
+        if (logical.value(QStringLiteral("handled")).toBool()) {
+            if (logical.value(QStringLiteral("error")).toInt()) return false;
+            caret = logical.value(QStringLiteral("characterRect"), logical.value(QStringLiteral("cursorRect"))).toRectF();
+        } else {
+            const auto block = document()->findBlock(position);
+            const auto line = block.layout()->lineForTextPosition(position - block.position());
+            if (!line.isValid()) return false;
+            const qreal leading = line.cursorToX(position - block.position(), QTextLine::Leading);
+            const qreal trailing = line.cursorToX(position - block.position(), QTextLine::Trailing);
+            caret = QRectF(blockBoundingRect(block).topLeft() + QPointF(qMin(leading, trailing), line.y()),
+                QSizeF(qMax(qreal(qMax(1, d->cursorWidth)), qAbs(trailing - leading)), line.height()));
+        }
+        const QRectF viewport = fd->wikidictScrollViewport.translated(d->frameBoundingRectInternal(frame).topLeft());
+        const qreal delta = caret.left() < viewport.left() ? caret.left() - viewport.left()
+            : qMax(qreal(0), caret.right() - viewport.right());
+        const qreal offset = qBound(fd->wikidictScrollMinimum, fd->wikidictScrollOffset + delta, fd->wikidictScrollMaximum);
+        changed |= offset != fd->wikidictScrollOffset;
+        fd->wikidictScrollOffset = offset;
+    }
+    if (changed) emit update();
+    return true;
+}
+
+// Native registration is atomic and tied to original document revisions. Caption
+// frames remain in the same QTextDocument and retain their actual source ranges.
+bool QTextDocumentLayout::wikidictSetLogicalFlows(const QVariantList &descriptions)
+{
+    Q_D(QTextDocumentLayout);
+    QList<std::shared_ptr<QTextLogicalFlowProjection>> replacement;
+    for (const QVariant &value : descriptions) {
+        if (value.metaType().id() != QMetaType::QVariantMap)
+            return false;
+        QString error;
+        if (!QTextLogicalFlowProjection::createGroup(document(), value.toMap(), &replacement, &error))
+            return false;
+    }
+    std::sort(replacement.begin(), replacement.end(), [](const auto &a, const auto &b) {
+        return a->firstPosition() < b->firstPosition();
+    });
+    QMap<int, std::shared_ptr<QTextLogicalFlowProjection>> index;
+    QMap<int, int> parents;
+    QList<std::shared_ptr<QTextLogicalFlowProjection>> stack;
+    for (const auto &flow : std::as_const(replacement)) {
+        if (index.contains(flow->firstPosition())) return false;
+        while (!stack.isEmpty() && flow->firstPosition() >= stack.last()->lastPosition()) stack.removeLast();
+        if (!stack.isEmpty()) {
+            const auto &parent = stack.last();
+            if (flow->lastPosition() > parent->lastPosition()
+                || !parent->inCaption(flow->firstPosition())
+                || !parent->inCaption(flow->lastPosition() > flow->firstPosition()
+                    ? flow->lastPosition() - 1 : flow->firstPosition())) return false;
+            parents.insert(flow->firstPosition(), parent->firstPosition());
+        }
+        index.insert(flow->firstPosition(), flow);
+        stack.append(flow);
+    }
+    d->logicalFlowRevision = document()->revision();
+    d->logicalFlowIndex = std::move(index);
+    d->logicalFlowParents = std::move(parents);
+    d->logicalFlows = std::move(replacement);
+    // Removing the final owner also invalidates later unowned float-wrap caches.
+    document()->markContentsDirty(0, document()->characterCount());
+    return true; // No member access after the potentially reentrant notification.
+}
+
+std::shared_ptr<QTextLogicalFlowProjection> QTextDocumentLayoutPrivate::logicalFlowAt(int position, bool includeCaption) const
+{
+    auto it = logicalFlowIndex.upperBound(position);
+    if (it == logicalFlowIndex.cbegin()) return {};
+    --it;
+    while (it != logicalFlowIndex.cend()) {
+        const auto &flow = it.value();
+        if (flow->current() && position >= flow->firstPosition() && position <= flow->lastPosition()
+            && (includeCaption || !flow->inCaption(position))) return flow;
+        const auto parent = logicalFlowParents.constFind(it.key());
+        if (parent == logicalFlowParents.cend()) return {};
+        it = logicalFlowIndex.find(parent.value());
+    }
+    return {};
+}
+
+bool QTextDocumentLayout::wikidictIsCurrentFigureCaption(const QTextBlock &block) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!block.isValid() || block.document() != document() || d->insideDocumentChange
+        || d->paragraphBoxError || document()->revision() != d->logicalFlowRevision)
+        return false;
+    QTextFrame *content = d->docPrivate->frameAt(block.position());
+    while (content && content->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("caption-content"))
+        content = content->parentFrame();
+    if (!wikidictFigureTableCaptionFrame(content)
+        || block.position() < content->firstPosition()
+        || block.position() + block.length() - 1 > content->lastPosition())
+        return false;
+    auto *caption = qobject_cast<QTextTable *>(content->parentFrame());
+    auto *figure = wikidictFigureTableCaptionRoot(content);
+    if (!caption || !figure || caption->parentFrame() != figure
+        || !wikidictFigureTableCaptionFrame(caption)
+        || caption->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("caption")
+        || wikidictFigureTableCaptionRoot(caption) != figure
+        || caption->rows() != 1 || caption->columns() != 1
+        || caption->childFrames().size() != 1 || caption->childFrames().first() != content
+        || figure->childFrames().size() != 2 || figure->childFrames().at(1) != caption)
+        return false;
+    // The regular Figure layout path already validates the complete policy.
+    // A dirty/active owner must not acquire geometry authority from role strings.
+    for (const QTextFrame *owner : {figure, static_cast<QTextFrame *>(caption), content}) {
+        const auto *fd = static_cast<const QTextFrameData *>(owner->layoutData());
+        if (!fd || fd->layoutDirty || fd->sizeDirty || fd->currentLayoutStruct)
+            return false;
+    }
+    const int anchor = figure->firstPosition() - 1;
+    const auto flow = d->logicalFlowAt(anchor, true);
+    if (!flow || !flow->current())
+        return false;
+    for (const auto &object : flow->objects())
+        if (object.frame == figure && object.first == anchor
+            && object.last == figure->lastPosition() + 1
+            && block.position() > object.first
+            && block.position() + block.length() - 1 < object.last)
+            return true;
+    return false;
+}
+
+static constexpr int WikidictFigureLinkPolicy = QTextFormat::UserProperty + 0x57b4;
+static constexpr int WikidictFigureLinkOwner = WikidictFigureLinkPolicy + 1;
+static constexpr int WikidictFigureLinkFixed = WikidictFigureLinkPolicy + 5;
+static constexpr int WikidictFigureLinkOutline = WikidictFigureLinkPolicy + 6;
+static constexpr int WikidictFigureLinkAtomic = WikidictFigureLinkPolicy + 7;
+static const QString &wikidictFigureLinkCapability()
+{
+    static const QString value = QStringLiteral("wikidict.figure-link-state/1");
+    return value;
+}
+static bool wikidictFixedFigureLink(const QTextFormat &format)
+{
+    return format.stringProperty(WikidictFigureLinkPolicy) == wikidictFigureLinkCapability()
+        && format.property(WikidictFigureLinkOwner).metaType().id() == QMetaType::LongLong
+        && format.property(WikidictFigureLinkOwner).toLongLong() >= (qint64(1) << 32);
+}
+
+static const QString &wikidictOrdinaryLinkCapability()
+{
+    static const QString value = QStringLiteral("wikidict.ordinary-link-state/1");
+    return value;
+}
+
+static bool wikidictOrdinaryLink(const QTextCharFormat &format)
+{
+    const auto policy = format.property(WikidictFigureLinkPolicy);
+    const auto owner = format.property(WikidictFigureLinkOwner);
+    const auto value = format.property(WikidictFigureLinkFixed);
+    if (policy.metaType().id() != QMetaType::QString || policy.toString() != wikidictOrdinaryLinkCapability()
+        || owner.metaType().id() != QMetaType::LongLong || owner.toLongLong() < (qint64(1) << 32)
+        || owner.toLongLong() >= (qint64(1) << 33) || !format.isAnchor() || format.anchorHref().isEmpty()
+        || format.boolProperty(WikidictFigureLinkAtomic)
+        || value.metaType().id() != QMetaType::QVariantMap) return false;
+    const auto paint = value.toMap();
+    if (paint.size() != 9 && paint.size() != 10) return false;
+    for (const auto &key : {"normal", "hover", "active", "hover_active", "visited", "visited_hover", "visited_active", "visited_hover_active"}) {
+        const auto state = paint.value(QLatin1String(key));
+        if (state.metaType().id() != QMetaType::QVariantMap) return false;
+        const auto fields = state.toMap();
+        const auto ink = fields.value(QStringLiteral("foreground"));
+        if (fields.size() != 2 || ink.metaType().id() != QMetaType::QString
+            || fields.value(QStringLiteral("underline")).metaType().id() != QMetaType::Bool) return false;
+        const QString name = ink.toString(); const QColor color(name);
+        if (name.size() != 7 || name.front() != u'#' || !color.isValid() || color.name() != name) return false;
+    }
+    if (paint.value(QStringLiteral("underline_on_focus")).metaType().id() != QMetaType::Bool
+        || (paint.size() == 10 && !paint.contains(QStringLiteral("focus_outline")))) return false;
+    const auto outline = format.property(WikidictFigureLinkOutline);
+    if (outline.metaType().id() != QMetaType::QVariantMap) return false;
+    const auto fields = outline.toMap();
+    if (fields.isEmpty()) return !paint.contains(QStringLiteral("focus_outline"))
+        || paint.value(QStringLiteral("focus_outline")).isNull();
+    if (fields.size() != 4 || fields.value(QStringLiteral("color")).metaType().id() != QMetaType::QColor
+        || !fields.value(QStringLiteral("color")).value<QColor>().isValid()) return false;
+    for (const auto &key : {"width", "radius", "offset"}) {
+        bool ok = false; const qreal number = fields.value(QLatin1String(key)).toDouble(&ok);
+        if (!ok || !qIsFinite(number) || qAbs(number) >= 1e6
+            || (qstrcmp(key, "offset") && number < 0)) return false;
+    }
+    return true;
+}
+
+bool QTextDocumentLayoutPrivate::currentOrdinaryLinkFrame(QTextFrame *frame) const
+{
+    if (!frame || frame->document() != document || document->object(frame->objectIndex()) != frame
+        || insideDocumentChange || paragraphBoxError
+        || (!logicalFlows.isEmpty() && document->revision() != logicalFlowRevision)) return false;
+    for (auto *owner = frame; owner; owner = owner->parentFrame()) {
+        const auto *fd = static_cast<const QTextFrameData *>(owner->layoutData());
+        if (!fd || fd->layoutDirty || fd->sizeDirty || fd->currentLayoutStruct) return false;
+    }
+    return true;
+}
+
+QTextFrame *QTextDocumentLayoutPrivate::currentFigureLinkRoot(QTextFrame *frame) const
+{
+    if (!frame || insideDocumentChange || paragraphBoxError || document->revision() != logicalFlowRevision)
+        return nullptr;
+    for (auto *owner = frame; owner; owner = owner->parentFrame()) {
+        const auto *fd = static_cast<const QTextFrameData *>(owner->layoutData());
+        if (!fd || fd->layoutDirty || fd->sizeDirty || fd->currentLayoutStruct) return nullptr;
+        if (owner->frameFormat().stringProperty(WikidictFigureRole) != QStringLiteral("figure")) continue;
+        if (!wikidictFigureTableCaptionFrame(owner)) return nullptr;
+        const int first = owner->firstPosition() - 1;
+        const auto flow = logicalFlowAt(first, true);
+        if (!flow || !flow->current()) return nullptr;
+        for (const auto &object : flow->objects())
+            if (object.frame == owner && object.first == first && object.last == owner->lastPosition() + 1)
+                return owner;
+        return nullptr;
+    }
+    return nullptr;
+}
+
+bool QTextDocumentLayoutPrivate::figureLinkPolicyMatches(QTextFrame *frame, const QTextFormat &format, bool missing) const
+{
+    const auto *root = currentFigureLinkRoot(frame);
+    if (!root || !wikidictFixedFigureLink(format)) return false;
+    const auto meta = QJsonDocument::fromJson(root->frameFormat().property(WikidictFigureOwner + 3).toByteArray()).object();
+    const auto source = meta.value(QStringLiteral("figure")).toObject().value(QStringLiteral("table_caption_layout")).toObject();
+    const auto policy = source.value(missing ? QStringLiteral("missing_link_paint") : QStringLiteral("caption_link_paint"));
+    return policy.isObject() && !policy.toObject().isEmpty()
+        && policy.toObject().toVariantMap() == format.property(WikidictFigureLinkFixed).toMap();
+}
+
+QList<QRectF> QTextDocumentLayoutPrivate::figureMissingLinkBoxes(QTextFrame *image, int *position) const
+{
+    if (position) *position = -1;
+    if (!wikidictFigureMediaFrame(image) || !currentFigureLinkRoot(image) || image->childFrames().size() != 1) return {};
+    auto *label = image->childFrames().first();
+    const auto *fd = static_cast<const QTextFrameData *>(image->layoutData());
+    if (!fd || fd->wikidictFixedLinkPosition < 0 || !figureLinkPolicyMatches(label, label->frameFormat(), true)) return {};
+    if (position) *position = fd->wikidictFixedLinkPosition;
+    return fd->wikidictFixedLinkBoxes;
+}
+
+static QRectF wikidictFigureLinkOutlineRect(QRectF box, qreal width, qreal outset)
+{
+    if (!qIsFinite(box.x()) || !qIsFinite(box.y()) || !qIsFinite(box.width()) || !qIsFinite(box.height())
+        || box.width() < 0 || box.height() < 0 || !qIsFinite(width) || width <= 0 || !qIsFinite(outset)) return {};
+    box.adjust(-outset - width / 2, -outset - width / 2, outset + width / 2, outset + width / 2);
+    const auto center = box.center();
+    box.setWidth(qMax(width, box.width())); box.setHeight(qMax(width, box.height())); box.moveCenter(center);
+    return box;
+}
+
+static void wikidictDrawFigureLinkOutline(QPainter *painter, const QList<QRectF> &boxes,
+                                         const QVariantMap &outline, qreal scale, const QPointF &offset,
+                                         const QRectF &clip)
+{
+    const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+    const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+    const qreal radius = qMax(qreal(0), outline.value(QStringLiteral("radius")).toDouble() * scale + outset + width / 2);
+    if (!qIsFinite(width) || width <= 0 || !qIsFinite(outset) || !qIsFinite(radius)) return;
+    QPainterPath contour;
+    for (auto box : boxes) {
+        box = wikidictFigureLinkOutlineRect(box.translated(offset), width, outset);
+        if (!box.isValid()) continue;
+        QPainterPath piece; piece.addRoundedRect(box, radius, radius);
+        contour = contour.isEmpty() ? piece : contour.united(piece);
+    }
+    if (contour.isEmpty()) return;
+    painter->save();
+    if (clip.isValid()) painter->setClipRect(clip, Qt::IntersectClip);
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setBrush(Qt::NoBrush); painter->setPen(QPen(outline.value(QStringLiteral("color")).value<QColor>(), width));
+    painter->drawPath(contour); painter->restore();
+}
+
+struct WikidictReferenceItem {
+    QJsonObject source, reference, item;
+    QByteArray bytes;
+    quint32 number = 0;
+    QTextFrame *owner = nullptr;
+};
+static bool wikidictReferenceItem(const QTextBlock &block, WikidictReferenceItem *out)
+{
+    const auto raw = block.blockFormat().property(QCompiledReference::ListProperty);
+    if (raw.metaType().id() != QMetaType::QVariantMap) return false;
+    const auto p = raw.toMap();
+    if (p.size() != 4 || p.value(QStringLiteral("capability")).metaType().id() != QMetaType::QString
+        || p.value(QStringLiteral("capability")) != QVariant(QString::fromLatin1(QCompiledReference::Capability))
+        || p.value(QStringLiteral("number")).metaType().id() != QMetaType::UInt
+        || p.value(QStringLiteral("owner")).metaType().id() != QMetaType::QObjectStar
+        || !QCompiledReference::object(p.value(QStringLiteral("source")), &out->source)
+        || out->source.size() != 2 || !out->source.value(QStringLiteral("reference")).isObject()
+        || !out->source.value(QStringLiteral("item")).isObject()) return false;
+    out->bytes = p.value(QStringLiteral("source")).toByteArray();
+    out->reference = out->source.value(QStringLiteral("reference")).toObject();
+    out->item = out->source.value(QStringLiteral("item")).toObject();
+    out->owner = block.document()->frameAt(block.position());
+    if (p.value(QStringLiteral("owner")).value<QObject *>() != out->owner || !wikidictPlainContainer(out->owner)
+        || !QCompiledReference::positiveU32(out->reference.value(QStringLiteral("group_number")), &out->number)
+        || p.value(QStringLiteral("number")).toUInt() != out->number || !block.textList()
+        || block.textList()->count() != 1 || block.textList()->format().style() != QTextListFormat::ListDecimal
+        || block.textList()->format().indent() != 0 || block.blockFormat().indent() != 0
+        || (block.textDirection() != Qt::LeftToRight && block.textDirection() != Qt::RightToLeft)) return false;
+    QJsonObject frameSource;
+    if (!QCompiledReference::object(out->owner->frameFormat().property(QTextFormat::UserProperty + 0x57e2), &frameSource)
+        || frameSource.value(QStringLiteral("kind")) != QStringLiteral("container")
+        || frameSource.value(QStringLiteral("container")).toObject().value(QStringLiteral("style")) != out->item.value(QStringLiteral("box"))) return false;
+    // Authenticate the application's existing one-paragraph projection, not a
+    // second text renderer. The backlink and original body spans stay exact.
+    const auto blocks = frameSource.value(QStringLiteral("container")).toObject().value(QStringLiteral("blocks")).toArray();
+    const auto backlinks = out->reference.value(QStringLiteral("backlinks")).toArray();
+    const auto bodySpans = out->reference.value(QStringLiteral("spans")).toArray();
+    if (blocks.size() != 1 || backlinks.size() != 1 || bodySpans.isEmpty()
+        || blocks.first().toObject().value(QStringLiteral("kind")) != QStringLiteral("paragraph")) return false;
+    const auto projected = blocks.first().toObject().value(QStringLiteral("spans")).toArray();
+    if (projected.size() != bodySpans.size() + 2
+        || projected.first() != backlinks.first().toObject().value(QStringLiteral("span"))) return false;
+    for (qsizetype i = 0; i < bodySpans.size(); ++i) if (projected[i + 2] != bodySpans[i]) return false;
+    const auto prefix = projected[1].toObject();
+    if (prefix.value(QStringLiteral("kind")) != QStringLiteral("text") || prefix.value(QStringLiteral("text")) != QStringLiteral(" ")
+        || !prefix.value(QStringLiteral("target")).toString().isEmpty() || !prefix.value(QStringLiteral("trail")).toString().isEmpty()
+        || prefix.value(QStringLiteral("inline_style")).toObject().value(QStringLiteral("font_normalized")) != true) return false;
+    const auto ownerFont = out->item.value(QStringLiteral("box")).toObject().value(QStringLiteral("owner_font")).toObject();
+    if (ownerFont.value(QStringLiteral("font_normalized")) != true) return false;
+    for (auto it = ownerFont.begin(); it != ownerFont.end(); ++it)
+        if (it.key() != QStringLiteral("font_normalized") && prefix.value(it.key()) != it.value()) return false;
+    const auto body = out->reference.value(QStringLiteral("body_typography")).toObject();
+    const auto direction = body.value(QStringLiteral("direction")).toString();
+    if ((direction != QStringLiteral("ltr") && direction != QStringLiteral("rtl"))
+        || block.textDirection() != (direction == QStringLiteral("rtl") ? Qt::RightToLeft : Qt::LeftToRight)) return false;
+    const auto color = out->item.value(QStringLiteral("marker_foreground")).toObject();
+    if (color.size() != 2 || color.value(QStringLiteral("kind")) != QStringLiteral("rgb")
+        || !QCompiledInline::rgb(color.value(QStringLiteral("value")).toVariant())) return false;
+    const auto target = out->item.value(QStringLiteral("target_background")); QColor targetColor;
+    if (!target.isNull() && !target.isUndefined() && !QCompiledReference::background(target, false, &targetColor)) return false;
+    // A marker cannot migrate to a later paragraph or hidden storage block.
+    for (auto prior = out->owner->begin(); !prior.atEnd(); ++prior) {
+        const auto candidate = prior.currentBlock();
+        if (!candidate.isValid() || !candidate.isVisible() || candidate.text().isEmpty()) continue;
+        return candidate == block;
+    }
+    return false;
+}
+struct WikidictReferenceMarker {
+    QTextLayout layout;
+    QPointF at;
+    QColor color;
+    bool valid = false;
+    WikidictReferenceMarker(const QTextBlock &block, const QTextLayout *content, QPaintDevice *device)
+        : layout(QString(), block.charFormat().font().resolve(block.document()->defaultFont()), device)
+    {
+        WikidictReferenceItem reference;
+        if (!content || !content->lineCount() || !wikidictReferenceItem(block, &reference)) return;
+        const QString text = QString::number(reference.number) + QStringLiteral(". ");
+        layout.setText(text);
+        QTextOption option(Qt::AlignLeft | Qt::AlignAbsolute);
+        option.setTextDirection(block.textDirection()); option.setWrapMode(QTextOption::NoWrap);
+        option.setFlags(QTextOption::IncludeTrailingSpaces); layout.setTextOption(option);
+        layout.beginLayout(); auto line = layout.createLine();
+        if (line.isValid()) line.setNumColumns(text.size());
+        layout.endLayout();
+        if (!line.isValid() || line.textLength() != text.size()) return;
+        const auto first = content->lineAt(0);
+        const qreal edge = block.textDirection() == Qt::RightToLeft ? first.rect().right() : first.rect().left();
+        at = QPointF(edge - line.cursorToX(text.size()), first.y() + first.ascent() - line.ascent());
+        color = QColor(reference.item.value(QStringLiteral("marker_foreground")).toObject().value(QStringLiteral("value")).toString());
+        valid = true;
+    }
+};
+static QRectF wikidictReferenceMarkerTraversal(const QTextBlock &block, const QTextLayout *content, QPaintDevice *device)
+{
+    if (!block.blockFormat().hasProperty(QCompiledReference::ListProperty)) return {};
+    WikidictReferenceMarker marker(block, content, device);
+    return marker.valid ? wikidictTextTraversal(&marker.layout).translated(marker.at) : QRectF();
+}
+static bool wikidictReferenceTargetPolicy(const QTextCharFormat &format, QCompiledReference::Citation *citation)
+{
+    return format.hasProperty(QCompiledReference::CitationProperty)
+        && QCompiledReference::citation(format.property(QCompiledReference::CitationProperty), citation)
+        && format.isAnchor() && format.anchorHref() == QStringLiteral("dict:#") + citation->span.value(QStringLiteral("target_fragment")).toString()
+        && format.property(WikidictFigureLinkOwner) == QVariant::fromValue(citation->owner)
+        && citation->span.value(QStringLiteral("citation_marker")).toObject().value(QStringLiteral("target_style")).isObject();
+}
+static QList<QVariantMap> wikidictReferenceTraversalOutlines(const QTextCharFormat &format)
+{
+    QList<QVariantMap> result{format.property(WikidictFigureLinkOutline).toMap()};
+    QCompiledReference::Citation citation;
+    // Ancestor traversal is cached. Reserve both authenticated focus policies,
+    // just as ordinary focus ink is reserved before the link gains focus.
+    if (wikidictReferenceTargetPolicy(format, &citation) && citation.outline != result.first())
+        result.append(citation.outline);
+    return result;
+}
+static QVariantMap wikidictSelectedReferenceOutline(const QTextCharFormat &format, const QTextDocument *document)
+{
+    const auto ordinary = format.property(WikidictFigureLinkOutline).toMap();
+    if (!document || !format.hasProperty(QCompiledReference::CitationProperty)) return ordinary;
+    QCompiledReference::Citation citation;
+    if (!wikidictReferenceTargetPolicy(format, &citation)
+        || !QCompiledReference::targeted(document->property("wikidict.reference.target"), document->property("wikidict.reference.epoch"), citation)) return ordinary;
+    return citation.outline;
+}
+static QBrush wikidictReferenceBackground(QTextFrame *frame, const QBrush &ordinary, bool dark)
+{
+    const auto raw = frame->document()->property("wikidict.reference.target");
+    if (raw.metaType().id() != QMetaType::QVariantMap) return ordinary;
+    const auto state = raw.toMap();
+    const auto epoch = frame->document()->property("wikidict.reference.epoch");
+    if (state.size() != 4 || epoch.metaType().id() != QMetaType::ULongLong || epoch.toULongLong() == 0
+        || state.value(QStringLiteral("kind")).metaType().id() != QMetaType::QString
+        || state.value(QStringLiteral("epoch")).metaType().id() != QMetaType::ULongLong
+        || state.value(QStringLiteral("epoch")) != epoch || state.value(QStringLiteral("kind")) != QStringLiteral("item")
+        || state.value(QStringLiteral("number")).metaType().id() != QMetaType::UInt
+        || state.value(QStringLiteral("source")).metaType().id() != QMetaType::QByteArray) return ordinary;
+    for (auto it = frame->begin(); !it.atEnd(); ++it) {
+        const auto block = it.currentBlock();
+        if (!block.isValid() || !block.blockFormat().hasProperty(QCompiledReference::ListProperty)) continue;
+        WikidictReferenceItem item;
+        quint32 referenceNumber = 0;
+        if (!wikidictReferenceItem(block, &item) || item.owner != frame || state.value(QStringLiteral("source")).toByteArray() != item.bytes
+            || !QCompiledReference::positiveU32(item.reference.value(QStringLiteral("number")), &referenceNumber)
+            || state.value(QStringLiteral("number")).toUInt() != referenceNumber) return ordinary;
+        const auto color = item.item.value(QStringLiteral("target_background"));
+        if (color.isNull() || color.isUndefined()) return ordinary;
+        QColor used;
+        if (QCompiledReference::background(color, dark, &used)) return QBrush(used);
+        return ordinary;
+    }
+    return ordinary;
+}
+
+static QList<QRectF> wikidictFigureLinkFragmentBoxes(const QTextLayout *layout, int first, int length)
+{
+    QList<QRectF> boxes;
+    auto *engine = layout->engine();
+    QTextLayout::FormatRange selection; selection.start = first; selection.length = length;
+    for (int index = 0; index < engine->lines.size(); ++index) {
+        const auto &line = engine->lines[index];
+        if (line.from >= first + length || line.from + line.length <= first) continue;
+        QTextLineItemIterator iterator(engine, index, QPointF(), &selection);
+        while (!iterator.atEnd()) {
+            const auto &item = iterator.next(); QFixed left, width;
+            if (!iterator.getSelectionBounds(&left, &width) || width < 0) continue;
+            QRectF box(left.toReal(), line.y.toReal(), width.toReal(), line.height().toReal());
+            const auto format = engine->format(&item);
+            if (item.analysis.flags == QScriptAnalysis::Object && format.isImageFormat()
+                && wikidictOrdinaryLink(format)) {
+                // Match QTextLine::draw_internal's actual replaced-object box,
+                // including legacy alignment. Text keeps its existing line slab.
+                QFixed top = line.y + line.base() - item.ascent;
+                switch (format.verticalAlignment()) {
+                case QTextCharFormat::AlignTop: top = line.y; break;
+                case QTextCharFormat::AlignMiddle: top = line.y + (line.height() - item.height()) / 2; break;
+                case QTextCharFormat::AlignBottom: top = line.y + line.height() - item.height(); break;
+                default: break;
+                }
+                box = QRectF(iterator.x.toReal(), top.toReal(), iterator.itemWidth.toReal(), item.height().toReal());
+            }
+            if (!boxes.isEmpty() && boxes.last().y() == box.y() && boxes.last().height() == box.height()
+                && boxes.last().right() == box.left()) boxes.last() = boxes.last().united(box);
+            else boxes.append(box);
+        }
+    }
+    return boxes;
+}
+
+static void wikidictDrawInlineActionBands(QPainter *painter, const QTextLayout *layout,
+        const QPointF &offset, const QList<QTextLayout::FormatRange> &selections,
+        QPaintDevice *device, const QRectF &clip, bool background)
+{
+    struct Band { qreal left, right, baseline; QTextCharFormat action, overlay; };
+    QList<Band> bands;
+    auto *engine = layout->engine();
+    for (int index = 0; index < engine->lines.size(); ++index) {
+        const auto &line = engine->lines[index];
+        QTextLayout::FormatRange whole{line.from, line.length, QTextCharFormat()};
+        QTextLineItemIterator iterator(engine, index, QPointF(), &whole);
+        while (!iterator.atEnd()) {
+            const auto &item = iterator.next();
+            const auto action = engine->format(&item);
+            // Ruby owns its allocated base band; ordinary glyphs preserve
+            // wrapping and bidi runs without turning the anchor into an object.
+            if (item.analysis.flags == QScriptAnalysis::Object || !QCompiledInline::actionMetric(action)) continue;
+            QFixed left, width;
+            if (!iterator.getSelectionBounds(&left, &width) || width <= 0) continue;
+            QTextCharFormat overlay;
+            for (const auto &selection : selections)
+                if (selection.start < item.position + engine->length(&item)
+                    && selection.start + selection.length > item.position
+                    && !QCompiledInline::actionPaint(selection.format, action).isEmpty()) overlay = selection.format;
+            Band band{left.toReal(), (left + width).toReal(), (line.y + line.base()).toReal(), action, overlay};
+            bands.append(band);
+        }
+    }
+    // Bidi visual runs need not arrive in x order. Merge each owner's touching
+    // intervals once, without a quadratic scan or bridges painted twice.
+    std::stable_sort(bands.begin(), bands.end(), [](const Band &a, const Band &b) {
+        const auto ai = a.action.property(QCompiledInline::ActionOwnerProperty).toLongLong();
+        const auto bi = b.action.property(QCompiledInline::ActionOwnerProperty).toLongLong();
+        if (ai != bi) return ai < bi;
+        if (a.baseline != b.baseline) return a.baseline < b.baseline;
+        return a.left < b.left;
+    });
+    QList<Band> merged;
+    for (const auto &band : bands) {
+        if (!merged.isEmpty()) {
+            auto &prior = merged.last();
+            if (prior.baseline == band.baseline && QCompiledInline::actionOwner(prior.action) == QCompiledInline::actionOwner(band.action)
+                && prior.action.property(QCompiledInline::ActionMetricProperty) == band.action.property(QCompiledInline::ActionMetricProperty)
+                && prior.overlay == band.overlay && band.left <= prior.right) {
+                prior.right = qMax(prior.right, band.right); continue;
+            }
+        }
+        merged.append(band);
+    }
+    painter->save();
+    if (clip.isValid()) painter->setClipRect(clip, Qt::IntersectClip);
+    const auto origin = offset + layout->position();
+    for (const auto &band : merged)
+        QCompiledInline::drawActionBand(painter, band.action, origin.x() + band.left, origin.x() + band.right,
+            origin.y() + band.baseline, device, band.overlay, background);
+    painter->restore();
+}
+
+static QList<QTextLayout::FormatRange> wikidictOrdinaryFlowLinks(const QTextLogicalFlowProjection &flow)
+{
+    QList<QTextLayout::FormatRange> ranges;
+    if (!flow.current()) return ranges;
+    // Primary Figure media owns the decorated action rectangle, not an inline
+    // line fragment. Its outline is painted and traversed with that frame.
+    if (wikidictFigureMediaFrame(flow.parentFrame())
+        && wikidictFigureMediaObject(flow.parentFrame()).isValid()) return ranges;
+    const auto &units = flow.sourceMap();
+    for (const auto &item : flow.textLayout()->formats()) {
+        if (!wikidictOrdinaryLink(item.format) || item.start < 0 || item.length < 0
+            || item.start > units.size() || item.length > units.size() - item.start) continue;
+        for (int i = item.start; i < item.start + item.length; ++i) {
+            if (units.at(i).kind != QTextLogicalFlowProjection::Kind::Text) continue;
+            if (!ranges.isEmpty() && ranges.last().start + ranges.last().length == i
+                && ranges.last().format == item.format) ++ranges.last().length;
+            else ranges.append({i, 1, item.format});
+        }
+    }
+    return ranges;
+}
+
+static QRectF wikidictOrdinaryFlowLinkTraversal(const QTextLogicalFlowProjection &flow, qreal scale)
+{
+    QRectF result;
+    for (const auto &item : wikidictOrdinaryFlowLinks(flow)) {
+        for (const auto &outline : wikidictReferenceTraversalOutlines(item.format)) {
+            const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+            const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+            for (const auto &box : wikidictFigureLinkFragmentBoxes(flow.textLayout(), item.start, item.length)) {
+                const auto stroke = wikidictFigureLinkOutlineRect(box, width, outset);
+                if (stroke.isValid()) result |= stroke.adjusted(-width / 2, -width / 2, width / 2, width / 2);
+            }
+        }
+    }
+    for (const auto &link : flow.rubyLinkBoxes()) {
+        if (!wikidictOrdinaryLink(link.format)) continue;
+        for (const auto &outline : wikidictReferenceTraversalOutlines(link.format)) {
+            const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+            const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+            const auto stroke = wikidictFigureLinkOutlineRect(link.rect, width, outset);
+            if (stroke.isValid()) result |= stroke.adjusted(-width / 2, -width / 2, width / 2, width / 2);
+        }
+    }
+    return result;
+}
+
+static QRectF wikidictFigureLinkTraversal(const QTextBlock &block, const QTextLayout *layout, qreal scale, bool ordinary = true)
+{
+    QRectF result;
+    const auto *frame = block.document()->frameAt(block.position());
+    if (wikidictFigureMediaFrame(frame) && wikidictFigureMediaObject(frame).isValid()) return result;
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment(); const auto format = fragment.charFormat();
+        if ((!wikidictFixedFigureLink(format) && !(ordinary && wikidictOrdinaryLink(format))) || format.boolProperty(WikidictFigureLinkAtomic)) continue;
+        for (const auto &outline : wikidictReferenceTraversalOutlines(format)) {
+            const qreal width = outline.value(QStringLiteral("width")).toDouble() * scale;
+            const qreal outset = outline.value(QStringLiteral("offset")).toDouble() * scale;
+            if (!qIsFinite(width) || width <= 0 || !qIsFinite(outset)) continue;
+            for (const auto &box : wikidictFigureLinkFragmentBoxes(layout, fragment.position() - block.position(), fragment.length())) {
+                const auto stroke = wikidictFigureLinkOutlineRect(box, width, outset);
+                if (stroke.isValid()) result |= stroke.adjusted(-width / 2, -width / 2, width / 2, width / 2);
+            }
+        }
+    }
+    return result;
+}
+
+void QTextDocumentLayoutPrivate::drawFigureCaptionLinkOutline(const QPointF &offset, QPainter *painter,
+        const QAbstractTextDocumentLayout::PaintContext &context, const QTextBlock &block) const
+{
+    const auto focused = document->property("wikidict.figure.linkFocusOwner");
+    if (!focused.isValid() || focused.toLongLong() < (qint64(1) << 32)) return;
+    auto *frame = document->frameAt(block.position());
+    if (wikidictFigureMediaFrame(frame) && wikidictFigureMediaObject(frame).isValid()) return;
+    const auto *layout = block.layout();
+    if (!layout) return;
+    QList<QRectF> boxes;
+    QVariantMap outline;
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment(); const auto format = fragment.charFormat();
+        if (!format.isAnchor() || format.boolProperty(WikidictFigureLinkAtomic)
+            || format.property(WikidictFigureLinkOwner).toLongLong() != focused.toLongLong()
+            || !(wikidictOrdinaryLink(format) ? currentOrdinaryLinkFrame(frame)
+                : figureLinkPolicyMatches(frame, format, false))) continue;
+        outline = wikidictSelectedReferenceOutline(format, document);
+        // Reuse the native selection iterator's shaped bidi/run intervals.
+        boxes.append(wikidictFigureLinkFragmentBoxes(layout, fragment.position() - block.position(), fragment.length()));
+    }
+    wikidictDrawFigureLinkOutline(painter, boxes, outline, scaleToDevice(1), offset + layout->position(),
+        context.clip.isValid() ? (context.clip & clipRect) : clipRect);
+}
+
+qreal QTextDocumentLayoutPrivate::logicalHorizontalMinimum(QTextFrame *ancestor) const
+{
+    // Report authenticated table and plain-container traversal overflow. This
+    // is a signed scroll origin, not a translation of native source coordinates.
+    qreal minimum = 0;
+    if (!paragraphBoxError && plainContainersPresent) {
+        auto *owner = ancestor ? ancestor : document->rootFrame();
+        const auto *fd = data(owner);
+        if (!fd->sizeDirty && fd->wikidictTraversalBounds.isValid()) {
+            const qreal left = frameBoundingRectInternal(owner).left() + fd->wikidictTraversalBounds.left();
+            if (std::isfinite(left) && left > -qreal(QFIXED_MAX)) minimum = qMin(minimum, left);
+        }
+    }
+    if (!paragraphBoxError) for (const auto &flow : std::as_const(logicalFlows)) {
+        if (!flow->current()) continue;
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || !QTextLogicalFlowProjection::inlineTable(object.frame)
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow
+                || data(object.frame)->layoutDirty || data(object.frame)->sizeDirty) continue;
+            auto *table = qobject_cast<QTextTable *>(object.frame.data());
+            if (!table) continue;
+            if (ancestor) {
+                QTextFrame *parent = table;
+                while (parent && parent != ancestor) parent = parent->parentFrame();
+                if (!parent) continue;
+            }
+            bool locallyClipped = false;
+            for (auto *parent = table->parentFrame(); parent && parent != ancestor; parent = parent->parentFrame())
+                locallyClipped |= data(parent)->wikidictScrollport;
+            if (locallyClipped) continue;
+            const qreal left = tableBoundingRectInternal(table).left();
+            if (std::isfinite(left) && left > -qreal(QFIXED_MAX)) minimum = qMin(minimum, left);
+        }
+    }
+    return minimum;
+}
+
+void QTextDocumentLayoutPrivate::updateLogicalHorizontalMinimum()
+{
+    const int rounded = qFloor(logicalHorizontalMinimum());
+    auto *layout = q_func();
+    const QVariant old = layout->property("_wikidictLogicalHorizontalMinimum");
+    if (rounded == 0 && !old.isValid()) return;
+    if (old.metaType().id() == QMetaType::Int && old.toInt() == rounded) return;
+    // A changed signed origin matters even if the reported positive extent
+    // stayed identical. Reuse the normal deferred scrollbar notification.
+    sizeChangedTimer.start(0, layout);
+    layout->setProperty("_wikidictLogicalHorizontalMinimum", rounded);
+}
+
+bool QTextDocumentLayout::wikidictHasLogicalFlows() const
+{
+    Q_D(const QTextDocumentLayout);
+    return !d->logicalFlows.isEmpty();
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalBoundary(int position, bool paragraph) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (d->logicalFlows.isEmpty())
+        return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    if (d->paragraphBoxError)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError}};
+    const auto range = flow->sourceBoundary(position, paragraph);
+    if (range.start < 0)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 0},
+        {QStringLiteral("start"), range.start}, {QStringLiteral("end"), range.start + range.length},
+        {QStringLiteral("ownerFirst"), flow->firstPosition()}, {QStringLiteral("ownerLast"), flow->lastPosition()}};
+}
+
+QVariantMap QTextDocumentLayout::wikidictAuthoredRuleGeometry(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    const QPointer<const QTextDocumentLayout> self(this);
+    const QPointer<QTextDocument> owner(document());
+    const auto block = owner->findBlock(position);
+    if (!block.isValid() || !block.blockFormat().hasProperty(WikidictAuthoredRule))
+        return {{QStringLiteral("handled"), false}};
+    const QVariantMap unavailable{{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    const int revision = owner->revision();
+    const auto format = block.blockFormat();
+    if (!d->docPrivate->canLayout() || d->insideDocumentChange || data(owner->rootFrame())->currentLayoutStruct)
+        return unavailable;
+    d->ensureLayoutFinished();
+    if (!self || !owner || owner->documentLayout() != this || owner->revision() != revision
+        || !block.isValid() || block.blockFormat() != format) return unavailable;
+    if (d->paragraphBoxError)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError}};
+    for (auto *frame = owner->frameAt(position); frame; frame = frame->parentFrame()) {
+        const auto *fd = data(frame);
+        if (fd->sizeDirty || fd->layoutDirty || fd->currentLayoutStruct) return unavailable;
+    }
+    const auto local = d->authoredRuleRect(block);
+    if (!local || position != block.position() || block.length() != 1) return unavailable;
+    const QRectF rect = blockBoundingRect(block);
+    if (!self || !owner || owner->documentLayout() != this || owner->revision() != revision
+        || !block.isValid() || block.blockFormat() != format) return unavailable;
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 0},
+        {QStringLiteral("position"), position}, {QStringLiteral("revision"), revision},
+        {QStringLiteral("characterRect"), rect},
+        {QStringLiteral("cursorRect"), QRectF(rect.topLeft(), QSizeF(qMax(0, d->cursorWidth), rect.height()))}};
+}
+
+static qreal wikidictInlineBoxScale(const QTextLayout *layout, const QCompiledInlineBox::Box &box)
+{
+    const auto *engine = layout->engine();
+    const auto *document = engine->projectedDocument ? engine->projectedDocument.data() : engine->block.document();
+    const auto *device = document && document->documentLayout() ? document->documentLayout()->paintDevice() : nullptr;
+    return QCompiledInline::deviceScale(device ? QFont(box.font, device) : box.font);
+}
+static QList<QCompiledInlineBox::Decoration> wikidictInlineBoxDecorations(const QTextLayout *layout,
+        const QList<QCompiledInlineBox::PaintSlice> &parts)
+{
+    QList<qreal> scales; scales.reserve(parts.size());
+    for (const auto &part : parts) scales.append(wikidictInlineBoxScale(layout, part.box));
+    QList<QCompiledInlineBox::Decoration> result;
+    if (!QCompiledInlineBox::decorations(parts, scales, &result)) {
+        layout->engine()->setInlineBoxInvalid(true); return {};
+    }
+    return result;
+}
+static QVariantMap wikidictInlineBoxActionGeometry(const QTextLayout *layout, int sourcePosition, const QPointF &origin)
+{
+    if (!layout || !layout->engine()->hasInlineBoxes() || layout->engine()->inlineBoxInvalid()) return {};
+    const auto *engine = layout->engine();
+    const auto *document = engine->projectedDocument ? engine->projectedDocument.data() : engine->block.document();
+    if (!document) return {};
+    bool ownerStart = false;
+    const auto block = document->findBlock(sourcePosition);
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment();
+        if (!fragment.isValid() || fragment.position() > sourcePosition || fragment.position() + fragment.length() <= sourcePosition) continue;
+        const auto identity = fragment.charFormat().property(QCompiledInlineBox::Property).toMap();
+        ownerStart = (identity.contains("action") || identity.contains("childAction")) && identity.value("first") == QVariant(sourcePosition);
+        break;
+    }
+    if (!ownerStart) return {};
+    const auto parts = QCompiledInlineBox::slices(layout);
+    const auto shapes = wikidictInlineBoxDecorations(layout, parts);
+    QPainterPath path;
+    const QCompiledInlineBox::Box *owner = nullptr;
+    for (int i = 0; i < parts.size(); ++i) {
+        const auto &part = parts.at(i);
+        if (!QCompiledInlineBox::hasAction(part.box) || sourcePosition < part.box.first || sourcePosition >= part.box.last) continue;
+        QPainterPath slice;
+        if (!QCompiledInlineBox::actionSlicePath(parts, shapes, i, &slice)) return {};
+        path = path.united(slice); owner = &part.box;
+    }
+    if (!owner || path.isEmpty()) return {};
+    path.translate(origin);
+    return {{QStringLiteral("inlineBoxActionFirst"), owner->first},
+        {QStringLiteral("inlineBoxActionLast"), owner->last},
+        {QStringLiteral("inlineBoxActionHref"), QCompiledInlineBox::actionHref(*owner)},
+        {QStringLiteral("inlineBoxActionPath"), QVariant::fromValue(path)},
+        {QStringLiteral("actionRect"), path.boundingRect()}};
+}
+// 1 is an owned box hit, -1 an inactive box edge, and 0 ordinary text.
+// Fuzzy insertion caret queries never call this action-only branch.
+static int wikidictInlineBoxActionHit(const QTextLayout *layout, const QPointF &point, int *sourcePosition)
+{
+    if (!layout || !layout->engine()->hasInlineBoxes() || layout->engine()->inlineBoxInvalid()) return 0;
+    const auto parts = QCompiledInlineBox::slices(layout);
+    const auto shapes = wikidictInlineBoxDecorations(layout, parts);
+    bool cutAway = false, childEdge = false, childContent = false;
+    for (int i = parts.size() - 1; i >= 0; --i) {
+        const auto &part = parts.at(i);
+        if (!part.geometry.border.contains(point)) continue;
+        // Source-tree edges carry decoration, not the nearest glyph's link.
+        // Vertical label edges still resolve to the original tooltip character.
+        if (part.box.identity.value("sourceRange").toBool()
+            && (point.x() < part.geometry.content.left() || point.x() > part.geometry.content.right())) return -1;
+        // A child link retains ordinary glyph hit testing. The surrounding
+        // actionless box must never lend its added advances to that anchor.
+        if (QCompiledInlineBox::childAction(part.box)) {
+            if (part.geometry.content.contains(point)) childContent = true;
+            else childEdge = true;
+            continue;
+        }
+        if (!QCompiledInlineBox::wholeAction(part.box)) continue;
+        QPainterPath path;
+        if (!QCompiledInlineBox::actionSlicePath(parts, shapes, i, &path)) return -1;
+        if (!path.contains(point)) { cutAway = true; continue; }
+        const auto line = layout->lineAt(part.line);
+        const int at = line.xToCursor(point.x(), QTextLine::CursorOnCharacter);
+        const auto *engine = layout->engine();
+        const int source = engine->projectedDocument ? engine->projectedSourcePositions.value(at, -1)
+            : engine->block.position() + at;
+        // Real leading/trailing characters own the padding; no synthetic source
+        // character or glyph is inserted to create an action target.
+        *sourcePosition = qBound(part.box.first, source, part.box.last - 1);
+        return 1;
+    }
+    // Wrapped child content can overlap another slice's inactive border.
+    // Keep whole-action cutouts independent and let ordinary glyph hits decide
+    // covered child content without lending it the box's padding.
+    return cutAway || (childEdge && !childContent) ? -1 : 0;
+}
+
+static bool wikidictInlineBoxActionContains(const QTextLayout *layout, int position, const QPointF &point)
+{
+    if (!layout || !layout->engine()->hasInlineBoxes()) return true;
+    const auto *engine = layout->engine();
+    if (engine->inlineBoxInvalid()) return false;
+    const int source = engine->projectedDocument ? engine->projectedSourcePositions.value(position, -1)
+        : engine->block.position() + position;
+    const auto parts = QCompiledInlineBox::slices(layout);
+    const auto shapes = wikidictInlineBoxDecorations(layout, parts);
+    bool owned = false;
+    for (int i = 0; i < parts.size(); ++i) {
+        const auto &part = parts.at(i);
+        if (!QCompiledInlineBox::hasAction(part.box) || source < part.box.first || source >= part.box.last) continue;
+        owned = true;
+        QPainterPath path;
+        if (!QCompiledInlineBox::actionSlicePath(parts, shapes, i, &path)) return false;
+        if (path.contains(point)) return true;
+    }
+    return !owned;
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalPosition(int position) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    const auto sourceBlock = document()->findBlock(position);
+    bool actionPosition = sourceBlock.isValid()
+        && sourceBlock.blockFormat().hasProperty(QCompiledInline::EmptyActionOwners);
+    if (sourceBlock.isValid() && !actionPosition)
+        for (auto it = sourceBlock.begin(); !it.atEnd(); ++it) {
+            const auto fragment = it.fragment();
+            if (fragment.isValid() && fragment.position() <= position
+                && position < fragment.position() + fragment.length()) {
+                actionPosition = fragment.charFormat().hasProperty(QCompiledInline::ActionOwnerProperty);
+                break;
+            }
+        }
+    // Mapped geometry can be queried synchronously while owners are being
+    // installed. A source cell exists before its layout vectors do; never
+    // expose partial geometry or recursively enter an active layout.
+    if (d->logicalFlowAt(position) || actionPosition) {
+        if (!d->docPrivate->canLayout() || d->insideDocumentChange
+            || data(document()->rootFrame())->currentLayoutStruct)
+            return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+        if (d->logicalFlowAt(position)) d->ensureLayoutFinished();
+        else d->ensureLayoutedByPosition(position);
+    } else {
+        d->ensureLayoutedByPosition(position);
+    }
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) {
+        QVariantMap result{{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+        const auto block = document()->findBlock(position);
+        if (block.isValid() && block.layout()) {
+            const auto line = block.layout()->lineForTextPosition(position - block.position());
+            if (actionPosition && line.isValid()) {
+                const auto origin = blockBoundingRect(block).topLeft();
+                result.insert(QStringLiteral("lineBaseline"), origin.y() + line.y() + line.ascent());
+                result.insert(QStringLiteral("cursorRect"), QRectF(origin.x() + line.cursorToX(position - block.position()),
+                    origin.y() + line.y(), d->cursorWidth, line.height()));
+            }
+            QRectF caret;
+            if (qt_textInlineCursorRect(block.layout(), position - block.position(), d->cursorWidth, &caret)) {
+                const auto origin = blockBoundingRect(block).topLeft();
+                result.insert(QStringLiteral("cursorRect"), caret.translated(origin));
+            }
+            QRectF character;
+            if (qt_textInlineCursorRect(block.layout(), position - block.position(), 0, &character, true))
+                result.insert(QStringLiteral("inlineCharacterRect"), character.translated(blockBoundingRect(block).topLeft()));
+        }
+        if (const auto owner = d->logicalFlowAt(position, true)) {
+            result.insert(QStringLiteral("first"), owner->firstPosition());
+            result.insert(QStringLiteral("last"), owner->lastPosition());
+        }
+        if (!d->paragraphBoxError && block.isValid() && block.layout()) {
+            const auto action = wikidictInlineBoxActionGeometry(block.layout(), position, blockBoundingRect(block).topLeft());
+            for (auto it = action.cbegin(); it != action.cend(); ++it) result.insert(it.key(), it.value());
+        }
+        return result;
+    }
+    const int projected = flow->toProjected(position);
+    if (projected < 0)
+        return {};
+    QVariantMap result;
+    result.insert(QStringLiteral("handled"), true);
+    result.insert(QStringLiteral("error"), d->paragraphBoxError);
+    if (d->paragraphBoxError)
+        return result;
+    result.insert(QStringLiteral("position"), position);
+    result.insert(QStringLiteral("projected"), projected);
+    result.insert(QStringLiteral("resolvedDirection"), int(flow->direction()));
+    result.insert(QStringLiteral("first"), flow->firstPosition());
+    result.insert(QStringLiteral("last"), flow->lastPosition());
+    result.insert(QStringLiteral("logicalOwnerFirst"), flow->ownerFirstPosition());
+    result.insert(QStringLiteral("logicalOwnerLast"), flow->ownerLastPosition());
+    const auto geometryReady = [](QTextFrame *frame, int sourcePosition) {
+        for (; frame; frame = frame->parentFrame()) {
+            const auto *fd = data(frame);
+            if (fd->sizeDirty || fd->layoutDirty || fd->currentLayoutStruct) return false;
+            if (auto *table = qobject_cast<QTextTable *>(frame)) {
+                const auto cell = table->cellAt(sourcePosition);
+                if (!cell.isValid()) continue;
+                const auto *td = static_cast<const QTextTableData *>(fd);
+                const int row = cell.row(), column = cell.column();
+                const qint64 index = qint64(row) * td->widths.size() + column;
+                if (row < 0 || column < 0 || row >= td->rowPositions.size()
+                    || column >= td->columnPositions.size() || column >= td->widths.size()
+                    || index < 0 || index >= td->cellVerticalOffsets.size()) return false;
+            }
+        }
+        return true;
+    };
+    if (!geometryReady(document()->frameAt(position), position))
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    for (const auto &object : flow->objects()) {
+        if (object.projectedPosition != projected || !object.frame) continue;
+        if (!geometryReady(object.frame, object.frame->firstPosition()))
+            return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+        if (auto *table = qobject_cast<QTextTable *>(object.frame.data()))
+            result.insert(QStringLiteral("objectRect"), d->tableBoundingRectInternal(table));
+        break;
+    }
+    QPointF offset;
+    QTextFrame *parent = document()->frameAt(position);
+    while (parent) {
+        const QTextFrameData *fd = data(parent);
+        offset += fd->position.toPointF() - QPointF(fd->wikidictScrollport ? fd->wikidictScrollOffset : 0, 0);
+        if (auto *table = qobject_cast<QTextTable *>(parent)) {
+            const auto cell = table->cellAt(position);
+            if (cell.isValid())
+                offset += static_cast<const QTextTableData *>(fd)->cellPosition(table, cell).toPointF();
+        }
+        parent = parent->parentFrame();
+    }
+    const auto action = wikidictInlineBoxActionGeometry(flow->textLayout(), position, flow->textLayout()->position() + offset);
+    for (auto it = action.cbegin(); it != action.cend(); ++it) result.insert(it.key(), it.value());
+    QRectF authoredCaret;
+    const bool authoredInline = qt_textInlineCursorRect(flow->textLayout(), projected, d->cursorWidth, &authoredCaret);
+    QRectF authoredCharacter;
+    const bool hasAuthoredCharacter = qt_textInlineCursorRect(flow->textLayout(), projected, 0, &authoredCharacter, true);
+    result.insert(QStringLiteral("cursorRect"), authoredInline
+        ? authoredCaret.translated(flow->textLayout()->position() + offset)
+        : flow->cursorRect(position, d->cursorWidth).translated(offset));
+    result.insert(QStringLiteral("contentLeft"), flow->leftEdge() + offset.x());
+    result.insert(QStringLiteral("contentRight"), flow->rightEdge() + offset.x());
+    const QTextLine line = flow->textLayout()->lineForTextPosition(projected);
+    if (line.isValid()) {
+        result.insert(QStringLiteral("lineBaseline"), flow->textLayout()->position().y() + offset.y() + line.y() + line.ascent());
+        const qreal leading = line.cursorToX(projected, QTextLine::Leading);
+        const qreal trailing = line.cursorToX(projected, QTextLine::Trailing);
+        const QPointF origin = flow->textLayout()->position() + offset;
+        qreal left = qMin(leading, trailing), right = qMax(leading, trailing);
+#ifndef QT_NO_RAWFONT
+        // A bidi insertion caret can belong to the neighboring isolate. Every
+        // code unit in one grapheme shares its complete shaped selection cell;
+        // splitting an RTL combining cluster can put that cell past its edge.
+        // Singleton graphemes retain the established ligature-part intervals.
+        int glyphFrom = projected, glyphLength = 1;
+        const auto *text = flow->textLayout();
+        const int start = text->isValidCursorPosition(projected) ? projected
+            : text->previousCursorPosition(projected, QTextLayout::SkipCharacters);
+        const int end = text->nextCursorPosition(start, QTextLayout::SkipCharacters);
+        if (start >= line.textStart() && end <= line.textStart() + line.textLength()
+            && start <= projected && end > projected) {
+            glyphFrom = start;
+            glyphLength = end - start;
+        }
+        bool hasGlyph = false;
+        for (const QGlyphRun &run : line.glyphRuns(glyphFrom, glyphLength)) {
+            const QRectF bounds = run.boundingRect();
+            if (!qIsFinite(bounds.left()) || !qIsFinite(bounds.right()))
+                return {};
+            left = hasGlyph ? qMin(left, bounds.left()) : bounds.left();
+            right = hasGlyph ? qMax(right, bounds.right()) : bounds.right();
+            hasGlyph = true;
+        }
+        // Pending wrap spaces, TabOrObject and structural/no-run positions
+        // retain their caret cell, including zero width. No extent is invented.
+#endif
+        const auto *engine = flow->textLayout()->engine();
+        const int imageItem = engine->findItem(projected);
+        const bool explicitImage = imageItem >= 0 && imageItem < engine->layoutData->items.size()
+            && QCompiledInline::imageAlignment(engine->format(&engine->layoutData->items[imageItem])) >= 0;
+        const bool registeredObject = imageItem >= 0 && imageItem < engine->layoutData->items.size()
+            && engine->layoutData->items[imageItem].analysis.flags == QScriptAnalysis::Object
+            && !engine->format(&engine->layoutData->items[imageItem]).isImageFormat()
+            && engine->hasDocumentObject(projected) && engine->docLayout()
+            && engine->docLayout()->handlerForObject(engine->format(&engine->layoutData->items[imageItem]).objectType());
+        if ((explicitImage || registeredObject) && hasAuthoredCharacter)
+            result.insert(QStringLiteral("characterRect"), authoredCharacter.translated(origin));
+        else result.insert(QStringLiteral("characterRect"), QRectF(origin.x() + left,
+            origin.y() + (hasAuthoredCharacter ? authoredCharacter.y() : line.y()), right - left,
+            hasAuthoredCharacter ? authoredCharacter.height() : line.height()));
+        result.insert(QStringLiteral("lineX"), leading);
+        result.insert(QStringLiteral("lineNumber"), line.lineNumber());
+        result.insert(QStringLiteral("lineCount"), flow->textLayout()->lineCount());
+        result.insert(QStringLiteral("lineTextLength"), line.textLength());
+        result.insert(QStringLiteral("lineTextStart"), line.textStart());
+        result.insert(QStringLiteral("lineWidth"), line.width());
+        result.insert(QStringLiteral("lineAdvance"), line.horizontalAdvance());
+        result.insert(QStringLiteral("lineIncludedTrailingSpaceWidth"), flow->includedTrailingSpaceWidth(line).toReal());
+        result.insert(QStringLiteral("lineNaturalWidth"), line.naturalTextWidth());
+        result.insert(QStringLiteral("lineNaturalLeft"), line.naturalTextRect().left() + origin.x());
+        result.insert(QStringLiteral("lineNaturalRight"), line.naturalTextRect().right() + origin.x());
+        result.insert(QStringLiteral("lineLeadingSpaceWidth"), flow->leadingSpaceWidth(line));
+        // Retain the native metrics independently of QVariant QRectF JSON
+        // conversion. These are observations, not alternate layout inputs.
+        result.insert(QStringLiteral("layoutY"), origin.y());
+        result.insert(QStringLiteral("lineY"), line.y());
+        result.insert(QStringLiteral("lineHeight"), line.height());
+        result.insert(QStringLiteral("lineAscent"), line.ascent());
+        result.insert(QStringLiteral("lineDescent"), line.descent());
+        result.insert(QStringLiteral("lineLeading"), line.leading());
+        const auto sourceFormat = document()->findBlock(flow->firstPosition()).blockFormat();
+        result.insert(QStringLiteral("blockLineHeightType"), sourceFormat.lineHeightType());
+        result.insert(QStringLiteral("blockLineHeightValue"), sourceFormat.lineHeight());
+        result.insert(QStringLiteral("leading"), leading + origin.x());
+        result.insert(QStringLiteral("trailing"), trailing + origin.x());
+    }
+    if (flow->isRubyPosition(position)) {
+        const auto caret = flow->cursorRect(position, d->cursorWidth);
+        const auto character = flow->rubyCharacterRect(position);
+        const auto action = flow->rubyActionRect(position);
+        if (!action.isEmpty()) result.insert(QStringLiteral("actionRect"), action.translated(offset));
+        result.insert(QStringLiteral("cursorRect"), caret.isEmpty() ? QRectF() : caret.translated(offset));
+        result.insert(QStringLiteral("characterRect"), character.isEmpty() ? QRectF() : character.translated(offset));
+        if (line.isValid()) result.insert(QStringLiteral("lineX"), caret.left() - flow->textLayout()->position().x());
+    }
+    if (projected < flow->sourceMap().size()) {
+        const auto &unit = flow->sourceMap().at(projected);
+        result.insert(QStringLiteral("languagePresent"), unit.languagePresent);
+        if (unit.languagePresent)
+            result.insert(QStringLiteral("language"), unit.language);
+    }
+    return result;
+}
+
+int QTextDocumentLayoutPrivate::logicalLinePosition(
+        const std::shared_ptr<QTextLogicalFlowProjection> &flow, int index, bool down, qreal documentX) const
+{
+        if (index < 0 || index >= flow->textLayout()->lineCount()) {
+            // Nested owners at a real caption boundary return to the enclosing
+            // object's adjacent line, not the enclosing owner's far edge.
+            const auto parentIndex = logicalFlowParents.constFind(flow->firstPosition());
+            if (parentIndex != logicalFlowParents.cend()) {
+                const auto parentFlow = logicalFlowIndex.value(parentIndex.value());
+                if (parentFlow && parentFlow != flow && parentFlow->current()) {
+                    const QTextBlock boundary = document->findBlock(down ? flow->lastPosition() : flow->firstPosition());
+                    for (const auto &object : parentFlow->objects()) {
+                        if (!object.frame || flow->firstPosition() <= object.first || flow->lastPosition() >= object.last
+                            || object.frame->frameFormat().position() != QTextFrameFormat::InFlow) continue;
+                        const QTextBlock edge = down ? object.frame->lastCursorPosition().block()
+                                                     : object.frame->firstCursorPosition().block();
+                        if (boundary != edge) break;
+                        const QTextLine anchor = parentFlow->textLayout()->lineForTextPosition(object.projectedPosition);
+                        if (!anchor.isValid()) return -2;
+                        return logicalLinePosition(parentFlow, anchor.lineNumber() + (down ? 1 : -1), down, documentX);
+                    }
+                }
+            }
+            return down ? -4 : -3;
+        }
+        const QTextLine target = flow->textLayout()->lineAt(index);
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || object.projectedPosition < target.textStart()
+                || object.projectedPosition >= target.textStart() + target.textLength()
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow)
+                continue;
+            const QTextBlock edge = down ? object.frame->firstCursorPosition().block()
+                                         : object.frame->lastCursorPosition().block();
+            const int edgePosition = down ? edge.position() : edge.position() + edge.length() - 1;
+            const auto nested = logicalFlowAt(edgePosition);
+            if (nested && nested != flow)
+                return logicalLinePosition(nested, down ? 0 : nested->textLayout()->lineCount() - 1, down, documentX);
+            const QTextLayout *caption = edge.layout();
+            if (!caption || !caption->lineCount()) return -2;
+            const QTextLine captionLine = caption->lineAt(down ? 0 : caption->lineCount() - 1);
+            if (!captionLine.isValid()) return -2;
+            const qreal captionX = documentX - q_func()->blockBoundingRect(edge).left();
+            const auto captionOwner = logicalFlowAt(edgePosition, true);
+            if (captionOwner && captionOwner->inCaption(edgePosition))
+                return edge.position() + qt_textLineXToCursorWithOrigin(captionLine,
+                    caption->engine(), captionX, QTextLine::CursorBetweenCharacters, true, true);
+            return edge.position() + captionLine.xToCursor(captionX);
+        }
+        const qreal localX = documentX
+            - q_func()->blockBoundingRect(document->findBlock(flow->firstPosition())).left();
+        // A projected Ruby unit contains several real child carets. The parent
+        // object's two edges cannot invert a preferred X inside that unit.
+        // Real caption/frame entry above retains its existing native route.
+        for (int position = target.textStart(); position < target.textStart() + target.textLength(); ++position) {
+            if (flow->sourceMap().at(position).kind != QTextLogicalFlowProjection::Kind::Ruby) continue;
+            const qreal firstEdge = target.cursorToX(position);
+            const qreal lastEdge = target.cursorToX(position + 1);
+            if (localX <= qMin(firstEdge, lastEdge) || localX >= qMax(firstEdge, lastEdge)) continue;
+            const int source = flow->rubyCursorForLineX(position, localX);
+            return source >= 0 ? source : -2;
+        }
+        return flow->toDocument(target.xToCursor(localX));
+}
+
+int QTextDocumentLayout::wikidictLogicalVerticalEntry(int position, bool fromAbove, qreal documentX) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return -2;
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position);
+    if (!flow) return -1;
+    if (d->paragraphBoxError || !qIsFinite(documentX)) return -2;
+    return d->logicalLinePosition(flow, fromAbove ? 0 : flow->textLayout()->lineCount() - 1,
+                                  fromAbove, documentX);
+}
+
+int QTextDocumentLayout::wikidictLogicalMove(int position, int operation, qreal preferredX) const
+{
+    return wikidictLogicalMove(position, operation, preferredX, false);
+}
+
+int QTextDocumentLayout::wikidictLogicalMove(int position, int operation, qreal preferredX,
+                                            bool documentSpaceX) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return -2;
+    d->ensureLayoutedByPosition(position);
+    const auto flow = d->logicalFlowAt(position, true);
+    if (!flow)
+        return -1;
+    const bool vertical = operation == QTextCursor::Up || operation == QTextCursor::Down;
+    const bool down = operation == QTextCursor::Down;
+    if (vertical && documentSpaceX && !qIsFinite(preferredX))
+        return -2;
+    const auto documentColumn = [&](qreal origin, qreal caretX) {
+        if (documentSpaceX) return preferredX;
+        return origin + (qIsFinite(preferredX) && preferredX != -1 ? preferredX : caretX);
+    };
+    const QPointF ownerOrigin = blockBoundingRect(document()->findBlock(flow->firstPosition())).topLeft();
+    if (flow->inCaption(position)) {
+        if (!vertical) return -1;
+        // Interior caption/table movement remains native. Only the real frame's
+        // outer edge bridges back into its owning projected paragraph.
+        for (const auto &object : flow->objects()) {
+            if (!object.frame || position <= object.first || position >= object.last
+                || object.frame->frameFormat().position() != QTextFrameFormat::InFlow)
+                continue;
+            const QTextBlock current = document()->findBlock(position);
+            const QTextBlock edge = down ? object.frame->lastCursorPosition().block()
+                                         : object.frame->firstCursorPosition().block();
+            if (current != edge || !edge.layout()) return -1;
+            const QTextLine line = edge.layout()->lineForTextPosition(position - edge.position());
+            if (!line.isValid() || line.lineNumber() != (down ? edge.layout()->lineCount() - 1 : 0))
+                return -1;
+            const QTextLine anchor = flow->textLayout()->lineForTextPosition(object.projectedPosition);
+            if (!anchor.isValid()) return -2;
+            return d->logicalLinePosition(flow, anchor.lineNumber() + (down ? 1 : -1), down,
+                documentColumn(blockBoundingRect(edge).left(), line.cursorToX(position - edge.position())));
+        }
+        return -1;
+    }
+    if (operation == QTextCursor::StartOfBlock)
+        return flow->firstPosition();
+    if (operation == QTextCursor::EndOfBlock)
+        return flow->lastPosition();
+    if (operation == QTextCursor::Left || operation == QTextCursor::Right) {
+        if (document()->defaultCursorMoveStyle() == Qt::VisualMoveStyle)
+            return flow->visualMove(position, operation == QTextCursor::Right);
+        const bool forward = (operation == QTextCursor::Right) == (flow->direction() == Qt::LeftToRight);
+        return flow->logicalMove(position, forward);
+    }
+    const int projected = flow->toProjected(position);
+    const QTextLine line = flow->textLayout()->lineForTextPosition(projected);
+    if (!line.isValid())
+        return -1;
+    if (operation == QTextCursor::StartOfLine)
+        return flow->toDocument(line.textStart());
+    if (operation == QTextCursor::EndOfLine)
+        return flow->toDocument(line.textStart() + line.textLength());
+    if (operation == QTextCursor::Up || operation == QTextCursor::Down) {
+        return d->logicalLinePosition(flow, line.lineNumber() + (down ? 1 : -1), down,
+            documentColumn(ownerOrigin.x(), line.cursorToX(projected)));
+    }
+    return -1;
+}
+
+QVariantMap QTextDocumentLayout::wikidictLogicalSelection(int first, int last) const
+{
+    Q_D(const QTextDocumentLayout);
+    if (!d->logicalFlows.isEmpty() && document()->revision() != d->logicalFlowRevision)
+        return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), 5}};
+    d->ensureLayoutedByPosition(last);
+    const auto flow = d->logicalFlowAt(first, true);
+    if (!flow || last > flow->lastPosition() || last < first
+        || (flow->inCaption(first) && flow->inCaption(last)))
+        return {{QStringLiteral("handled"), false}, {QStringLiteral("error"), 0}};
+    const QTextBlock block = document()->findBlock(flow->firstPosition());
+    const QPointF origin = blockBoundingRect(block).topLeft();
+    QRectF bounds;
+    for (const auto &range : flow->selectionRanges(first, last)) {
+        for (int index = 0; index < flow->textLayout()->lineCount(); ++index) {
+            const QTextLine line = flow->textLayout()->lineAt(index);
+            if (range.start < line.textStart() + line.textLength()
+                && line.textStart() < range.start + range.length)
+                bounds |= line.naturalTextRect().translated(origin);
+        }
+    }
+    for (const auto &rect : flow->rubySelectionRects(first, last)) bounds |= rect.translated(origin);
+    for (const auto &object : flow->objects())
+        if (object.frame && first < object.last && last > object.first)
+            bounds |= frameBoundingRect(object.frame);
+    return {{QStringLiteral("handled"), true}, {QStringLiteral("error"), d->paragraphBoxError},
+            {QStringLiteral("rect"), bounds.adjusted(-1, -1, 1, 1)}};
+}
+
+bool QTextDocumentLayoutPrivate::prepareLogicalFlow(const std::shared_ptr<QTextLogicalFlowProjection> &flow,
+                                                   QTextLayoutStruct *layoutStruct, int layoutFrom, int layoutTo)
+{
+    if (!flow->current() || flow->parentFrame() != layoutStruct->frame || !flow->refreshLayoutInputs()) {
+        refuseParagraphBox(5, flow->firstPosition());
+        return false;
+    }
+    layoutStruct->fullLayout = true;
+    layoutStruct->wikidictParagraphBoxes = true;
+    const QTextBlockFormat ownerFormat = document->findBlock(flow->firstPosition()).blockFormat();
+    const qreal leftMargin = ownerFormat.leftMargin();
+    const qreal rightMargin = ownerFormat.rightMargin();
+    if (!qIsFinite(leftMargin) || !qIsFinite(rightMargin)
