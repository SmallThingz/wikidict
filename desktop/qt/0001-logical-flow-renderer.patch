+// PRIVATE SOURCE CANDIDATE, NOT REGISTERED OR COMPILED.
+// Contract05 graphical order, after producer validation and auto-hiding.
+// This is source ownership only; it deliberately advertises no layout capability.
+#include <QtCore/qlist.h>
+#include <QtCore/qpointer.h>
+#include <QtCore/qstringview.h>
+#include <QtGui/qtextdocument.h>
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <utility>
+
