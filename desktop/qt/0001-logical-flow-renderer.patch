+bool QTextDocumentLayoutPrivate::validateReferenceLayout()
+{
+    struct Owned { QVariant raw; int first = -1, last = -1; QString text, href; };
+    QHash<qint64, Owned> citations;
+    QSet<QTextFrame *> items;
+    const auto fail = [&](int position) { refuseParagraphBox(1, position); return false; };
+    for (auto block = document->begin(); block.isValid(); block = block.next()) {
+        if (block.blockFormat().hasProperty(QCompiledReference::ListProperty)) {
+            WikidictReferenceItem item;
+            if (!wikidictReferenceItem(block, &item) || items.contains(item.owner)) return fail(block.position());
+            items.insert(item.owner);
+            const auto policy = block.blockFormat().property(WikidictContainerTypography).toMap();
+            if (policy.value(QStringLiteral("font")).metaType().id() != QMetaType::QFont
+                || block.charFormat().font().resolve(document->defaultFont()) != policy.value(QStringLiteral("font")).value<QFont>()) return fail(block.position());
+            const auto body = item.reference.value(QStringLiteral("body_typography")).toObject();
+            const auto box = item.item.value(QStringLiteral("box")).toObject();
+            if (body.value(QStringLiteral("owner_font")) != box.value(QStringLiteral("owner_font"))
+                || body.value(QStringLiteral("line_height")) != box.value(QStringLiteral("line_height"))) return fail(block.position());
+        }
