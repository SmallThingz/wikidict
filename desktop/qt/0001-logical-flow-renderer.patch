+struct Decoration {
+    QPainterPath outer, border;
+};
+inline bool decorations(const QList<PaintSlice> &parts, const QList<qreal> &scales, QList<Decoration> *out)
+{
+    if (!out || scales.size() != parts.size()) return false;
+    out->clear(); out->resize(parts.size());
+    struct Group { QList<int> indexes; qreal width = 0, height = 0, scale = 0; int lastLine = -1; };
+    QMap<int, Group> groups;
+    for (int i = 0; i < parts.size(); ++i) {
+        const auto &part = parts.at(i);
+        if (!part.box.identity.contains("radius")) { (*out)[i].outer.addRect(part.geometry.border); continue; }
+        auto &group = groups[part.box.first];
+        if (group.indexes.isEmpty()) {
+            if (!part.geometry.first) return false;
+            group.height = part.geometry.border.height(); group.scale = scales.at(i);
+        } else {
+            const auto &previous = parts.at(group.indexes.last());
+            if (previous.box.identity != part.box.identity || part.geometry.first || previous.geometry.last
+                || qAbs(part.geometry.border.height() - group.height) > 1.0 / 64 || scales.at(i) != group.scale) return false;
+        }
+        if (part.line <= group.lastLine || part.geometry.border.width() < 0) return false;
+        group.lastLine = part.line; group.indexes.append(i); group.width += part.geometry.border.width();
+        if (!finite(group.width)) return false;
+    }
+    for (const auto &group : groups) {
+        const auto &box = parts.at(group.indexes.first()).box;
+        if (!parts.at(group.indexes.last()).geometry.last || group.height <= 0 || !finite(group.height)
+            || !finite(group.scale) || group.scale <= 0) return false;
+        const qreal value = box.identity.value("radius").toDouble();
+        const bool percent = box.identity.contains("radiusUnit");
+        qreal rx = value * (percent ? group.width / 100 : group.scale);
+        qreal ry = value * (percent ? group.height / 100 : group.scale);
+        const qreal edge = box.widths[0] * group.scale;
+        if (!finite(rx) || !finite(ry) || !finite(edge)) return false;
+        if (percent) {
+            // Percent axes use the unbroken border box, then one common CSS
+            // overlap reduction. A non-square 50% box remains an ellipse.
+            const qreal reduction = qMin(qreal(1), qMin(rx > 0 ? group.width / (2 * rx) : qreal(1),
+                                                       ry > 0 ? group.height / (2 * ry) : qreal(1)));
+            rx *= reduction; ry *= reduction;
+        } else rx = ry = qMin(rx, qMin(group.width / 2, group.height / 2));
+        const QRectF whole(0, 0, group.width, group.height);
+        QPainterPath outer; outer.addRoundedRect(whole, rx, ry, Qt::AbsoluteSize);
+        QPainterPath inner;
+        const QRectF padding = whole.adjusted(edge, edge, -edge, -edge);
+        if (padding.width() > 0 && padding.height() > 0) {
+            inner.addRoundedRect(padding, qMax(qreal(0), rx - edge), qMax(qreal(0), ry - edge), Qt::AbsoluteSize);
+        }
+        QPainterPath ring = outer.subtracted(inner);
+        if (box.identity.contains("borderStyle")) {
+            QPainterPath dots;
+            if (edge > 0) {
+                QPainterPath center;
+                center.addRoundedRect(whole.adjusted(edge / 2, edge / 2, -edge / 2, -edge / 2),
+                    qMax(qreal(0), rx - edge / 2), qMax(qreal(0), ry - edge / 2), Qt::AbsoluteSize);
+                // Zero-length dash segments are discarded by the native
+                // stroker. Build real circles once on the closed center path;
+                // cached arc lengths keep each dot lookup bounded.
+                center.setCachingEnabled(true);
+                const qreal perimeter = center.length();
+                const qreal requestedDots = perimeter / (2 * edge);
+                if (!finite(perimeter) || !qIsFinite(requestedDots) || requestedDots > 65536) return false;
+                const int count = qMax(1, qRound(requestedDots));
+                const qreal spacing = perimeter / count;
+                for (int dot = 0; dot < count; ++dot)
+                    dots.addEllipse(center.pointAtPercent(center.percentAtLength(dot * spacing)), edge / 2, edge / 2);
+                dots = dots.intersected(ring);
+            }
+            ring = dots;
+        }
+        // Build each owner's unbroken paths once per paint/query, then slice
+        // them in source order. No wrapped line rescans the whole paragraph.
+        qreal before = 0;
+        for (int index : group.indexes) {
+            const auto &part = parts.at(index);
+            QTransform placement;
+            placement.translate(part.geometry.border.left() - before, part.geometry.border.top());
+            QPainterPath clip; clip.addRect(part.geometry.border);
+            (*out)[index].outer = placement.map(outer).intersected(clip);
+            (*out)[index].border = placement.map(ring).intersected(clip);
+            before += part.geometry.border.width();
+        }
+    }
+    return true;
+}
+inline bool actionSlicePath(const QList<PaintSlice> &parts, const QList<Decoration> &shapes, int index, QPainterPath *path)
+{
+    if (!path || index < 0 || index >= parts.size() || shapes.size() != parts.size()
+        || !hasAction(parts.at(index).box)) return false;
+    if (childAction(parts.at(index).box)) {
+        *path = QPainterPath(); path->addRect(parts.at(index).geometry.content);
+    } else *path = shapes.at(index).outer;
+    return true;
+}
