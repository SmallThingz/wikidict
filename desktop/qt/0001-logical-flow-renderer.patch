+
+class QTextRubyRangeMap
+{
+public:
+    struct Range {
+        int first = -1;
+        int last = -1; // Half-open logical UTF-16 positions unless explicitly document.
+        bool empty() const { return first == last; }
+        bool contains(int p) const { return first <= p && p < last; }
+    };
+    enum class Role { Gap, Base, Annotation };
+    enum class Bias { Before, After };
+    struct Piece {
+        Range logical;
+        Range document;
+        // Only a declared CSS gap may collapse in document storage. No hidden
+        // control, semantic body character, or action can use this escape.
+        bool collapsedGap = false;
+    };
+    struct Owner;
+    struct Content {
+        Range range;
+        // Nested owners occupy real subranges of this content, in source order.
+        // Surrounding text is ordinary text, not an object replacement character.
+        QList<std::shared_ptr<const Owner>> nested;
+    };
+    struct Base { Range gap; Content body; };
+    struct Annotation {
+        int baseStart = 0;
+        int baseCount = 0;
+        int level = 0;
+        bool autoHidden = false;
+        Range gap;
+        Content body;
+    };
+    struct Segment { Range gap; QList<Base> bases; QList<Annotation> annotations; };
+    struct Owner { Range range; QList<Segment> segments; };
+    struct Child {
+        Range range;
+        Role role = Role::Gap;
+        int segment = -1;
+        int index = -1;
+        int level = -1;
+    };
+
+    // Descriptions are owned immutable copies. A caller cannot mutate a nested
+    // description after validation by retaining a non-const shared_ptr alias.
+    static std::unique_ptr<QTextRubyRangeMap> create(QTextDocument *document,
+            const Owner &description, qsizetype itemBudget, QString *error)
+    {
+        if (!document) return fail(error, u"invalid ruby document");
+        const auto text = document->toRawText();
+        const int end = document->characterCount() - 1;
+        const QList<Piece> identity = end ? QList<Piece>{{{0, end}, {0, end}, false}}
+                                          : QList<Piece>{};
+        return create(document, text, identity, description, itemBudget, error);
+    }
+    static std::unique_ptr<QTextRubyRangeMap> create(QTextDocument *document,
+            QString logicalText, QList<Piece> pieces, const Owner &description,
+            qsizetype itemBudget, QString *error)
+    {
+        return createMany(document, std::move(logicalText), std::move(pieces),
+                          QList<Owner>{description}, itemBudget, error);
+    }
+    static std::unique_ptr<QTextRubyRangeMap> createMany(QTextDocument *document,
+            QString logicalText, QList<Piece> pieces, const QList<Owner> &descriptions,
+            qsizetype itemBudget, QString *error)
+    {
+        if (!document || itemBudget <= 0 || logicalText.size() > std::numeric_limits<int>::max())
+            return fail(error, u"invalid ruby document or budget");
+        auto result = std::unique_ptr<QTextRubyRangeMap>(
+            new QTextRubyRangeMap(document, std::move(logicalText), std::move(pieces)));
+        if (descriptions.isEmpty()) return fail(error, u"ruby projection has no owners");
+        int end = 0;
+        for (const auto &description : descriptions) {
+            if (description.range.first < end || !result->validate(description, 0, itemBudget, error))
+                return fail(error, u"overlapping or invalid top-level ruby owners");
+            result->collectGaps(description);
+            end = description.range.last;
+        }
+        if (!result->validateProjection(itemBudget, error)) return {};
+        for (const auto &description : descriptions) result->roots.append(copy(description));
+        return result;
+    }
+
+    bool current() const
+    {
+        return document && document->revision() == revision
+            && document->characterCount() == characterCount;
+    }
+    QTextDocument *sourceDocument() const { return current() ? document.data() : nullptr; }
+    const Owner *owner(int index = 0) const
+    { return current() && index >= 0 && index < roots.size() ? roots[index].get() : nullptr; }
+    int logicalCount() const { return current() ? int(logicalText.size()) : -1; }
+    QString text(int first, int last) const
+    {
+        return current() && range({first, last}) ? logicalText.mid(first, last - first) : QString();
+    }
+    int toDocument(int position, Bias bias) const { return translate(position, bias, false); }
+    int toLogical(int position, Bias bias) const { return translate(position, bias, true); }
+    Range logicalGap(int position) const
+    {
+        if (!current()) return {};
+        const auto it = std::lower_bound(gaps.begin(), gaps.end(), position,
+            [](Range r, int p) { return r.last <= p; });
+        return it != gaps.end() && it->contains(position) ? *it : Range{};
+    }
+    Range selectionToDocument(int first, int last) const
+    {
+        if (!range({first, last})) return {};
+        const int start = toDocument(first, Bias::After);
+        int end = first == last ? start : toDocument(last, Bias::Before);
+        if (start < 0 || end < 0) return {};
+        if (end < start) {
+            const auto gap = logicalGap(first);
+            if (gap.first < 0 || last > gap.last) return {};
+            // A subrange inside collapsed whitespace has no distinct storage
+            // interval. The owner retains the exact logical selection/copy;
+            // native painting receives one deterministic caret, not a neighbor.
+            end = start;
+        }
+        return {start, end};
+    }
+
+    // Never approximate a column by [base.first, annotation.last]: another
+    // base/reading can lie between those positions in graphical logical order.
+    QList<Child> columnSources(int segmentIndex, int baseIndex, int ownerIndex = 0) const
+    {
+        QList<Child> out;
+        const auto *root = owner(ownerIndex);
+        if (!root || segmentIndex < 0 || segmentIndex >= root->segments.size()) return out;
+        const auto &segment = root->segments[segmentIndex];
+        if (baseIndex < 0 || baseIndex >= segment.bases.size()) return out;
+        const auto &base = segment.bases[baseIndex];
+        out.append({base.body.range, Role::Base, segmentIndex, baseIndex, -1});
+        for (int i = 0; i < segment.annotations.size(); ++i) {
+            const auto &annotation = segment.annotations[i];
+            if (!annotation.autoHidden && baseIndex >= annotation.baseStart
+                && baseIndex - annotation.baseStart < annotation.baseCount)
+                out.append({annotation.body.range, Role::Annotation, segmentIndex, i, annotation.level});
+        }
+        return out;
+    }
+
+    // Selection is intersected with each exact child range. Painting a partial
+    // reading must not select the base or a sibling merely inside its envelope.
+    static Range selected(const Range &child, int first, int last)
+    {
+        const int start = qMax(child.first, first), end = qMin(child.last, last);
+        return end > start ? Range{start, end} : Range{start, start};
+    }
+
+private:
+    QPointer<QTextDocument> document;
+    const int revision;
+    const int characterCount;
+    const QString logicalText;
+    const QList<Piece> pieces;
+    QList<Range> gaps;
+    QList<std::shared_ptr<const Owner>> roots;
+
+    QTextRubyRangeMap(QTextDocument *doc, QString text, QList<Piece> projection)
+        : document(doc), revision(doc->revision()), characterCount(doc->characterCount()),
+          logicalText(std::move(text)), pieces(std::move(projection)) {}
+    static std::unique_ptr<QTextRubyRangeMap> fail(QString *error, QStringView message)
+    {
+        if (error) *error = message.toString();
+        return {};
+    }
+    static bool reject(QString *error, QStringView message)
+    {
+        if (error) *error = message.toString();
+        return false;
+    }
+    static std::shared_ptr<const Owner> copy(const Owner &source)
+    {
+        auto result = std::make_shared<Owner>(source);
+        const auto clone = [](Content &content) {
+            for (auto &nested : content.nested) nested = copy(*nested);
+        };
+        for (auto &segment : result->segments) {
+            for (auto &base : segment.bases) clone(base.body);
+            for (auto &annotation : segment.annotations) clone(annotation.body);
+        }
+        return result;
+    }
+    static bool boundary(QStringView text, int position)
+    {
+        if (position < 0 || position > text.size()) return false;
+        return position == 0 || position == text.size() || !text[position].isLowSurrogate()
+            || !text[position - 1].isHighSurrogate();
+    }
+    bool boundary(int position) const
+    {
+        return current() && boundary(logicalText, position);
+    }
+    bool range(const Range &r) const
+    {
+        return r.first <= r.last && boundary(r.first) && boundary(r.last);
+    }
+    bool consume(const Range &r, int &cursor, int end, qsizetype &budget, QString *error) const
+    {
+        if (--budget < 0 || !range(r) || r.first != cursor || r.last > end)
+            return reject(error, u"invalid ruby source coverage");
+        cursor = r.last;
+        return true;
+    }
+    bool content(const Content &value, int depth, qsizetype &budget, QString *error) const
+    {
+        int previous = value.range.first;
+        for (const auto &nested : value.nested) {
+            if (!nested || !range(nested->range) || nested->range.first < previous
+                || nested->range.last > value.range.last
+                || !body({previous, nested->range.first}, error)
+                || !validate(*nested, depth + 1, budget, error))
+                return reject(error, u"invalid nested ruby source range");
+            previous = nested->range.last;
+        }
+        return body({previous, value.range.last}, error);
+    }
+    bool body(const Range &value, QString *error) const
+    {
+        for (int p = value.first; p < value.last; ++p) {
+            const auto ch = logicalText[p].unicode();
+            if (ch == 0x09 || ch == 0x0a || ch == 0x0d || ch == 0x0c
+                || ch == 0x2028 || ch == 0x2029 || ch == 0xfffc)
+                return reject(error, u"unsupported object or forced break in ruby body");
+        }
+        return true;
+    }
+    static bool cssWhitespace(QChar ch)
+    {
+        const auto u = ch.unicode();
+        return u == 0x20 || u == 0x09 || u == 0x0a || u == 0x0d || u == 0x0c;
+    }
+    bool gap(const Range &value, int &cursor, int end, qsizetype &budget, QString *error) const
+    {
+        if (!consume(value, cursor, end, budget, error)) return false;
+        for (int p = value.first; p < value.last; ++p) {
+            if (!cssWhitespace(logicalText[p]))
+                return reject(error, u"non-CSS whitespace in ruby gap");
+        }
+        return true;
+    }
+    bool validate(const Owner &owner, int depth, qsizetype &budget, QString *error) const
+    {
+        if (--budget < 0 || depth >= 16 || !range(owner.range) || owner.segments.isEmpty())
+            return reject(error, u"invalid ruby owner or nesting budget");
+        int cursor = owner.range.first;
+        for (int s = 0; s < owner.segments.size(); ++s) {
+            const auto &segment = owner.segments[s];
+            if (--budget < 0 || segment.bases.isEmpty() || (s == 0 && !segment.gap.empty())
+                || !gap(segment.gap, cursor, owner.range.last, budget, error))
+                return reject(error, u"invalid ruby segment");
+            for (int b = 0; b < segment.bases.size(); ++b) {
+                const auto &base = segment.bases[b];
+                if (b == 0 && !base.gap.empty())
+                    return reject(error, u"leading base gap");
+                if (!gap(base.gap, cursor, owner.range.last, budget, error)
+                    || !consume(base.body.range, cursor, owner.range.last, budget, error)
+                    || !content(base.body, depth, budget, error)) return false;
+            }
+            int level = -1, previousEnd = 0;
+            for (const auto &annotation : segment.annotations) {
+                if (annotation.level < 0 || annotation.level < level || annotation.level > level + 1
+                    || annotation.baseStart < 0 || annotation.baseCount <= 0
+                    || annotation.baseStart > segment.bases.size()
+                    || annotation.baseCount > segment.bases.size() - annotation.baseStart)
+                    return reject(error, u"invalid ruby association");
+                if (annotation.level != level) {
+                    if (!annotation.gap.empty()) return reject(error, u"leading annotation gap");
+                    level = annotation.level; previousEnd = 0;
+                }
+                if (annotation.baseStart < previousEnd)
+                    return reject(error, u"overlapping ruby annotations at one level");
+                previousEnd = annotation.baseStart + annotation.baseCount;
+                if (annotation.autoHidden && (!annotation.gap.empty() || !annotation.body.range.empty()
+                    || !annotation.body.nested.isEmpty()))
+                    return reject(error, u"hidden annotation has graphical source");
+                if (!gap(annotation.gap, cursor, owner.range.last, budget, error)
+                    || !consume(annotation.body.range, cursor, owner.range.last, budget, error)
+                    || !content(annotation.body, depth, budget, error)) return false;
+            }
+        }
+        return cursor == owner.range.last || reject(error, u"incomplete ruby source coverage");
+    }
+    void collectGaps(const Owner &owner)
+    {
+        const auto append = [this](Range r) { if (!r.empty()) gaps.append(r); };
+        const auto nested = [this](const Content &content) {
+            for (const auto &child : content.nested) collectGaps(*child);
+        };
+        for (const auto &segment : owner.segments) {
+            append(segment.gap);
+            for (const auto &base : segment.bases) { append(base.gap); nested(base.body); }
+            for (const auto &annotation : segment.annotations) {
+                append(annotation.gap); nested(annotation.body);
+            }
+        }
+    }
+    bool validateProjection(qsizetype &budget, QString *error)
+    {
+        const auto stored = document->toRawText();
+        std::sort(gaps.begin(), gaps.end(), [](Range a, Range b) { return a.first < b.first; });
+        int logicalCursor = 0, documentCursor = 0;
+        qsizetype gapIndex = 0;
+        for (const auto &piece : pieces) {
+            if (--budget < 0 || !range(piece.logical) || piece.logical.empty()
+                || piece.logical.first != logicalCursor || piece.document.first != documentCursor
+                || piece.document.last < piece.document.first
+                || !boundary(stored, piece.document.first) || !boundary(stored, piece.document.last))
+                return reject(error, u"invalid ruby document projection coverage");
+            const auto source = QStringView(logicalText).mid(piece.logical.first,
+                                                            piece.logical.last - piece.logical.first);
+            const auto target = QStringView(stored).mid(piece.document.first,
+                                                        piece.document.last - piece.document.first);
+            if (!piece.collapsedGap) {
+                if (source != target) return reject(error, u"changed ruby body in document projection");
+            } else {
+                while (gapIndex < gaps.size() && gaps[gapIndex].last <= piece.logical.first) ++gapIndex;
+                if (gapIndex == gaps.size() || piece.logical.first < gaps[gapIndex].first
+                    || piece.logical.last > gaps[gapIndex].last
+                    || (!target.isEmpty() && target != u" "))
+                    return reject(error, u"projection collapse outside a declared ruby gap");
+                // The validated gap supplies exact semantic whitespace; storage
+                // contributes at most one ordinary space, never a paragraph.
+            }
+            logicalCursor = piece.logical.last;
+            documentCursor = piece.document.last;
+        }
+        return (logicalCursor == logicalText.size() && documentCursor == characterCount - 1
+                && stored.size() == documentCursor)
+            || reject(error, u"incomplete ruby document projection");
+    }
+    int translate(int position, Bias bias, bool inverse) const
+    {
+        if (!current() || position < 0
+            || position > (inverse ? characterCount - 1 : logicalText.size())) return -1;
+        if (pieces.isEmpty()) return position == 0 ? 0 : -1;
+        const auto from = [inverse](const Piece &p) { return inverse ? p.document : p.logical; };
+        auto it = std::lower_bound(pieces.begin(), pieces.end(), position,
+            [&](const Piece &p, int value) { return from(p).last < value; });
+        int before = std::numeric_limits<int>::max(), after = -1;
+        for (; it != pieces.end() && from(*it).first <= position; ++it) {
+            const Range input = from(*it), output = inverse ? it->logical : it->document;
+            int low, high;
+            if (input.empty()) { low = output.first; high = output.last; }
+            else if (position == input.first) { low = high = output.first; }
+            else if (position == input.last) { low = high = output.last; }
+            else if (!it->collapsedGap) { low = high = output.first + position - input.first; }
+            else { low = output.first; high = output.last; }
+            before = qMin(before, low); after = qMax(after, high);
+        }
+        return after < 0 ? -1 : (bias == Bias::Before ? before : after);
+    }
+};
+
+QT_END_NAMESPACE
+#endif
