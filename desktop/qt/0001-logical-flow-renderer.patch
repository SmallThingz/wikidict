+static bool wikidictRelativeAuto(QTextFrame *frame)
+{
+    return frame && frame->frameFormat().stringProperty(QTextFormat::UserProperty + 0x57e6)
+        == QStringLiteral("wikidict.relative-auto/1");
+}
+
+static bool wikidictAbsoluteContainer(QTextFrame *frame)
+{
+    return frame && frame->frameFormat().hasProperty(WikidictContainerAbsolute);
+}
+
+static bool wikidictIntrinsicFloatImage(const QTextFrame *frame)
+{
+    return frame && frame->frameFormat().property(WikidictContainerFixedFloat).toMap()
+        .value(QStringLiteral("capability")).toString() == QStringLiteral("wikidict.intrinsic-float-image/1");
+}
+
+static bool wikidictRelativeFloatImage(const QTextFrame *frame)
+{
+    return frame && frame->frameFormat().property(WikidictContainerFixedFloat).toMap()
+        .value(QStringLiteral("capability")).toString() == QStringLiteral("wikidict.relative-float-image/1");
+}
+
+static bool wikidictHasRelativeFloatImageDescendant(QTextFrame *frame)
+{
+    for (auto *child : frame->childFrames()) {
+        if (wikidictRelativeFloatImage(child)) return true;
+        const auto format = child->frameFormat();
+        if (!wikidictPlainContainer(child) || qobject_cast<QTextTable *>(child)
+            || wikidictAbsoluteContainer(child) || format.position() != QTextFrameFormat::InFlow
+            || format.hasProperty(WikidictContainerScrollport) || format.hasProperty(WikidictContainerFlex)
+            || format.hasProperty(WikidictContainerFlexItem) || format.hasProperty(QTextFormat::UserProperty + 0x57e5)) continue;
+        if (wikidictHasRelativeFloatImageDescendant(child)) return true;
+    }
+    return false;
+}
+
+static bool wikidictHasAbsoluteDescendant(QTextFrame *frame)
+{
+    QList<QTextFrame *> pending = frame->childFrames();
+    while (!pending.isEmpty()) {
+        auto *child = pending.takeLast();
+        if (wikidictAbsoluteContainer(child)) return true;
+        pending.append(child->childFrames());
+    }
+    return false;
+}
+
+static bool wikidictAbsoluteContext(QTextFrame *frame)
+{
+    for (auto *owner = frame; owner; owner = owner->parentFrame())
+        if (wikidictRelativeAuto(owner) && (wikidictHasAbsoluteDescendant(owner)
+            || owner->frameFormat().hasProperty(WikidictContainerTextWrap))) return true;
+    return false;
+}
+
+static bool wikidictContainerNoWrap(QTextFrame *frame)
+{
+    for (auto *owner = frame; owner; owner = owner->parentFrame()) {
+        const auto format = owner->frameFormat();
+        if (format.hasProperty(WikidictContainerTextWrap))
+            return format.stringProperty(WikidictContainerTextWrap) == QStringLiteral("nowrap");
+    }
+    return false;
+}
+
+static bool wikidictHasPlainDescendant(QTextFrame *frame)
+{
+    QList<QTextFrame *> pending = frame->childFrames();
+    while (!pending.isEmpty()) {
+        auto *child = pending.takeLast();
+        if (wikidictPlainContainer(child)) return true;
+        pending.append(child->childFrames());
+    }
+    return false;
+}
