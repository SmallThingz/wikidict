+WikidictAdjoining QTextDocumentLayoutPrivate::authoredRuleProfile(const QTextBlock &block)
+{
+    WikidictAdjoining result;
+    const auto rule = wikidictRuleStyle(block.blockFormat());
+    const qreal top = scaleToDevice(rule.margins[0]), bottom = scaleToDevice(rule.margins[2]);
+    if (!rule.valid || !qIsFinite(top) || !qIsFinite(bottom) || top < 0 || bottom < 0
+        || top >= QFIXED_MAX / 8 || bottom >= QFIXED_MAX / 8) {
+        refuseParagraphBox(1, block.position()); return result;
+    }
+    result.before = WikidictMarginStrut::from(QFixed::fromReal(top));
+    result.after = WikidictMarginStrut::from(QFixed::fromReal(bottom));
+    result.through = rule.height == 0;
+    if (authoredRuleClearances.contains(block.position())) {
+        result.beforeAdjoins = false; result.afterAdjoins = !result.through;
+    }
+    return result;
+}
