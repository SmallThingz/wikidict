+            if (it.key() != u"style"_s && it.key() != u"color"_s && it.key() != u"thickness"_s) return false;
+        if (d.value(u"style"_s).metaType().id() != QMetaType::QString
+            || (d.value(u"style"_s) != u"solid"_s && d.value(u"style"_s) != u"dotted"_s)
+            || (d.contains(u"color"_s) && !rgb(d.value(u"color"_s)))
+            || (d.contains(u"thickness"_s) && !number(d.value(u"thickness"_s)))) return false;
+    }
+    return p.value(u"normalized"_s).toBool() || p.size() > 2;
+}
+inline QVariantMap policy(const QTextCharFormat &format)
+{
+    return format.hasProperty(Property) && valid(format.property(Property))
+        ? format.property(Property).toMap() : QVariantMap{};
+}
+inline bool actionMetric(const QTextCharFormat &format, QTextCharFormat *result = nullptr)
+{
+    const auto value = format.property(ActionMetricProperty);
+    if (!actionOwner(format).isValid() || value.metaType() != QMetaType::fromType<QTextFormat>()) return false;
+    const auto raw = value.value<QTextFormat>();
+    if (!raw.isCharFormat() || raw.isImageFormat() || raw.objectType() != QTextFormat::NoObject
+        || raw.hasProperty(ActionMetricProperty) || raw.hasProperty(ActionOwnerProperty)
+        || raw.hasProperty(EmptyActionOwners) || raw.hasProperty(EmptyOwners)
+        || raw.hasProperty(ActionPaintProperty)) return false;
+    const auto owner = raw.toCharFormat();
+    if (owner.isAnchor() || !owner.anchorHref().isEmpty() || !owner.anchorNames().isEmpty()
+        || !(owner.font().pointSizeF() > 0) || !std::isfinite(owner.font().pointSizeF())
+        || owner.font().pointSizeF() >= qreal(QFIXED_MAX)
+        || (owner.hasProperty(Property) && !valid(owner.property(Property)))) return false;
+    for (qreal v : {owner.baselineOffset(), owner.superScriptBaseline(), owner.subScriptBaseline()})
+        if (!std::isfinite(v) || qAbs(v) >= qreal(QFIXED_MAX)) return false;
+    if (result) *result = owner;
+    return true;
+}
+inline QTextCharFormat shapingFormat(QTextCharFormat format)
+{
+    format.clearProperty(QCompiledReference::CitationProperty);
+    auto p = policy(format);
+    if (p.contains(u"wrap"_s)) {
+        p.remove(u"wrap"_s);
+        if (p.size() == 2 && !p.value(u"normalized"_s).toBool()) format.clearProperty(Property);
+        else format.setProperty(Property, p);
+    }
+    return format;
+}
+inline QString wrap(const QTextCharFormat &format)
+{
+    return format.objectType() == QTextFormat::NoObject ? policy(format).value(u"wrap"_s).toString() : QString();
+}
+inline bool normalized(const QTextCharFormat &format)
+{
+    return policy(format).value(u"normalized"_s).toBool();
+}
+inline void applyScriptSize(QFont &font, const QTextCharFormat &format)
+{
+    const auto v = format.verticalAlignment();
+    if (!normalized(format) && (v == QTextCharFormat::AlignSuperScript || v == QTextCharFormat::AlignSubScript)) {
+        if (font.pointSize() != -1) font.setPointSize((font.pointSize() * 2) / 3);
+        else font.setPixelSize((font.pixelSize() * 2) / 3);
+    }
+}
+inline qreal deviceScale(const QFont &font)
+{ return QFontMetricsF(font).fontDpi() / QFontMetricsF(QFont()).fontDpi(); }
+inline QFixed baseline(const QTextCharFormat &format, QFixed fontHeight, qreal scaling)
+{
+    const auto p = policy(format);
+    if (p.contains(u"shift"_s)) return -QFixed::fromReal(p.value(u"shift"_s).toDouble() * scaling);
+    QFixed result = -fontHeight * QFixed::fromReal(format.baselineOffset() / 100.0);
+    if (format.verticalAlignment() == QTextCharFormat::AlignSubScript)
+        result += fontHeight * QFixed::fromReal(format.subScriptBaseline() / 100.0);
+    else if (format.verticalAlignment() == QTextCharFormat::AlignSuperScript)
+        result -= fontHeight * QFixed::fromReal(format.superScriptBaseline() / 100.0);
+    return result;
+}
+inline QVariantMap actionPaint(const QTextCharFormat &overlay, const QTextCharFormat &action)
+{
+    const auto raw = overlay.property(ActionPaintProperty);
+    if (raw.metaType().id() != QMetaType::QVariantMap) return {};
+    const auto value = raw.toMap();
+    if (value.size() != 3 || value.value(u"owner"_s) != action.property(ActionOwnerProperty)
+        || value.value(u"owner"_s).metaType().id() != QMetaType::LongLong
+        || value.value(u"underline"_s).metaType().id() != QMetaType::Bool
+        || value.value(u"foreground"_s).metaType() != QMetaType::fromType<QColor>()
+        || !value.value(u"foreground"_s).value<QColor>().isValid()) return {};
+    return value;
+}
+inline bool actionBaseline(const QTextCharFormat &owner, qreal height, qreal scaling, QFixed *result)
+{
+    if (!std::isfinite(height) || height <= 0 || height >= qreal(QFIXED_MAX)
+        || !std::isfinite(scaling) || scaling <= 0) return false;
+    const auto p = policy(owner);
+    qreal magnitude = qAbs(height * owner.baselineOffset() / 100);
+    if (owner.verticalAlignment() == QTextCharFormat::AlignSuperScript)
+        magnitude += qAbs(height * owner.superScriptBaseline() / 100);
+    else if (owner.verticalAlignment() == QTextCharFormat::AlignSubScript)
+        magnitude += qAbs(height * owner.subScriptBaseline() / 100);
+    if (p.contains(u"shift"_s)) magnitude = qAbs(p.value(u"shift"_s).toDouble() * scaling);
+    if (!std::isfinite(magnitude) || magnitude >= qreal(QFIXED_MAX) - 1) return false;
+    *result = baseline(owner, QFixed::fromReal(height), scaling);
+    return true;
+}
+inline QRectF actionBand(const QTextCharFormat &action, qreal left, qreal right,
+                        qreal lineBaseline, const QPaintDevice *device)
+{
+    QTextCharFormat owner;
+    if (!actionMetric(action, &owner) || !std::isfinite(left) || !std::isfinite(right)
+        || !std::isfinite(lineBaseline) || right < left) return {};
+    QFont font = device ? QFont(owner.font(), device) : owner.font();
+    applyScriptSize(font, owner);
+    const QFontMetricsF metrics(font, device);
+    QFixed shift;
+    if (!actionBaseline(owner, metrics.ascent() + metrics.descent(), deviceScale(font), &shift)) return {};
+    return {left, lineBaseline + shift.toReal() - metrics.ascent(), right - left,
+        metrics.ascent() + metrics.descent()};
+}
+inline void drawActionBand(QPainter *painter, const QTextCharFormat &action, qreal left, qreal right,
+                           qreal lineBaseline, const QPaintDevice *device, const QTextCharFormat &overlay,
+                           bool background)
+{
+    QTextCharFormat owner;
+    if (!actionMetric(action, &owner)) return;
+    const QRectF band = actionBand(action, left, right, lineBaseline, device);
+    if (!band.isValid()) return;
+    if (background) {
+        if (owner.background().style() != Qt::NoBrush) painter->fillRect(band, owner.background());
+        return;
+    }
+    QFont font = device ? QFont(owner.font(), device) : owner.font();
+    applyScriptSize(font, owner);
+    const QFontMetricsF metrics(font, device);
+    const auto dynamic = actionPaint(overlay, action);
+    const bool underline = dynamic.isEmpty() ? owner.fontUnderline() : dynamic.value(u"underline"_s).toBool();
+    if (!underline && !owner.fontStrikeOut()) return;
+    const auto decoration = policy(owner).value(u"decoration"_s).toMap();
+    QPen pen = painter->pen();
+    if (!dynamic.isEmpty()) pen.setColor(dynamic.value(u"foreground"_s).value<QColor>());
+    else if (owner.foreground().style() != Qt::NoBrush) pen.setBrush(owner.foreground());
+    if (decoration.contains(u"color"_s)) pen.setColor(QColor(decoration.value(u"color"_s).toString()));
+    pen.setWidthF(decoration.contains(u"thickness"_s)
+        ? decoration.value(u"thickness"_s).toDouble() * deviceScale(font) : metrics.lineWidth());
+    pen.setStyle(decoration.value(u"style"_s) == u"dotted"_s ? Qt::DotLine : Qt::SolidLine);
+    if (pen.widthF() <= 0) return;
+    const qreal base = band.top() + metrics.ascent();
+    painter->save(); painter->setPen(pen);
+    if (underline) painter->drawLine(QPointF(left, base + metrics.underlinePos()), QPointF(right, base + metrics.underlinePos()));
+    if (owner.fontStrikeOut()) painter->drawLine(QPointF(left, base - metrics.strikeOutPos()), QPointF(right, base - metrics.strikeOutPos()));
+    painter->restore();
+}
+// -1 is the historical absent path; -2 is a malformed explicit owner.
+inline int imageAlignment(const QTextCharFormat &format)
+{
+    if (!format.hasProperty(ImageAlignmentProperty)) return -1;
+    const auto value = format.property(ImageAlignmentProperty);
+    const auto vertical = format.verticalAlignment();
+    if (!format.isImageFormat() || value.metaType().id() != QMetaType::QString
+        || (vertical != QTextCharFormat::AlignNormal && vertical != QTextCharFormat::AlignSuperScript
+            && vertical != QTextCharFormat::AlignSubScript)) return -2;
+    return value == u"middle"_s ? 0 : value == u"baseline"_s ? 1 : -2;
+}
+inline bool imageAscent(const QTextCharFormat &format, const QFont &font, QFixed height, QFixed *ascent)
+{
+    const int alignment = imageAlignment(format);
+    if (alignment < 0 || height < 0 || height >= QFIXED_MAX) return false;
+    const QFontMetricsF metrics(font);
+    for (qreal n : {metrics.ascent(), metrics.descent(), metrics.xHeight(), format.baselineOffset(),
+                   format.superScriptBaseline(), format.subScriptBaseline()})
+        if (!std::isfinite(n) || qAbs(n) >= qreal(QFIXED_MAX)) return false;
+    if (format.hasProperty(Property) && !valid(format.property(Property))) return false;
+    const qreal fontHeight = metrics.ascent() + metrics.descent();
+    const qreal scaling = deviceScale(font);
+    if (!std::isfinite(fontHeight) || fontHeight < 0 || fontHeight >= qreal(QFIXED_MAX)
+        || !std::isfinite(scaling) || scaling <= 0 || scaling >= qreal(QFIXED_MAX)) return false;
+    const QFixed fixedHeight = QFixed::fromReal(fontHeight);
+    const auto p = policy(format);
+    qreal magnitude = 0;
+    if (p.contains(u"shift"_s)) {
+        magnitude = qAbs(p.value(u"shift"_s).toDouble() * scaling);
+    } else {
+        // Bound the same quantized products before baseline() evaluates them.
+        const qreal offset = QFixed::fromReal(format.baselineOffset() / 100.0).toReal();
+        qreal script = 0;
+        if (format.verticalAlignment() == QTextCharFormat::AlignSubScript)
+            script = QFixed::fromReal(format.subScriptBaseline() / 100.0).toReal();
+        else if (format.verticalAlignment() == QTextCharFormat::AlignSuperScript)
+            script = QFixed::fromReal(format.superScriptBaseline() / 100.0).toReal();
+        magnitude = fixedHeight.toReal() * (qAbs(offset) + qAbs(script));
+    }
+    if (!std::isfinite(magnitude) || magnitude >= qreal(QFIXED_MAX)) return false;
+    const auto shift = baseline(format, fixedHeight, scaling);
+    const qreal above = (alignment == 0 ? (height.toReal() + metrics.xHeight()) / 2 : height.toReal()) - shift.toReal();
+    if (!std::isfinite(above) || qAbs(above) >= qreal(QFIXED_MAX)
+        || qAbs(height.toReal() - above) >= qreal(QFIXED_MAX)) return false;
+    *ascent = QFixed::fromReal(above); return true;
+}
+inline bool height(const QTextCharFormat &format, QPaintDevice *device, qreal scaling, qreal *result)
+{
+    const auto p = policy(format);
+    if (p.contains(u"height"_s)) *result = p.value(u"height"_s).toDouble() * scaling;
+    else if (p.contains(u"height_font"_s)) {
+        const auto owner = p.value(u"height_font"_s).value<QTextFormat>().toCharFormat();
+        QFont font = device ? QFont(owner.font(), device) : owner.font();
+        applyScriptSize(font, owner);
+        const QFontMetricsF fm(font, device);
+        const qreal pixels = font.pixelSize() > 0 ? font.pixelSize() : font.pointSizeF() * fm.fontDpi() / 72.0;
+        *result = pixels * p.value(u"height_factor"_s).toDouble();
+    } else return false;
+    return std::isfinite(*result) && *result >= 0 && *result < qreal(QFIXED_MAX);
+}
+}
+// Source-bound reference metadata. The application owns semantic decoding;
+// native layout verifies the exact retained source and used values again.
+namespace QCompiledReference {
+using namespace Qt::StringLiterals;
+inline bool object(const QVariant &raw, QJsonObject *out)
+{
+    if (raw.metaType().id() != QMetaType::QByteArray) return false;
+    QJsonParseError error;
+    const auto doc = QJsonDocument::fromJson(raw.toByteArray(), &error);
+    if (error.error != QJsonParseError::NoError || !doc.isObject()
+        || doc.toJson(QJsonDocument::Compact) != raw.toByteArray()) return false;
+    *out = doc.object(); return true;
+}
+inline bool positiveU32(const QJsonValue &raw, quint32 *out)
+{
+    if (!raw.isDouble()) return false;
+    const double n = raw.toDouble();
+    if (!std::isfinite(n) || n < 1 || n > double(std::numeric_limits<quint32>::max()) || std::floor(n) != n) return false;
+    *out = quint32(n); return true;
+}
+inline bool length(const QJsonValue &raw, qreal em, bool signedValue, qreal *out)
+{
+    if (!raw.isObject()) return false;
+    const auto p = raw.toObject(); const auto unit = p.value(u"unit"_s).toString();
+    if (p.size() != 2 || !p.value(u"value"_s).isDouble() || (unit != u"px"_s && unit != u"em"_s)) return false;
+    const double n = p.value(u"value"_s).toDouble();
+    *out = n * (unit == u"em"_s ? em : 1);
+    return std::isfinite(n) && (signedValue || n >= 0) && std::isfinite(*out) && qAbs(*out) < 1e6;
+}
+struct Citation { QByteArray source; QJsonObject span; qint64 owner = -1; bool nowrap = false; QVariantMap outline; };
+inline bool citation(const QVariant &raw, Citation *out)
+{
+    if (raw.metaType().id() != QMetaType::QVariantMap) return false;
+    const auto p = raw.toMap();
+    if (p.size() != 6 || p.value(u"capability"_s).metaType().id() != QMetaType::QString
+        || p.value(u"capability"_s) != QVariant(QString::fromLatin1(Capability))
+        || p.value(u"owner"_s).metaType().id() != QMetaType::LongLong || p.value(u"owner"_s).toLongLong() < 0
+        || p.value(u"nowrap"_s).metaType().id() != QMetaType::Bool
+        || !QCompiledInline::number(p.value(u"em"_s)) || p.value(u"em"_s).toDouble() <= 0
+        || p.value(u"target_outline"_s).metaType().id() != QMetaType::QVariantMap
+        || !object(p.value(u"source"_s), &out->span)) return false;
+    out->source = p.value(u"source"_s).toByteArray(); out->owner = p.value(u"owner"_s).toLongLong();
+    out->nowrap = p.value(u"nowrap"_s).toBool(); out->outline = p.value(u"target_outline"_s).toMap();
+    const auto marker = out->span.value(u"citation_marker"_s).toObject(); quint32 reference, occurrence;
+    if (out->span.value(u"kind"_s) != u"link"_s || out->span.value(u"role"_s) != u"reference"_s || !out->span.value(u"target"_s).toString().isEmpty()
+        || out->span.value(u"text"_s).toString().isEmpty() || !out->span.value(u"trail"_s).toString().isEmpty()
+        || !positiveU32(marker.value(u"reference"_s), &reference) || !positiveU32(marker.value(u"occurrence"_s), &occurrence)
+        || reference == std::numeric_limits<quint32>::max() || occurrence == std::numeric_limits<quint32>::max()
+        || marker.value(u"anchor"_s).toString().isEmpty()
+        || out->span.value(u"target_fragment"_s) != QStringLiteral("reference-%1").arg(reference)
+        || (marker.contains(u"nowrap"_s) && !marker.value(u"nowrap"_s).isBool())
+        || marker.value(u"nowrap"_s).toBool() != out->nowrap) return false;
+    for (const auto c : out->span.value(u"text"_s).toString())
+        if (c.unicode() < 0x20 || c.unicode() == 0x7f || c.unicode() == 0x2028 || c.unicode() == 0x2029
+            || c.unicode() == 0xfffc) return false;
+    for (const auto &key : {u"image"_s,u"ruby"_s,u"audio_control"_s,u"inline_action_group"_s,u"inline_box_group"_s,u"inline_padding_group"_s})
+        if (!out->span.value(key).isNull() && !out->span.value(key).isUndefined()) return false;
+    const auto target = marker.value(u"target_style"_s);
+    if (!target.isNull() && !target.isUndefined() && (!target.isObject() || !out->span.value(u"link_paint"_s).isObject())) return false;
+    const auto sourceOutline = target.toObject().value(u"paint"_s).toObject().value(u"focus_outline"_s);
+    if (sourceOutline.isUndefined() || sourceOutline.isNull()) return out->outline.isEmpty();
+    if (!sourceOutline.isObject() || sourceOutline.toObject().size() != 4 || out->outline.size() != 4) return false;
+    const auto spec = sourceOutline.toObject(); const qreal em = p.value(u"em"_s).toDouble();
+    for (const auto &key : {u"width"_s, u"radius"_s, u"offset"_s}) {
+        qreal used;
+        if (!length(spec.value(key), em, key == u"offset"_s, &used)
+            || out->outline.value(key).metaType().id() != QMetaType::Double || out->outline.value(key).toDouble() != used) return false;
+    }
+    const auto color = spec.value(u"color"_s).toObject();
+    return color.size() == 2 && color.value(u"kind"_s) == u"rgb"_s
+        && QCompiledInline::rgb(color.value(u"value"_s).toVariant())
+        && out->outline.value(u"color"_s).metaType() == QMetaType::fromType<QColor>()
+        && out->outline.value(u"color"_s).value<QColor>() == QColor(color.value(u"value"_s).toString());
+}
+inline bool background(const QJsonValue &raw, bool dark, QColor *out)
+{
+    if (!raw.isObject() || raw.toObject().size() != 1) return false;
+    const auto color = raw.toObject();
+    if (color.contains(u"transparent"_s)) {
+        if (!color.value(u"transparent"_s).isObject() || !color.value(u"transparent"_s).toObject().isEmpty()) return false;
+        *out = Qt::transparent; return true;
+    }
+    QJsonValue selected = color.value(u"rgb"_s);
+    if (color.contains(u"light_dark"_s)) {
+        const auto pair = color.value(u"light_dark"_s).toObject();
+        if (pair.size() != 2 || !QCompiledInline::rgb(pair.value(u"light"_s).toVariant())
+            || !QCompiledInline::rgb(pair.value(u"dark"_s).toVariant())) return false;
+        selected = pair.value(dark ? u"dark"_s : u"light"_s);
+    }
