+bool QTextDocumentLayoutPrivate::positionLocalBfc(QTextFrame *frame, QTextLayoutStruct *flow,
+    int from, int to, QFixed *left, QFixed *right, QFixedPoint *position, QFixed *width, bool leadingAdjoins)
+{
+    const auto exclusions = floatExclusions(flow, frame->firstPosition());
+    auto *fd = data(frame); WikidictFlexStyle style;
+    if (wikidictSectionHeading(frame)) {
+        if (!validatePlainContainer(frame)) return false;
+    } else if (!wikidictFlexStyle(frame, &style)) { refuseParagraphBox(1, frame->firstPosition()); return false; }
+    const QFixed topMargin = leadingAdjoins ? QFixed() : adjoiningMargin(frame, 0);
+    const QFixed leftMargin = adjoiningMargin(frame, 3), rightMargin = adjoiningMargin(frame, 1);
+    const auto origin = [&] {
+        qreal offset = leftMargin.toReal();
+        const qreal free = (*right - *left - *width - leftMargin - rightMargin).toReal();
+        if (free > 0 && style.autos[3]) offset += free / (int(style.autos[1]) + int(style.autos[3]));
+        else if ((free < 0 || (!style.autos[3] && !style.autos[1])) && frame->frameFormat().layoutDirection() == Qt::RightToLeft) offset += free;
+        return *left + QFixed::fromReal(offset);
+    };
+    for (qsizetype pass = 0; pass <= exclusions.size(); ++pass) {
+        position->x = origin();
+        const QRectF border(position->toPointF(), fd->size.toSizeF());
+        QFixed next = position->y; bool overlap = false;
+        for (const auto &exclusion : exclusions) {
+            const QRectF obstacle(exclusion.position.toPointF(), exclusion.size.toSizeF());
+            if (border.intersects(obstacle)) {
+                next = qMax(next, exclusion.position.y + exclusion.size.height + qMax(QFixed(), topMargin));
+                overlap = true;
+            }
+        }
+        if (!overlap) return true;
+        if (next <= position->y || !checkParagraphBoxPosition(flow, next.value(), frame->firstPosition(), true)) {
+            refuseParagraphBox(2, frame->firstPosition()); return false;
+        }
+        position->y = next;
+        floatMargins(next, flow, left, right, frame->firstPosition());
+        *left = qMax(*left, flow->x_left); *right = qMin(*right, flow->x_right);
+        *width = adjoiningWidth(frame, *right - *left); position->x = origin();
+        fd->position = *position; fd->sizeDirty = true;
+        layoutFrame(frame, from, to, *width, -1, flow->frameY);
+        if (paragraphBoxError) return false;
+    }
+    refuseParagraphBox(2, frame->firstPosition()); return false;
