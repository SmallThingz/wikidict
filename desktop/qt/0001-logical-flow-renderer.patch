+        if (!current()) return -1;
+        for (const auto &box : boxes) {
+            if (position < box.source.first || position > box.source.last) continue;
+            if (box.composite) { const int moved = box.composite->visualMove(position, right); if (moved >= 0 && moved != position) return moved; continue; }
+            const int local = position - box.source.first;
+            const int next = right ? box.shaped->layout->rightCursorPosition(local)
+                                   : box.shaped->layout->leftCursorPosition(local);
+            if (next != local) return box.source.first + next;
+        }
+        return logicalMove(position, right);
+    }
+
+    int logicalMove(int position, bool forward) const
+    {
+        if (!current()) return -1;
+        for (const auto &box : boxes) {
+            if (position < box.source.first || position > box.source.last) continue;
+            if (box.composite) { const int moved = box.composite->logicalMove(position, forward); if (moved >= 0 && moved != position) return moved; continue; }
+            const int local = position - box.source.first;
+            const int next = forward ? box.shaped->layout->nextCursorPosition(local)
+                                     : box.shaped->layout->previousCursorPosition(local);
+            if (next != local) return box.source.first + next;
+        }
+        if (forward) {
+            for (const auto &range : ranges) if (range.first > position) return range.first;
+        } else {
+            for (auto it = ranges.crbegin(); it != ranges.crend(); ++it)
+                if (it->last < position) return it->last;
+        }
+        return -1;
+    }
+
+    QRectF characterRect(int position) const
+    {
+        if (!current()) return {};
+        for (const auto &box : boxes) {
+            if (position < box.source.first || position >= box.source.last) continue;
+            if (box.composite) return box.composite->characterRect(position).translated(box.origin());
+            const auto *text = box.shaped->layout.get();
+            const auto line = text->lineAt(0);
+            const int local = position - box.source.first;
+            const int first = text->isValidCursorPosition(local) ? local
+                : text->previousCursorPosition(local, QTextLayout::SkipCharacters);
+            const int last = text->nextCursorPosition(first, QTextLayout::SkipCharacters);
+            qreal left = line.cursorToX(local, QTextLine::Leading);
+            qreal right = line.cursorToX(local, QTextLine::Trailing);
+            if (right < left) qSwap(left, right);
+            if (last - first > 1) {
+                bool found = false;
+                for (const auto &run : line.glyphRuns(first, last - first)) {
+                    const auto rect = run.boundingRect();
+                    left = found ? qMin(left, rect.left()) : rect.left();
+                    right = found ? qMax(right, rect.right()) : rect.right();
+                    found = true;
+                }
+            }
+            return {box.x + box.edge + left, box.y + box.shaped->fontTop,
+                right - left, box.shaped->fontBottom - box.shaped->fontTop};
+        }
+        return {};
+    }
+
+    QList<QRectF> selectionRects(int first, int last) const
+    {
+        QList<QRectF> result;
+        if (!current() || last <= first) return result;
+        for (const auto &box : boxes) {
+            const int begin = qMax(first, box.source.first), end = qMin(last, box.source.last);
+            if (end <= begin) continue;
+            if (box.composite) { for (const auto &rect : box.composite->selectionRects(begin, end)) result.append(rect.translated(box.origin())); continue; }
+            const auto line = box.shaped->layout->lineAt(0);
+            bool measuredGlyph = false;
+            for (const auto &run : line.glyphRuns(begin - box.source.first, end - begin)) {
+                const auto rect = run.boundingRect();
+                if (!rect.isEmpty()) {
+                    result.append(rect.translated(box.x + box.edge, box.y - box.shaped->baseline));
+                    measuredGlyph = true;
+                }
+            }
+            if (!measuredGlyph) {
+                const qreal a = line.cursorToX(begin - box.source.first);
+                const qreal b = line.cursorToX(end - box.source.first);
+                result.append(QRectF(box.x + box.edge + qMin(a, b), box.y + box.shaped->fontTop,
+                    qAbs(a - b), box.shaped->fontBottom - box.shaped->fontTop));
+            }
+        }
+        return result;
+    }
+
+    QRectF actionRect(int position) const
+    {
+        if (!current()) return {};
+        for (const auto &box : boxes) {
+            if (box.composite && position >= box.source.first && position < box.source.last) {
+                const auto r = box.composite->actionRect(position); if (!r.isEmpty()) return r.translated(box.origin());
+            }
+            if (box.inlinePadding && box.inlinePadding->ownerFormat.isAnchor()
+                && position >= box.source.first && position < box.source.last)
+                return paddingRect(box);
+        }
+        return {};
+    }
+
+    QList<LinkBox> linkBoxes() const
+    {
+        QList<LinkBox> result;
+        if (!current()) return result;
+        for (const auto &box : boxes) {
+            if (box.composite) {
+                for (auto link : box.composite->linkBoxes()) { link.rect.translate(box.origin()); result.append(link); }
+                continue;
+            }
+            if (box.inlinePadding && box.inlinePadding->ownerFormat.isAnchor()) {
+                result.append({paddingRect(box), box.inlinePadding->ownerFormat});
+                continue;
+            }
+            for (const auto &run : box.shaped->layout->formats()) {
+                if (!run.format.isAnchor() || run.format.anchorHref().isEmpty()) continue;
+                for (const auto &rect : selectionRects(box.source.first + run.start,
+                        box.source.first + run.start + run.length)) result.append({rect, run.format});
+            }
+        }
+        return result;
+    }
+
+private:
+    int depth = 0;
+    bool hasNestedAnnotation = false;
+    struct Box {
+        std::shared_ptr<Composite> composite;
+        QPointF origin() const { return {x + edge, y}; }
+        Range source;
+        QFont ownerFont;
+        QBrush foreground, background;
+        std::unique_ptr<QTextRubyGeometry::ShapedChild> shaped;
+        qreal x = 0, y = 0, width = 0, edge = 0;
+        bool underline = false, strike = false;
+        QTextCharFormat actionDecoration;
+        bool allowInternalBreak = true;
+        bool hidden = false;
+        std::optional<InlinePadding> inlinePadding;
+        qreal paddingLeft = 0, paddingRight = 0;
+    };
+    static QRectF paddingRect(const Box &box)
+    {
+        const auto line = box.shaped->layout->lineAt(0);
+        return {box.x + box.edge - box.paddingLeft, box.y + box.shaped->fontTop,
+            line.horizontalAdvance() + box.paddingLeft + box.paddingRight,
+            box.shaped->fontBottom - box.shaped->fontTop};
+    }
+    explicit QTextRubyLayout(QTextDocument *doc)
+        : document(doc), revision(doc ? doc->revision() : -1),
+          characterCount(doc ? doc->characterCount() : 0),
+          layout(doc ? doc->documentLayout() : nullptr),
+          paintDevice(layout ? layout->paintDevice() : nullptr),
+          dpiX(paintDevice ? paintDevice->logicalDpiX() : 0),
+          dpiY(paintDevice ? paintDevice->logicalDpiY() : 0),
+          originalDefaultFont(doc ? doc->defaultFont() : QFont()) {}
+
+    bool child(const Child &description, Box *result, qsizetype &budget)
+    {
+        if (!current() || description.source.first < 0
+            || description.source.last < description.source.first
+            || description.source.last >= characterCount
+            || !QTextRubyGeometry::finite(description.baselineDelta)
+            || !QTextRubyGeometry::finite(description.usedAbove)
+            || !QTextRubyGeometry::finite(description.usedBelow)
+            || description.usedAbove + description.usedBelow < 0) return false;
+        const auto firstBlock = document->findBlock(description.source.first);
+        if (description.source.last > description.source.first
+            && document->findBlock(description.source.last - 1) != firstBlock) return false;
+        if (!description.nestedParts.isEmpty()) {
+            if (description.inlinePadding || !description.actionDecoration.isEmpty()) return false;
+            QList<std::shared_ptr<QTextRubyLayout>> measuredParts;
+            int pos = description.source.first;
+            for (const auto &part : description.nestedParts) {
+                if (!part.description || part.source.first < pos || part.source.last <= part.source.first
+                    || part.source.last > description.source.last) return false;
+                auto nested = createAtDepth(document, *part.description, depth + 1, budget);
+                if (!nested) return false;
+                int covered = part.source.first;
+                for (const auto &range : nested->sourceRanges()) {
+                    if (range.first != covered) return false;
+                    covered = range.last;
+                }
+                if (covered != part.source.last) return false;
+                pos = covered;
+                hasNestedAnnotation |= nested->metrics().visibleAnnotation;
+                measuredParts.append(std::shared_ptr<QTextRubyLayout>(std::move(nested)));
+            }
+            result->composite = Composite::create(document, description, measuredParts);
+            if (!result->composite) return false;
+            result->shaped = std::make_unique<QTextRubyGeometry::ShapedChild>();
+            result->shaped->advance = result->composite->advance();
+            const QFontMetricsF declaring(description.ownerFont, paintDevice);
+            result->shaped->fontTop = qMin(-declaring.ascent(), result->composite->top());
+            result->shaped->fontBottom = qMax(declaring.descent(), result->composite->bottom());
+        } else {
+            QString text;
+            QList<QTextLayout::FormatRange> formats;
+            const auto *priv = QTextDocumentPrivate::get(document);
+            for (int position = description.source.first; position < description.source.last; ++position) {
+                const auto fragment = priv->find(position);
+                auto format = priv->formatCollection()->charFormat(fragment.value()->format);
+                format.clearProperty(QTextFormat::ObjectIndex);
+                if (format.objectType() != QTextFormat::NoObject) return false;
+                const int start = text.size(); text += document->characterAt(position);
+                if (!formats.isEmpty() && formats.last().format == format) ++formats.last().length;
+                else formats.append({start, 1, format});
+            }
+            QFont declaring = description.ownerFont;
+            declaring.setUnderline(false); declaring.setStrikeOut(false);
+            result->shaped = QTextRubyGeometry::measureFlatChild(text, declaring,
+                formats, description.option, paintDevice);
+            if (!result->shaped || !current()) return false;
+            if (description.inlinePadding) {
+                const auto &group = *description.inlinePadding;
+                if (text.isEmpty() || text.trimmed() != text || text.isRightToLeft()
+                    || description.option.textDirection() != Qt::LeftToRight
+                    || !(group.ownerFont.pointSizeF() > 0)
+                    || !QTextRubyGeometry::finite(group.ownerFont.pointSizeF())) return false;
+                for (qsizetype i = 0; i < text.size(); ++i) {
+                    const QChar first = text.at(i);
+                    char32_t scalar = first.unicode();
+                    if (first.isHighSurrogate()) {
+                        if (i + 1 == text.size() || !text.at(i + 1).isLowSurrogate()) return false;
+                        scalar = QChar::surrogateToUcs4(first, text.at(++i));
+                    } else if (first.isLowSurrogate()) return false;
+                    const auto direction = QChar::direction(scalar);
+                    if (direction == QChar::DirR || direction == QChar::DirAL || direction == QChar::DirAN
+                        || QChar::category(scalar) == QChar::Other_Control
+                        || scalar == 0x061c || scalar == 0x200e || scalar == 0x200f
+                        || (scalar >= 0x202a && scalar <= 0x202e) || (scalar >= 0x2066 && scalar <= 0x2069)) return false;
+                }
+                // This initial inline boundary has one native fragment. Prove it
+                // from ordinary opportunities; never change the source wrap policy.
+                QTextBoundaryFinder boundaries(QTextBoundaryFinder::Line, text);
+                for (int cut = 1; cut < text.size(); ++cut) {
+                    boundaries.setPosition(cut);
+                    if ((boundaries.boundaryReasons() & QTextBoundaryFinder::BreakOpportunity)
+                        && result->shaped->layout->isValidCursorPosition(cut)) return false;
+                }
+                const auto &owner = group.ownerFormat;
+                const auto identity = [](const QTextCharFormat &format) {
+                    const auto action = QCompiledInline::actionOwner(format);
+                    return action.isValid() ? action : QCompiledInline::rubyAnchorOwner(format);
+                };
+                if (owner.isAnchor() != !owner.anchorHref().isEmpty()
+                    || (owner.isAnchor() && !identity(owner).isValid())
+                    || (owner.hasProperty(QCompiledInline::ActionOwnerProperty) && !QCompiledInline::actionMetric(owner))) return false;
+                for (const auto &run : formats) {
+                    if (owner.isAnchor() && (!run.format.isAnchor()
+                        || run.format.anchorHref() != owner.anchorHref()
+                        || identity(run.format) != identity(owner))) return false;
+                }
+                const qreal defaultDpi = QFontMetricsF(QFont()).fontDpi();
+                const qreal dpi = QFontMetricsF(group.ownerFont, paintDevice).fontDpi();
+                if (!(defaultDpi > 0) || !(dpi > 0)) return false;
+                const auto resolve = [&](const InlinePadding::Edge &edge) {
+                    return edge.value * (edge.em ? group.ownerFont.pointSizeF() * dpi / 72 : dpi / defaultDpi);
+                };
+                if (!QTextRubyGeometry::length(group.left.value) || !QTextRubyGeometry::length(group.right.value)
+                    || (group.left.value == 0 && group.right.value == 0)) return false;
+                result->paddingLeft = resolve(group.left); result->paddingRight = resolve(group.right);
+                if (!QTextRubyGeometry::length(result->paddingLeft) || !QTextRubyGeometry::length(result->paddingRight)) return false;
+                result->shaped->advance += result->paddingLeft + result->paddingRight;
+                if (!QTextRubyGeometry::length(result->shaped->advance)
+                    || result->shaped->advance >= qreal(QFIXED_MAX)) return false;
+                const QFontMetricsF metrics(group.ownerFont, paintDevice);
+                result->shaped->fontTop = qMin(result->shaped->fontTop, -metrics.ascent());
+                result->shaped->fontBottom = qMax(result->shaped->fontBottom, metrics.descent());
+                result->inlinePadding = group;
+            }
+        }
+        result->source = description.source; result->ownerFont = description.ownerFont;
+        result->foreground = description.foreground; result->background = description.background;
+        result->underline = description.underline; result->strike = description.strike;
+        if (!description.actionDecoration.isEmpty() && !QCompiledInline::actionMetric(description.actionDecoration)) return false;
+        result->actionDecoration = description.actionDecoration;
+        result->allowInternalBreak = description.option.wrapMode() != QTextOption::NoWrap
+            && description.option.wrapMode() != QTextOption::ManualWrap;
+        result->y = description.baselineDelta;
+        return true;
+    }
+
+    bool initialize(const Description &description, qsizetype &budget)
+    {
+        using namespace QTextRubyGeometry;
+        if (!current() || !QTextRubyGeometry::finite(description.baselineOrigin) || description.bases.isEmpty() || description.bases.size() > 65536
+            || description.readings.size() > 65536
+            || (description.direction != Qt::LeftToRight && description.direction != Qt::RightToLeft)
+            || description.gaps.size() != description.bases.size()) return false;
+        const bool action = !description.actionFormat.isEmpty();
+        if (action && !QCompiledInline::actionMetric(description.actionFormat)) return false;
+        const auto actionIdentity = QCompiledInline::actionOwner(description.actionFormat);
+        for (const auto &base : description.bases)
+            if (action != !base.actionDecoration.isEmpty()
+                || (action && (QCompiledInline::actionOwner(base.actionDecoration) != actionIdentity
+                    || base.actionDecoration != description.actionFormat))) return false;
+        for (const auto &reading : description.readings)
+            if (!reading.child.actionDecoration.isEmpty()) return false;
+        for (const auto &gap : description.gapSources)
+            if (!gap.child.actionDecoration.isEmpty()) return false;
+        if (action) {
+            const auto owns = [&](const Child &child) {
+                if (child.source.first < 0 || child.source.last < child.source.first
+                    || child.source.last >= document->characterCount()) return false;
+                for (auto block = document->findBlock(child.source.first);
+                     block.isValid() && block.position() < child.source.last; block = block.next()) {
+                    for (auto it = block.begin(); !it.atEnd(); ++it) {
+                        const auto fragment = it.fragment();
+                        if (!fragment.isValid() || fragment.position() >= child.source.last
+                            || fragment.position() + fragment.length() <= child.source.first) continue;
+                        const auto format = fragment.charFormat();
+                        if (QCompiledInline::actionOwner(format) != actionIdentity
+                            || format.anchorHref() != description.actionFormat.anchorHref()
+                            || format.property(QCompiledInline::ActionMetricProperty)
+                                != description.actionFormat.property(QCompiledInline::ActionMetricProperty)) return false;
+                    }
+                }
+                return !child.inlinePadding || (QCompiledInline::actionOwner(child.inlinePadding->ownerFormat) == actionIdentity
+                    && child.inlinePadding->ownerFormat.anchorHref() == description.actionFormat.anchorHref()
+                    && child.inlinePadding->ownerFormat.property(QCompiledInline::ActionMetricProperty)
+                        == description.actionFormat.property(QCompiledInline::ActionMetricProperty));
+            };
+            for (const auto &base : description.bases) if (!owns(base)) return false;
+            for (const auto &reading : description.readings) if (!owns(reading.child)) return false;
+        }
+        if (description.gaps.first() != 0
+            || std::any_of(description.gaps.cbegin(), description.gaps.cend(),
+                [](qreal gap) { return !QTextRubyGeometry::length(gap); })) return false;
+        QList<qreal> advances;
+        QList<AnnotationWidth> annotationWidths;
+        QList<AnnotationBox> annotationBoxes;
+        qreal usedAbove = -std::numeric_limits<qreal>::infinity(), usedBelow = usedAbove;
+        qreal top = usedAbove, bottom = usedAbove;
+        boxes.reserve(size_t(description.bases.size() + description.readings.size()));
+        for (const auto &base : description.bases) {
+            Box box;
+            if (base.inlinePadding || !child(base, &box, budget)) return false;
+            advances.append(box.shaped->advance);
+            usedAbove = qMax(usedAbove, base.usedAbove - box.y);
+            usedBelow = qMax(usedBelow, base.usedBelow + box.y);
+            const qreal childTop = box.shaped->fontTop + box.y;
+            const qreal childBottom = box.shaped->fontBottom + box.y;
+            top = boxes.empty() ? childTop : qMin(top, childTop);
+            bottom = boxes.empty() ? childBottom : qMax(bottom, childBottom);
+            boxes.push_back(std::move(box));
+        }
+        int lastLevel = -1, lastEnd = 0;
+        for (const auto &reading : description.readings) {
+            if (reading.level < 0 || reading.level > lastLevel + 1
+                || reading.level < lastLevel || reading.firstBase < 0 || reading.baseCount <= 0
+                || reading.baseCount > description.bases.size() - reading.firstBase) return false;
+            if (reading.level != lastLevel) lastEnd = 0;
+            if (reading.firstBase < lastEnd) return false;
+            lastLevel = reading.level; lastEnd = reading.firstBase + reading.baseCount;
+            Box box;
+            if (!child(reading.child, &box, budget)) return false;
+            if (reading.hidden && box.source.first != box.source.last) return false;
+            box.hidden = reading.hidden;
+            box.y -= description.baselineOrigin;
+            if (!QTextRubyGeometry::finite(box.y)) return false;
+            annotationWidths.append({reading.firstBase, reading.baseCount, box.shaped->advance, reading.hidden});
+            annotationBoxes.append({reading.level, reading.hidden,
+                box.shaped->fontTop, box.shaped->fontBottom, box.y});
+            boxes.push_back(std::move(box));
+        }
+        std::vector<Box> gapBoxes;
+        QList<int> gapStackIndices;
+        QList<qreal> sharedGaps = description.gaps;
+        QSet<int> gapTargets;
+        for (const auto &gap : description.gapSources) {
+            const bool baseGap = gap.beforeBase >= 0;
+            if (baseGap == (gap.beforeReading >= 0)
+                || gap.beforeBase >= description.bases.size()
+                || gap.beforeReading >= description.readings.size()) return false;
+            if (!baseGap && description.readings[gap.beforeReading].hidden) return false;
+            const int target = baseGap ? gap.beforeBase : description.bases.size() + gap.beforeReading;
+            if (gapTargets.contains(target)) return false;
+            gapTargets.insert(target);
+            Box box;
+            auto gapDescription = gap.child;
+            gapDescription.option.setFlags(gapDescription.option.flags() | QTextOption::IncludeTrailingSpaces);
+            if (!gapDescription.nestedParts.isEmpty() || gapDescription.inlinePadding || !child(gapDescription, &box, budget)) return false;
+            if (box.source.first != box.source.last) {
+                auto *gapEngine = box.shaped->layout->engine();
+                box.shaped->advance = gapEngine->width(0, box.source.last - box.source.first).toReal();
+                if (!length(box.shaped->advance)) return false;
+                // The same full whitespace width drives placement, selection
+                // and xToCursor; generic horizontalAdvance omits trailing spaces.
+                gapEngine->lines[0].textAdvance = QFixed::fromReal(box.shaped->advance);
+                gapEngine->lines[0].textWidth = QFixed::fromReal(box.shaped->advance);
+            }
+            for (int position = box.source.first; position < box.source.last; ++position) {
+                if (document->characterAt(position).unicode() != 0x20) return false;
+                const auto *priv = QTextDocumentPrivate::get(document);
+                const auto fragment = priv->find(position);
+                const auto format = priv->formatCollection()->charFormat(fragment.value()->format);
+                if (format.isAnchor() || format.objectType() != QTextFormat::NoObject) return false;
+            }
+            int stackIndex = -1;
+            if (box.source.first != box.source.last) {
+                if (baseGap) {
+                    if (gap.beforeBase == 0) return false; // No leading column-gap slot.
+                    sharedGaps[gap.beforeBase] = qMax(sharedGaps[gap.beforeBase], box.shaped->advance);
+                    usedAbove = qMax(usedAbove, gap.child.usedAbove - box.y);
+                    usedBelow = qMax(usedBelow, gap.child.usedBelow + box.y);
+                    top = qMin(top, box.shaped->fontTop + box.y);
+                    bottom = qMax(bottom, box.shaped->fontBottom + box.y);
+                } else {
+                    const auto &following = description.readings[gap.beforeReading];
+                    int previous = gap.beforeReading - 1;
+                    while (previous >= 0 && description.readings[previous].level == following.level
+                           && description.readings[previous].hidden) --previous;
+                    // A gap between adjacent visible spans constrains their
+                    // common column boundary. A leading row gap, or one across
+                    // intervening columns, needs a different span planner.
+                    if (previous < 0 || description.readings[previous].level != following.level
+                        || description.readings[previous].firstBase + description.readings[previous].baseCount
+                            != following.firstBase || following.firstBase <= 0) return false;
+                    sharedGaps[following.firstBase] = qMax(sharedGaps[following.firstBase], box.shaped->advance);
+                    // Anonymous text shares the row's placement baseline, but
+                    // its own font and local shift come from the Ruby origin.
+                    box.y -= description.baselineOrigin;
+                    if (!QTextRubyGeometry::finite(box.y)) return false;
+                    stackIndex = annotationBoxes.size();
+                    annotationBoxes.append({following.level, false,
+                        box.shaped->fontTop, box.shaped->fontBottom, box.y});
+                }
+            }
+            gapStackIndices.append(stackIndex);
+            gapBoxes.push_back(std::move(box));
+        }
+        // Keep the metadata/reading order intact; the stack alone consumes
+        // level order, including each anonymous gap as an independent member.
+        QList<qsizetype> stackOrder;
+        for (qsizetype i = 0; i < annotationBoxes.size(); ++i) stackOrder.append(i);
+        std::stable_sort(stackOrder.begin(), stackOrder.end(), [&](qsizetype a, qsizetype b) {
+            return annotationBoxes[a].level < annotationBoxes[b].level;
+        });
+        QList<AnnotationBox> stackBoxes;
+        for (qsizetype i : stackOrder) stackBoxes.append(annotationBoxes[i]);
+        const auto columns = QTextRubyGeometry::columns(advances, sharedGaps, annotationWidths);
+        const auto stacked = stack(usedAbove, usedBelow, top, bottom, stackBoxes);
+        if (!columns || !stacked || columns->advance >= qreal(QFIXED_MAX)
+            || qAbs(usedAbove) >= qreal(QFIXED_MAX) || qAbs(usedBelow) >= qreal(QFIXED_MAX)
+            || qAbs(stacked->top) >= qreal(QFIXED_MAX) || qAbs(stacked->bottom) >= qreal(QFIXED_MAX)) return false;
+        QList<qreal> participantBaselines(annotationBoxes.size(), 0);
+        for (qsizetype i = 0; i < stackOrder.size(); ++i)
+            participantBaselines[stackOrder[i]] = stacked->baselines[i];
+        for (qsizetype i = 0; i < description.bases.size(); ++i) {
+            auto &box = boxes[size_t(i)];
+            box.x = columns->starts[i]; box.width = columns->widths[i];
+        }
+        for (qsizetype i = 0; i < description.readings.size(); ++i) {
+            const auto &reading = description.readings[i];
+            auto &box = boxes[size_t(description.bases.size() + i)];
+            box.x = columns->starts[reading.firstBase];
+            const int end = reading.firstBase + reading.baseCount - 1;
+            box.width = columns->starts[end] + columns->widths[end] - box.x;
+            box.y += participantBaselines[i];
+        }
+        for (auto &box : boxes) {
+            if (box.hidden) continue;
