+QList<QTextFrame *> QTextDocumentLayoutPrivate::resetCellLayout(
+    QTextTable *t, const QTextTableCell &cell, QTextTableData *td)
+{
+    // Intrinsic and final cell allocations may have different active exclusions.
+    // Recompute Rule clearance with the same reset boundary as child frames.
+    for (auto it = authoredRuleClearances.begin(); it != authoredRuleClearances.end(); ) {
+        if (*it >= cell.firstPosition() && *it <= cell.lastPosition()) it = authoredRuleClearances.erase(it);
+        else ++it;
+    }
+    const QList<QTextFrame *> childFrames = td->childFrameMap.values(cell.row() + cell.column() * t->rows());
+    for (int i = 0; i < childFrames.size(); ++i) {
+        QTextFrame *frame = childFrames.at(i);
+        QTextFrameData *cd = data(frame);
+        cd->sizeDirty = true;
+        if (adjoiningContainersPresent) {
+            const auto reset = [&](auto &&visit, QTextFrame *owner) -> void {
+                adjoiningClearances.remove(owner); adjoiningFloatWidths.remove(owner);
+                for (auto *child : owner->childFrames()) visit(visit, child);
+            };
+            reset(reset, frame);
+        }
+    }
+
+    return childFrames;
+}
