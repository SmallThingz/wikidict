+    if (out->source.value(QStringLiteral("kind")) != QStringLiteral("container") || !owner.isObject()
+        || !owner.toObject().value(QStringLiteral("blocks")).isArray()) return false;
+    out->style = owner.toObject().value(QStringLiteral("style")).toObject();
+    const auto screen = out->style.value(QStringLiteral("screen_max_width")).toObject();
+    QList<QJsonObject> bands;
+    if (!screen.isEmpty()) {
+        bands.append(screen);
+        for (const auto &next : screen.value(QStringLiteral("following_rules")).toArray()) bands.append(next.toObject());
+        if (bands.size() > 16) return false;
+        qreal previous = 4294967296.0;
+        for (qsizetype i = 0; i < bands.size(); ++i) {
+            const auto &band = bands[i]; const qreal bound = band.value(QStringLiteral("max_width_px")).toDouble(-1);
+            if (bound < 0 || !qIsFinite(bound) || std::floor(bound) != bound || bound >= previous
+                || (i && !band.value(QStringLiteral("following_rules")).toArray().isEmpty())) return false;
+            previous = bound;
+            if (viewport > bound) continue;
+            for (const auto &key : {QStringLiteral("width"), QStringLiteral("max_width"), QStringLiteral("box_sizing"),
+                    QStringLiteral("line_height"), QStringLiteral("float_side"), QStringLiteral("clear")})
+                if (!band.value(key).isNull() && !band.value(key).isUndefined()) out->style.insert(key, band.value(key));
+            if (band.value(QStringLiteral("margins")).isObject()) {
+                out->style.remove(QStringLiteral("margins"));
+                out->style.insert(QStringLiteral("margin_values"), band.value(QStringLiteral("margins")));
+            }
+        }
+    }
+    const auto present = [&](const QString &key) { const auto v = out->style.value(key); return !v.isNull() && !v.isUndefined(); };
+    for (const auto &key : {QStringLiteral("positioning"), QStringLiteral("columns"), QStringLiteral("min_height")})
+        if (present(key)) return false;
+    if (out->style.value(QStringLiteral("overflow")) == QStringLiteral("auto")) return false;
+    const auto layout = out->style.value(QStringLiteral("layout")).toString(QStringLiteral("flow"));
+    if (layout != QStringLiteral("flow") && layout != QStringLiteral("flex_row")) return false;
+    out->row = layout == QStringLiteral("flex_row");
+    out->none = present(QStringLiteral("flex_item"));
+    if (out->none && out->style.value(QStringLiteral("flex_item")) != QStringLiteral("none")) return false;
+    out->align = out->style.value(QStringLiteral("align_items")).toString(QStringLiteral("stretch"));
+    if (out->align != QStringLiteral("stretch") && out->align != QStringLiteral("start")
+        && out->align != QStringLiteral("center") && out->align != QStringLiteral("end")) return false;
+    const auto marginValues = out->style.value(QStringLiteral("margin_values")).toObject();
+    const QString sides[] = {QStringLiteral("top"), QStringLiteral("right"), QStringLiteral("bottom"), QStringLiteral("left")};
+    for (int i = 0; i < 4; ++i) out->autos[i] = marginValues.value(sides[i]).toObject().contains(QStringLiteral("auto"));
+    return true;
+}
