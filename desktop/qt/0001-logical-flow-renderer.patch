+struct Stack {
+    QList<qreal> baselines; // Input order; hidden entries have no painted box.
+    qreal top = 0;
+    qreal bottom = 0;
+    Leading leading;
+};
+
+// All members of one annotation level share its baseline; a level's declaring
+// fonts and real content determine its extents. Alternating levels stack outwards
+// from the measured base content, including nested Ruby, not from a synthetic
+// replacement character or the base's possibly fixed/short used line-height.
+inline std::optional<Stack> stack(qreal baseUsedAbove, qreal baseUsedBelow,
+                                  qreal baseContentTop, qreal baseContentBottom,
+                                  const QList<AnnotationBox> &boxes)
+{
+    if (!finite(baseUsedAbove) || !finite(baseUsedBelow)
+        || !length(baseUsedAbove + baseUsedBelow)
+        || !finite(baseContentTop) || !finite(baseContentBottom)
+        || baseContentBottom < baseContentTop) return std::nullopt;
+    Stack result;
+    result.baselines = QList<qreal>(boxes.size(), 0);
+    result.top = baseContentTop;
+    result.bottom = baseContentBottom;
+    bool hasVisibleAnnotation = false;
+    int previousLevel = -1;
+    for (qsizetype begin = 0; begin < boxes.size();) {
+        const int level = boxes[begin].level;
+        if (level < 0 || level != previousLevel + 1) return std::nullopt;
+        qsizetype end = begin;
+        bool visible = false;
+        qreal top = 0, bottom = 0;
+        for (; end < boxes.size() && boxes[end].level == level; ++end) {
+            const auto &box = boxes[end];
+            if (!finite(box.top) || !finite(box.bottom) || !finite(box.localShift) || box.bottom < box.top)
+                return std::nullopt;
+            if (box.hidden) continue;
+            if (!visible) { top = box.top; bottom = box.bottom; }
+            else { top = qMin(top, box.top); bottom = qMax(bottom, box.bottom); }
+            visible = true;
+        }
+        if (visible) {
+            hasVisibleAnnotation = true;
+            const qreal baseline = level % 2 == 0 ? result.top - bottom : result.bottom - top;
+            if (!finite(baseline)) return std::nullopt;
+            for (qsizetype i = begin; i < end; ++i) {
+                if (boxes[i].hidden) continue;
+                result.baselines[i] = baseline;
+                result.top = qMin(result.top, baseline + boxes[i].top + boxes[i].localShift);
+                result.bottom = qMax(result.bottom, baseline + boxes[i].bottom + boxes[i].localShift);
+            }
+            if (!finite(result.top) || !finite(result.bottom)) return std::nullopt;
+        }
+        previousLevel = level;
+        begin = end;
+    }
+    // An annotation-free/all-hidden owner must remain ordinary inline content.
+    // In particular, its short fixed line-height does not become expanded just
+    // because the semantic source still retains an auto-hidden reading.
+    if (!hasVisibleAnnotation) return result;
+    const auto leading = additionalLeading(baseUsedAbove, baseUsedBelow, result.top, result.bottom);
+    if (!leading) return std::nullopt;
+    result.leading = *leading;
+    return result;
