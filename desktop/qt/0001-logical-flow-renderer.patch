+#ifndef QTEXTRUBYGEOMETRY_P_H
+#define QTEXTRUBYGEOMETRY_P_H
+
+// Private source candidate for the existing native logical-flow layout.
+// Unregistered and uncompiled. Inputs are measured native child results, never
+// guessed font metrics or source CSS values. Shaping, breaks, bidi, gap collapse,
+// paint, hit-testing and source registration remain the containing flow's job.
+#include <QtCore/qlist.h>
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+QT_BEGIN_NAMESPACE
+
+namespace QTextRubyGeometry {
+
+inline bool finite(qreal value) { return std::isfinite(value); }
+inline bool length(qreal value) { return finite(value) && value >= 0; }
+
+struct Distribution {
+    qreal edgeBefore = 0;
+    qreal between = 0;
+    qreal edgeAfter = 0;
+};
+
+// The caller supplies actual shaped-cluster justification opportunities after
+// Ruby's script policy has filtered them. Qt's ordinary AlignJustify opportunity
+// set also contains Latin/Bopomofo boundaries and is not suitable unfiltered.
+inline std::optional<Distribution> spaceAround(qreal advance, qreal allocated,
+                                               qsizetype opportunities)
+{
+    if (!length(advance) || !length(allocated) || allocated < advance || opportunities < 0)
+        return std::nullopt;
+    const qreal share = (allocated - advance) / (qreal(opportunities) + 1);
+    if (!finite(share)) return std::nullopt;
+    return Distribution{share / 2, share, share / 2};
+}
+
+struct Leading {
+    qreal above = 0;
+    qreal below = 0;
+};
+
+// Base used metrics stay unchanged. Annotation extent may legitimately exceed
+// the line box; it is not an image/object strut. This choice of additional
+// leading ensures non-overlap of three identical lines and assigns additions
+// only to sides on which the measured Ruby extends beyond the base used box.
+// Different neighbouring content and block clipping require separate checks.
+inline std::optional<Leading> additionalLeading(qreal baseAbove, qreal baseBelow,
+                                                qreal occupiedTop, qreal occupiedBottom)
+{
+    if (!finite(baseAbove) || !finite(baseBelow) || !finite(occupiedTop)
+        || !finite(occupiedBottom) || occupiedBottom < occupiedTop)
+        return std::nullopt;
+    const qreal advance = baseAbove + baseBelow;
+    const qreal extent = occupiedBottom - occupiedTop;
+    if (!length(advance) || !length(extent)) return std::nullopt;
+    const qreal extra = qMax(qreal(0), extent - advance);
+    if (!extra) return Leading{};
+    const qreal over = qMax(qreal(0), -occupiedTop - baseAbove);
+    const qreal under = qMax(qreal(0), occupiedBottom - baseBelow);
+    const qreal total = over + under;
+    if (!length(extra) || !finite(total) || total <= 0) return std::nullopt;
+    const qreal above = extra * (over / total);
+    return Leading{above, extra - above};
+}
+
+struct AnnotationWidth {
+    qsizetype first = 0;
+    qsizetype count = 0;
+    qreal advance = 0;
+    bool hidden = false;
+};
+
+struct AnnotationBox {
+    int level = 0;
+    bool hidden = false;
+    // Measured declaring-font/child/nested-content bounds relative to its own
