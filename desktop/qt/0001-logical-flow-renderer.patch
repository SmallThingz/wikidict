+inline void paintDecoration(QPainter *painter, const Box &box, const Decoration &shape,
+                            const QPointF &offset, bool background)
+{
+    if (background && !box.identity.contains("background")) return;
+    painter->save();
+    painter->setPen(Qt::NoPen);
+    painter->setBrush(background ? box.identity.value("background").value<QColor>() : box.colors[0]);
+    painter->drawPath((background ? shape.outer : shape.border).translated(offset));
+    painter->restore();
+}
