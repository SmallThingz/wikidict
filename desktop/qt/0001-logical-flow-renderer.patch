+static constexpr auto wikidictFixedImageDelegateProperty = "_wikidictFixedImageIntrinsicDelegateV1";
+
+QObject *QTextDocumentLayoutPrivate::tableIntrinsicImageDelegate() const
+{
+    const auto handler = handlers.value(QTextFormat::ImageObject);
+    if (!handler.component || !handler.iface || !stockImageHandler) return nullptr;
+    if (handler.component == stockImageHandler
+        && handler.iface == qobject_cast<QTextObjectInterface *>(stockImageHandler.data()))
+        return stockImageHandler.data();
+    // This is a dynamic, value-only opt-in contract, never a provider callback.
+    // Its fixed-image branch must use this layout's original stock delegate
+    // and may add only format-owned decoration to its intrinsic dimensions.
+    if (handler.component->metaObject()->indexOfProperty(wikidictFixedImageDelegateProperty) >= 0)
+        return nullptr;
+    const auto value = handler.component->property(wikidictFixedImageDelegateProperty);
+    return value.metaType() == QMetaType::fromType<QObject *>()
+        && value.value<QObject *>() == stockImageHandler.data() ? stockImageHandler.data() : nullptr;
+}
+
+bool QTextDocumentLayoutPrivate::tableIntrinsicImage(const QTextFragment &fragment, QTextFrame *owner)
+{
+    if (!fragment.isValid() || fragment.length() != 1
+        || fragment.text() != QString(QChar::ObjectReplacementCharacter)
+        || !tableIntrinsicEpochCurrent() || !tableIntrinsicEpoch->imageDelegate)
+        return false;
+    const auto format = fragment.charFormat();
+    const auto image = format.toImageFormat();
+    if (!format.isImageFormat() || format.objectType() != QTextFormat::ImageObject
+        || !format.hasProperty(QTextFormat::ImageWidth) || !format.hasProperty(QTextFormat::ImageHeight)
+        || format.hasProperty(QTextFormat::ImageMaxWidth)
+        || format.hasProperty(QTextFormat::UserProperty + 0x57b0)
+        || !qIsFinite(image.width()) || !qIsFinite(image.height())
+        || image.width() <= 0 || image.height() <= 0
+        || image.width() >= qreal(QFIXED_MAX) || image.height() >= qreal(QFIXED_MAX)
+        || !owner || owner->document() != document || !qobject_cast<QTextTable *>(owner)
+        || fragment.position() < owner->firstPosition() || fragment.position() > owner->lastPosition())
+        return false;
+    // Figure/media sizing is allocation-dependent even when the format has
+    // two axes. Ordinary table ancestors alone are admitted by the context.
+    for (auto *frame = owner; frame; frame = frame->parentFrame()) {
+        const auto box = frame->frameFormat();
+        if (box.hasProperty(WikidictFigureRole) || box.hasProperty(WikidictFigureBlockMedia)
+            || box.hasProperty(WikidictFigureTableCaption)) return false;
+    }
+    const auto accepted = [&] {
+        if (q_func()->property("_wikidictCollectTableWork").toBool())
+            tableIntrinsicImagePositions.insert(fragment.position());
+        return true;
+    };
+    // Inspect the existing frame tree only: objectForFormat can lazily create
+    // an object through a virtual document callback, even during admission.
+    QTextFrame *helper = nullptr;
+    for (auto *child : owner->childFrames()) {
+        if (child->firstPosition() <= fragment.position() && fragment.position() <= child->lastPosition())
+            return false;
+        if (child->objectIndex() == format.objectIndex()) helper = child;
+    }
+    if (format.objectIndex() == -1) return accepted();
+    QTextFrameFormat neutral; neutral.setPosition(QTextFrameFormat::InFlow);
+    return helper && helper->parentFrame() == owner && helper->childFrames().isEmpty()
+        && !qobject_cast<QTextTable *>(helper) && helper->frameFormat() == neutral
+        && helper->firstPosition() == fragment.position() + 1
+        && helper->lastPosition() == fragment.position() && accepted();
+}
+
+bool QTextDocumentLayoutPrivate::tableIntrinsicImageFrame(QTextFrame *frame)
+{
+    if (!frame || qobject_cast<QTextTable *>(frame)
+        || frame->firstPosition() != frame->lastPosition() + 1) return false;
+    const auto block = document->findBlock(frame->lastPosition());
+    for (auto it = block.begin(); !it.atEnd(); ++it) {
+        const auto fragment = it.fragment();
+        if (fragment.contains(frame->lastPosition()))
+            return fragment.charFormat().objectIndex() == frame->objectIndex()
+                && tableIntrinsicImage(fragment, frame->parentFrame());
+    }
+    return false;
+}
