+inline bool slice(const Box &b, qreal firstX, qreal lastX, qreal baseline,
+                  qreal scale, const QPaintDevice *device, bool first, bool last, Slice *out)
+{
+    if (!finite(firstX)||!finite(lastX)||!finite(baseline)||!finite(scale)||scale<=0||lastX<firstX) return false;
+    const QFont font = device ? QFont(b.font, device) : b.font;
+    const QFontMetricsF fm(font, device);
+    const qreal left = first ? (b.padding[3]+b.widths[3])*scale : 0;
+    const qreal right = last ? (b.padding[1]+b.widths[1])*scale : 0;
+    const qreal top = (b.padding[0]+b.widths[0])*scale, bottom=(b.padding[2]+b.widths[2])*scale;
+    if (!finite(fm.ascent())||!finite(fm.descent())||!finite(left)||!finite(right)||!finite(top)||!finite(bottom)
+        || lastX-firstX+1.0/64 < left+right) return false;
+    Slice s; s.first=first; s.last=last;
+    s.content={firstX+left,baseline-fm.ascent(),qMax(qreal(0),lastX-firstX-left-right),fm.ascent()+fm.descent()};
+    s.padding=s.content.adjusted(first ? -b.padding[3]*scale : 0,-b.padding[0]*scale,
+        last ? b.padding[1]*scale : 0,b.padding[2]*scale);
+    s.border=s.padding.adjusted(first ? -b.widths[3]*scale : 0,-b.widths[0]*scale,
+        last ? b.widths[1]*scale : 0,b.widths[2]*scale);
+    for(qreal n:{s.border.left(),s.border.right(),s.border.top(),s.border.bottom()}) if(!finite(n)) return false;
+    *out=s;return true;
+}
+// Physical ranges are installed in decoded source preorder. Two owners of the
+// same characters remain distinct through the parent index, including when
+// the inner box changes paint but contributes no additional advance.
+struct SourceBoxLineSlice { int node, first, last; PaintSlice paint; };
+struct SourceBoxVisualRun { qreal firstX, lastX; bool rightToLeft; };
+
+class SourceBoxTree
+{
+    struct Edges { qreal left = 0, right = 0; };
+    struct Boundary { Edges open, close; };
+    struct Measured {
+        SourceBoxNode node;
+        qreal scale;
+        Edges own, ancestorsAtFirst, ancestorsAtLast;
+        int lastChildEnd;
+    };
+    QList<Measured> m_nodes;
+    QMap<int, Boundary> m_boundaries;
+    const QPaintDevice *m_device = nullptr;
+
+    static bool add(Edges *sum, const Edges &edge) {
+        sum->left += edge.left;
+        sum->right += edge.right;
+        return finite(sum->left) && finite(sum->right);
+    }
+    static bool splitsSurrogate(QStringView source, int at) {
+        return at > 0 && at < source.size() && source.at(at - 1).isHighSurrogate() && source.at(at).isLowSurrogate();
+    }
+
+public:
+    // Call after validating the semantic owner, ordinary glyph/action formats,
+    // source revision and installed cursors. This object belongs to the current
+    // layout/device pass. A change to either requires fresh measurements.
+    template <typename PixelScale>
+    static bool build(const QList<SourceBoxNode> &source, const QPaintDevice *device,
+                      PixelScale pixelScale, SourceBoxTree *result) {
+        if (!result || source.isEmpty() || source.size() > (1 << 20)) return false;
+        SourceBoxTree tree;
+        tree.m_device = device;
+        tree.m_nodes.reserve(source.size());
+        QList<int> active;
+        const Box &root = source.first().box;
+        if (!root.document || root.first < 0 || root.last <= root.first || root.source.size() != root.last - root.first
+            || root.source.size() > (1 << 20)) return false;
+        const QStringView original(root.source);
+        for (int index = 0; index < source.size(); ++index) {
+            const auto &node = source.at(index);
+            const auto &box = node.box;
+            if (box.document != root.document || box.first < root.first || box.last > root.last || box.last <= box.first
+                || box.last - box.first != box.source.size() || splitsSurrogate(original, box.first - root.first)
+                || splitsSurrogate(original, box.last - root.first)
+                || original.sliced(box.first - root.first, box.source.size()) != QStringView(box.source)) return false;
+            if ((index == 0) != (node.parent == -1) || node.parent >= index || node.parent < -1) return false;
+            const qreal scale = pixelScale(device ? QFont(box.font, device) : box.font);
+            if (!finite(scale) || scale <= 0) return false;
+            Measured measured{node, scale, {}, {}, {}, box.first};
+            for (int side = 0; side < 4; ++side) {
+                if (!finite(box.padding[side]) || box.padding[side] < 0 || !finite(box.widths[side]) || box.widths[side] < 0
+                    || !finite((box.padding[side] + box.widths[side]) * scale)) return false;
+            }
+            // Use the same 26.6 advance as the native glyph cluster. Each
+            // owner's two ends are quantized once, independent of nesting.
+            measured.own.left = QFixed::fromReal((box.padding[3] + box.widths[3]) * scale).toReal();
+            measured.own.right = QFixed::fromReal((box.padding[1] + box.widths[1]) * scale).toReal();
+            if (node.parent >= 0) {
+                while (!active.isEmpty() && active.last() != node.parent) active.removeLast();
+                if (active.isEmpty() || active.size() >= 16) return false;
+                auto &parent = tree.m_nodes[node.parent];
+                if (box.first < parent.lastChildEnd || box.last > parent.node.box.last) return false;
+                parent.lastChildEnd = box.last;
+                if (box.first == parent.node.box.first) {
+                    measured.ancestorsAtFirst = parent.ancestorsAtFirst;
+                    if (!add(&measured.ancestorsAtFirst, parent.own)) return false;
+                }
+                if (box.last == parent.node.box.last) {
+                    measured.ancestorsAtLast = parent.ancestorsAtLast;
+                    if (!add(&measured.ancestorsAtLast, parent.own)) return false;
+                }
+            }
+            if (!add(&tree.m_boundaries[box.first].open, measured.own)
+                || !add(&tree.m_boundaries[box.last].close, measured.own)) return false;
+            tree.m_nodes.append(std::move(measured));
+            active.append(index);
+        }
+        *result = std::move(tree);
+        return true;
+    }
+
+    // The caller supplies the native shaped cluster's exact half-open source
+    // interval. An owner boundary cutting the cluster needs a shaping break.
+    // A shared end/start at one boundary charges only the participating side.
+    bool clusterEdges(int first, int last, bool rightToLeft, qreal *left, qreal *right) const {
+        if (m_nodes.isEmpty() || !left || !right || last <= first || first < m_nodes.first().node.box.first
+            || last > m_nodes.first().node.box.last) return false;
+        const auto interior = m_boundaries.upperBound(first);
+        if (interior != m_boundaries.cend() && interior.key() < last) return false;
+        const auto opening = m_boundaries.value(first).open;
+        const auto closing = m_boundaries.value(last).close;
+        *left = rightToLeft ? closing.left : opening.left;
+        *right = rightToLeft ? opening.right : closing.right;
+        return true;
+    }
+
+    // Supply only the root's real source intersection with the native line.
+    // visualRun maps that interval to its actual visual edges. It may refuse
+    // noncontiguous bidi projections; reversing raw UTF-16 positions is never
+    // a substitute for the text engine's visual run geometry.
+    template <typename VisualRun>
+    bool lineSlices(int first, int last, int line, qreal baseline, VisualRun visualRun,
+                    QList<SourceBoxLineSlice> *output) const {
+        if (m_nodes.isEmpty() || !output || line < 0 || !finite(baseline) || first >= last
+            || first < m_nodes.first().node.box.first || last > m_nodes.first().node.box.last) return false;
+        QList<SourceBoxLineSlice> slices;
+        const auto append = [&](int index) {
+            const auto &measured = m_nodes.at(index);
+            const Box &box = measured.node.box;
+            const int begin = qMax(first, box.first), end = qMin(last, box.last);
+            SourceBoxVisualRun run{};
+            if (begin >= end || !visualRun(begin, end, &run) || !finite(run.firstX) || !finite(run.lastX)
+                || (run.rightToLeft ? run.firstX < run.lastX : run.firstX > run.lastX)) return false;
+            const bool atFirst = begin == box.first, atLast = end == box.last;
+            const bool hasLeft = run.rightToLeft ? atLast : atFirst;
+            const bool hasRight = run.rightToLeft ? atFirst : atLast;
+            const Edges &outerLeft = run.rightToLeft ? measured.ancestorsAtLast : measured.ancestorsAtFirst;
+            const Edges &outerRight = run.rightToLeft ? measured.ancestorsAtFirst : measured.ancestorsAtLast;
+            const qreal left = qMin(run.firstX, run.lastX) + (hasLeft ? outerLeft.left : 0);
+            const qreal right = qMax(run.firstX, run.lastX) - (hasRight ? outerRight.right : 0);
+            Slice geometry;
+            if (!slice(box, left, right, baseline, measured.scale, m_device, hasLeft, hasRight, &geometry)) return false;
+            slices.append({index, begin, end, {box, geometry, line}});
+            return true;
+        };
+        // Source preorder is nondecreasing in first. Visit only open ancestors
+        // and owners which start on the line, in their original paint order.
+        const auto firstNew = std::lower_bound(m_nodes.cbegin(), m_nodes.cend(), first,
+            [](const Measured &node, int start) { return node.node.box.first < start; });
+        int index = int(firstNew - m_nodes.cbegin());
+        QList<int> carry;
+        for (int prior = index - 1; prior >= 0; prior = m_nodes.at(prior).node.parent)
+            if (m_nodes.at(prior).node.box.last > first) carry.append(prior);
+        for (auto it = carry.crbegin(); it != carry.crend(); ++it) if (!append(*it)) return false;
+        for (; index < m_nodes.size() && m_nodes.at(index).node.box.first < last; ++index)
+            if (!append(index)) return false;
+        *output = std::move(slices);
+        return true;
+    }
+};
