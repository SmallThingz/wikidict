+double QTextDocumentLayout::wikidictFigureContentWidth(int objectPosition) const
+{
+    if (objectPosition < 0 || objectPosition >= document()->characterCount() - 1
+            || document()->characterAt(objectPosition) != QChar::ObjectReplacementCharacter) return -1;
+    Q_D(const QTextDocumentLayout);
+    // Intrinsic-size handlers call this during layout. Constructing a cursor
+    // would compute its visual X and recursively request logical layout.
+    QTextFrame *frame = d->document->frameAt(objectPosition);
+    if (!frame || frame->frameFormat().stringProperty(QTextFormat::UserProperty + 0x57a0) != QStringLiteral("wikidict.figure-layout/1")
+            || frame->frameFormat().stringProperty(QTextFormat::UserProperty + 0x57a4) != QStringLiteral("image")) return -1;
+    return data(frame)->wikidictFigureContentWidth;
+}
