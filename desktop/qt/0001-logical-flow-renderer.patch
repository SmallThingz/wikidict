+struct Columns {
+    // Logical order. The containing flow mirrors positions as a group for RTL;
+    // it must not reverse source ranges or independently reorder annotations.
+    QList<qreal> widths;
+    QList<qreal> starts;
+    qreal advance = 0;
+};
+
+// Two Fenwick sums support range increments and range sums, so deeply nested
+// spanning constraints do not turn a bounded typed record into quadratic work.
+class WidthSums
+{
+public:
+    explicit WidthSums(qsizetype count) : first(count + 2, 0), second(count + 2, 0) {}
+    void add(qsizetype begin, qsizetype end, qreal value)
+    {
+        update(first, begin + 1, value);
+        update(first, end + 1, -value);
+        update(second, begin + 1, value * begin);
+        update(second, end + 1, -value * end);
+    }
+    qreal sum(qsizetype begin, qsizetype end) const { return prefix(end) - prefix(begin); }
+private:
+    QList<qreal> first, second;
+    static void update(QList<qreal> &tree, qsizetype index, qreal value)
+    {
+        for (; index < tree.size(); index += index & -index) tree[index] += value;
+    }
+    static qreal query(const QList<qreal> &tree, qsizetype index)
+    {
+        qreal value = 0;
+        for (; index > 0; index -= index & -index) value += tree[index];
+        return value;
+    }
+    qreal prefix(qsizetype end) const
+    { return query(first, end) * end - query(second, end); }
+};
+
+// Gaps are measured/collapsed by the containing Ruby whitespace stage. This
+// solver never converts a logical gap to a base or invents a break opportunity.
+// Process narrower spans first; each deficit is divided over its columns.
+inline std::optional<Columns> columns(const QList<qreal> &baseAdvances,
+                                     const QList<qreal> &gapsBefore,
+                                     const QList<AnnotationWidth> &annotations)
+{
+    const qsizetype count = baseAdvances.size();
+    if (!count || gapsBefore.size() != count || gapsBefore.first() != 0)
+        return std::nullopt;
+    QList<qreal> gapPrefix(count + 1, 0);
+    WidthSums widths(count);
+    for (qsizetype i = 0; i < count; ++i) {
+        if (!length(baseAdvances[i]) || !length(gapsBefore[i])) return std::nullopt;
+        widths.add(i, i + 1, baseAdvances[i]);
+        gapPrefix[i + 1] = gapPrefix[i] + gapsBefore[i];
+        if (!length(gapPrefix[i + 1])) return std::nullopt;
+    }
+    QList<qsizetype> order;
+    for (qsizetype i = 0; i < annotations.size(); ++i) {
+        const auto &a = annotations[i];
+        if (a.first < 0 || a.count <= 0 || a.first >= count || a.count > count - a.first
+            || !length(a.advance)) return std::nullopt;
+        if (!a.hidden) order.append(i);
+    }
+    std::stable_sort(order.begin(), order.end(), [&](qsizetype a, qsizetype b) {
+        return annotations[a].count < annotations[b].count;
+    });
+    for (qsizetype index : order) {
+        const auto &a = annotations[index];
+        const qsizetype end = a.first + a.count;
+        const qreal gaps = gapPrefix[end] - gapPrefix[a.first + 1];
+        const qreal available = widths.sum(a.first, end) + gaps;
+        if (!length(available)) return std::nullopt;
+        if (a.advance > available) widths.add(a.first, end, (a.advance - available) / a.count);
+    }
+    Columns result;
+    result.widths.reserve(count); result.starts.reserve(count);
+    for (qsizetype i = 0; i < count; ++i) {
+        const qreal width = widths.sum(i, i + 1);
+        if (!length(width)) return std::nullopt;
+        result.advance += gapsBefore[i];
+        result.starts.append(result.advance);
+        result.widths.append(width);
+        result.advance += width;
+        if (!length(result.advance)) return std::nullopt;
+    }
+    return result;
+}
