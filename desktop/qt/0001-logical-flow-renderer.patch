+bool QTextDocumentLayoutPrivate::checkedFlexBox(QTextFrame *frame, QFixedPoint borderPosition,
+    QFixedSize borderSize, WikidictFloatExclusion *box) const
+{
+    const auto values = frame->frameFormat().property(WikidictContainerMargins).toMap().value(QStringLiteral("edges")).toList();
+    if (values.size() != 4 || borderSize.width < 0 || borderSize.height < 0) return false;
+    qint64 side[4];
+    for (int i = 0; i < 4; ++i) {
+        const qreal scaled = scaleToDevice(values[i].toDouble());
+        if (values[i].metaType().id() != QMetaType::Double || !qIsFinite(scaled) || qAbs(scaled) >= qreal(QFIXED_MAX) / 8) return false;
+        side[i] = QFixed::fromReal(scaled).value();
+    }
+    const qint64 x = qint64(borderPosition.x.value()) - side[3], y = qint64(borderPosition.y.value()) - side[0];
+    const qint64 width = qMax(qint64(0), qint64(borderSize.width.value()) + side[1] + side[3]);
+    const qint64 height = qMax(qint64(0), qint64(borderSize.height.value()) + side[0] + side[2]);
+    const qint64 limit = qint64(QFIXED_MAX) * 64;
+    if (qAbs(x) > limit || qAbs(y) > limit || width > limit || height > limit
+        || qAbs(x + width) > limit || qAbs(y + height) > limit) return false;
+    *box = {frame, {QFixed::fromFixed(int(x)), QFixed::fromFixed(int(y))},
+        {QFixed::fromFixed(int(width)), QFixed::fromFixed(int(height))}, frame->frameFormat().position()};
+    return true;
+}
