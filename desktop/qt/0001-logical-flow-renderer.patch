+bool QTextDocumentLayoutPrivate::tableIntrinsicSubtree(QTextFrame *frame)
+{
+    auto &known = tableIntrinsicEpoch->eligible;
+    const auto found = known.constFind(frame);
+    if (found != known.cend()) return *found;
+    // Resource/custom-object callbacks and non-table formatting contexts keep
+    // the original path. No resource-generation/reentrant callback assumption
+    // is made merely from QTextDocument::revision().
+    auto *table = qobject_cast<QTextTable *>(frame);
+    if (!table) {
+        const bool eligible = tableIntrinsicImageFrame(frame);
+        known.insert(frame, eligible); return eligible;
+    }
+    bool eligible = frame->frameFormat().position() == QTextFrameFormat::InFlow
+        && frame->frameFormat().stringProperty(WikidictTableBoxOwner) == QStringLiteral("wikidict.table-box/1")
+        && !frame->frameFormat().hasProperty(WikidictTableViewport)
+        && !frame->frameFormat().hasProperty(WikidictTableViewportGrid)
+        && !frame->frameFormat().hasProperty(WikidictTableFloatViewport)
+        && !frame->frameFormat().hasProperty(WikidictContainerFlex)
+        && !frame->frameFormat().hasProperty(WikidictContainerFlexItem)
+        && !wikidictFigureTableCaptionFrame(frame);
+    for (auto it = frame->begin(); eligible && !it.atEnd(); ++it) {
+        if (auto *child = it.currentFrame()) eligible = tableIntrinsicSubtree(child);
+        else if (const auto block = it.currentBlock(); block.isValid()) {
+            eligible = !block.blockFormat().hasProperty(WikidictAuthoredRule);
+            if (const auto flow = logicalFlowAt(block.position())) {
+                eligible &= flow->current();
+                for (const auto &unit : flow->sourceMap())
+                    eligible &= unit.kind == QTextLogicalFlowProjection::Kind::Text;
+            }
+            for (auto fragment = block.begin(); eligible && !fragment.atEnd(); ++fragment) {
+                const auto text = fragment.fragment();
+                eligible = (text.charFormat().objectType() == QTextFormat::NoObject
+                    && !text.text().contains(QChar::ObjectReplacementCharacter))
+                    || tableIntrinsicImage(text, frame);
+            }
+        }
+    }
+    known.insert(frame, eligible);
+    return eligible;
+}
+
+bool QTextDocumentLayoutPrivate::tableIntrinsicContext(QTextTable *table)
+{
+    if (!tableIntrinsicEpochCurrent() || paragraphBoxError || document->pageSize().height() > 0
+        || !wikidictFitMeasuring.isEmpty() || !wikidictFlexMeasuring.isEmpty()) return false;
+    const auto *td = static_cast<QTextTableData *>(data(table));
+    if (!qIsFinite(td->wikidictContainingWidth)) return false;
+    for (auto *owner = static_cast<QTextFrame *>(table); owner; owner = owner->parentFrame()) {
+        if (owner != document->rootFrame()
+            && (!qobject_cast<QTextTable *>(owner)
+                || owner->frameFormat().position() != QTextFrameFormat::InFlow)) return false;
+        const auto *fd = data(owner);
+        if (!fd->floats.isEmpty()) return false;
+        if (const auto *flow = fd->currentLayoutStruct)
+            if (!flow->inheritedExclusions.isEmpty() || !flow->exportedExclusions.isEmpty()) return false;
+    }
+    return tableIntrinsicSubtree(table);
+}
