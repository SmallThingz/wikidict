+    if (!projectedDocument || !layoutData || position < 0
+        || position > layoutData->string.size())
+        return false;
+    const auto syntheticIsolate = [this](int at) {
+        if (at < 0 || at >= layoutData->string.size()
+            || at >= projectedSourcePositions.size() || projectedSourcePositions.at(at) >= 0)
+            return false;
+        const ushort ch = layoutData->string.at(at).unicode();
+        return ch >= 0x2066 && ch <= 0x2069; // LRI/RLI/FSI/PDI only.
+    };
+    int before = position - 1;
+    int after = position;
+    while (syntheticIsolate(before)) --before;
+    while (syntheticIsolate(after)) ++after;
+    const auto left = projectedRubyMetrics().constFind(before);
+    const auto right = projectedRubyMetrics().constFind(after);
+    return (left == projectedRubyMetrics().cend() || (left->valid() && left->breakAfter))
+        && (right == projectedRubyMetrics().cend() || (right->valid() && right->breakBefore));
+}
