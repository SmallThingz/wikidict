+            const int boundary = baseGap ? gap.beforeBase : description.readings[gap.beforeReading].firstBase;
+            const qreal available = sharedGaps[boundary];
+            if (box.shaped->advance > available) return false;
+            const auto &following = boxes[size_t(target)];
+            box.width = box.shaped->advance;
+            box.x = description.direction == Qt::LeftToRight
