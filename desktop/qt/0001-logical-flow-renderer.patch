+static bool wikidictInlineActionContains(const QTextLayout *layout, int position, const QPointF &point)
+{
+    auto *engine = layout->engine();
+    if (!engine->layoutData || position < 0 || position >= engine->layoutData->string.size()) return true;
+    const int index = engine->findItem(position);
+    if (index < 0 || index >= engine->layoutData->items.size()) return true;
+    const auto &item = engine->layoutData->items[index]; const auto format = engine->format(&item);
+    if (!QCompiledInline::actionOwner(format).isValid()) return true;
+    QRectF rect;
+    if (!qt_textInlineCursorRect(layout, position, 0, &rect, true)) {
+        const auto line = layout->lineForTextPosition(position);
+        if (!line.isValid() || item.analysis.flags >= QScriptAnalysis::TabOrObject) return false;
+        const auto *font = engine->fontEngine(item);
+        const qreal shift = QCompiledInline::baseline(format, font->ascent() + font->descent(),
+            QCompiledInline::deviceScale(engine->font(item))).toReal();
+        const qreal a = line.cursorToX(position), b = line.cursorToX(position, QTextLine::Trailing);
+        rect = QRectF(qMin(a, b), line.y() + line.ascent() - font->ascent().toReal() + shift,
+            qAbs(a - b), (font->ascent() + font->descent()).toReal());
