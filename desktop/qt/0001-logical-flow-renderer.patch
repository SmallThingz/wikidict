+            const auto fragment = it.fragment(); const auto format = fragment.charFormat();
+            if (!format.hasProperty(QCompiledReference::CitationProperty)) continue;
+            const auto raw = format.property(QCompiledReference::CitationProperty);
+            QCompiledReference::Citation citation;
+            if (!fragment.isValid() || !QCompiledReference::citation(raw, &citation)
+                || format.objectType() != QTextFormat::NoObject || !format.isAnchor()
+                || format.anchorHref() != QStringLiteral("dict:#") + citation.span.value(QStringLiteral("target_fragment")).toString()
+                || (format.hasProperty(WikidictFigureLinkOwner)
+                    && format.property(WikidictFigureLinkOwner) != QVariant::fromValue(citation.owner))) return fail(fragment.position());
+            auto found = citations.find(citation.owner);
+            if (found == citations.end()) {
+                citations.insert(citation.owner, {raw, fragment.position(), fragment.position() + fragment.length(), fragment.text(), format.anchorHref()});
+            } else {
+                if (found->raw != raw || found->last != fragment.position() || found->href != format.anchorHref()
