+    const auto valueAutos = policy.value(QStringLiteral("autos"));
+    if (value.metaType().id() != QMetaType::QVariantMap || policy.size() != 3
+        || capability.metaType().id() != QMetaType::QString
+        || capability.toString() != QStringLiteral("wikidict.table-auto-margins/1")
+        || direction.metaType().id() != QMetaType::Int || direction.toInt() < int(Qt::LeftToRight)
+        || direction.toInt() > int(Qt::RightToLeft)
+        || valueAutos.metaType().id() != QMetaType::QVariantList) return false;
+    const auto autos = valueAutos.toList();
+    if (autos.size() != 4) return false;
+    for (const auto &automatic : autos)
+        if (automatic.metaType().id() != QMetaType::Bool) return false;
+    bool cornerNumeric = format.hasProperty(WikidictTableCornerRadii);
+    if (!cornerNumeric && format.stringProperty(WikidictTableBoxOwner) == QStringLiteral("wikidict.empty-table/1")
+        && format.stringProperty(QTextFormat::UserProperty + 0x57d4) == QStringLiteral("wrapper")) {
+        const auto children = frame->childFrames();
+        if (!children.isEmpty()) {
+            const auto child = children.constLast()->frameFormat();
+            cornerNumeric = child.stringProperty(WikidictTableBoxOwner) == QStringLiteral("wikidict.empty-table/1")
+                && child.stringProperty(QTextFormat::UserProperty + 0x57d4) == QStringLiteral("grid")
+                && child.hasProperty(WikidictTableCornerRadii);
+        }
+    }
+    return !autos[0].toBool() && !autos[2].toBool() && (autos[1].toBool() || autos[3].toBool() || cornerNumeric);
