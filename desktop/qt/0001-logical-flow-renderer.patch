+// Single-line child shaped by the same source-mapped Qt engine used for the
+// containing logical flow. All positions crossing this boundary are document UTF-16.
+class QTextRubyChildFlow final : public QTextRubyLayout::Composite {
+public:
+    QTextRubyChildFlow(QTextDocument *doc, std::unique_ptr<QTextLogicalFlowProjection> projection)
+        : document(doc), flow(std::move(projection)) {}
+    QTextLayout *textLayout() const override { return flow->textLayout(); }
+    int documentOffset(int projected) const override {
+        return projected >= 0 && projected < flow->sourceMap().size() ? flow->sourceMap().at(projected).first : -1;
+    }
+    qreal advance() const override { return line().horizontalAdvance(); }
+    qreal top() const override {
+        qreal result = -line().ascent();
+        for (const auto &ruby : flow->measuredRubyObjects())
+            result = qMin(result, ruby.measured->metrics().occupiedTop.toReal());
+        return result;
+    }
+    qreal bottom() const override {
+        qreal result = line().descent();
+        for (const auto &ruby : flow->measuredRubyObjects())
+            result = qMax(result, ruby.measured->metrics().occupiedBottom.toReal());
+        return result;
+    }
+    void draw(QPainter *painter, QPointF baseline, const QList<QTextRubyLayout::PaintSelection> &selections) const override {
+        const QPointF origin = baseline - QPointF(0, line().ascent());
+        QList<QTextLayout::FormatRange> local;
+        QAbstractTextDocumentLayout::PaintContext context;
+        for (const auto &selection : selections) {
+            for (const auto &range : flow->selectionRanges(selection.source.first, selection.source.last))
+                local.append({range.start, range.length, selection.format});
+            QTextCursor cursor(document);
+            cursor.setPosition(selection.source.first); cursor.setPosition(selection.source.last, QTextCursor::KeepAnchor);
+            context.selections.append({cursor, selection.format});
+        }
+        flow->textLayout()->draw(painter, origin, local);
+        flow->drawRuby(painter, origin, context, 0);
+    }
+    int hitTest(QPointF point, Qt::HitTestAccuracy accuracy) const override {
+        return flow->hitTest(point + QPointF(0, line().ascent()), accuracy);
+    }
+    QRectF cursorRect(int position, qreal width) const override {
+        return relative(flow->cursorRect(position, width));
+    }
+    QRectF characterRect(int position) const override {
+        if (flow->isRubyPosition(position)) return relative(flow->rubyCharacterRect(position));
+        const auto *layout = flow->textLayout();
+        const int index = flow->toProjected(position);
+        if (index < 0 || index >= layout->text().size()) return {};
+        const int start = layout->isValidCursorPosition(index) ? index : layout->previousCursorPosition(index);
+        const int end = layout->nextCursorPosition(start);
+        const auto rects = projectedRects(start, end);
+        QRectF result; for (const auto &rect : rects) result = result.united(rect);
+        return result;
+    }
+    int visualMove(int pos, bool right) const override { return flow->visualMove(pos, right); }
+    int logicalMove(int pos, bool forward) const override { return flow->logicalMove(pos, forward); }
+    QList<QRectF> selectionRects(int first, int last) const override {
+        QList<QRectF> result;
+        for (const auto &r : flow->rubySelectionRects(first, last)) result.append(relative(r));
+        for (const auto &r : flow->selectionRanges(first, last)) result.append(projectedRects(r.start, r.start + r.length));
+        return result;
+    }
+    QRectF actionRect(int position) const override { return relative(flow->rubyActionRect(position)); }
+    QList<QTextRubyLayout::LinkBox> linkBoxes() const override {
+        auto result = flow->rubyLinkBoxes();
+        for (auto &box : result) box.rect = relative(box.rect);
+        const auto *priv = QTextDocumentPrivate::get(document);
+        const auto &units = flow->sourceMap();
+        for (int i = 0; i < units.size();) {
+            if (units[i].kind != QTextLogicalFlowProjection::Kind::Text) { ++i; continue; }
+            const auto fragment = priv->find(units[i].first);
+            const auto format = priv->formatCollection()->charFormat(fragment.value()->format);
+            const int start = i++;
+            while (i < units.size() && units[i].kind == QTextLogicalFlowProjection::Kind::Text
+                   && units[i].first == units[i - 1].last && priv->find(units[i].first) == fragment) ++i;
+            if (!format.isAnchor() || format.anchorHref().isEmpty()) continue;
+            for (const auto &r : projectedRects(start, i)) result.append({r, format});
+        }
+        return result;
+    }
+private:
+    QTextLine line() const { return flow->textLayout()->lineAt(0); }
+    QRectF relative(QRectF r) const { return r.isEmpty() ? QRectF() : r.translated(0, -line().ascent()); }
+    QList<QRectF> projectedRects(int start, int end) const {
+        QList<QRectF> result;
+        for (const auto &run : line().glyphRuns(start, end - start)) {
+            const auto r = relative(run.boundingRect()); if (!r.isEmpty()) result.append(r);
+        }
+        if (result.isEmpty() && start < end) {
+            const qreal a = line().cursorToX(start), b = line().cursorToX(end);
+            result.append(QRectF(qMin(a,b), -line().ascent(), qAbs(a-b), line().height()));
+        }
