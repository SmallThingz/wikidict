+// mandatory for document admission and each paint/slice census; a successful
+// metrics parse is not permission to draw or admit the source policy.
+inline bool parseMetrics(const QVariant &raw, Box *out) { return parseImpl(raw, out, false); }
+inline bool nestedBoxes(const Box &box, QList<Box> *out,
+                        const QList<QPair<int, QJsonObject>> *sourceChildren)
+{
+    if (out) out->clear();
+    if (!box.identity.contains("nestedChildren")) return !sourceChildren || sourceChildren->isEmpty();
+    const auto raw = box.identity.value("nestedChildren");
+    if (raw.metaType().id() != QMetaType::QVariantList || raw.toList().isEmpty() || raw.toList().size() > 2
+        || !hasBorderSource(box) || hasAction(box) || box.identity.contains("radius") || box.identity.contains("background")
+        || (sourceChildren && sourceChildren->size() != raw.toList().size())) return false;
+    int previousLast = -1, index = 0;
+    for (const auto &value : raw.toList()) {
