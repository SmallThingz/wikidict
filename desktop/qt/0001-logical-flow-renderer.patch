+bool QTextDocumentLayoutPrivate::opaqueTraversalBackground(const QTextFrame::Iterator &it,
+                                                          const QFixedPoint &point) const
+{
+    const auto opaque = [](const QBrush &brush) {
+        return brush.style() == Qt::SolidPattern && brush.color().alpha() == 255;
+    };
+    if (auto *frame = it.currentFrame()) {
+        const auto *fd = data(frame);
+        const auto format = frame->frameFormat();
+        if (fd->layoutDirty || !opaque(format.background())) return false;
+        const bool physical = wikidictHasTableBorderEdges(format);
+        WikidictPhysicalEdges edges;
+        if (physical && !wikidictTableBorderEdges(format, &edges)) return false;
+        const auto border = [&](int side) { return physical
+            ? QFixed::fromReal(scaleToDevice(edges.width[side])).round().toReal() : fd->borderInset(side).toReal(); };
+        const QRectF allocation(fd->position.toPointF(), fd->size.toSizeF());
+        if (format.hasProperty(WikidictTableCornerRadii)
+            && format.property(WikidictTableCornerRadii).toList() != QVariantList{0.0, 0.0, 0.0, 0.0}) {
+            const QRectF box = allocation.adjusted(fd->leftMargin.toReal(), fd->topMargin.toReal(),
+                -fd->rightMargin.toReal(), -fd->bottomMargin.toReal());
+            WikidictTableCorners radii; QPainterPath outer, inner;
+            return wikidictTableCorners(format, &radii)
+                && wikidictTableCornerPaths(box, radii, scaleToDevice(1), border(0), &outer, &inner)
+                && outer.contains(point.toPointF());
+        }
+        return allocation.adjusted(fd->leftMargin.toReal() + border(3), fd->topMargin.toReal() + border(0),
+            -fd->rightMargin.toReal() - border(1), -fd->bottomMargin.toReal() - border(2)).contains(point.toPointF());
+    }
+    const auto block = it.currentBlock();
+    if (!block.isValid() || !block.isVisible() || logicalFlowAt(block.position())) return false;
+    const auto format = block.blockFormat();
+    if (!opaque(format.background()) || format.hasProperty(QTextFormat::BlockTrailingHorizontalRulerWidth)) return false;
+    const auto *layout = block.layout();
+    QRectF box = layout->boundingRect().translated(layout->position());
+    if (it.parentFrame() == docPrivate->rootFrame() && document->pageSize().width() <= 0) {
+        const auto *root = data(docPrivate->rootFrame());
+        box.setRight((root->size.width - root->rightMargin).toReal());
+    }
+    return box.contains(point.toPointF());
