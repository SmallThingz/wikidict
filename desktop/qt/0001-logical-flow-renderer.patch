+static WikidictRuleStyle wikidictRuleStyle(const QTextBlockFormat &format)
+{
+    WikidictRuleStyle result;
+    const auto value = format.property(WikidictAuthoredRule);
+    const auto policy = value.toMap();
+    const auto capability = policy.value(QStringLiteral("capability"));
+    const auto source = policy.value(QStringLiteral("source"));
+    const auto em = policy.value(QStringLiteral("em"));
+    const auto dark = policy.value(QStringLiteral("dark"));
+    const auto height = policy.value(QStringLiteral("height"));
+    const auto fill = policy.value(QStringLiteral("fill"));
+    const auto margins = policy.value(QStringLiteral("margins"));
+    const bool hasClear = policy.contains(QStringLiteral("clear"));
+    const auto clearValue = policy.value(QStringLiteral("clear"));
+    if (hasClear && (clearValue.metaType().id() != QMetaType::Int || clearValue.toInt() < 0 || clearValue.toInt() > 3)) return result;
+    if (value.metaType().id() != QMetaType::QVariantMap || policy.size() != (hasClear ? 8 : 7)
+        || capability.metaType().id() != QMetaType::QString || capability.toString() != (hasClear
+            ? QStringLiteral("wikidict.authored-rule-clear/1") : QStringLiteral("wikidict.authored-rule/1"))
+        || source.metaType().id() != QMetaType::QByteArray || em.metaType().id() != QMetaType::Double
+        || !qIsFinite(em.toDouble()) || em.toDouble() <= 0 || dark.metaType().id() != QMetaType::Bool
+        || height.metaType().id() != QMetaType::Double || fill.metaType().id() != QMetaType::QColor
+        || margins.metaType().id() != QMetaType::QVariantList || margins.toList().size() != 4) return result;
+    const auto json = QJsonDocument::fromJson(source.toByteArray());
+    if (!json.isObject() || json.toJson(QJsonDocument::Compact) != source.toByteArray()) return result;
+    const auto block = json.object();
+    const QStringList blockKeys{QStringLiteral("kind"), QStringLiteral("depth"), QStringLiteral("level"),
+        QStringLiteral("spans"), QStringLiteral("list_path"), QStringLiteral("number"), QStringLiteral("anchor"),
+        QStringLiteral("anchor_fallback"), QStringLiteral("feature"), QStringLiteral("table"), QStringLiteral("figure"),
+        QStringLiteral("flow"), QStringLiteral("container"), QStringLiteral("style"), QStringLiteral("text_align"), QStringLiteral("rule_style")};
+    for (auto it = block.begin(); it != block.end(); ++it) if (!blockKeys.contains(it.key())) return result;
+    if (block.value(QStringLiteral("kind")) != QStringLiteral("rule")) return result;
+    for (const auto &key : {QStringLiteral("depth"), QStringLiteral("level")}) {
+        const auto field = block.value(key);
+        if (!field.isUndefined() && (!field.isDouble() || field.toDouble() != 0)) return result;
+    }
+    for (const auto &key : {QStringLiteral("spans")}) {
+        const auto field = block.value(key);
+        if (!field.isUndefined() && (!field.isArray() || !field.toArray().isEmpty())) return result;
+    }
+    for (const auto &key : {QStringLiteral("list_path"), QStringLiteral("number"), QStringLiteral("anchor"), QStringLiteral("anchor_fallback")}) {
+        const auto field = block.value(key);
+        if (!field.isUndefined() && (!field.isString() || !field.toString().isEmpty())) return result;
+    }
+    for (const auto &key : {QStringLiteral("feature"), QStringLiteral("table"), QStringLiteral("figure"),
+            QStringLiteral("flow"), QStringLiteral("container"), QStringLiteral("style"), QStringLiteral("text_align")}) {
+        const auto field = block.value(key);
+        if (!field.isUndefined() && !field.isNull()) return result;
+    }
+    const auto styleValue = block.value(QStringLiteral("rule_style")); const auto style = styleValue.toObject();
+    if (!styleValue.isObject() || style.size() != (style.contains(QStringLiteral("clear")) ? 4 : 3)
+        || !style.contains(QStringLiteral("height")) || !style.contains(QStringLiteral("fill"))
+        || !style.contains(QStringLiteral("margins"))) return result;
+    const auto sourceClear = style.value(QStringLiteral("clear"));
+    const bool sourceHasClear = !sourceClear.isUndefined() && !sourceClear.isNull();
+    if (sourceHasClear != hasClear) return result;
+    if (hasClear) {
+        if (!sourceClear.isString()) return result;
+        result.clear = QStringList{QStringLiteral("none"), QStringLiteral("left"), QStringLiteral("right"),
+            QStringLiteral("both")}.indexOf(sourceClear.toString());
+        if (result.clear < 0 || result.clear != clearValue.toInt()) return result;
+    }
+    const auto resolve = [&](const QJsonValue &input, qreal *output) {
+        const auto length = input.toObject(); const auto unit = length.value(QStringLiteral("unit"));
+        const auto number = length.value(QStringLiteral("value"));
+        if (!input.isObject() || length.size() != 2 || !unit.isString()
+            || (unit != QStringLiteral("px") && unit != QStringLiteral("em")) || !number.isDouble()
+            || !qIsFinite(number.toDouble()) || number.toDouble() < 0 || number.toDouble() > std::numeric_limits<float>::max()) return false;
+        *output = number.toDouble() * (unit == QStringLiteral("em") ? em.toDouble() : 1);
+        return qIsFinite(*output) && *output >= 0;
+    };
+    if (!resolve(style.value(QStringLiteral("height")), &result.height) || result.height != height.toDouble()) return result;
+    const auto edgesValue = style.value(QStringLiteral("margins")); const auto edges = edgesValue.toObject();
+    if (!edgesValue.isObject() || edges.size() != 4) return result;
+    const QString names[] = {QStringLiteral("top"), QStringLiteral("right"), QStringLiteral("bottom"), QStringLiteral("left")};
+    const auto expectedMargins = margins.toList();
+    for (int i = 0; i < 4; ++i)
+        if (expectedMargins[i].metaType().id() != QMetaType::Double || !resolve(edges.value(names[i]), &result.margins[i])
+            || result.margins[i] != expectedMargins[i].toDouble()) return result;
+    const auto rgb = [](const QJsonValue &input) {
+        const auto text = input.toString();
+        if (!input.isString() || text.size() != 7 || text.front() != QChar('#')) return QColor();
+        for (const auto c : text.mid(1))
+            if (!((c >= QChar('0') && c <= QChar('9')) || (c >= QChar('a') && c <= QChar('f')))) return QColor();
+        return QColor(text);
+    };
+    const auto colorValue = style.value(QStringLiteral("fill")); const auto color = colorValue.toObject();
+    if (!colorValue.isObject() || color.size() != 1) return result;
+    if (color.contains(QStringLiteral("transparent"))) {
+        const auto payload = color.value(QStringLiteral("transparent"));
+        if (!payload.isObject() || !payload.toObject().isEmpty()) return result;
+        result.fill = QColor(Qt::transparent);
+    } else if (color.contains(QStringLiteral("rgb"))) result.fill = rgb(color.value(QStringLiteral("rgb")));
+    else if (color.contains(QStringLiteral("light_dark"))) {
+        const auto pairValue = color.value(QStringLiteral("light_dark")); const auto pair = pairValue.toObject();
+        if (!pairValue.isObject() || pair.size() != 2) return result;
+        const auto light = rgb(pair.value(QStringLiteral("light"))), darkColor = rgb(pair.value(QStringLiteral("dark")));
+        if (!light.isValid() || !darkColor.isValid()) return result;
+        result.fill = dark.toBool() ? darkColor : light;
+    }
+    if (!result.fill.isValid() || result.fill != fill.value<QColor>()) return result;
+    result.valid = true;
+    return result;
+}
 
