+{
+    auto *fd = data(frame); auto *pd = data(frame->parentFrame());
+    auto *flow = pd->currentLayoutStruct;
+    if (!flow || line || fd->sizeDirty) { refuseParagraphBox(1, frame->firstPosition()); return; }
