+#define QTEXTRUBYSHAPING_P_H
+#include "qtextrubygeometry_p.h"
+// Future implementation in the EXISTING native logical-flow layout, alongside
+// qtextrubygeometry_p.h. Private, unregistered, uncompiled source fragment.
+// Measures one flat child; the caller still owns nested Ruby, used line metrics,
+// inter-child whitespace, ordinary breaks and filtered cluster distribution.
+#include <QtGui/qfontmetrics.h>
+#include <QtGui/qglyphrun.h>
+#include <QtGui/qrawfont.h>
+#include <QtGui/qtextlayout.h>
+#include <limits>
+#include <memory>
+
+QT_BEGIN_NAMESPACE
