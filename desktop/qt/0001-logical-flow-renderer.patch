+    if (!engine->layoutData) return true;
+    const int index = engine->findItem(position);
+    if (index < 0 || index >= engine->layoutData->items.size()
+        || !engine->format(&engine->layoutData->items[index]).hasProperty(QCompiledInline::ImageAlignmentProperty)) return true;
+    QRectF rect;
