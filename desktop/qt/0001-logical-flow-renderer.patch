+
+// Flex grow is zero. Negative free space is distributed by the unscaled basis;
+// a frozen min/max constraint restarts the remaining row, never equal-fills it.
+static bool wikidictFlexWidths(QList<WikidictFlexMeasure> *items, qreal available)
+{
+    if (!qIsFinite(available) || available < 0) return false;
+    for (auto &item : *items) {
+        item.used = qBound(item.minimum, item.basis, item.cap);
+        item.frozen = item.style.none || item.basis < item.used;
+    }
+    qreal hypothetical = 0;
+    for (const auto &item : std::as_const(*items)) hypothetical += item.used + item.inset + item.margins[1] + item.margins[3];
+    if (hypothetical < available) return true;
+    for (qsizetype pass = 0; pass <= items->size(); ++pass) {
+        qreal occupied = 0, weight = 0;
+        for (const auto &item : std::as_const(*items)) {
+            occupied += (item.frozen ? item.used : item.basis) + item.inset + item.margins[1] + item.margins[3];
+            if (!item.frozen) weight += item.basis;
+        }
+        const qreal free = available - occupied;
+        qreal totalViolation = 0;
+        QList<qreal> violations; violations.reserve(items->size());
+        for (auto &item : *items) if (!item.frozen) {
+            const qreal proposed = item.basis - (weight > 0 ? qAbs(free) * item.basis / weight : 0);
+            item.used = qBound(item.minimum, proposed, item.cap);
+            violations.append(item.used - proposed); totalViolation += item.used - proposed;
+            if (!qIsFinite(item.used) || item.used < 0) return false;
+        } else violations.append(0);
+        qsizetype newlyFrozen = 0, active = 0;
+        for (qsizetype i = 0; i < items->size(); ++i) if (!(*items)[i].frozen) {
+            ++active;
+            if (totalViolation == 0 || (totalViolation > 0 && violations[i] > 0) || (totalViolation < 0 && violations[i] < 0)) {
+                (*items)[i].frozen = true; ++newlyFrozen;
+            }
+        }
+        if (!active || newlyFrozen == active) return true;
+        if (!newlyFrozen) return false;
+    }
+    return false;
+}
