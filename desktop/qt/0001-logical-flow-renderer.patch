+// fixed heights. Ruby contributes additional leading separately; treating its
+// entire paint extent as an image strut would discard those base semantics.
+static inline bool getLineHeightParams(const QTextBlock &sourceBlock,
+        const QTextBlockFormat &blockFormat, const QTextLine &line,
+        const QTextLayout *layout, QPaintDevice *paintDevice, qreal scaling,
+        QFixed *lineAdjustment, QFixed *lineBreakHeight, QFixed *lineHeight,
+        QFixed *lineBottom, int *error)
