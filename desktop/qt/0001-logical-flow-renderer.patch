+struct Slice {
+    QRectF border, padding, content;
+    bool first = false, last = false;
+};
+struct PaintSlice { Box box; Slice geometry; int line = -1; };
+Q_GUI_EXPORT QList<PaintSlice> slices(const QTextLayout *layout, int onlyLine = -1);
+Q_GUI_EXPORT QRectF bounds(const QTextLayout *layout);
+struct OverlayPaint { Box box; Slice geometry; int line = -1; };
+inline bool overlayPaints(const QList<PaintSlice> &parts, const QList<qreal> &scales, QList<OverlayPaint> *out)
+{
+    if (!out || parts.size() != scales.size()) return false;
+    out->clear();
+    struct Owner { int first = -1, last = -1; };
+    QMap<int, Owner> owners;
+    for (int i = 0; i < parts.size(); ++i) {
+        const auto &part = parts.at(i);
+        if (!hasBorderSource(part.box) || part.box.identity.value("overlays").toList().isEmpty()) continue;
+        auto &owner = owners[part.box.first];
+        if (owner.first < 0) owner.first = i;
+        else if (part.box.identity != parts.at(owner.first).box.identity || scales.at(i) != scales.at(owner.first)
+            || part.line <= parts.at(owner.last).line) return false;
+        owner.last = i;
+    }
+    for (const auto &owner : owners) {
+        const auto &first = parts.at(owner.first), &last = parts.at(owner.last);
+        if (!first.geometry.first || !last.geometry.last) return false;
+        // Same containing block as the established empty-overlay consumer:
+        // first/last inline padding edges, without adding advance or a strut.
+        const QRectF containing = first.geometry.padding.united(last.geometry.padding);
+        const qreal scale = scales.at(owner.first);
+        for (const auto &raw : first.box.identity.value("overlays").toList()) {
+            const auto map = raw.toMap(); const auto insets = map.value("insets").toList();
+            Box border = first.box;
+            border.identity["currentColors"] = map.value("currentColors");
+            for (int side = 0; side < 4; ++side) {
+                border.widths[side] = map.value("widths").toList().at(side).toDouble();
+                border.colors[side] = map.value("colors").toList().at(side).value<QColor>();
+            }
+            const auto axis = [&](qreal origin, qreal length, int startSide, int endSide, qreal *start, qreal *extent) {
+                const auto resolve = [&](const QVariant &raw) {
+                    const auto value = raw.toMap();
+                    return value.value("value").toDouble() * (value.value("unit") == QVariant(QStringLiteral("percent")) ? length / 100 : scale);
+                };
+                const bool hasStart = insets.at(startSide).isValid(), hasEnd = insets.at(endSide).isValid();
+                if (!hasStart && !hasEnd) return false;
+                const qreal a = hasStart ? resolve(insets.at(startSide)) : 0, b = hasEnd ? resolve(insets.at(endSide)) : 0;
+                const qreal minimum = (border.widths[startSide] + border.widths[endSide]) * scale;
+                *extent = qMax(minimum, hasStart && hasEnd ? length - a - b : minimum);
+                *start = hasStart ? origin + a : origin + length - b - *extent;
+                return finite(a) && finite(b) && finite(*extent) && finite(*start) && finite(*start + *extent);
+            };
+            qreal x, y, width, height;
+            if (!finite(scale) || scale <= 0 || !axis(containing.left(), containing.width(), 3, 1, &x, &width)
+                || !axis(containing.top(), containing.height(), 0, 2, &y, &height)) return false;
+            Slice geometry; geometry.border = QRectF(x, y, width, height);
+            geometry.padding = geometry.border.adjusted(border.widths[3]*scale, border.widths[0]*scale,
+                -border.widths[1]*scale, -border.widths[2]*scale);
+            geometry.content = geometry.padding; geometry.first = geometry.last = true;
+            out->append({std::move(border), geometry, last.line});
+        }
+    }
+    return true;
+}
