+inline void paintBackground(QPainter *p, const Box &b, const Slice &s)
+{
+    if (!b.identity.contains("background")) return;
+    p->save(); p->setPen(Qt::NoPen);
+    p->setBrush(b.identity.value("background").value<QColor>());
+    p->drawRect(s.border); p->restore();
+}
+inline void paint(QPainter *p, const Box &b, const Slice &s, const QBrush &declaringInk = QBrush())
+{
+    const auto &o=s.border; const auto &i=s.padding;
+    const std::array<QPolygonF,4> edges{{
+        QPolygonF{o.topLeft(),o.topRight(),i.topRight(),i.topLeft()},
+        QPolygonF{o.topRight(),o.bottomRight(),i.bottomRight(),i.topRight()},
+        QPolygonF{o.bottomRight(),o.bottomLeft(),i.bottomLeft(),i.bottomRight()},
+        QPolygonF{o.bottomLeft(),o.topLeft(),i.topLeft(),i.bottomLeft()}}};
+    p->save();p->setPen(Qt::NoPen);
+    for(int edge=0;edge<4;++edge) {
+        const bool dynamic = hasBorderSource(b) && b.identity.value("currentColors").toList().at(edge).toBool();
+        if((edge==3&&!s.first)||(edge==1&&!s.last)||b.widths[edge]==0||(!dynamic && b.colors[edge].alpha()==0)) continue;
+        p->setBrush(dynamic ? declaringInk : QBrush(b.colors[edge]));p->drawPolygon(edges[edge]);
+    }
+    p->restore();
+}
