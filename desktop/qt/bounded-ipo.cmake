# Intentional private build difference from the Arch recipe: bound GCC LTO
# workers explicitly. Load through CMAKE_USER_MAKE_RULES_OVERRIDE, including
# compiler checks/try_compile. This is not a system CMake modification.
foreach(_wikidict_lang IN ITEMS C CXX)
    if(DEFINED CMAKE_${_wikidict_lang}_COMPILER_ID)
        if(NOT CMAKE_${_wikidict_lang}_COMPILER_ID STREQUAL "GNU")
            message(FATAL_ERROR "Private QtGui recipe requires its authenticated GNU toolchain")
        endif()
        foreach(_wikidict_kind IN ITEMS COMPILE LINK)
            set(_wikidict_variable "CMAKE_${_wikidict_lang}_${_wikidict_kind}_OPTIONS_IPO")
            if(DEFINED ${_wikidict_variable})
                set(_wikidict_flags "")
                set(_wikidict_lto_found FALSE)
                foreach(_wikidict_flag IN LISTS ${_wikidict_variable})
                    if(_wikidict_flag MATCHES "^-flto(=.*)?$")
                        list(APPEND _wikidict_flags "-flto=1")
                        set(_wikidict_lto_found TRUE)
                    else()
                        list(APPEND _wikidict_flags "${_wikidict_flag}")
                    endif()
                endforeach()
                if(_wikidict_kind STREQUAL "COMPILE" AND NOT _wikidict_lto_found)
                    message(FATAL_ERROR "GNU IPO rule has no explicit LTO option to bound")
                endif()
                set(${_wikidict_variable} "${_wikidict_flags}")
            endif()
        endforeach()
    endif()
endforeach()
unset(_wikidict_lang)
unset(_wikidict_kind)
unset(_wikidict_variable)
unset(_wikidict_flags)
unset(_wikidict_flag)
unset(_wikidict_lto_found)

# CMake's internal Ninja try_compile builder does not pass a -j limit.
# Use one shared pool so compile and link probes cannot run concurrently.
get_property(_wikidict_try_compile GLOBAL PROPERTY IN_TRY_COMPILE)
if(_wikidict_try_compile)
    set_property(GLOBAL PROPERTY JOB_POOLS "wikidict_configure_probe=1")
    set(CMAKE_JOB_POOL_COMPILE "wikidict_configure_probe")
    set(CMAKE_JOB_POOL_LINK "wikidict_configure_probe")
endif()
unset(_wikidict_try_compile)
