# Select an already qualified core for installation without changing the GUI's
# compiled headers, link inputs or expected build-tree RPATH.
set(WIKIDICT_INSTALL_CORE_PREFIX "" CACHE PATH
    "Optional qualified core prefix to install instead of the GUI's build-time core")
set(WIKIDICT_INSTALL_COMPILED_HEADER "" CACHE FILEPATH
    "Optional authenticated header from the retained GUI build, used only for install-core comparison")

function(wikidict_select_install_core default_executable default_ffi compiled_header)
    set(selected_executable "${default_executable}")
    set(selected_ffi "${default_ffi}")
    set(selected_header "")
    if(NOT WIKIDICT_INSTALL_CORE_PREFIX STREQUAL "")
        if(NOT WIKIDICT_INSTALL_COMPILED_HEADER STREQUAL "")
            if(NOT IS_ABSOLUTE "${WIKIDICT_INSTALL_COMPILED_HEADER}")
                message(FATAL_ERROR "WIKIDICT_INSTALL_COMPILED_HEADER must be absolute")
            endif()
            set(compiled_header "${WIKIDICT_INSTALL_COMPILED_HEADER}")
        endif()
        if(NOT IS_ABSOLUTE "${WIKIDICT_INSTALL_CORE_PREFIX}")
            message(FATAL_ERROR "WIKIDICT_INSTALL_CORE_PREFIX must be absolute")
        endif()
        get_filename_component(ffi_name "${default_ffi}" NAME)
        set(selected_executable "${WIKIDICT_INSTALL_CORE_PREFIX}/bin/wikidict")
        set(selected_ffi "${WIKIDICT_INSTALL_CORE_PREFIX}/lib/${ffi_name}")
        set(selected_header "${WIKIDICT_INSTALL_CORE_PREFIX}/include/dict/dict.h")
        foreach(required IN ITEMS "${selected_executable}" "${selected_ffi}"
                                  "${selected_header}" "${compiled_header}")
            if(NOT EXISTS "${required}" OR IS_DIRECTORY "${required}")
                message(FATAL_ERROR "Paired install core requires a file: ${required}")
            endif()
        endforeach()
        file(SHA256 "${compiled_header}" compiled_header_sha256)
        file(SHA256 "${selected_header}" selected_header_sha256)
        if(NOT selected_header_sha256 STREQUAL compiled_header_sha256)
            message(FATAL_ERROR "WIKIDICT_INSTALL_CORE_PREFIX header does not match the compiled header")
        endif()
    endif()
    set(wikidict_install_executable "${selected_executable}" PARENT_SCOPE)
    set(wikidict_install_ffi "${selected_ffi}" PARENT_SCOPE)
    set(wikidict_install_header "${selected_header}" PARENT_SCOPE)
endfunction()
