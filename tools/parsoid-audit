#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -lt 1 ]; then
  printf 'Usage: tools/parsoid-audit <compiled-zig-tool> [args...]\n' >&2
  exit 1
fi

tool_bin="$1"
shift
tool_bin="$(realpath "$tool_bin")"

cd "$repo_dir"
exec "$tool_bin" "$@"
